<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	elementFormDefault="qualified" version="1.0.1">

	<xs:annotation>
		<xs:documentation>
			This schema defines IBM Software Identity Catalog.
		</xs:documentation>
	</xs:annotation>

	<xs:simpleType name="StringValue1toMax">
		<xs:annotation>
			<xs:documentation>
				Common String value with min length of 1 and max of 255
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="250"/>
		</xs:restriction>
	</xs:simpleType>
     <xs:simpleType name="StringValue0toMax">
		<xs:annotation>
			<xs:documentation>
				Common String value with min length of 1 and max of 255
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="250"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="UniqueIdType">
		<xs:annotation>
			<xs:documentation>
				UniqueId e.g. 1c7ead84-c931-4dbf-bed2-1b225579f54b
			</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="36"/>
			<xs:maxLength value="36"/>
			<xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="SizeType">
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="15"/>
			<xs:pattern value="[0-9]*" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="VersionType">
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="250"/>
			<xs:pattern value="([0-9]{1,18}\..*)|\*" />
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="FileRuleType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute type="StringValue1toMax" name="name" use="required" />
				<xs:attribute type="SizeType" name="size" />
				<xs:attribute type="StringValue0toMax" name="version" />
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="PackageFilterRuleType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute type="StringValue1toMax" name="name" use="required"/>
				<xs:attribute type="StringValue0toMax" name="vendor"/>
				<xs:attribute type="StringValue0toMax" name="version"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="SignatureBasicType">
		<xs:choice minOccurs="1" maxOccurs="1">
			<xs:element name="AND" maxOccurs="1" minOccurs="1">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="OR" maxOccurs="2" minOccurs="1">
							<xs:complexType>
								<xs:choice minOccurs="1" maxOccurs="1">
									<xs:element name="File" maxOccurs="20" minOccurs="1" type="FileRuleType"/>
									<xs:element name="PackageFilter" maxOccurs="20" minOccurs="1" type="PackageFilterRuleType"/>
								</xs:choice>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
            <xs:element name="ExtendedSignature" maxOccurs="1" minOccurs="1"/>
		</xs:choice>
		<xs:attribute type="UniqueIdType" name="uniqueId"/>
		<xs:attribute type="xs:dateTime" name="modified"/>
		<xs:attribute type="xs:dateTime" name="created"/>
	</xs:complexType>

	<xs:complexType name="SoftwareType">
		<xs:sequence>
			<xs:element name="Signature" minOccurs="1" maxOccurs="unbounded" type="SignatureBasicType"/>
		</xs:sequence>
		<xs:attribute type="StringValue1toMax" name="name" use="required"/>
		<xs:attribute type="StringValue1toMax" name="vendor" use="required"/>
		<xs:attribute type="UniqueIdType" name="uniqueId"/>
		<xs:attribute type="VersionType" name="version" use="required"/>
	</xs:complexType>

	<xs:complexType name="SoftwareIdentityCatalogType">
		<xs:sequence>
			<xs:element name="Software" minOccurs="1" maxOccurs="unbounded" type="SoftwareType"/>
		</xs:sequence>
		<xs:attribute type="xs:dateTime" name="exportTimeStamp"/>
	</xs:complexType>
	<xs:element name="SoftwareIdentityCatalog" type="SoftwareIdentityCatalogType"/>

</xs:schema>
