<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Printer Distribution: CLAS - Delete Printer Objects (See Description Tab for Details)</Title>
    <Description><![CDATA[<P>This task will <STRONG><U>delete</U></STRONG> the following printer ojects:</P>
<UL>
<LI>Microsoft XPS Document Writer
<LI>Microsoft Office Document Image Writer
<LI>Adobe PDF
<LI>Send To OneNote 2010
<LI>Fax</LI></UL>]]></Description>
    <Relevance>(((name of it = &quot;WinXP&quot; AND x64 of it)OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it))of operating system )</Relevance>
    <Category>Windows Printers</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2013-01-08</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 11 Jan 2013 18:39:40 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">createfile until stop
	runas /user:%COMPUTERNAME%\Administrator
	cscript &quot;C:\Windows\System32\Printing_Admin_Scripts\en-US\prnmngr.vbs&quot; -d -p &quot;Microsoft XPS Document Writer&quot;
	cscript &quot;C:\Windows\System32\Printing_Admin_Scripts\en-US\prnmngr.vbs&quot; -d -p &quot;Microsoft Office Document Image Writer&quot;
	cscript &quot;C:\Windows\System32\Printing_Admin_Scripts\en-US\prnmngr.vbs&quot; -d -p &quot;Adobe PDF&quot;
	cscript &quot;C:\Windows\System32\Printing_Admin_Scripts\en-US\prnmngr.vbs&quot; -d -p &quot;Send To OneNote 2010&quot;
	cscript &quot;C:\Windows\System32\Printing_Admin_Scripts\en-US\prnmngr.vbs&quot; -d -p &quot;Fax&quot;
stop
delete deletePrinters.bat
copy __createfile deletePrinters.bat
wait cmd.exe /C deletePrinters.bat</ActionScript>
    </DefaultAction>
  </Task>
</BES>
