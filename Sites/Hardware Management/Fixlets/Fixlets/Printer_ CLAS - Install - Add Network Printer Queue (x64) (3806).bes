	waithidden "__Download\RunAsCurrentUser-2.0.3.1.exe" --w --q cmd.exe /C AddPrinter.bat

	// WINXP - KILL PRINTER QUEUE WINDOW WHEN IT OPENS
	if {exists running application whose (name of it as lowercase is "rundll32.exe")}
		runhidden taskkill /f /im rundll32.exe
	endif

	// WIN& - KILL PRINTER QUEUE WINDOW WHEN IT OPENS
	if {exists running application whose (name of it as lowercase is "splwow64.exe")}
		runhidden taskkill /f /im splwow64.exe
	endif
endif

// UPDATE STATUS
notify client ForceRefresh]]></ActionScript>
    </Action>
  </Task>
