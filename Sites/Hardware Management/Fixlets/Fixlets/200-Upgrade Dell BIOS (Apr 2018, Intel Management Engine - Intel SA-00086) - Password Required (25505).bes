    <Relevance>(exists wmi)</Relevance>
    <Relevance>(exists string values whose (it as string contains &quot;Dell&quot;) of selects &quot;Manufacturer from Win32_ComputerSystem&quot; of wmi)</Relevance>
    <Relevance>exists string values whose (it as string contains &quot;Latitude E5470&quot; OR it as string contains &quot;Latitude E5270&quot; OR it as string contains &quot;Latitude E5570&quot; OR it as string contains &quot;Precision 3510&quot; OR it as string contains &quot;Latitude E5450&quot; OR it as string contains &quot;Latitude 5280&quot; OR it as string contains &quot;Latitude 5288&quot; OR it as string contains &quot;Latitude 5480&quot; OR it as string contains &quot;Latitude 5488&quot; OR it as string contains &quot;Latitude 5580&quot; OR it as string contains &quot;Precision 3520&quot;) of selects &quot;Model from Win32_ComputerSystem&quot; of wmi</Relevance>
    <Relevance><![CDATA[((it as version < "A19" as version AND it as string contains "A" as string) of string value of select "SMBIOSBIOSVersion from WIN32_BIOS" of wmi) OR (((it as version < "1.9.3" as version AND it as string does not contain "A" as string) of string value of select "SMBIOSBIOSVersion from WIN32_BIOS" of wmi) AND ((it as string contains "Latitude 5280" OR it as string contains "Latitude 5288" OR it as string contains "Latitude 5480" OR it as string contains "Latitude 5488" OR it as string contains "Latitude 5580" OR it as string contains "Precision 3520" AND it as string does not contain "Latitude E5470" AND it as string does not contain "Latitude E5270" AND it as string does not contain "Latitude E5570" AND it as string does not contain "Precision 3510") of select "Model from Win32_ComputerSystem" of wmi)) OR (((it as version < "1.18.6" as version AND it as string does not contain "A" as string) of string value of select "SMBIOSBIOSVersion from WIN32_BIOS" of wmi) AND ((it as string contains "Latitude E5470" OR it as string contains "Latitude E5270" OR it as string contains "Latitude E5570" OR it as string contains "Precision 3510" AND it as string does not contain "Latitude 5280" AND it as string does not contain "Latitude 5288" AND it as string does not contain "Latitude 5480" AND it as string does not contain "Latitude 5488" AND it as string does not contain "Latitude 5580" AND it as string does not contain "Precision 3520") of select "Model from Win32_ComputerSystem" of wmi))]]></Relevance>
    <Category>BIOS Updates</Category>
    <Source>Tyler D.</Source>
    <SourceReleaseDate>2018-04-10</SourceReleaseDate>
    <SourceSeverity>High</SourceSeverity>
    <CVENames>CVE-2017-5715, CVE-2017-5753, CVE-2017-5754</CVENames>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 03 May 2018 15:11:10 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to Upgrade Dell BIOS.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//prefetch YOU MUST DOWNLOAD THE BIOS UPDATES AND GENERATE YOUR OWN PREFETCH.

//Suspend BitLocker until next reboot
//Script will not capture bitlocker recovery password
//Verifies BitLocker is suspended on C:\ before continuing

action uses wow64 redirection {not x64 of operating system}

parameter "PowerShellExe"="{ pathname of file ((it as string) of value "Path" of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\ShellIds\Microsoft.PowerShell" of native registry) }"

delete __createfile
delete powershell.ps1

createfile until _end_

Suspend-BitLocker -mountpoint "C:" -rebootcount 1

_end_

move __createfile powershell.ps1

waithidden "{parameter "PowershellExe"}" -ExecutionPolicy Bypass -File powershell.ps1

continue if {(exists wmi "root\CIMv2\Security\MicrosoftVolumeEncryption" whose (exists select objects "ProtectionStatus, DriveLetter from Win32_EncryptableVolume" whose (integer value of property "ProtectionStatus" of it = 0 AND string value of property "DriveLetter" of it = "C:") of it))}

//Run potential solutions to the 'Black screen, never fully reboots' problem

waithidden cmd.exe /C Powercfg /hibernate off
waithidden cmd.exe /C bcdboot C:\Windows

//Run the install for the BIOS update depending on model

if {exists string values whose (it as string contains "Latitude E5450") of selects "Model from Win32_ComputerSystem" of wmi}

waithidden __Download\Flash64W.exe /b="{(client folder of current site as string) & "\__Download\E5450A19.exe"}" /p={parameter "secret" of action} /f /s /l="C:\BIOSUpdateLog.log"
continue if {exit code of action = 2}

elseif {exists string values whose (it as string contains "Latitude E5470" OR it as string contains "Latitude E5270" OR it as string contains "Latitude E5570" OR it as string contains "Precision 3510") of selects "Model from Win32_ComputerSystem" of wmi}

waithidden __Download\Flash64W.exe /b="{(client folder of current site as string) & "\__Download\Latitude_E5x70_Precision_3510_1.18.6.exe"}" /p={parameter "secret" of action} /f /s /l="C:\BIOSUpdateLog.log"
continue if {exit code of action = 2}

elseif {exists string values whose (it as string contains "Latitude 5280" OR it as string contains "Latitude 5288" OR it as string contains "Latitude 5480" OR it as string contains "Latitude 5488" OR it as string contains "Latitude 5580" OR it as string contains "Precision 3520") of selects "Model from Win32_ComputerSystem" of wmi}

waithidden __Download\Flash64W.exe /b="{(client folder of current site as string) & "\__Download\Latitude_5X80_Precision_3520_1.9.3.exe"}" /p={parameter "secret" of action} /f /s /l="C:\BIOSUpdateLog.log"
continue if {exit code of action = 2}

endif

action requires restart]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
