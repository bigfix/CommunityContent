  Imported : 2015-05-12T12:13:44
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install Driver: Graphtec Pro Scanners - Windows</Title>
    <Description><![CDATA[<P>This task will install the&nbsp;Graphtec Pro&nbsp;scanner drivers. </P>
<P><A href="http://www.graphteccorp.com/support/software/scanners.html">http://www.graphteccorp.com/support/software/scanners.html</A></P>
<P>&nbsp;</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or later */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>not exists folder whose (name of it as lowercase starts with &quot;gtcscan&quot;) of folder &quot;DriverStore\FileRepository&quot; of system x64 folder</Relevance>
    <Category>Drivers</Category>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2014-06-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 12 May 2015 19:13:16 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click&amp;nbsp; </PreLink>
        <Link>here </Link>
        <PostLink>&amp;nbsp;to deploy this action. </PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// References:
//		http://www.graphteccorp.com/support/software/scanners.html
//		DPInst Command-Line Switches:  http://msdn.microsoft.com/en-us/library/windows/hardware/ff544775(v=vs.85).aspx
//		http://www.symantec.com/connect/articles/readyuse-dpinst-driver-applications
//		DPInst Return Codes:  http://msdn.microsoft.com/en-us/library/windows/hardware/ff544790(v=vs.85).aspx
//		http://blogs.technet.com/b/svengruenitz/archive/2008/07/02/driver-installation-and-updating-made-easy-dpinst-exe.aspx
//		http://www.ftdichip.com/Support/Knowledgebase/index.html?sampledpinstxmlfile.htm
//		http://www.itninja.com/question/silent-inf-install-with-dpinst-exe-failed

prefetch USB_Driver_v220.zip sha1:b3dc2c26b7dd64e46e426ce39aa9d0532f968783 size:2212200 http://www.graphteccorp.com/support/software/scanner/USB_Driver(CS_IS_CSX)v220.zip

// Download UnZip utility
prefetch unzip.exe sha1:84debf12767785cd9b43811022407de7413beb6f size:204800 http://software.bigfix.com/download/redist/unzip-6.0.exe sha256:2122557d350fd1c59fb0ef32125330bde673e9331eb9371b454c2ad2d82091ac
utility __Download\unzip.exe

// Extract
waithidden __Download\unzip.exe -o "{pathname of client folder of current site}\__Download\USB_Driver_v220.zip" -d "{pathname of client folder of current site}\__Download"

//Add certificates from the security catalog to trustedpublisher certificate store in order to bypass the trusted publisher dialog box.
parameter "InstallCAT" = "GTCUSD"
waithidden "{windows folder}\{if(x64 of operating system) then ("sysnative") else ("system32")}\certutil" -f -addstore trustedpublisher "{(pathname of file whose(name of it as uppercase starts with (parameter "InstallCAT") AND name of it as uppercase ends with ".CAT") of folder whose(name of it = ("Win_" & (if(x64 of operating system) then ("64bits") else ("32bits")))) of folder whose(name of it starts with "USB_Driver") of folder "__Download" of client folder of current site)}"


//Install Driver
parameter "InstallINF" = "GTCSCAN{ (if(x64 of operating system) then ("64") else ("")) }"

waithidden "{(pathname of folder whose(name of it = ("Win_" & (if(x64 of operating system) then ("64bits") else ("32bits")))) of folder whose(name of it starts with "USB_Driver") of folder "__Download" of client folder of current site) }\DPInst.exe" /s /se /sw /c /path "{(pathname of folder whose(name of it = ("Win_" & (if(x64 of operating system) then ("64bits") else ("32bits")))) of folder whose(name of it starts with "USB_Driver") of folder "__Download" of client folder of current site) }"]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
