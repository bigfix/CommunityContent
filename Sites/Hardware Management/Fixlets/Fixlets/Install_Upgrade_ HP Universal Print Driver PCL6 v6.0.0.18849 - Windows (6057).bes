<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Install/Upgrade: HP Universal Print Driver PCL6 v6.0.0.18849 - Windows
  ID       : 6057
  Author   : jgstew
  Domain   : BESC
  Imported : 2015-05-11T07:49:57
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Upgrade: HP Universal Print Driver PCL6 v6.0.0.18849 - Windows</Title>
    <Description><![CDATA[<P>This task will add the HP Universal Print Drivers to the Windows DriverStore. This will allow non-admins to use the driver to setup printers as needed.</P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance><![CDATA[not exists files whose( (name of it as lowercase ends with ".inf") AND (exists section "Version" of it) AND ("61.175.01.18849" <= unique value of (it as version) of following texts of lasts "," of keys "DriverVer" of section "Version" of it) AND (exists lines whose(it contains "HP Universal Printing PCL 6") of it) ) of folders whose(name of it as lowercase starts with "hp") of folders "DriverStore\FileRepository" of system x64 folder]]></Relevance>
    <Category>Driver</Category>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2015-05-11</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 11 May 2015 14:49:01 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// http://www8.hp.com/us/en/solutions/business-solutions/printingsolutions/UPD.html
// http://h20331.www2.hp.com/Hpsub/cache/494717-0-0-225-121.html
// http://h20628.www2.hp.com/km-ext/kmcsdirect/emr_na-c03633736-3.pdf
// http://h20566.www2.hp.com/hpsc/doc/public/display?sp4ts.oid=503548&docId=emr_na-c03633712&docLocale=en_US
// http://h20564.www2.hp.com/hpsc/swd/public/detail?sp4ts.oid=4157320&swItemId=ds_99377_6&swEnvOid=4062
// http://h20564.www2.hp.com/hpsc/swd/public/detail?sp4ts.oid=4157320&swItemId=ds_99378_6&swEnvOid=4063
// http://h20566.www2.hp.com/hpsc/swd/public/detail?sp4ts.oid=4157320&swItemId=ds_99433_13&swEnvOid=4062
// https://h20565.www2.hp.com/hpsc/doc/public/display?sp4ts.oid=503548&docId=emr_na-c01695467&docLocale=en_US
// https://technet.microsoft.com/en-us/library/cc730875.aspx
begin prefetch block

	add prefetch item name=7za.zip sha1=9ce9ce89ebc070fea5d679936f21f9dde25faae0 size=384846 url=http://softlayer-dal.dl.sourceforge.net/project/sevenzip/7-Zip/9.20/7za920.zip
    add prefetch item name=unzip.exe sha1=84debf12767785cd9b43811022407de7413beb6f size=204800 url=http://software.bigfix.com/download/redist/unzip-6.0.exe sha256=2122557d350fd1c59fb0ef32125330bde673e9331eb9371b454c2ad2d82091ac

	if{ x64 of operating system }
		add prefetch item name=upd-pcl6.exe sha1=1e3cc47ac9aa2505bb2d3cbf1164b46b1d76aa8b size=19282160 url=http://ftp.hp.com/pub/softlib/software12/COL40842/ds-99374-10/upd-pcl6-x64-6.0.0.18849.exe
	else
		add prefetch item name=upd-pcl6.exe sha1=162b09ce78851999d39895db9e84738cd9a478e5 size=17455344 url=http://ftp.hp.com/pub/softlib/software12/COL40842/ds-99353-10/upd-pcl6-x32-6.0.0.18849.exe
	endif

end prefetch block

// ADD TO UTILITY CACHE (to use in multiple tasks)
utility __Download\unzip.exe
utility __Download\7za.zip

// http://pic.dhe.ibm.com/infocenter/tivihelp/v26r1/index.jsp?topic=%2Fcom.ibm.tem.doc_8.2%2FPlatform%2FAction%2Fc_action_launch_preference_low_p.html
// launch exe's with low priority settings to help prevent disrupting the user
action launch preference low-priority

// EXTRACT using unzip: the 7zip command line utility
waithidden __Download\unzip.exe -o "{pathname of file "7za.zip" of folder "__Download" of client folder of current site}" 7za.exe -d "{pathname of folder "__Download" of client folder of current site}"

// EXTRACT using 7zip:
waithidden "{(pathname of file "7za.exe" of folder "__Download" of client folder of current site)}" x -y -o"{ pathname of folder "__Download" of client folder of current site }" "{pathname of file "upd-pcl6.exe" of folder "__Download" of client folder of current site}"

// INSTALL HP Universal Print Drivers
waithidden "{(pathname of file "Install.exe" of folder "__Download" of client folder of current site)}" /q /h /infstage

// ===============================================================================================
// |||||||||||||||||||||||||||||      BEGIN INSTALL.EXE /?     |||||||||||||||||||||||||||||||||||
// ===============================================================================================
//
// Installer Operation
//
// /q Quiet mode, no prompts
//
// /npf Don't open the Printers folder on completion
//
// /sc Simple confirmation
//
// /h Hides the install dialog
//
// /sm Creates a static printer instance bound to the specified , e.g. /sm\\server\printer, /smhostname, /sm15.62.98.111
//
// /m - driver version name need not be specified while installing. The /sm is required. Cannot be used with /sm\server\printer. The /n  is optional.
//
// /n"" Uses the specified name as the name of the printer, e.g. /n"HP LaserJet 8150"
//
// /ni Does not perform the printer install, only processes other install options
//
// /aml<"NAME","URL"> Adds a Managed List Name using the specified URL, e.g. '/aml"My Server","http://mywebserver"' or '/aml"My Printers","\\myprinters\printerlist\printerlist.xml"'
//
// /nd Does not set the printer as the default
//
// /tm Installs the printer in Traditional Mode
//
// /dm Installs the printer in Dynamic Mode
//
// /u Use the existing printer driver if it's already installed
//
// /infstage:  stage driver files to Windows driver store for printer plug and play software first installation. Only additional switches supported are /infremove, /q and /h (/q and /h required).
//
// /infremove:  remove all versions of HP Universal Printing Driver from the Windows driver store. Only additional switches supported are /infstage, /q and /h (/q and /h required).
//
// /gcfm"" - Specify DCU configuration file to be utilized for new printer installation, e.g. /gcfm"c:\temp\duplex.cfm"
//
// /qcomname"" Creates a queue specific snmp community name. (Note: name cannot end with numeric).
//
// /gcomname"" Specifies a system-global SNMP community name. (Note: name cannot end with numeric).
//
// /dgst - Disables the Services tab globally in the HP UPD for all print queues.
//
// /s - specify virtual node for cluster install for e.g.  /s"\\virtualspooler" should be run from the node having administrative privileges. Where "virtualspooler" is the virtual spooler where the queue is getting installed.
//
// ===============================================================================================
]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
