<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>TEMPLATE: Dell Command Configure - Windows</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>FALSE</Relevance>
    <Relevance>/* DELL Only */ exists values &quot;vendor&quot; whose(it as string as uppercase contains &quot;DELL&quot;) of structures &quot;bios_information&quot; of smbios</Relevance>
    <Relevance>/* check for supported model: OptiPlex, Latitude, Precision, Venue Tablets, XPS */ exists ((value &quot;product_name&quot; of structures &quot;system_information&quot; of smbios) as string as uppercase) whose(it starts with &quot;OPTIPLEX&quot; OR it starts with &quot;LATITUDE&quot; OR it starts with &quot;PRECISION&quot; OR it starts with &quot;XPS&quot; OR it starts with &quot;VENUE&quot;)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2015-10-21</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 21 Oct 2015 17:35:44 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// Download DCC? Use already installed version?


// Run DCC


parameter "DCC_ExitCode" = "0"

//  https://bigfix.me/relevance/details/3003613
//  https://bigfix.me/relevance/details/3003614
//    If Dell Command Configure is installed on the endpoint, then this info could be pulled from: cctkerrorcodes.txt
// get value of ERROR code and echo it so that it ends up in the BigFix client log
waithidden CMD /C echo { tuple string item ( parameter "DCC_ExitCode" as integer ) of (it as string) of ( rope "Success., " & rope "Attempt to read write-only parameter '%25s'., " & rope "Password cannot exceed 16 characters., " & rope "A BMC was either not detected or is not supported., " & rope "This username is already in use. Enter a unique username., " & rope "Access mode not supported., " & rope "Cannot return number of requested data bytes., " & rope "User ID 1 cannot be assigned a username., " & rope "Cannot execute duplicated request., " & rope "There was an error clearing the SEL., " & rope "Clear SEL cannot be accompanied with any other option., " & rope "racreset cannot be accompanied with any other option., " & rope "Cannot execute command '%25s'. Command; or request parameter(s); not supported in present state., " & rope "Command not supported on given channel., " & rope "The community string may only contain printable ASCII characters., " & rope "Destination unavailable. Cannot deliver request to selected destination., " & rope "Cannot execute command. Insufficient privilege level., " & rope "Command illegal for specified sensor or record type., " & rope "Invalid commstring value., " & rope "Hardware subsystem error. Invalid data field in Request., " & rope "Invalid destination IP address., " & rope "The GUID is invalid., " & rope "Invalid gateway., " & rope "Invalid hostname., " & rope "Invalid IP address., " & rope "Invalid DNS IP address., " & rope "Invalid sub net mask., " & rope "Invalid value for PEF. PEF value should be between 1 and 16., " & rope "Reservation Canceled or Invalid Reservation ID., " & rope "Invalid Time to live value., " & rope "Invalid VLANID value., " & rope "Invalid Command. Used to indicate an unrecognized or unsupported command., " & rope "Command invalid for given LUN., " & rope "Load defaults cannot be accompanied with any other option., " & rope "There was an error loading the defaults., " & rope "Node Busy. Command could not be processed because command processing resources are temporarily unavailable., " & rope "Out of space. Command could not be completed because of a lack of storage space required to execute the given command operation., " & rope "This parameter is not supported., " & rope "Parameter out of range. One or more parameters in the data field of the Request are out of range., " & rope "The password may only contain printable ASCII characters., " & rope "Password test failed., " & rope "Requested data length invalid., " & rope "Requested data field length limit exceeded., " & rope "Requested Sensor; data; or record not present., " & rope "Request data truncated., " & rope "Command response could not be provided., " & rope "Command response could not be provided. BMC initialization or initialization agent in progress., " & rope "Command response could not be provided. Device in firmware update mode., " & rope "Command response could not be provided. SDR Repository in update mode., " & rope "Cannot execute command; SEL erase in progress., " & rope "Attempt to set the 'set in progress' value when not in the 'set in complete' state., " & rope "The SOL character 'accumulate interval' is invalid., " & rope "The SOL character 'send threshold' is invalid., " & rope "The SOL 'retry interval' is invalid., " & rope "Command completed successfully., " & rope "Timeout while processing command. Response unavailable., " & rope "Unspecified error., " & rope "The password may only contain printable ASCII characters., " & rope "Username cannot exceed 16 characters., " & rope "Invalid VLANID value. Enter in 'dddd' format., " & rope "Attempt to write read-only parameter '%25s'., " & rope "BMC is busy., " & rope "Response data did not return successfully., " & rope "BMC time out error., " & rope "Invalid Configuration Option., " & rope "Cannot execute command.Parameter is illegal because command sub-function has been disabled or is unavailable., " & rope "Option '%25s' requires an argument., " & rope "The asset tag for this system is not available., " & rope "The asset tag cannot be more than 10 characters long., " & rope "The required BIOS interfaces cannot be found on this system., " & rope "The BIOS version information is not available., " & rope "There is not enough free system memory to complete the BIOS update., " & rope "The BIOS update file version is a different version class (A00; X00) than the current system BIOS. Use the --force option to use this BIOS image., " & rope "The BIOS update file version is older than the current system bios.  Use the --force option to use this BIOS image., " & rope "The BIOS update file version is identical to the current system bios.  Use the --force option to use this BIOS image., " & rope "The sequence list must be a comma-separated numerical list of valid unique boot device numbers (ex: 2; 1; 3)., " & rope "The sequence list must be a comma-separated list of valid unique device names (ex: nic.emb.1; hdd.emb.1) or a comma-separated numerical list of valid unique boot device numbers (ex: 2; 1; 3)., " & rope "There was an error setting the sequence., " & rope "The list is not formatted correctly. See the help for more details., " & rope "The size of returned buffer is larger than the size of allocated buffer., " & rope "There was a problem getting the state byte., " & rope "The state byte is not available on this system., " & rope "There was a problem setting the state byte., " & rope "The state byte must be a value between 0 and 255 decimal., " & rope "The CPU information is not available., " & rope "The dependent option '%25s' required for this subcommand is missing in the command line., " & rope "Duplicate sub command '%25s' has been entered., " & rope "The script file does contain not a valid DTK environment script signature.  (%25s), " & rope "The format of the environment variable is incorrect., " & rope "The --envar/-s option can only be used for a single option., " & rope "The --envar/-s option can only be used for report operations., " & rope "The individual sub commands should be specified for the -s option., " & rope "Getting external serial connector settings failed., " & rope "Setting external serial connector settings failed., " & rope "There was an error opening the file %25s., " & rope "File '%25s' does not have write permission., " & rope "The file contains invalid option '%25s'., " & rope "The replication information does not match for this system., " & rope "There can only be one section in the input file., " & rope "Bad ini file; the required section [%25s] cannot be found., " & rope "The format of the bios image file is incorrect., " & rope "Report operations and set operations must be separate., " & rope "Help is not available for the option '%25s'., " & rope "The -x (--hex) option can only be used with -b or -r., " & rope "Input file '%25s' not found., " & rope "Input file '%25s' cannot be read., " & rope "Invalid argument for the provided option '%25s'., " & rope "Function table lookup error., " & rope "The machine ID was not found in the file '%25s'., " & rope "The system memory information is not available., " & rope "Mode can only be used with the --pci option., " & rope "The device name or index must be present in the boot order., " & rope "The output file '%25s' could not be opened. Please make sure the path exists and the media is not write protected., " & rope "Could not write to output file; disk may be full., " & rope "The old password must be supplied to set a new password using --valsyspwd., " & rope "The old password must be supplied to set a new password using --valsetuppwd., " & rope "The current password can only be supplied when setting a new password., " & rope "Actions are not allowed for this filter. Only alerts are allowed., " & rope "There was an error getting the option '%25s'., " & rope "The option '%25s' is not available or cannot be configured through this tool., " & rope "There was an error setting the option '%25s'., " & rope "The -n (--namefile) option can only be used with --pci., " & rope "The password may only contain alphanumeric characters., " & rope "The BIOS passwords have been disabled via jumper., " & rope "The password length must be between 1 and 32., " & rope "This password is locked and can only be unlocked by the admin user., " & rope "There was an error setting the password., " & rope "The LCD string length must be between 1 and the maximum value %25s., " & rope "The LCD string may only contain alphanumeric characters., " & rope "There was an error setting the LCD string., " & rope "The second channel can only be set if the RAID controller is set to RAID., " & rope "The set operation; '%25s'; requires sub commands., " & rope "The service tag for this system is not available., " & rope "The system ID value is not available., " & rope "The system information string is not available., " & rope "A system error has occured., " & rope "Usage error., " & rope "The uuid information is not present on this system., " & rope "The manufacturing/first-power-on date information is not present on this system., " & rope "Version cannot be accompanied with any other option., " & rope "The self-identify blinker timer should be set to 0..255 second(s)., " & rope "Encrypt key is too long., " & rope "Encrypt key is invalid; accepted characters are 0 to 9 or A to F., " & rope "Parameter has been temporarily disabled due to a dependancy on other settings., " & rope "The old password supplied is incorrect. The new password will not be set. Please try again., " & rope "Cannot start /etc/omreg.cfg file. Please ensure /etc/omreg.cfg file is present and is valid for your environment. You can copy this file from the DTK iso., " & rope "Getting nicselection settings failed., " & rope "HAPI Driver Load Error., " & rope "Filter action power reduction is only supported for the system power warn/fail filters., " & rope "TPM Clear settings requires setup password., " & rope "There is currently no TPM Clear request pending., " & rope "Password is not required for retrieving the TPM options., " & rope "Setup password is required for setting the TPM options., " & rope "Invalid Password override., " & rope "Invalid TPM set option., " & rope "There was an error setting the TPM option., " & rope "There is no setup password installed on this system., " & rope "The setup password supplied is incorrect. Please try again., " & rope "Profile should be custom for setting cpupowermode; memorypowermode and fanmode., " & rope "There was an error setting the Power Option., " & rope "The power cap value entered is out of range. Please try again., " & rope "The power cap value entered must be between 0 to 100 if unit is percent., " & rope "Invalid IPv6 address. The IPv6 address cannot be link-local or multicast., " & rope "Invalid IPv6 address. The IPv6 address specified has incorrect address format., " & rope "Invalid IPv6 address. The gateway address specified has incorrect address format., " & rope "Invalid IPv6 address. The Primary DNS server address specified has incorrect address format., " & rope "Invalid IPv6 address. The Secondary DNS server address specified has incorrect address format., " & rope "Invalid IPv6 address. The gateway address specified is invalid., " & rope "Invalid configuration. Attempting to apply IPv6 configuration on a non supported platform., " & rope "Invalid IPv6 configuration. Attempt to set DNS server address manually while DNS address source is set to auto., " & rope "Invalid IPv6 configuration. Attempt to set IPv6 address manually while IPv6 address source is set to auto., " & rope "Invalid IPv6 configuration. Attempting to apply IPv6 configuration without loading IPv6 stack., " & rope "Invalid IPv4 configuration. Attempting to apply IPv4 configuration with IPv4 disabled., " & rope "Invalid IPv6 configuration. Ipv6 address cannot be specified without specifying prefix-length., " & rope "Invalid IPv6 configuration. dnssrcv6 cannot be set to auto when ipsrcv6 is set to manual., " & rope "Error while executing IPMI Set command., " & rope "Error while executing IPMI Get command., " & rope "Error during Trap Alert., " & rope "Unspecified error., " & rope "Unsupported device. Re-try with supported device, " & rope "Setup password is installed. Re-try providing setup/admin password, " & rope "System password is required. Re-try providing system password, " & rope "The password supplied is incorrect. Please try again., " & rope "Password verification failed., " & rope "Password not changed; new password does not meet criteria., " & rope "Password not installed in the system., " & rope "Password is DISABLED by jumper., " & rope "Error in Validation., " & rope "Error in Setting the Value., " & rope "The password length should not exceed the maximum value %25s., " & rope "This is not a Dell machine. DCC supports only Dell machines., " & rope "Setup Password is required to change the setting. Use --valsetuppwd to provide password., " & rope "System Password is required to change the setting. Use --valsyspwd to provide password., " & rope "Password is not Installed. so use only --setuppwd, " & rope "Password is not Installed. so use only --syspwd, " & rope "The system password supplied is incorrect. Please try again., " & rope "The Sequence list must be a comma-separated list of valid unique device names (ex: hdd,cdrom)., " & rope "The system revision information is not available for this system., " & rope "The completion code information is not available for this system., " & rope "The BIOS characteristics information is not available for this system., " & rope "The password should not contain special characters. Password characters are limited to alphanumeric (A-Z; a-z; 0-9)., " & rope "Please use 64-bit version of this application., " & rope "%25s cannot be modified when TPM is OFF., " & rope "System password cannot be set when pwdlock option is in locked state (pwdlock=lock)., " & rope "adddevice option not supported by this machine's BIOS, " & rope "usb device already present in this machine., " & rope "Unable to get information from BIOS., " & rope "%25s - Error : Unable to store BIOS information., " & rope "Duplicate entry found in the input list : %25s ; Operation Aborted., " & rope "Typo found in the input list : %25s ; Operation Aborted., " & rope "Asset tag can have only printable ASCII characters., " & rope "Multiple inputs will not be accepted., " & rope "Invalid Hex format., " & rope "Hex value range should be 0x0 to 0xffff., " & rope "%25s - Only positive numeric values are acceptable., " & rope "%25s - Length cannot exceed two characters., " & rope "Range for autoon hour value should be 0 to 23(24 hour format)., " & rope "Range for autoon minute value should be 0 to 59., " & rope "This option Not supported on UEFI Bios., " & rope "Unable to Set Bootorder., " & rope "Invalid Arguments. Unable to Set Bootorder., " & rope "The provided command %25s should not combine with other suboptions., " & rope "The property ownership tag for this system is not available., " & rope "The property ownership tag cannot be more than 80 characters for non portable machines., " & rope "The property ownership tag is limited to 48 characters for portable systems., " & rope "Property ownership tag can have only printable ASCII characters., " & rope "Error in Setting the Value. Note : In some machines; If Hdd password or System password is set; you can't set Setup password., " & rope "'admin/root' privileges required to execute this application., " & rope "The option related BIOS information is not available in this machine., " & rope "Improper Output from Bios. Please try again., " & rope ";Error in Bootorder., " & rope "The manufacturing/first-power-on date information is not present on this system., " & rope "Not Applicable., " & rope ";Uefi bootlisttype is not supported in this Machine., " & rope ";Error in Bootorder., " & rope "Unable to get information specific to machine., " & rope "The input file is invalid., " & rope "No Status Present., " & rope "File Do not have configurable Options., " & rope "Please provide the days to enable., " & rope "Password is not Installed. Please try again without providing --val%25s, " & rope "Please provide the old password to set the new password using --valownerpwd., " & rope "The owner password is incorrect. Please try again., " & rope "Error in setting the value. Note : Setup or system password might be set on the system. Clear the password(s) and try again., " & rope "Owner password is not supported in file operations., " & rope "Password operation is not supported on the system., " & rope "The owner of the system has enabled the Owner Access feature. To set the Bios configuration; create setup or system password., " & rope "Either the system hardware or the BIOS version does not support the option. To resolve the BIOS version issue; upgrade the BIOS to the latest version., " & rope "Unable to get password information., " & rope "Please provide the start and stop values. Example: custom:start-end., " & rope "The start and stop values should be in the range '%25s'., " & rope "The stop value should be greater than the start value by 5 percentage., " & rope "The option '%25s' is not supported in this machine., " & rope "Unable to set '%25s'. Note: To set this Option Legacy Option rom(legacyorom) should be enable and secureboot should be disable., " & rope "Unable to set '%25s'. Note: To set this Option bootmode(activebootlist) should be uefi and legacy option rom (legacyorom) should be disable., " & rope "Unable to set '%25s'. Note: To enable this Option secureboot should be disable. To disable this Option secureboot should be disable and bootmode(activebootlist) should be uefi., " & rope "The allowed value for the option in the system are in between %25s., " & rope "The option '%25s' is not enabled., " & rope "Invalid argument! The possible values are: 0; 1-15; and 255., " & rope "Invalid argument. The