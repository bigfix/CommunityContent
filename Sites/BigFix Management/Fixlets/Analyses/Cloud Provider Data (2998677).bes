    <Property ID="4" Name="Cloud Unique ID" EvaluationPeriod="P1D">if (exists property &quot;cloud provider&quot;) then (if (exists unique id of cloud provider) then unique id of cloud provider else nothing) else nothing</Property>
    <Property ID="5" Name="Cloud Version" EvaluationPeriod="P1D">if (exists property &quot;cloud provider&quot;) then (if (exists version of cloud provider) then version of cloud provider else nothing) else nothing</Property>
