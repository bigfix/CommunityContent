<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>BigFix Client - Health Check - Windows</Title>
    <Description>Provides Health Check information from the Client Health Check Script </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists event log &quot;BigFix Client Health&quot;</Relevance>
    <Domain>BESC</Domain>
    <Property ID="5" Name="Client Health Check - Errors - Windows" EvaluationPeriod="PT1H">(time generated of it, description of it) of records whose (time generated of it &gt; now - day * 14 and event id of it = 1338) of event log &quot;BigFix Client Health&quot; </Property>
    <Property ID="6" Name="Client Health Check - Last Event - Windows" EvaluationPeriod="PT1H">(time generated of it, description of it) of record (maximum of record numbers of records of it) of event log &quot;BigFix Client Health&quot; </Property>
    <Property ID="7" Name="Client Health Check - Last Repair - Windows" EvaluationPeriod="PT1H">maximum of times generated of records whose (event id of it = 1338) of event log &quot;BigFix Client Health&quot; </Property>
    <Property ID="9" Name="Client Health Check - Failure Messages - Windows" EvaluationPeriod="PT1H">(time generated of it, description of it) of records whose (event id of it = 1338) of event log &quot;BigFix Client Health&quot; </Property>
    <Property ID="11" Name="Client Health Check - Last Success - Windows" EvaluationPeriod="PT1H">maximum of times generated of records whose (event id of it = 1340) of event log &quot;BigFix Client Health&quot; </Property>
  </Analysis>
</BES>
