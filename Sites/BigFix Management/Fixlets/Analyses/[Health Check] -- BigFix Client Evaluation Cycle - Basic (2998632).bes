<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>[Health Check] -- BigFix Client Evaluation Cycle - Basic</Title>
    <Description><![CDATA[<P>This analysis returns the following basic client evalation loop statistics. </P>
<UL>
<LI>Client Version
<LI>Maximum Cycle&nbsp;Minutes
<LI>Average Cycle Minutes
<LI>Top 10 Longest Evaluating Fixlets - External Sites
<LI>Top 10 Longest Evaluating Fixlets - Custom Sites
<LI>Maximum CPU Usage</LI></UL>]]></Description>
    <Relevance>true</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 21 Dec 2020 13:47:01 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Client Version" EvaluationPeriod="PT6H">version of client</Property>
    <Property ID="2" Name="Maximum Cycle Minutes" EvaluationPeriod="PT6H">((maximum of it /1000* second)/minute) of evaluationcycle of client</Property>
    <Property ID="3" Name="Average Cycle Minutes" EvaluationPeriod="PT6H">((average of it /1000* second)/minute) of evaluationcycle of client</Property>
    <Property ID="4" Name="Top 10 Longest Evaluating Fixlets - External Sites" EvaluationPeriod="PT6H"> track fixlets whose (it does not contain &quot;CustomSite&quot; OR it as lowercase does not contain &quot;opsite&quot;) of evaluationcycle of client</Property>
    <Property ID="6" Name="Top 10 Longest Evaluating Fixlets - Custom Sites" EvaluationPeriod="PT6H">track fixlets whose (it contains &quot;CustomSite&quot; OR it as lowercase contains &quot;opsite&quot;) of evaluationcycle of client</Property>
    <Property ID="7" Name="Maximum CPU Usage" EvaluationPeriod="PT6H">(((((it)/((it)+((if (not exists setting &quot;_BESClient_Resource_SleepIdle&quot; of client OR not exists value of setting &quot;_BESClient_Resource_SleepIdle&quot; of client) then 480 /* Default value */ else (value of setting &quot;_BESClient_Resource_SleepIdle&quot; of client as integer)) as floating point))) / (sum of cores of cpupackage as floating point)) * 100) as integer) of ((if (not exists setting &quot;_BESClient_Resource_WorkIdle&quot; of client OR not exists value of setting &quot;_BESClient_Resource_WorkIdle&quot; of client) then 10 /* Default value */ else (value of setting &quot;_BESClient_Resource_WorkIdle&quot; of client as integer)) as floating point)</Property>
  </Analysis>
</BES>
