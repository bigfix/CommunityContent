<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Upload Manager Settings</Title>
    <Description><![CDATA[<P>Analysis which pulls back all of the Archive Manager related settings so we can confirm all is working correctly.</P>
<P>NOTE:&nbsp; See <A href="http://support.bigfix.com/product/documents/Upload_Archive_Manager_80_101211.pdf">http://support.bigfix.com/product/documents/Upload_Archive_Manager_80_101211.pdf</A> for more details.</P>]]></Description>
    <Relevance>true</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 01 Oct 2012 21:31:03 +0000</Value>
    </MIMEField>
    <Domain>BES </Domain>
    <Property ID="7" Name="Progress" EvaluationPeriod="PT0S">if exists setting &quot;_BESClient_UploadManager_Progress&quot; of client then   value of setting &quot;_BESClient_UploadManager_Progress&quot; of client as string  else &quot;&quot;</Property>
    <Property ID="8" Name="Client Buffer Directory" EvaluationPeriod="P1D">if exists setting &quot;_BESClient_UploadManager_BufferDirectory&quot; of client then   value of setting &quot;_BESClient_UploadManager_BufferDirectory&quot; of client as string  else &quot;&quot;</Property>
  </Analysis>
</BES>
