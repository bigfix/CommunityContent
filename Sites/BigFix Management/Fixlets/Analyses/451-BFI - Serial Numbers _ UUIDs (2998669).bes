<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>BFI - Serial Numbers / UUIDs</Title>
    <Description><![CDATA[<P>This is sample analysis pulling out raw data from BigFix Inventory Hardware Scan, Detailed Hardware Scan as well as BigFix Client Inspectors.</P>]]></Description>
    <Relevance>if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true</Relevance>
    <Relevance><![CDATA[version of client >= "9" as version]]></Relevance>
    <MIMEField>
      <Name>bigfixme-added-time</Name>
      <Value>Tue, 17 Aug 2021 10:44:07 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-modification-time</Name>
      <Value>Tue, 17 Aug 2021 10:44:07 GMT</Value>
    </MIMEField>
    <MIMEField>
