<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Action that can only be run by a particular user - Universal</Title>
    <Description>This will be TRUE on all systems, unless it is taken as an action, then it will only be true if the correct user ran it.</Description>
    <Relevance>if (exists action AND exists headers &quot;action-issuer-name&quot; of action) then (exists values whose(it as string = &quot;NAME_OF_ONLY_USER_THAT_CAN_ACTUALLY_RUN_THIS&quot;) of headers &quot;action-issuer-name&quot; of action) else TRUE</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2015-11-12</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 12 Nov 2015 19:35:08 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
run echo This doesn&apos;t really do anything: { values of headers &quot;action-issuer-name&quot; of action }
</ActionScript>
    </DefaultAction>
  </Task>
</BES>
