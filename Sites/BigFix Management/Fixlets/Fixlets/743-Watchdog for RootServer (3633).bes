<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Watchdog for RootServer</Title>
    <Description><![CDATA[This task has one job... when/if RootServer fails, it will start it back up.&nbsp; If it can't start it, this task will wait 10min and try again.&nbsp; It will do this for 99 failures before giving up. ]]></Description>
    <Relevance><![CDATA[version of client >= "6.0"]]></Relevance>
    <Relevance>exists service &quot;BESRootServer&quot;</Relevance>
    <Relevance>not exists running service &quot;BESRootServer&quot;</Relevance>
    <Category>BESRootServer</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2011-05-02</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 01 Oct 2012 21:30:49 +0000</Value>
    </MIMEField>
    <Domain>BES </Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//this task is triggered if filldb is stopped... it will kick in and start it back up...

waithidden cmd /c net start BESRootServer
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
