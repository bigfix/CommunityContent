<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Patch BigFix Console wizards.js for IE11 compatibility - Windows TODO:testing</Title>
    <Description><![CDATA[&lt;enter a description of the problem and the corrective action here&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists lines containing &quot;window.attachEvent(&quot; whose(it starts with &quot;window.attachEvent(&quot;) of files &quot;wizards.js&quot; whose(not exists lines containing &quot;window.addEventListener(&quot; of it) of folders &quot;Reference&quot; of (folder it) of unique values of ( ( pathnames of parent folders of regapps &quot;BESConsole.exe&quot; );( pathnames of (folders it) of (it as string) of values &quot;InstallLocation&quot; of keys whose( exists values &quot;DisplayName&quot; whose(it as string contains &quot;BigFix Console&quot;) of it ) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries; x32 registries) ) )</Relevance>
    <Relevance>(exists regapps &quot;BESConsole.exe&quot;) OR ( exists keys whose( exists values &quot;DisplayName&quot; whose(it as string contains &quot;BigFix Console&quot;) of it ) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries; x32 registries) )</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2017-01-14</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sun, 15 Jan 2017 05:08:13 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
parameter &quot;wizardsjsfilepath&quot;=&quot;{ unique value of pathnames of files &quot;wizards.js&quot; whose(not exists lines containing &quot;window.addEventListener(&quot; of it) of folders &quot;Reference&quot; of (folder it) of unique values of ( ( pathnames of parent folders of regapps &quot;BESConsole.exe&quot; );( pathnames of (folders it) of (it as string) of values &quot;InstallLocation&quot; of keys whose( exists values &quot;DisplayName&quot; whose(it as string contains &quot;BigFix Console&quot;) of it ) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries; x32 registries) ) ) }&quot;

delete __createfile
createfile until _END_OF_FILE_
{ concatenations &quot;%0d%0a&quot; of lines whose(it does not start with &quot;window.attachEvent(&quot;) of files &quot;wizards.js&quot; whose(not exists lines containing &quot;window.addEventListener(&quot; of it) of folders &quot;Reference&quot; of (folder it) of unique values of ( ( pathnames of parent folders of regapps &quot;BESConsole.exe&quot; );( pathnames of (folders it) of (it as string) of values &quot;InstallLocation&quot; of keys whose( exists values &quot;DisplayName&quot; whose(it as string contains &quot;BigFix Console&quot;) of it ) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries; x32 registries) ) ) }


(function () {{
    if(window.addEventListener){{
        window.addEventListener(&apos;load&apos;, InsertUtilityDiv);
    } else {{
        window.attachEvent(&quot;onload&quot;, InsertUtilityDiv);
    }
})();

_END_OF_FILE_

delete &quot;{parameter &quot;wizardsjsfilepath&quot;}&quot;
copy __createfile &quot;{parameter &quot;wizardsjsfilepath&quot;}&quot;


// References:
//  - https://forum.bigfix.com/t/issues-with-console-dashboards-and-internet-explorer-versions-wizards-js-ie11-incompatibility/19790/6
//  - https://blogs.technet.microsoft.com/heyscriptingguy/2007/09/08/how-can-i-remove-any-line-in-a-text-file-that-contains-a-specified-string-value/
//  - https://bigfix.me/relevance/details/3019211
//  - https://bigfix.me/relevance/details/3019209
//  - https://bigfix.me/relevance/details/3019210
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
