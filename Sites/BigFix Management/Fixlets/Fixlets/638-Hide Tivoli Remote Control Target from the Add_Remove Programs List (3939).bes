<!--
  BigFix Fixlet Export

  Title    : Hide Tivoli Remote Control Target from the Add/Remove Programs List
  ID       : 3939
  Author   : thetick
  Domain   : BESC
  Imported : 2015-01-07T22:01:14
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Hide Tivoli Remote Control Target from the Add/Remove Programs List</Title>
    <Description><![CDATA[<TABLE>
<TBODY>
<TR>
<TD>The standard&nbsp;TRC installation package will list the TRC Target in the Windows "Add/Remove Programs" Tool. Any user logged in with sufficient privileges can see and remove the TRC Target using "Add/Remove Programs". Use the action below to remove the BES Client entry from the "Add/Remove Programs" list.</TD></TR></TBODY></TABLE>]]></Description>
    <Relevance>(if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true )</Relevance>
    <Relevance><![CDATA[version of client >= "7.2"]]></Relevance>
    <Relevance>(name of it starts with &quot;Win&quot; AND platform id of it != 3) of operating system</Relevance>
    <Relevance>1 = number of keys whose ((it = &quot;IBM Endpoint Manager for Remote Control - Target&quot;) of value &quot;ProductName&quot; of it) of keys &quot;HKEY_CLASSES_ROOT\Installer\Products&quot; of native registry</Relevance>
    <Category>Support</Category>
    <Source>BigFix</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2015-01-07</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to hide the TRC Target from the &quot;Add/Remove Programs&quot; list.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[parameter "InstallKeyName"="{"HKEY_CLASSES_ROOT\Installer\Products\" & (name of key whose ((it = "IBM Endpoint Manager for Remote Control - Target") of value "ProductName" of it) of keys "HKCR\Installer\Products" of native registry) as string}"

continue if {exists key (parameter "InstallKeyName") of native registry}

regset64 "[{parameter "InstallKeyName"}]" "RemovedProductName"="{value "ProductName" of key (parameter "InstallKeyName") of native registry}"

continue if {exists value "RemovedProductName" of key (parameter "InstallKeyName") of native registry}

regdelete64 "[{parameter "InstallKeyName"}]" "ProductName"]]></ActionScript>
    </DefaultAction>
    <Action ID="Action4347">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> for information on how to make this action a &quot;policy&quot; action.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://support.bigfix.com/cgi-bin/kbdirect.pl?id=113</ActionScript>
    </Action>
  </Fixlet>
</BES>
