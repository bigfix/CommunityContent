<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>BES Client Setting: Remove Arbitrary Client Setting</Title>
    <Description><![CDATA[
Sometimes it is necessary to completely remove a client setting.&nbsp; This task will delete the registry key that corresponds to the client setting you would like to remove.&nbsp; The actions below will prompt you for the client setting name of the setting you'd like to remove.<BR><BR><b>Note:</b> If the client setting you specify does not exist for the client, the action will not have an effect. However, the action results will either be "failed" or "completed" depending on which action you choose to deploy from below.<BR><BR><b>Note:</b> Do <b>not</b> set the "Reapply" behavior when taking this action or you may cause the BES Client to constantly attempt to delete the specified client setting.
]]></Description>
    <Relevance>name of operating system as lowercase starts with &quot;win&quot;</Relevance>
    <Relevance>(if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true )</Relevance>
    <Relevance><![CDATA[version of client >= "5.1"]]></Relevance>
    <Category>BES Client Setting</Category>
    <Source>BigFix</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2026-09-17</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>BES Component Client</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sat, 12 May 2012 00:55:27 +0000</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-first-propagation</Name>
      <Value>Thu, 21 Jul 2005 21:12:39 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action796">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to remove an arbitrary client setting. If the given setting does not exist on the client, the client will report back as &quot;&lt;b&gt;failed&lt;/b&gt;.&quot;</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[action parameter query "ClientSetting" with description "Please enter the name of the client setting you would like to remove:" with default "<Enter Client Setting>"
continue if {exists key ("HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\EnterpriseClient\Settings\Client\" & parameter "ClientSetting" of action) of registry}
delete __appendfile
delete temp.reg
appendfile REGEDIT4
appendfile [-HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\EnterpriseClient\Settings\Client\{parameter "ClientSetting" of action}]
move __appendfile temp.reg
wait regedit -s temp.reg]]></ActionScript>
    </Action>
    <Action ID="Action797">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to remove an arbitrary client setting. If the given setting does not exist on the client, the client will report back as &quot;&lt;b&gt;completed&lt;/b&gt;.&quot;</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[action parameter query "ClientSetting" with description "Please enter the name of the client setting you would like to remove:" with default "<Enter Client Setting>"
delete __appendfile
delete temp.reg
appendfile REGEDIT4
appendfile [-HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\EnterpriseClient\Settings\Client\{parameter "ClientSetting" of action}]
move __appendfile temp.reg
wait regedit -s temp.reg]]></ActionScript>
    </Action>
  </Fixlet>
</BES>
