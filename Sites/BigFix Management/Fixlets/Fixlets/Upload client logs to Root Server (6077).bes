  Imported : 2015-05-18T10:20:07
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Upload client logs to Root Server</Title>
    <Description>This task will Leverage the Upload and Archive Manager to Pull a specific&apos;s client&apos;s logs back to the Root Server </Description>
    <Relevance>true</Relevance>
    <Category>Utilities</Category>
    <Source>Created by Jared Levy, jlevy@us.ibm.com.  This content is custom content and not supported by IBM support. </Source>
    <SourceReleaseDate>2015-05-18</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 18 May 2015 16:36:48 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Enter your action script here

if {exists setting "_BESClient_ArchiveManager_OperatingMode" of client}
	parameter "archivesetting"="{value of setting "_BESClient_ArchiveManager_OperatingMode" of client}"
else
	parameter "archivesetting"="0"

endif



setting "_BESClient_ArchiveManager_OperatingMode"="2" on "{parameter "action issue date" of action}" for client
setting "_BESClient_ArchiveManager_FileSet-{computer name}"="{data folder of client as string & (if (windows of operating system) then "\__Global\Logs\*.log" else "/__Global/Logs/*.log")}" on "{parameter "action issue date" of action}" for client


archive now








setting "_BESClient_ArchiveManager_OperatingMode"="{parameter "archivesetting"}" on "{now}" for client]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
