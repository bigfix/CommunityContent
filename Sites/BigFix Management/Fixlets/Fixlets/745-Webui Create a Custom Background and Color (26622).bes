<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Webui Create a Custom Background and Color</Title>
    <Description><![CDATA[<P class=MsoNormal style="BACKGROUND: #f6f9ff; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto"><SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: "Helvetica",sans-serif; mso-fareast-font-family: "Times New Roman"'>This action prompts you for the default css color you want to use for your WebUI.&nbsp; </SPAN><SPAN style="mso-fareast-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri"><A href="https://www.w3schools.com/cssref/css_colors.asp"><SPAN style="COLOR: #0563c1"><FONT size=3 face=Calibri>https://www.w3schools.com/cssref/css_colors.asp</FONT></SPAN></A></SPAN></P>
<P class=MsoNormal style="BACKGROUND: #f6f9ff; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto"><SPAN style="mso-fareast-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri"></SPAN>&nbsp;</P>
<P class=MsoNormal style="BACKGROUND: #f6f9ff; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto"><SPAN style="mso-fareast-font-family: Calibri; mso-ascii-font-family: Calibri; mso-hansi-font-family: Calibri; mso-bidi-font-family: Calibri"></SPAN><SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: "Helvetica",sans-serif; mso-fareast-font-family: "Times New Roman"'><?xml:namespace prefix = "o" ns = "urn:schemas-microsoft-com:office:office" /><o:p></o:p></SPAN>&nbsp;</P>
<P class=MsoNormal style="BACKGROUND: #f6f9ff; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto"><SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: "Helvetica",sans-serif; mso-fareast-font-family: "Times New Roman"'>Next it creates a directory in C:\Program Files (x86)\BigFix Enterprise\BES WebUI\WebUI\sites\WebUI Common_12049_51_1553129035\login-app\app\client\public\skins\skins that looks for an image called Custom.jpg once you copy your custom.jpg file to C:\Program Files (x86)\BigFix Enterprise\BES WebUI\WebUI\sites\WebUI Common_12049_51_1553129035\login-app\app\client\public\skins\skins you will need to restart the BESWebUI on your WebUI server.<o:p></o:p></SPAN></P>
<P class=MsoNormal style="BACKGROUND: #f6f9ff; MARGIN: 0in 0in 0pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto"><SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: "Helvetica",sans-serif; mso-fareast-font-family: "Times New Roman"'>&nbsp;<o:p></o:p></SPAN></P>
<P class=MsoNormal style="BACKGROUND: #f6f9ff; MARGIN: 0in 0in 8pt; LINE-HEIGHT: normal; mso-margin-top-alt: auto"><SPAN style='FONT-SIZE: 10pt; FONT-FAMILY: "Helvetica",sans-serif; mso-fareast-font-family: "Times New Roman"'>For Best results it looks like you want to use an image size of 1280x975 for best rendering<o:p></o:p></SPAN></P>
<P>&nbsp;</P>]]></Description>
    <Relevance>exist folder &quot;C:\Program Files (x86)\BigFix Enterprise\BES WebUI&quot;</Relevance>
    <Source>Brad Sexton</Source>
    <SourceReleaseDate>2019-03-01</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 15 May 2019 21:16:03 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action parameter query &quot;Color&quot; with description &quot;Please type in the CSS Color Code&quot; With default &quot;#2F4F4F&quot;

if {not exist folder &quot;C:\Program Files (x86)\BigFix Enterprise\BES WebUI\WebUI\sites\WebUI Common_12049_51_1553129035\login-app\app\client\public\skins\skins&quot;}
dos mkdir &quot;C:\Program Files (x86)\BigFix Enterprise\BES WebUI\WebUI\sites\WebUI Common_12049_51_1553129035\login-app\app\client\public\skins\skins&quot;

endif

action uses wow64 redirection false
delete __createfile
Createfile until END_OF_FILE

.container .login-container .login-box {{
    background: {parameter &quot;Color&quot; of action};
}

.container .login-container .login-image-section div img {{
    padding-top: 10%;
    height: 100%;
    width: 115%;
    opacity: 0.5;
    background-image: url(&apos;Custom.jpg&apos;)
}

END_OF_FILE

delete &quot;C:\Program Files (x86)\BigFix Enterprise\BES WebUI\WebUI\sites\WebUI Common_12049_51_1553129035\login-app\app\client\public\skins\skins\custom.css&quot;
move __createfile &quot;C:\Program Files (x86)\BigFix Enterprise\BES WebUI\WebUI\sites\WebUI Common_12049_51_1553129035\login-app\app\client\public\skins\skins\custom.css&quot;

delete __createfile


setting &quot;_WebUIAppEnv_SKIN_DEFAULT_DIR&quot;=&quot;0&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client
setting &quot;_WebUIAppEnv_SKIN_DEFAULT_FILE&quot;=&quot;custom.css&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client

</ActionScript>
    </DefaultAction>
  </Task>
</BES>
