<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - BigFix Server does not have .Net 4.5 - Windows</Title>
    <Description><![CDATA[<P>This is relevant on BigFix Servers which do not have .Net 4.5 installed.</P>
<P>.Net 4.5 is required for both the RES Database Connector and the BigFix.Me Sync Tool. You can use Fixlet 45001 in the Patches for Windows (English) site: "UPDATE: Microsoft .NET Framework 4.5 Available - Windows 7 SP1 / Windows 2008 SP2 / Windows 2008 R2 SP1 / Windows Vista SP2" to resolve this issue.</P>]]></Description>
    <Relevance>exists main gather service</Relevance>
    <Relevance>windows of operating system</Relevance>
    <Relevance>not exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\NET Framework Setup\NDP\v4.0&quot; of registry</Relevance>
    <Category>Prerequisite</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <SourceSeverity>Critical</SourceSeverity>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
  </Fixlet>
</BES>
