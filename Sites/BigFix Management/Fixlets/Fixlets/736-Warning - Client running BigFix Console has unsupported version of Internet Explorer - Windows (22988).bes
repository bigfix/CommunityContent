<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - Client running BigFix Console has unsupported version of Internet Explorer - Windows</Title>
    <Description><![CDATA[This fixlet is relevant if a computer running the BigFix console is running on an unsupported version&nbsp;of internet explorer. ]]></Description>
    <Relevance>exists regapp &quot;BESConsole.exe&quot;</Relevance>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[version of regapp "iexplore.exe" < "10" as version]]></Relevance>
    <Category>Audit</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <SourceSeverity>Critical</SourceSeverity>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
  </Fixlet>
</BES>
