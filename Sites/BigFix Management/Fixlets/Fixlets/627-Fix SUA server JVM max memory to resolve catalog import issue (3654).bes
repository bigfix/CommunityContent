<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Fix SUA server JVM max memory to resolve catalog import issue
  ID       : 3654
  Author   : jgstew
  Domain   : BESC
  Imported : 2013-11-07T10:33:51
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Fix SUA server JVM max memory to resolve catalog import issue</Title>
    <Description><![CDATA[<P>This fixlet is meant to address the issue found here: <A href="http://www-01.ibm.com/support/docview.wss?uid=swg21638307"><FONT color=#000080>http://www-01.ibm.com/support/docview.wss?uid=swg21638307</FONT></A></P>
<P>Latest version found here: <A href="http://bigfix.me/fixlet/details/3653"><FONT color=#000080>http://bigfix.me/fixlet/details/3653</FONT></A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[/* Relevant on machines with SUA server installed */ exists folder (parent folder of folder (parenthesized part of match (regex "^%22?([^%22]+)\\TEMAnalytics.exe%22?") of (value whose (name of it = "ImagePath") of keys "HKLM\SYSTEM\CurrentControlSet\services\TEMA" of registry as string)) as string & "\work\tema\webapp\WEB-INF\domains\sam")]]></Relevance>
    <Relevance>/* Relevant on SUA server that does not have the JAVA max memory set to 1.5gb */ 1536 != ((it as string as integer) of (value &quot;JvmMx&quot; of key &quot;TEMA\Parameters\Java&quot; of key whose(exists key &quot;TEMA&quot; of it) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apache Software Foundation&quot; of registry))</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2013-11-06</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 07 Nov 2013 17:33:27 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
regset &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\Apache Software Foundation\Procrun 2.0\TEMA\Parameters\Java]&quot; &quot;JvmMx&quot;=dword:{1536 as hexadecimal}

// The SUA service will need restarted for this change to take effect, but that is probably better handled seperately during a maintance window.</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
