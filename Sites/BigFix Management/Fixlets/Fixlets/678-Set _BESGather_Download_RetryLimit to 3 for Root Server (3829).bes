<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Set _BESGather_Download_RetryLimit to 3 for Root Server
  ID       : 3829
  Author   : jgstew
  Domain   : BESC
  Imported : 2014-08-20T11:48:45
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Set _BESGather_Download_RetryLimit to 3 for Root Server</Title>
    <Description><![CDATA[<P>This is to prevent the root server from downloading the same file with the wrong SHA1 over and over and over again.</P>
<P>This could have detrimental effects of gathering from IBM if IBM is unreachable for some reason, or other unknown effects.</P>
<P>&nbsp;</P>]]></Description>
    <Relevance>exists main gather service</Relevance>
    <Relevance><![CDATA[version of client >= "5.1"]]></Relevance>
    <Relevance>not exists settings &quot;_BESGather_Download_RetryLimit&quot; whose(3 = (value of it as string as integer)) of client</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2014-08-20</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 20 Aug 2014 18:41:14 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
// Limit the Root Server from retrying downloads to 3 times instead of 432 times.
setting &quot;_BESGather_Download_RetryLimit&quot;=&quot;3&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
