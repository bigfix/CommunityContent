  <Task>
    <Title>Set &quot;_BESClient_ActionManager_HistoryKeepDays&quot; to &quot;1825&quot; - 5 years - Universal</Title>
    <Description><![CDATA[<P>This task will set a client setting</P>
<P>&nbsp;</P>]]></Description>
    <Relevance>not exists settings &quot;_BESClient_ActionManager_HistoryKeepDays&quot; whose(&quot;1825&quot; = value of it) of client</Relevance>
    <Category>Configuration: Client Settings</Category>
    <Source>jgstew</Source>
    <SourceID>https://forum.bigfix.com/users/jgstew</SourceID>
    <SourceReleaseDate>2017-01-31</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 01 Feb 2017 02:03:06 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to set the Client Setting</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">setting &quot;_BESClient_ActionManager_HistoryKeepDays&quot;=&quot;1825&quot; on &quot;{ parameter &quot;action issue date&quot; of action}&quot; for client</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
