<!--
  BigFix Fixlet Export

  Title    : ForceRefresh BESClient if it has been a while - Universal
  ID       : 6033
  Author   : jgstew
  Domain   : BESC
  Imported : 2015-04-23T10:46:09
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>ForceRefresh BESClient if it has been a while - Universal</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance><![CDATA[(now - it > 10*day) of minimum of subscribe times of sites]]></Relevance>
    <Relevance><![CDATA[(now - it > 1*hour) of last command time of client]]></Relevance>
    <Relevance>not exists lines whose(it as lowercase contains &quot;forcerefresh&quot; AND it as lowercase contains &quot;command received.&quot;) of files whose(exists lines of it AND (name of it as lowercase ends with &quot;.log&quot; OR name of it as lowercase ends with &quot;.bkg&quot;) AND name of it starts with ( (it as string) of (it as integer / 100) of current year ) ) of folders &quot;Logs&quot; of folders &quot;__Global&quot; of ( (if (exists properties whose(it as string starts with &quot;data folder of &quot; AND it as string contains &quot;client&quot;)) then (data folder of client) else NULL)|(folder &quot;/var/opt/BESClient/__BESData&quot;)|(folder &quot;/Library/Application Support/BigFix/BES Agent/__BESData&quot;)|(folder &quot;__BESData&quot; of parent folder of client) )</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2015-04-23</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 23 Apr 2015 17:45:19 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
notify client ForceRefresh
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
