<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>DMZ Relay Selection</Title>
    <Description><![CDATA[<P>Evenly distribute endpoints across 4 different DMZ relays.</P>
<P>When used with Automatic selection, these endpoints, when leaving the internal network, will attempt to do automatic selection but nothing will respond... thus triggering the logic which leads to the failover relay setting configure using this task.</P>]]></Description>
    <Relevance>true</Relevance>
    <Category>Configuration</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2013-01-09</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 09 Jan 2013 16:20:59 +0000</Value>
    </MIMEField>
    <Domain>BES </Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//determine which group this computer is in then set the relay parameter
parameter &quot;modVal&quot;=&quot;{computer id mod 4}&quot;
if {parameter &quot;modVal&quot; = &quot;0&quot;}
	parameter &quot;relay&quot;=&quot;dmz1.bigfix.me&quot;
elseif {parameter &quot;modVal&quot; = &quot;1&quot;}
	parameter &quot;relay&quot;=&quot;dmz2.bigfix.me&quot;
elseif {parameter &quot;modVal&quot; = &quot;2&quot;}
	parameter &quot;relay&quot;=&quot;dmz3.bigfix.me&quot;
else
	parameter &quot;relay&quot;=&quot;dmz4.bigfix.me&quot;
endif
//configure the failover relay setting
setting &quot;_BESClient_RelaySelect_FailoverRelay&quot;=&quot;{parameter &quot;relay&quot; as string}&quot; on &quot;{now}&quot; for client
</ActionScript>
    </DefaultAction>
    <Action ID="Action1616">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn more about BigFix client settings.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">https://www.ibm.com/developerworks/mydeveloperworks/wikis/home?lang=en#/wiki/Tivoli%20Endpoint%20Manager/page/Configuration%20Settings</ActionScript>
    </Action>
  </Task>
</BES>
