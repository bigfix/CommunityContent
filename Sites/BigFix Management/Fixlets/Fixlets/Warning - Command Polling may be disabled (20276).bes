<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - Command Polling may be disabled</Title>
    <Description>This fixlet is relevant if command polling is disabled</Description>
    <Relevance>(NOT exists setting &quot;_BESClient_Comm_CommandPollEnable&quot; of client) OR (value of setting &quot;_BESClient_Comm_CommandPollEnable&quot; of client as integer != 1)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-04-24</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sun, 24 Apr 2016 17:06:19 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
  </Fixlet>
</BES>
