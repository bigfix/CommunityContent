<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : BigFix Console_Uninstall
  ID       : 26993
  Author   : raghavendra.s
  Domain   : BESC
  Imported : 2023-01-31T04:28:27
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>BigFix Console_Uninstall</Title>
    <Description><![CDATA[BigFix Console_Uninstall&nbsp; ]]></Description>
    <Relevance>true</Relevance>
    <Relevance>exists file &quot;C:\Program Files (x86)\BigFix Enterprise\BES Console\BESConsole.exe&quot;</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2023-01-30</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 30 Jan 2023 17:06:00 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">if {windows of operating system}
	if {exists location of client}
		delete &quot;{location of console}\udtinstall.log&quot;
	endif
	parameter &quot;ProductID&quot; = &quot;{substring after &quot;/X&quot; of((value &quot;UninstallString&quot; of key whose((value &quot;DisplayName&quot; of it = &quot;BigFix Console&quot;) and name of it starts with &quot;{&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry)as string)}&quot;
	wait msiexec /quiet /uninstall { parameter &quot;ProductID&quot; }

endif</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
