  Imported : 2022-06-10T12:27:11
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Cleanup Relay ActiveDownloads folder</Title>
    <Description><![CDATA[Deletes&nbsp;files that are older than 15 days in the <FONT size=2><FONT size=2>bfmirror\downloads\ActiveDownloads of the relay client.</FONT></FONT> ]]></Description>
    <Relevance>exists relay service</Relevance>
    <Relevance><![CDATA[exists files whose(exists (now - it) whose(it > 15 * day) of maxima of (creation times of it; modification times of it) of it) of folder "C:\Program Files (x86)\BigFix Enterprise\BES Relay\wwwrootbes\bfmirror\downloads\ActiveDownloads"]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2021-08-11</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 10 Jun 2022 19:25:55 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[createfile until EOF
{("del %22" & pathname of it & "%22 /q%0a") of files whose(exists (now - it) whose(it > 15 * day) of maxima of (creation times of it; modification times of it) of it) of folder "C:\Program Files (x86)\BigFix Enterprise\BES Relay\wwwrootbes\bfmirror\downloads\ActiveDownloads"}
EOF

delete delfiles.cmd
copy __createfile delfiles.cmd
waithidden delfiles.cmd]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
