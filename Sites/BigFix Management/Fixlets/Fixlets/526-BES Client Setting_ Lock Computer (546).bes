<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>BES Client Setting: Lock Computer</Title>
    <Description><![CDATA[
<TABLE><TBODY><TR><TD>This task will changed the lock status of the selected computer in your network. This lets you exclude specific computers or groups of computers from the effects of Fixlet actions. This could be useful if you want to insulate certain development computers from any changes or updates. Client computers can be locked forever until explicitly unlocked.<BR></TD></TR></TBODY></TABLE>
]]></Description>
    <Relevance>(if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true )</Relevance>
    <Relevance><![CDATA[version of client >= "5.1"]]></Relevance>
    <Relevance>(lock string of action lock state != &quot;Yes&quot;)</Relevance>
    <Category>BES Client Setting</Category>
    <Source>BigFix</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2026-09-17</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>BES Component Client</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sat, 12 May 2012 00:55:27 +0000</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-first-propagation</Name>
      <Value>Wed, 30 Jun 2004 20:47:37 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to lock listed BES Clients.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action lock indefinite &quot;{parameter &quot;action issue date&quot; of action}&quot;</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
