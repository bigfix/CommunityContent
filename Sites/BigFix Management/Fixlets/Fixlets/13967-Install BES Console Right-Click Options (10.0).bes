<Property Name="Remote Desktop Enabled" EvaluationPeriod="PT0S">(name of operating system as lowercase starts with "win") AND ((name of operating system = "Win2000" AND (value "TSEnabled" of key "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server" of registry = 1)) OR (exists values "fDenyTSConnections" of keys "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server" of registry  AND (value "fDenyTSConnections" of key "HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server" of registry = 0))) </Property>
