<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>AAC - Set Relay Diagnostic Password and Enable Relay Diagnostic</Title>
    <Description><![CDATA[<DIV id=fixletMessage2 class=FixletMessage>
<DIV id=paramFixletDescription>
<P>This&nbsp;Fixlet prompts for a password that will be required to access the Relay diagnostic page of the relays where the action will be distributed.</P>
<P>Relay Password will travel encrypted in the fixlet action and will be obfuscated on the relay settings. </P>
<P>After setting the password the Relay Diagnostic will be enabled and Relay service&nbsp;will be restarted.</P>
<P><BR>&nbsp;</P></DIV><script>
    loaded = false;
    var CODE_SITE_NAME = 'BES Support' ;
    function loadScript (siteName, callback) {
      loaded = false;
      var relevanceQuery ='( value of it) of (mime fields of (bes fixlets whose ( name of it = "Parameterized Fixlet Library" and  name of site of it = \"' + siteName + '\" ))) whose (name of it = "vrt_utils.js")'
      var code = EvaluateRelevance(relevanceQuery);
      var head = document.getElementsByTagName("head")[0];
      var script   = document.createElement("script");
      script.type  = "text/javascript";
      script.text = code;
      head.appendChild(script);
      callback();
    }
    function scriptLoaded(){
      if (!loaded) {
        if ( typeof FixletUtils !== 'undefined') {
           loaded = true;
           var relQuery = "(messages of it) of bes fixlets whose (name of it = \"Parameterized Fixlet Library\" and ((name of it ) of site of it = \"" + CODE_SITE_NAME +"\" ))";
           var messages = EvaluateRelevance(relQuery);
           var regex = /\s*<DIV id=globalizationMessageDiv  style="display:none;">([\x00-\x7F]+)\s*<\/Div>/i;
           var matches = regex.exec(messages);
           matches[1]=matches[1].replace(/<br>/gi,"");
           eval(matches[1]);
           FixletUtils.initFixletRender();
        }
    }
}
    loadScript(CODE_SITE_NAME, scriptLoaded);
  </script>
<DIV class=FixletProperty></DIV><BR>
<P>Written by <A href="mailto:andrea.capasso@hcl.com">andrea.capasso@hcl.com</A> using documentation
for  <A href="https://bigfix-wiki.hcltechsw.com/wikis/home?lang=en-us#!/wiki/BigFix%20Wiki/page/Creating%20parameterized%20fixlets">parametrized fixlets</A>&nbsp;</P> "Creating Parameterized Fixlets V1.0.doc" </DIV>]]></Description>
    <Relevance>exists relay service OR exists main gather service</Relevance>
    <Category>Utility</Category>
    <Source>andrea.capasso@hcl.com</Source>
    <SourceReleaseDate>2017-08-17</SourceReleaseDate>
    <MIMEField>
      <Name>parametermetadatatag</Name>
      <Value> { &quot;RDPW&quot;: { &quot;Name&quot;: &quot;RDPW&quot;, &quot;Title&quot;: &quot;Relay Diagnostics Password:&quot;, &quot;Description&quot;: &quot;Define Relay Diagnostic access Password :&quot;, &quot;Encrypt&quot; : &quot;true&quot;,  &quot;UIType&quot;: &quot;Textbox&quot;, &quot;SubUIType&quot; : &quot;Password&quot;, &quot;Required&quot; : &quot;1&quot; } }             </Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 18 Aug 2017 12:22:56 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
//File with name details
action log commands
setting &quot;_BESRelay_Diagnostics_Password&quot;=&quot;{parameter &quot;RDPW&quot;}&quot; on &quot;{now}&quot; for client
setting &quot;_BESRelay_Diagnostics_Enable&quot; = &quot;1&quot; on &quot;{now}&quot; for client
action log all
if {(windows of operating system)}
  wait net stop besrelay
  wait net start besrelay
elseif {(name of operating system = case insensitive regex &quot;.*linux.*&quot;)}
  wait /etc/init.d/besrelay restart
endif</ActionScript>
    </DefaultAction>
  </Task>
</BES>
