<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Trigger Gather / Command Polling with file - BES Client</Title>
    <Description><![CDATA[&lt;enter a description of the problem and the corrective action here&gt; ]]></Description>
    <Relevance>exists files whose(name of it starts with &quot;_BigFix_Trigger_Gather&quot;) of (folders &quot;/tmp&quot;; folders &quot;/Windows/Temp&quot;)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2018-03-06</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 06 Mar 2018 19:16:52 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
enable gathering

delete &quot;{ pathname of files whose(name of it starts with &quot;_BigFix_Trigger_Gather&quot;) of (folders &quot;/tmp&quot;; folders &quot;/Windows/Temp&quot;) }&quot;
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
