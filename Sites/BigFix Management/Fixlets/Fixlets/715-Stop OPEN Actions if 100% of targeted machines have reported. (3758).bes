		dos {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"} {"post action/" & tuple string item 2 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml")) & "/stop -q"}
