<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Stop OPEN Actions if 100% of targeted machines have reported.
  ID       : 3758
  Author   : menglish
  Domain   : BESC
  Imported : 2014-04-05T06:22:55
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Stop OPEN Actions if 100% of targeted machines have reported.</Title>
    <Description><![CDATA[<P><STRONG><FONT size=3>Action&nbsp;Parameters:</FONT></STRONG></P>
<P>&nbsp;<INPUT onblur="if (this.value == '') {this.value = 'OP Name';}" id=RemoteOP onfocus="if (this.value == 'OP Name') {this.value = '';}" title="Enter the Exporting IEM Server Operator Name" value="OP Name" name=RemoteOP>&nbsp;<FONT color=#0080ff><STRONG>&lt;&lt;&nbsp;</STRONG></FONT> Enter the IEM Server Operator Name<BR>&nbsp;<INPUT id=RemoteOPPass title="Enter the Exporting IEM Server Operator Password" type=password name=RemoteOPPass>&nbsp;&nbsp; <FONT color=#0080ff><STRONG>&lt;&lt;</STRONG></FONT>&nbsp; Enter the&nbsp;IEM Server Operator Password (<FONT color=#ff0000><STRONG>Note:</STRONG></FONT> This password will be <STRONG><EM>encrypted</EM></STRONG>)<BR><script>
			document.body.ontakeaction = function() {
				var theRemoteOP = document.getElementById( "RemoteOP" ).value;
				var theRemoteOPPass = document.getElementById( "RemoteOPPass" ).value;
				TakeSecureFixletAction( Relevance('id of current fixlet'), Relevance('id of current bes site'), "Action1", {}, { RemoteOP: theRemoteOP , RemoteOPPass: theRemoteOPPass } );
				return false;
			}
			</script><BR><STRONG>_____________________________________________________________________________________________________</STRONG> </P>
<P><STRONG>Description:</STRONG></P>
<DIV class=subsection>
<P>Run this action as a policy on the root IEM server as a schedueled policy (reapply action every<EM> n</EM> minutes)</P>
<P>This action will stop any open actions that 100% of the targeted machines have reported on. The open actions that will be stopped are using targeting methods of computer ID or list and the action is NOT a policy.</P></DIV>]]></Description>
    <Relevance>exist main gather service</Relevance>
    <Source>mike.english@us.ibm.com</Source>
    <SourceReleaseDate>2014-02-12</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sat, 05 Apr 2014 12:53:19 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Check for C:\Import
if {not exist folder "c:\import"}
	dos mkdir "c:\import"
endif

delete c:\IMPORT\openactions.xml
delete __appendfile

//login to API and obtain all open actions who targeting method was by list or computer ID
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"} login -q --server=localhost --user={parameter "RemoteOP" of action} --password={parameter "RemoteOPPass" of action}
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"} get query --relevance "(concatenation %%22, %%22 of (ids of bes actions whose ((targeting method of it = %%22By Computer ID%%22 or targeting method of it = %%22By List%%22) and state of it = %%22Open%%22)as string))" > c:\import\openactions.xml

delete api.bat
copy __appendfile api.bat
waithidden api.bat


//verify that an open action exists
if {exists tuple string item 0 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))}
delete c:\IMPORT\result.xml
delete __appendfile

//take the action ID from the array and verify that 100% of targeted machines have reported and that the open action is NOT a policy
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"} login -q --server=localhost --user={parameter "RemoteOP" of action} --password={parameter "RemoteOPPass" of action}
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"}  get query --relevance "((((number of elements of reported computer set of bes action whose (id of it = {tuple string item 0 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))})) / (number of elements of targeted computer set of bes action whose (id of it = {tuple string item 0 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))}))) * 100) = 100) AND (end date of bes action whose (id of it = {tuple string item 0 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))})) as string | %%22policy%%22 != %%22policy%%22" > c:\import\result.xml
delete api.bat
copy __appendfile api.bat
waithidden api.bat

	//stop the action
	if{(preceding text of first "</Answer>" of (following text of first "<Answer type=%22boolean%22>" of lines of file "c:\import\result.xml")as boolean = true)}
		dos {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"} {"post action/" & tuple string item 0 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml")) & "/stop -q"}
	endif
endif

// repeat the process (will stop up to 10 open actions at a time)
//verify that an open action exists
if {exists tuple string item 1 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))}
delete c:\IMPORT\result.xml
delete __appendfile

//take the action ID from the array and verify that 100% of targeted machines have reported and that the open action is NOT a policy
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"} login -q --server=localhost --user={parameter "RemoteOP" of action} --password={parameter "RemoteOPPass" of action}
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"}  get query --relevance "((((number of elements of reported computer set of bes action whose (id of it = {tuple string item 1 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))})) / (number of elements of targeted computer set of bes action whose (id of it = {tuple string item 1 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))}))) * 100) = 100) AND (end date of bes action whose (id of it = {tuple string item 1 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))})) as string | %%22policy%%22 != %%22policy%%22" > c:\import\result.xml
delete api.bat
copy __appendfile api.bat
waithidden api.bat

	//stop the action
	if{(preceding text of first "</Answer>" of (following text of first "<Answer type=%22boolean%22>" of lines of file "c:\import\result.xml")as boolean = true)}
		dos {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"} {"post action/" & tuple string item 1 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml")) & "/stop -q"}
	endif
endif

//verify that an open action exists
if {exists tuple string item 2 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))}
delete c:\IMPORT\result.xml
delete __appendfile

//take the action ID from the array and verify that 100% of targeted machines have reported and that the open action is NOT a policy
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"} login -q --server=localhost --user={parameter "RemoteOP" of action} --password={parameter "RemoteOPPass" of action}
