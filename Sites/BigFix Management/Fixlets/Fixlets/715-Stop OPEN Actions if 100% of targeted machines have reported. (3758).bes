appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\iem.exe%22"}  get query --relevance "((((number of elements of reported computer set of bes action whose (id of it = {tuple string item 4 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))})) / (number of elements of targeted computer set of bes action whose (id of it = {tuple string item 4 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))}))) * 100) = 100) AND (end date of bes action whose (id of it = {tuple string item 4 of (preceding text of first "</Answer>" of (following text of first "<Answer type=%22string%22>" of lines of file "c:\import\openactions.xml"))})) as string | %%22policy%%22 != %%22policy%%22" > c:\import\result.xml
delete api.bat
copy __appendfile api.bat
