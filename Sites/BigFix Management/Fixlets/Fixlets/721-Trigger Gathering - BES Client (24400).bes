<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Trigger Gathering - BES Client</Title>
    <Description>This will help new things happen quicker in BigFix, but it shouldn&apos;t be done too often. This is especially useful for clients that are mobile and not on a primary network.</Description>
    <Relevance>true</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2016-12-10</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 13 Dec 2016 23:18:06 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
enable gathering
</ActionScript>
    </DefaultAction>
  </Task>
</BES>
