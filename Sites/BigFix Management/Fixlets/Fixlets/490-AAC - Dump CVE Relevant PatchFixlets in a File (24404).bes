<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : AAC - Dump CVE Relevant PatchFixlets in a File
  ID       : 24404
  Author   : kapax
  Domain   : BESC
  Imported : 2017-05-29T08:47:37
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>AAC - Dump CVE Relevant PatchFixlets in a File</Title>
    <Description><![CDATA[<P>Create a file that lists all the system relevant fixlets of subscribed sites named ".....Patch ........"&nbsp; or "......Applications.."</P>
<P>This will catch the titles of fixlets that may be applied on a systems to fix listed CVEs (Common Vulnerability Exposures)&nbsp; in the files and will be possibly used by the corresponding Analisys to return individual systems CVE lists.</P>
<P>&nbsp;</P>]]></Description>
    <Relevance><![CDATA[not exists it whose (modification time of it + 30 * minute> now)  of files "RelevantFixlets.lst" of parent folder of data folder of client]]></Relevance>
    <Category>Security check</Category>
    <Source>Andrea_Capasso@it.ibm.com</Source>
    <SourceReleaseDate>2017-05-29</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 29 May 2017 15:47:16 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action for fixlets&amp;nbsp;where a CVE Id exists from all subscribed sites that have name containing &quot;Patches&quot; or &quot;Applications&quot;</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Enter your action script here
action log command

parameter "MyFilename" = "{pathname of parent folder of data folder of client as string & "/" & "RelevantFixlets.lst"}"
delete "{parameter "MyFilename"}"
delete __appendfile
appendfile  {concatenation "%0d%0a" of (concatenation "," of ((values of it) of ( headers "X-Fixlet-CVE" of it) of it) & " | " & name of site of it & " | " & id of it as string & " | " & value of header "Subject" of it) of it of fixlets whose (relevance of it and (( exist headers "X-Fixlet-CVE" whose (value of it contains "CVE-")of it))) of sites whose (name of it as lowercase contains "patch" or name of it as lowercase contains "applications" )}
move __appendfile "{parameter "MyFilename"}"

action log all
]]></ActionScript>
    </DefaultAction>
    <Action ID="Action25473">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Enter your action script here
action log command
if {name of operating system as lowercase contains "win"}
delete "C:\RelevantFixlets.lst"
else
delete "/tmp/RelevantFixlets.lst"
endif

action log all
parameter "MyFilename" = "{pathname of parent folder of data folder of client as string & "/" & "RelevantFixlets.lst"}"
delete "{parameter "MyFilename"}"
delete __appendfile
appendfile  {concatenation "%0d%0a" of (concatenation "," of ((values of it) of ( headers "X-Fixlet-CVE" of it) of it) & " | " & name of site of it & " | " & id of it as string & " | " & value of header "Subject" of it) of it of fixlets whose (relevance of it) of sites whose (name of it as lowercase contains "patch")}
move __appendfile "{parameter "MyFilename"}"
]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </Action>
  </Fixlet>
</BES>
