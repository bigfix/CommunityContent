<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>PropertyIDMapper Service v3.0.3.170 Available</Title>
    <Description><![CDATA[This task will deploy: PropertyIDMapper.<BR><BR>This task is applicable on: Windows 2000, Windows XP, Windows XP x64, Windows 2003, Windows 2003 x64, Windows Vista, Windows Vista x64, Windows 2008, Windows 2008 x64, Windows 7, Windows 7 x64, Windows 2008 R2 and Windows XP Embedded. ]]></Description>
    <Relevance>(name of it = &quot;Win2000&quot; OR name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;Win2003&quot; AND NOT x64 of it) OR (name of it = &quot;Win2003&quot; AND x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR ((name of it = &quot;Win2008&quot; or (name of it = &quot;WinVista&quot; and product type of it != nt workstation product type)) AND NOT x64 of it) OR ((name of it = &quot;Win2008&quot; or (name of it = &quot;WinVista&quot; and product type of it != nt workstation product type)) AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it) OR name of it = &quot;Win2008R2&quot; OR name of it = &quot;WinXPe&quot;) of operating system</Relevance>
    <Relevance>exists main gather service AND exists service &quot;FillDB&quot;</Relevance>
    <Relevance><![CDATA[if exists service "FillDB" then if exists folder (concatenation of (pathname of parent folder of parent folder of file (substring between "%22" of image path of service "FillDB" as string); "\BES Utilities\PropertyIDMapper")) AND (exists service "BESPropertyIDMapper")then (version of file "BESPropertyIDMapper.exe" of folder (concatenation of (pathname of parent folder of parent folder of file (substring between "%22" of image path of service "FillDB" as string); "\BES Utilities\PropertyIDMapper")) < "3.0.3.170" as version) else true else false]]></Relevance>
    <Category>Update</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2011-03-25</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 01 Oct 2012 21:30:49 +0000</Value>
    </MIMEField>
    <Domain>BES </Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here </Link>
        <PostLink>to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[parameter "path"="{(pathname of parent folder of parent folder of file (substring between "%22" of image path of service "FillDB" as string))}/BES Utilities/PropertyIDMapper"
folder create "{(pathname of parent folder of parent folder of file (substring between "%22" of image path of service "FillDB" as string))}/BES Utilities"
folder create "{parameter "path"}"

//stop the service... if it exists
if {exists service "BESPropertyIDMapper"}
	waithidden cmd /c net stop BESPropertyIDMapper
endif


//download
download http://software.bigfix.com/download/bes/util/BESPropertyIDMapper.exe
continue if {(size of it = 1941591 AND sha1 of it = "9fd372acea70792362a50178dd9a5378195db70e") of file "BESPropertyIDMapper.exe" of folder "__Download"}

//put into proper location
move __Download\BESPropertyIDMapper.exe "{parameter "path"}\BESPropertyIDMapper.exe"


//register this new service... if it doesn't already exist
if {not exists service "BESPropertyIDMapper"}
	waithidden cmd.exe /c sc create BESPropertyIDMapper binpath= "{parameter "path"}\BESPropertyIDMapper.exe"
endif


//start the service
continue if {exists service whose (service name of it as lowercase = ("BESPropertyIDMapper" as lowercase) OR (display name of it as lowercase = ("BESPropertyIDMapper" as lowercase)))}

delete __appendfile
delete netquiet.bat

appendfile @ECHO OFF
appendfile start "" /min /b net %1 %2 /y > NUL 2> NUL
move __appendfile netquiet.bat

waithidden "{pathname of client folder of site "BESSupport" & "\RunQuiet.exe"}" netquiet.bat start "BESPropertyIDMapper"

delete netquiet.bat]]></ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action3903">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn more about the PropertyIDMapper tool.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri"><![CDATA[http://forum.bigfix.com/viewtopic.php?id=1221&p=2]]></ActionScript>
    </Action>
  </Fixlet>
</BES>
