<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : BIGMIME
  ID       : 6255
  Author   : menglish
  Domain   : BES
  Imported : 2015-10-20T07:38:07
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>BIGMIME</Title>
    <Description><![CDATA[<P><STRONG><FONT size=3>Action&nbsp;Parameters:</FONT></STRONG></P>
<P>&nbsp;<INPUT onblur="if (this.value == '') {this.value = 'OP Name';}" id=RemoteOP onfocus="if (this.value == 'OP Name') {this.value = '';}" title="Enter the Exporting IEM Server Operator Name" value="OP Name" name=RemoteOP>&nbsp;<FONT color=#0080ff><STRONG>&lt;&lt;&nbsp;</STRONG></FONT> Enter the&nbsp;IEM Server Operator Name<BR>&nbsp;<INPUT id=RemoteOPPass title="Enter the Exporting IEM Server Operator Password" type=password name=RemoteOPPass>&nbsp;&nbsp; <FONT color=#0080ff><STRONG>&lt;&lt;</STRONG></FONT>&nbsp; Enter the&nbsp;IEM Server Operator Password&nbsp;<BR><script>
			document.body.ontakeaction = function() {
				var theRemoteOP = document.getElementById( "RemoteOP" ).value;
				var theRemoteOPPass = document.getElementById( "RemoteOPPass" ).value;
				TakeSecureFixletAction( Relevance('id of current fixlet'), Relevance('id of current bes site'), "Action1", {}, { RemoteOP: theRemoteOP , RemoteOPPass: theRemoteOPPass } );
				return false;
			}
			</script></P>
<P>This task will inject a custom MIME field into the specified fixlet without altering the fixlet ID and which can then be queried by relevance such as: <FONT size=2></P>
<P>(name </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>of</FONT></FONT><FONT size=2> </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>it,</FONT></FONT><FONT size=2> values </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>of</FONT></FONT><FONT size=2> </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>it</FONT></FONT><FONT size=2>) </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>of</FONT></FONT><FONT size=2> headers </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>whose</FONT></FONT><FONT size=2> (name </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>of</FONT></FONT><FONT size=2> </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>it</FONT></FONT><FONT size=2> </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>=</FONT></FONT><FONT size=2> </FONT><FONT color=#008080 size=2><FONT color=#008080 size=2>"x-fixlet-<EM><STRONG>&lt;CUSTOM NAME&gt;</STRONG></EM>"</FONT></FONT><FONT size=2>) </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>of</FONT></FONT><FONT size=2> relevant fixlets </FONT><FONT color=#0000ff size=2><FONT color=#0000ff size=2>of</FONT></FONT><FONT size=2> sites</P></FONT>
<P>Deploy it against the Bigfix Root Server.</P>
<P><STRONG><FONT color=#ff0000>NOTE:</FONT></STRONG> This will only work on fixlets in CUSTOM sites.</P>]]></Description>
    <Relevance>exists main gather service</Relevance>
    <Relevance><![CDATA[version of client >= "9.0"]]></Relevance>
    <Relevance>(name of operating system starts with &quot;Win&quot;)</Relevance>
    <Category>IEM Maintenance</Category>
    <Source>mike.english@us.ibm.com</Source>
    <SourceReleaseDate>2015-10-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 20 Oct 2015 14:35:45 +0000</Value>
    </MIMEField>
    <Domain>BES </Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[download as RunAsCurrentUser.exe http://software.bigfix.com/download/bes/util/RunAsCurrentUser-2.0.3.1.exe
action parameter query "fixletid" with description "Please enter the fixlet id:" with default value "6674"
action parameter query "sitename" with description "Please enter the site name where the fixlet resides (Use Quotations):" with default value "Enterprise Security"
action parameter query "mimename" with description "Please enter the name of the MIME field:" with default value "MIME Name"
action parameter query "mimevalue" with description "Please enter the value of the MIME field:" with default value "MIME Value"

//PreReqs
//Check for C:\export
if {not exist folder "C:\export"}
	dos mkdir "C:\export"
endif


delete __appendfile
delete "c:\export\{parameter "fixletid" of action}.bes"
delete "c:\export\{parameter "fixletid" of action}.xml"

//fetch fixlet
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\IEM CLI\iem.exe%22"} login -q --server=localhost --user={parameter "RemoteOP" of action} --password={parameter "RemoteOPPass" of action}
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\IEM CLI\iem.exe%22"} get fixlet/custom/{parameter "sitename" of action}/{parameter "fixletid" of action} >> c:\export\{parameter "fixletid" of action}.bes
appendfile DEL "%~f0"
delete fetchfixlet.bat
copy __appendfile fetchfixlet.bat
wait __Download\RunAsCurrentUser.exe --w --q cmd.exe /C fetchfixlet.bat

//update fixlet with new mime value
delete __appendfile
appendfile {(concatenation "" of (substrings separated by "::" of (concatenation ("::</MIMEField>%09%09<MIMEField>::%09%09%09<Name>x-fixlet-" & (parameter "mimename" of action) & "</Name>::%09%09%09<Value>" & (parameter "mimevalue" of action) & "</Value>::%09%09</MIMEField>") of (substrings separated by "</MIMEField>" of (concatenation "::" of (lines of file ("c:\export\" & (parameter "fixletid" of action) & ".bes")))))))}
copy __appendfile "c:\export\{parameter "fixletid" of action}.xml"

//replace fixlet
delete __appendfile
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\IEM CLI\iem.exe%22"} login -q --server=localhost --user={parameter "RemoteOP" of action} --password={parameter "RemoteOPPass" of action}
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\IEM CLI\iem.exe%22"} put "c:\export\{parameter "fixletid" of action}.xml" "/fixlet/custom/{parameter "sitename" of action}/{parameter "fixletid" of action}"
appendfile DEL "%~f0"
delete mimeinject.bat
copy __appendfile mimeinject.bat
wait __Download\RunAsCurrentUser.exe --w --q cmd.exe /C mimeinject.bat

//Cleanup
delete "c:\export\{parameter "fixletid" of action}.bes"
delete "c:\export\{parameter "fixletid" of action}.xml"]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
