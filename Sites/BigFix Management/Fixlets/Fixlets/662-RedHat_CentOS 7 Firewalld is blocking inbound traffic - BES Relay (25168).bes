<!--
  BigFix Fixlet Export

  Title    : RedHat/CentOS 7 Firewalld is blocking inbound traffic - BES Relay
  ID       : 25168
  Author   : rexit1982
  Domain   : BES
  Imported : 2018-02-19T07:35:57
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>RedHat/CentOS 7 Firewalld is blocking inbound traffic - BES Relay</Title>
    <Description><![CDATA[<TABLE>
<TBODY>
<TR>
<TD>
<P>The listed computers are BES Relays, have firewalld enabled and are not configured to allow inbound TCP/UDP traffic on the port used by BESRelay (BES uses port 52311 by default). </P>
<P>The&nbsp;BES Relays must recieve inbound tcp and udp&nbsp;connections from clients.</P>
<P><FONT size=2><STRONG>Note:</STRONG> The&nbsp;firewalld configuration is modified by inserting a new service into /etc/firewalld/services&nbsp;and enabling it on the&nbsp;default zone.</FONT></P></TD></TR></TBODY></TABLE>]]></Description>
    <Relevance>(if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true )</Relevance>
    <Relevance>exists relay service</Relevance>
    <Relevance><![CDATA[(if (version of client >= "8.0") then (unix of it) else ((it does not start with "Win" AND it does not start with "Mac OS X") of name of it)) of operating system]]></Relevance>
    <Relevance>exists match (regex &quot;Linux (Red Hat Enterprise (AS|ES|WS|Client|Server|Workstation)|CentOS) (7)&quot;) of name of operating system</Relevance>
    <Relevance>exists file &quot;/etc/systemd/system/basic.target.wants/firewalld.service&quot;</Relevance>
    <Relevance><![CDATA[NOT exists file "/etc/firewalld/zones/public.xml" whose ( exists ( lines of it ) whose ( it does not start with "#" AND it contains "<service name=%22bigfix-relay%22/>" ) ) AND exists file "/etc/firewalld/zones/public.xml"]]></Relevance>
    <Category>Support</Category>
    <Source>Internal</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2018-02-19</SourceReleaseDate>
    <SourceSeverity>Important</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>BES Warn Important</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-first-propagation</Name>
      <Value>Wed, 17 Jun 2009 18:18:35 +0000</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 19 Feb 2018 15:34:44 +0000</Value>
    </MIMEField>
    <Domain>BES </Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to leave firewalld enabled, but create a service and enable it on the&amp;nbsp;default zone to allow incoming traffic on the port reserved for BESRelay.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Modify the iptables saved ruleset
delete __appendfile

appendfile #!/bin/bash
appendfile echo -e '<?xml version="1.0" encoding="utf-8"?>\n<service>\n  <short>bigfix-relay</short>\n  <description>The BES Server and BES Relays send UDP packets to the BES Clients to notify them that there is new information available such as new Fixlet messages, actions, and computer refreshes.  This service permits that traffic on the port designated by the server.</description>\n  <port protocol="tcp" port="{port number of selected server as string}"/>\n<port protocol="udp" port="{port number of selected server as string}"/>\n</service>' > /etc/firewalld/services/bigfix-relay.xml
appendfile firewall-cmd --reload
appendfile firewall-cmd --permanent --zone=public --add-service=bigfix-relay
appendfile firewall-cmd --reload

wait chmod +x "{(client folder of current site as string) & "/__appendfile"}"

wait "{(client folder of current site as string) & "/__appendfile"}"

//delete delete __appendfile]]></ActionScript>
    </DefaultAction>
    <Action ID="Action26436">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to disable firewalld.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Disable iptables
delete __appendfile

appendfile #!/bin/bash
appendfile systemctl disable firewalld.service
appendfile systemctl stop firewalld.service

wait chmod +x "{(client folder of current site as string) & "/__appendfile"}"

wait "{(client folder of current site as string) & "/__appendfile"}"

//delete delete __appendfile]]></ActionScript>
    </Action>
    <Action ID="Action26437">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> for information on how to make this action a &quot;policy&quot; action that will automatically open the BES port on any computer that has this Fixlet message relevant. </PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://support.bigfix.com/cgi-bin/kbdirect.pl?id=113</ActionScript>
    </Action>
  </Fixlet>
</BES>
