<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - Client Setting - Log Retention - 14 Days</Title>
    <Description><![CDATA[<P>This fixlet will change the log retention of the client to 14 days</P>
<P>For general information or to report issues with C3 Platform Kickstart content please visit GitHub here: <A href="https://github.com/strawgate/C3-Platform-Kickstart">https://github.com/strawgate/C3-Platform-Kickstart</A></P>]]></Description>
    <Relevance>not exists (settings &quot;_BESClient_Log_Days&quot; of client) whose (value of it as integer = 14)</Relevance>
    <Category>Configuration</Category>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2015-01-12</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">setting &quot;_BESClient_Log_Days&quot;=&quot;14&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
