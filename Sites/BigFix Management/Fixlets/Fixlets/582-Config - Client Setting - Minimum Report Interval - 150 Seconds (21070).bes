<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - Client Setting - Minimum Report Interval - 150 Seconds</Title>
    <Description><![CDATA[<P>This fixlet will change the Minimum Report Interval of the client to 150 seconds</P>
<P>For general information or to report issues with C3 Platform Kickstart content please visit GitHub here: <A href="https://github.com/strawgate/C3-Platform-Kickstart">https://github.com/strawgate/C3-Platform-Kickstart</A></P>]]></Description>
    <Relevance>not exists (settings &quot;_BESClient_Report_MinimumInterval&quot; of client) whose (value of it as integer = 150)</Relevance>
    <Category>Configuration</Category>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2015-01-12</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">setting &quot;_BESClient_Report_MinimumInterval&quot;=&quot;150&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
