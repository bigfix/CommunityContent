<!--
  BigFix Fixlet Export

  Title    : Warning - BES Server Plugin Service REST API Credentials are not Configured Correctly - Universal
  ID       : 22983
  Author   : RES
  Domain   : BESC
  Imported : 2016-12-07T02:01:59
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - BES Server Plugin Service REST API Credentials are not Configured Correctly - Universal</Title>
    <Description><![CDATA[<TABLE>
<TBODY>
<TR>
<TD>
<P>The BES Server Plugin Service requires a master operator's user name and password. </P>
<P>To configure the BES Server Plug-in Service, use <?relevance ul of concatenation of lis of (if (version of datastore inspectors >= "9.0") then (links of fixlets (1294) of bes site whose (id of it = 1)) else (links of wizards whose (dashboard id of it = "MFSConfiguration.ojo") of bes site whose (id of it = 1))) ?>.</P></TD></TR></TBODY></TABLE>]]></Description>
    <Relevance>exists relay service OR exists main gather service</Relevance>
    <Relevance>exists main gather service</Relevance>
    <Relevance>exists service &quot;BESPluginService&quot;</Relevance>
    <Relevance>not exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\Enterprise Server\MFSConfig&quot; whose ((exists value &quot;RESTUsername&quot; whose (it != &quot;&quot;) of it) AND (exists value &quot;RESTPassword&quot; whose (it != &quot;&quot;) of it)) of registry</Relevance>
    <Category>Prerequisite</Category>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <SourceSeverity>Critical</SourceSeverity>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
  </Fixlet>
</BES>
