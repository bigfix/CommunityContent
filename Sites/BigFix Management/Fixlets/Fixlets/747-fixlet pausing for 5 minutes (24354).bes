<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>fixlet pausing for 5 minutes</Title>
    <Description>fixlet that pauses for 5 minutes </Description>
    <Relevance>windows of operating system</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2014-04-11</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 18 May 2017 19:41:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Enter your action script here
parameter "adesso"="{now as string}"
dos time /T > C:\pio.txt
pause while {(now - ((parameter "adesso") as time)) < 5 * minute }
dos time /T >> C:\pio.txt]]></ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
