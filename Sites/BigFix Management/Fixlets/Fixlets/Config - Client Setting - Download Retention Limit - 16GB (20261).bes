<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - Client Setting - Download Retention Limit - 16GB</Title>
    <Description><![CDATA[<P>This fixlet will change the client download retention limit</P>]]></Description>
    <Relevance>not exists (setting &quot;_BESClient_Download_DownloadsCacheLimitMB&quot; of client) whose (value of it as integer = 16000)</Relevance>
    <Category>Configuration</Category>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2015-01-12</SourceReleaseDate>
    <MIMEField>
      <Name>bigfixme-added-time</Name>
      <Value>Mon, 12 Jan 2015 09:59:25 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-modification-time</Name>
      <Value>Mon, 12 Jan 2015 09:59:25 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-keywords</Name>
      <Value></Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sun, 24 Apr 2016 00:44:14 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">setting &quot;_BESClient_Download_DownloadsCacheLimitMB&quot;=&quot;16000&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
