<!--
  BigFix Fixlet Export

  Title    : Configure Automatic Relay Selection
  ID       : 84
  Author   : danielheth
  Domain   : BES
  Imported : 2012-10-17T09:31:55
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Configure Automatic Relay Selection</Title>
    <Description>Detects if an endpoint is not configured for automatic relay selection and configures it. </Description>
    <Relevance>NOT (exists setting &quot;__RelaySelect_Automatic&quot; of client and value of setting &quot;__RelaySelect_Automatic&quot; of client is &quot;1&quot;)</Relevance>
    <Relevance>NOT exists relay service</Relevance>
    <Relevance>NOT exists main gather service</Relevance>
    <Category>Configuration</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2011-07-05</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 01 Oct 2012 21:30:49 +0000</Value>
    </MIMEField>
    <Domain>BES </Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">setting &quot;__RelaySelect_Automatic&quot;=&quot;1&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
