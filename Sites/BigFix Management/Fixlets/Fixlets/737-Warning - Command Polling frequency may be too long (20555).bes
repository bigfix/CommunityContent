<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - Command Polling frequency may be too long</Title>
    <Description><![CDATA[This fixlet is relevant if the command polling frequency is greater than 2 hours
<P>For general information or to report issues with C3 Platform Kickstart content please visit GitHub here: <A href="https://github.com/strawgate/C3-Platform-Kickstart">https://github.com/strawgate/C3-Platform-Kickstart</A></P>]]></Description>
    <Relevance><![CDATA[(NOT exists setting "_BESClient_Comm_CommandPollIntervalSeconds" of client) OR (value of setting "_BESClient_Comm_CommandPollIntervalSeconds" of client as integer > 7200)]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-04-24</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
  </Fixlet>
</BES>
