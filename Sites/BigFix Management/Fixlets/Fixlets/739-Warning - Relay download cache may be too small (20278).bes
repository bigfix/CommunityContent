<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - Relay download cache may be too small</Title>
    <Description>This fixlet is relevant if the relay download cache is set to a value smaller than 20 GB (Default is 1 GB) </Description>
    <Relevance>exists relay service</Relevance>
    <Relevance><![CDATA[(not exists setting "_BESGather_Download_CacheLimitMB" of client) or ((exists setting "_BESGather_Download_CacheLimitMB" of client) and (value of setting "_BESGather_Download_CacheLimitMB" of client as integer < 20480))]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-04-24</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sun, 24 Apr 2016 17:43:15 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
  </Fixlet>
</BES>
