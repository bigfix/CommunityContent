  <Fixlet>
    <Title>Config - Client Setting - Secondary Relay - relay.domain.tld</Title>
    <Description><![CDATA[Sets the secondary relay on the client
<P>For general information or to report issues with C3 Platform Kickstart content please visit GitHub here: <A href="https://github.com/strawgate/C3-Platform-Kickstart">https://github.com/strawgate/C3-Platform-Kickstart</A></P>]]></Description>
    <Relevance>not exists (setting &quot;__RelayServer2&quot; of client) whose (value of it = &quot;http://relay.domain.tld:52311/bfmirror/downloads/&quot;)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-03-30</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Enter your action script here

setting &quot;__RelayServer2&quot;=&quot;http://relay.domain.tld:52311/bfmirror/downloads/&quot; on &quot;{now}&quot; for client</ActionScript>
    </DefaultAction>
  </Fixlet>
