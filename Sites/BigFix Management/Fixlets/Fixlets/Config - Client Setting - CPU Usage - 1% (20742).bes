<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - Client Setting - CPU Usage - 1%</Title>
    <Description><![CDATA[<P>This fixlet will set the client workidle to 5/500 setting the CPU usage to about 1% of one CPU core</P>
<P>For general information or to report issues with C3 Platform Kickstart content please visit GitHub here: <A href="https://github.com/strawgate/C3-Platform-Kickstart">https://github.com/strawgate/C3-Platform-Kickstart</A></P>]]></Description>
    <Relevance>(value of setting &quot;_BESClient_Resource_WorkIdle&quot; of client != &quot;5&quot;) | true or (value of setting &quot;_BESClient_Resource_SleepIdle&quot; of client != &quot;495&quot;) | true</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-30</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:18:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Enter your action script here

setting &quot;_BESClient_Resource_WorkIdle&quot;=&quot;5&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client

setting &quot;_BESClient_Resource_SleepIdle&quot;=&quot;495&quot; on &quot;{parameter &quot;action issue date&quot; of action}&quot; for client</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
