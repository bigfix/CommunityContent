<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Local Admin/User Audit - Windows</Title>
    <Description><![CDATA[<P>This analysis will audit the number of local admins on the system. </P>
<P>From here: <A href="http://bigfix.me/cdb/analysis/49"><FONT color=#000080>http://bigfix.me/cdb/analysis/49</FONT></A></P>]]></Description>
    <Relevance>(windows of operating system)</Relevance>
    <Relevance>(exists local group &quot;Administrators&quot;)</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 10 Jul 2013 17:52:56 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Number of Local Admins" EvaluationPeriod="P2D">(number of members whose (it as string contains computer name) of local group &quot;Administrators&quot; as string)</Property>
    <Property ID="2" Name="Local Admins" EvaluationPeriod="P2D">(concatenation &quot;, &quot; of (members whose (it as string contains computer name) of local group &quot;Administrators&quot; as string))</Property>
    <Property ID="3" Name="Local Users" EvaluationPeriod="P1D">(concatenation &quot;, &quot; of (members whose (it as string contains computer name) of local group &quot;Users&quot; as string))</Property>
  </Analysis>
</BES>
