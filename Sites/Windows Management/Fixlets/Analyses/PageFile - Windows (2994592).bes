    <Domain>BESC</Domain>
    <Property ID="1" Name="Initial Page file Size" EvaluationPeriod="P1D">string values of selects &quot;InitialSize from Win32_PageFileSetting&quot; of wmi</Property>
    <Property ID="2" Name="Maximum Page file Size" EvaluationPeriod="P1D">string values of selects &quot;MaximumSize from Win32_PageFileSetting&quot; of wmi</Property>
    <Property ID="3" Name="Pagefile Name" EvaluationPeriod="P1D">string values of selects &quot;Name from Win32_PageFileSetting&quot; of wmi</Property>
    <Property ID="4" Name="Size of pagefile" EvaluationPeriod="PT6H">sum of sizes of files (string values of selects &quot;Name from Win32_PageFileSetting&quot; of wmi)</Property>
