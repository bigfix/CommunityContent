    <Relevance><![CDATA[windows of operating system and version of operating system >= "6.1"]]></Relevance>
    <Relevance>(product info string of operating system = &quot;Enterprise&quot; or product info string of operating system = &quot;Server&quot;)</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Applocker - Enabled - Windows" EvaluationPeriod="P1D">exists key &quot;HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\SrpV2&quot; of native registry</Property>
