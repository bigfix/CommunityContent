<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>EMET - Configuration - Windows</Title>
    <Description><![CDATA[<P>This analysis covers various details of the currently deployed EMET configuration.</P>
<P>Information on using this content is available here: <A href="https://github.com/strawgate/C3-Protect/wiki/EMET">https://github.com/strawgate/C3-Protect/wiki/EMET</A></P>
<P>For general information or to report issues with C3 Protect content please visit GitHub here: <A href="https://github.com/strawgate/C3-Protect">https://github.com/strawgate/C3-Protect</A>&nbsp;</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\EMET\AppSettings&quot; of native registry</Relevance>
    <Relevance>exists service &quot;EMET_SERVICE&quot;</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="EMET - Mitigated Applications - Windows" EvaluationPeriod="PT6H">(name of it, it) of values of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\EMET\AppSettings&quot; of native registry</Property>
    <Property ID="2" Name="EMET - Service State - Windows" EvaluationPeriod="P1D">state of service &quot;EMET_Service&quot;</Property>
    <Property ID="3" Name="EMET - Version - Windows" EvaluationPeriod="P1D">version of service &quot;EMET_Service&quot;</Property>
    <Property ID="4" Name="EMET - Sites with Certificate Pinning - Windows" EvaluationPeriod="P1D">(name of it, it) of values of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\EMET\CertPinning\Sites&quot; of native registry</Property>
    <Property ID="5" Name="EMET - Anti-Detours Mitigation - Windows" EvaluationPeriod="P1D">(if (value &quot;AntiDetours&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\EMET&quot; of native registry = 1) then &quot;Enabled&quot; else &quot;Disabled&quot;) | &quot;Disabled&quot;</Property>
    <Property ID="6" Name="EMET - Banned Functions Mitigation - Windows" EvaluationPeriod="P1D">(if (value &quot;BannedFunctions&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\EMET&quot; of native registry = 1) then &quot;Enabled&quot; else &quot;Disabled&quot;) | &quot;Disabled&quot;</Property>
    <Property ID="7" Name="EMET - Deep Hooks Mitigation - Windows" EvaluationPeriod="P1D">(if (value &quot;DeepHooks&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\EMET&quot; of native registry = 1) then &quot;Enabled&quot; else &quot;Disabled&quot;) | &quot;Disabled&quot;</Property>
    <Property ID="8" Name="EMET - Unsafe Settings Available - Windows" EvaluationPeriod="P1D">(if (value &quot;EnableUnsafeSettings&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\EMET&quot; of native registry = 1) then &quot;Enabled&quot; else &quot;Disabled&quot;) | &quot;Disabled&quot;</Property>
    <Property ID="9" Name="EMET - Exploit Action - Windows" EvaluationPeriod="P1D">(if (value &quot;ExploitAction&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\EMET&quot; of native registry = 1) then &quot;Kill Process&quot; else &quot;Audit&quot;) | &quot;audit&quot;</Property>
  </Analysis>
</BES>
