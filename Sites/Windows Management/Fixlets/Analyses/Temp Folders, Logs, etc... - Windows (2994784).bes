<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Temp Folders, Logs, etc... - Windows</Title>
    <Description><![CDATA[<P>&nbsp;</P>
<P>The latest version of this Analysis can be found here: &nbsp;<A href="http://bigfix.me/analysis/details/2994620"><FONT color=#000080>http://bigfix.me/analysis/details/2994620</FONT></A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 01 Jul 2014 16:05:36 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Temp Folders" EvaluationPeriod="PT6H">(folders &quot;Temp&quot; of windows folder;folders &quot;C:\temp&quot;; folders &quot;C:\ProgramData\TEMP&quot;; folders &quot;AppData\Local\Temp&quot; of folders whose(exists folder &quot;AppData\Local\Temp&quot; of it) of folders &quot;C:\Users&quot;; folders &quot;C:\Program Files (x86)\BigFix Enterprise\BES Client&quot;; folders &quot;C:\Program Files\BigFix Enterprise\BES Client&quot;)</Property>
    <Property ID="2" Name="Log Files" EvaluationPeriod="P2D">pathnames of descendants whose(name of it as lowercase ends with &quot;.log&quot;) of (folders &quot;Temp&quot; of windows folder;folders &quot;C:\temp&quot;; folders &quot;C:\ProgramData\TEMP&quot;; folders &quot;AppData\Local\Temp&quot; of folders whose(exists folder &quot;AppData\Local\Temp&quot; of it) of folders &quot;C:\Users&quot;; folders &quot;C:\Program Files (x86)\BigFix Enterprise\BES Client&quot;; folders &quot;C:\Program Files\BigFix Enterprise\BES Client&quot;; folders &quot;C:\Windows\Logs&quot;)</Property>
    <Property ID="3" Name="MS Office Logs" EvaluationPeriod="PT12H">pathnames of descendants whose(name of it as lowercase ends with &quot;.txt&quot; AND name of it as lowercase starts with &quot;microsoft office setup&quot;) of (folders &quot;Temp&quot; of windows folder ; folders &quot;C:\temp&quot; ; folders &quot;C:\ProgramData\TEMP&quot; ; folders &quot;AppData\Local\Temp&quot; of folders whose(exists folder &quot;AppData\Local\Temp&quot; of it) of folders &quot;C:\Users&quot;)</Property>
  </Analysis>
</BES>
