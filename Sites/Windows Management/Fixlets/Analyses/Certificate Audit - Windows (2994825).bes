  <Analysis>
    <Title>Certificate Audit - Windows</Title>
    <Description><![CDATA[&lt;enter a description of the analysis here&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\SystemCertificates&quot; of (x64 registries; x32 registries)</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 26 Nov 2015 04:14:23 +0000</Value>
