    <Domain>BESC</Domain>
    <Property ID="5" Name="Path" EvaluationPeriod="PT12H">value &quot;Path&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\ShellIds\Microsoft.PowerShell&quot; of registry</Property>
    <Property ID="1" Name="ApplicationBase" EvaluationPeriod="PT12H">value &quot;ApplicationBase&quot; of key &quot;PowerShellEngine&quot; of key ((it as string) of maximum of (it as integer) of names of keys of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell&quot; of registry) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell&quot; of registry</Property>
    <Property ID="2" Name="PowerShellVersion" EvaluationPeriod="PT12H">value &quot;PowerShellVersion&quot; of key &quot;PowerShellEngine&quot; of key ((it as string) of maximum of (it as integer) of names of keys of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell&quot; of registry) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell&quot; of registry</Property>
    <Property ID="3" Name="PSCompatibleVersion" EvaluationPeriod="PT12H">value &quot;PSCompatibleVersion&quot; of key &quot;PowerShellEngine&quot; of key ((it as string) of maximum of (it as integer) of names of keys of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell&quot; of registry) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell&quot; of registry</Property>
    <Property ID="4" Name="RuntimeVersion" EvaluationPeriod="PT12H">value &quot;RuntimeVersion&quot; of key &quot;PowerShellEngine&quot; of key ((it as string) of maximum of (it as integer) of names of keys of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell&quot; of registry) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell&quot; of registry</Property>
    <Property ID="6" Name="ExecutionPolicy" EvaluationPeriod="PT1H">if (not exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\ShellIds\ScriptedDiagnostics&quot; whose(exists value &quot;ExecutionPolicy&quot; of it) of registry) then ERROR &quot;no ExecutionPolicy set&quot; else (value &quot;ExecutionPolicy&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\ShellIds\ScriptedDiagnostics&quot; whose(exists value &quot;ExecutionPolicy&quot; of it) of registry)</Property>
