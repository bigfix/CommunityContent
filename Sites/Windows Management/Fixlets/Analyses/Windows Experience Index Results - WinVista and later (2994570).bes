<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Windows Experience Index Results - WinVista and later</Title>
    <Description><![CDATA[<P>&nbsp;</P>
<P><A href="https://www.ibm.com/developerworks/community/forums/html/topic?id=77777777-0000-0000-0000-000014780300#77777777-0000-0000-0000-000014956475"><FONT color=#000080>https://www.ibm.com/developerworks/community/forums/html/topic?id=77777777-0000-0000-0000-000014780300#77777777-0000-0000-0000-000014956475</FONT></A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[version of operating system >= "6.0"/* Windows Vista or later */]]></Relevance>
    <Relevance>exists name whose(it does not contain &quot;Win2008&quot; AND it does not contain &quot;Win2012&quot;) of operating system/* Exclude Windows Server */</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 22 Aug 2013 21:32:40 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="4" Name="Exists WEI results folder?" EvaluationPeriod="P2D">exists folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="5" Name="Num of WEI results xml" EvaluationPeriod="P2D">number of files whose(name of it ends with &quot;.WinSAT.xml&quot;) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="6" Name="names of WEI result files" EvaluationPeriod="P7D">names of files whose(name of it ends with &quot;.WinSAT.xml&quot;) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="8" Name="SystemScores" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/SystemScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/SystemScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="9" Name="CpuScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/CpuScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/CpuScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="10" Name="MemoryScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/MemoryScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/MemoryScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="11" Name="GraphicsScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/GraphicsScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/GraphicsScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="12" Name="GamingScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/GamingScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/GamingScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="13" Name="DiskScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/DiskScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/DiskScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="14" Name="VideoEncodeScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/VideoEncodeScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/VideoEncodeScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="15" Name="CPUSubAggScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/CPUSubAggScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/CPUSubAggScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="16" Name="Dx9SubScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/Dx9SubScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/Dx9SubScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="17" Name="Dx10SubScore" EvaluationPeriod="P2D">(it as floating point) of unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/Dx10SubScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/Dx10SubScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="18" Name="StdDefPlayback" EvaluationPeriod="P2D">unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/StdDefPlaybackScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/StdDefPlaybackScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="19" Name="HighDefPlayback" EvaluationPeriod="P2D">unique values of (it as text) of xpaths &quot;/WinSAT/WinSPR/HighDefPlaybackScore&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/WinSPR/HighDefPlaybackScore&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="20" Name="Run Dates" EvaluationPeriod="P2D">unique values of (preceding text of first &quot;  &quot; of following text of first &quot; &quot; of (it as text) as string) of attributes &quot;Friendly&quot; of xpaths &quot;/WinSAT/SystemEnvironment/ExecDateTOD&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/SystemEnvironment/ExecDateTOD&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="21" Name="HDD Random Read MB/s" EvaluationPeriod="P2D">unique values of (it as text as floating point) of xpaths &quot;/WinSAT/Metrics/DiskMetrics/AvgThroughput[@kind=&apos;Random Read&apos;]&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/Metrics/DiskMetrics/AvgThroughput[@kind=&apos;Random Read&apos;]&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="22" Name="HDD Sequential Read MB/s" EvaluationPeriod="P2D">unique values of (it as text as floating point) of xpaths &quot;/WinSAT/Metrics/DiskMetrics/AvgThroughput[@kind=&apos;Sequential Read&apos;]&quot; of xml documents of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; and exists xpath &quot;/WinSAT/Metrics/DiskMetrics/AvgThroughput[@kind=&apos;Sequential Read&apos;]&quot; of xml document of it) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder</Property>
    <Property ID="23" Name="WEI run in past 90 days?" EvaluationPeriod="P2D">((exists folder &quot;Performance\WinSAT\DataStore&quot; of windows folder) AND (exists files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot;) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder) AND (1 &lt; (number of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; AND (&quot;0&quot; = (it as text) of xpath &quot;/WinSAT/CompletionStatus&quot; of xml document of it)) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder)) AND ((now - maximum of creation times of files whose(name of it ends with &quot;.WinSAT.xml&quot; AND name of it contains &quot;Assessment&quot; AND (&quot;0&quot; = (it as text) of xpath &quot;/WinSAT/CompletionStatus&quot; of xml document of it)) of folder &quot;Performance\WinSAT\DataStore&quot; of windows folder) &lt; 90*day))</Property>
  </Analysis>
</BES>
