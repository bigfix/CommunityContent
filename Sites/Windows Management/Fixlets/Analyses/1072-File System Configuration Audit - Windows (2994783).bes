    <Domain>BESC</Domain>
    <Property ID="1" Name="DisableDeleteNotification (0=TRIM_Enabled)" EvaluationPeriod="P2D">value &quot;DisableDeleteNotification&quot; of keys &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\FileSystem&quot; of registry | ERROR &quot;does not exist&quot; /* a result of 0 means TRIM is enabled as far as the Windows/NTFS side is concerned. This does not mean that these TRIM notifications are actually being used by the actual storage system, which may or may not support TRIM. */ </Property>
    <Property ID="2" Name="NtfsDisableLastAccessUpdate" EvaluationPeriod="PT12H">value &quot;NtfsDisableLastAccessUpdate&quot; of keys &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\FileSystem&quot; of registry | ERROR &quot;does not exist&quot;</Property>
    <Property ID="3" Name="NtfsMemoryUsage" EvaluationPeriod="PT12H">value &quot;NtfsMemoryUsage&quot; of keys &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\FileSystem&quot; of registry | ERROR &quot;does not exist&quot;</Property>
