    <Property ID="1" Name="Failure Details">preceding texts of lasts &quot;&lt;/FailureDetails&gt;&quot; of following texts of firsts &quot;&lt;FailureDetails&gt;&quot; of lines containing &quot;&lt;FailureDetails&gt;&quot; of files &quot;setupdiagresults.xml&quot; of folder &quot;Windows\Logs\SetupDiag&quot; of drive of system folder</Property>
    <Property ID="2" Name="Failure Data">preceding texts of lasts &quot;&lt;/FailureData&gt;&quot; of following texts of firsts &quot;&lt;FailureData&gt;&quot; of lines containing &quot;&lt;FailureData&gt;&quot; of files &quot;setupdiagresults.xml&quot; of folder &quot;Windows\Logs\SetupDiag&quot; of drive of system folder</Property>
    <Property ID="3" Name="Remediation">preceding texts of lasts &quot;&lt;/Remediation&gt;&quot; of following texts of firsts &quot;&lt;Remediation&gt;&quot; of lines containing &quot;&lt;Remediation&gt;&quot; of files &quot;setupdiagresults.xml&quot; of folder &quot;Windows\Logs\SetupDiag&quot; of drive of system folder</Property>
