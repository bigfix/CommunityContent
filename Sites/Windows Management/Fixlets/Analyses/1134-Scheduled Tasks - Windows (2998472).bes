<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Scheduled Tasks - Windows</Title>
    <Description><![CDATA[<P>This analysis provides information about the currently configured scheduled tasks on the system.</P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Tasks - Paths - Windows" EvaluationPeriod="P1D">unique values of (concatenations of (it as string)) of (path of it) of scheduled tasks</Property>
    <Property ID="2" Name="Tasks - Last Run Time - Windows" EvaluationPeriod="P1D">unique values of (concatenations of (it as string)) of (path of it, last run time of it) of scheduled tasks</Property>
    <Property ID="3" Name="Tasks - Next Run Time - Windows" EvaluationPeriod="P1D">unique values of (concatenations of (it as string)) of (path of it, next run time of it as string | &quot;none&quot;) of scheduled tasks</Property>
    <Property ID="4" Name="Tasks - Last Result - Windows" EvaluationPeriod="P1D">unique values of (concatenations of (it as string)) of (path of it, last task result of it | 0) of scheduled tasks</Property>
    <Property ID="5" Name="Tasks - State - Windows" EvaluationPeriod="P1D">unique values of (concatenations of (it as string)) of (name of it, (if (enabled of it) then (&quot;Enabled&quot;) else &quot;Disabled&quot;)) of scheduled tasks</Property>
    <Property ID="6" Name="Tasks - Run when Idle - Windows" EvaluationPeriod="P1D">unique values of (concatenations of (it as string)) of (name of it, idle duration of idle settings of settings of definition of it as string) of scheduled tasks whose (exists idle duration of idle settings of settings of definition of it as string)</Property>
    <Property ID="7" Name="Tasks - Run As - Windows" EvaluationPeriod="P1D">unique values of (concatenations of (it as string)) of (name of it, account name of owner of security descriptor of it) of scheduled tasks</Property>
    <Property ID="8" Name="Tasks - Embedded Passwords - Windows" EvaluationPeriod="P1D">unique values of (concatenations of (it as string)) of (name of it, user id of principal of definition of it) of scheduled tasks whose (password logon of principal of definition of it)</Property>
  </Analysis>
</BES>
