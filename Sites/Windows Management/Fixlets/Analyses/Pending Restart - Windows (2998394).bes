<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Pending Restart - Windows</Title>
    <Description><![CDATA[<P>Provides information on the various sources that the BigFix Agent uses when assessing whether a Windows computer has a pending restart.</P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>pending restart</Relevance>
    <Relevance>windows of operating system</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Pending Restart - File Rename Operations - Windows" EvaluationPeriod="P1D">substrings separated by &quot;%00&quot; whose (it != &quot;&quot;) of (values &quot;PendingFileRenameOperations&quot; of keys &quot;HKLM\System\CurrentControlSet\Control\Session Manager&quot; of native registry as string)</Property>
    <Property ID="2" Name="Pending Restart - Windows Updates - Windows" EvaluationPeriod="P1D">names of values of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired&quot; of native registry</Property>
    <Property ID="3" Name="Pending Restart - Component Based Servicing - Windows" EvaluationPeriod="P1D">exists key &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending&quot; of native registry</Property>
    <Property ID="4" Name="Pending Restart - Volatile Update Executable - Windows" EvaluationPeriod="P1D">values &quot;Flags&quot; of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Updates\UpdateExeVolatile&quot; of native registry </Property>
    <Property ID="5" Name="Pending Restart - BigFix Action - Windows" EvaluationPeriod="P1D">values whose (it != &quot;&quot;) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\EnterpriseClient\BESPendingRestart&quot; of x32 registry</Property>
  </Analysis>
</BES>
