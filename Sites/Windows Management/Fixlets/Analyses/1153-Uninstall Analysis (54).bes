<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Uninstall Analysis</Title>
    <Description>Pulls back Registry Keys and Display Names for windows installed software </Description>
    <Relevance>true</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 04 Dec 2012 16:37:14 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="QuietUninstallString" EvaluationPeriod="PT1H">(values &quot;DisplayName&quot; of it, values &quot;DisplayVersion&quot; of it, values &quot;UninstallString&quot; of it, values &quot;QuietUninstallString&quot; of it) of keys of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Property>
    <Property ID="2" Name="UninstallString" EvaluationPeriod="PT1H">(values &quot;DisplayName&quot; of it, values &quot;DisplayVersion&quot; of it, values &quot;UninstallString&quot; of it) of keys of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Property>
  </Analysis>
</BES>
