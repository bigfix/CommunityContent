<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Values(BIOS &amp; More) of wmi &quot;root\dcim\sysman&quot; - Windows (Dell Command Monitor / OMCI &amp; others)</Title>
    <Description><![CDATA[<P>Written against the <FONT size=2>Dell Command | Monitor Version 9.0 Reference Guide.</FONT></P>
<P><FONT size=2>The information in wmi root\dcim\sysman is part of a standard, so this analysis should work for more than just Dell systems as long as the non-Dell systems have similar functionality and reporting mechanisms installed.</FONT></P>
<P><FONT size=2>&nbsp;</P></FONT>
<P><STRONG>References:</STRONG></P>
<P><A href="http://www.dell.com/support/Manuals/us/en/19/Topic/dell-opnmang-clnt-instr-v9.0.0/Dell_Command_Monitor_Ref_Guide-v1/en-us/GUID-28F353DA-781B-4426-A01F-DBD815555AAD">http://www.dell.com/support/Manuals/us/en/19/Topic/dell-opnmang-clnt-instr-v9.0.0/Dell_Command_Monitor_Ref_Guide-v1/en-us/GUID-28F353DA-781B-4426-A01F-DBD815555AAD</A></P>
<P><A href="https://support.bigfix.com/inspectors/WMI%20Objects_Any.html">https://support.bigfix.com/inspectors/WMI%20Objects_Any.html</A></P>
<P><A href="http://schemas.dmtf.org/wbem/cim-html/2/CIM_BIOSAttribute.html">http://schemas.dmtf.org/wbem/cim-html/2/CIM_BIOSAttribute.html</A></P>
<P><A href="http://schemas.dmtf.org/wbem/cim-html/2/CIM_BIOSEnumeration.html">http://schemas.dmtf.org/wbem/cim-html/2/CIM_BIOSEnumeration.html</A></P>
<P>&nbsp;</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists wmi &quot;root\dcim\sysman&quot;</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 06 Feb 2015 21:39:34 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="2" Name="AC Power Recovery Mode" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;AC Power Recovery Mode&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;AC Power Recovery Mode&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="3" Name="Chassis Intrusion" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Chassis Intrusion&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Chassis Intrusion&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="4" Name="Chassis Intrusion Status" EvaluationPeriod="PT12H">( if &quot;Disable&quot; = ( tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Chassis Intrusion&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Chassis Intrusion&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) then ERROR &quot;Disabled&quot; else ( tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Chassis Intrusion Status&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Chassis Intrusion Status&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) ) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="5" Name="Auto On" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Auto On&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Auto On&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="6" Name="Intel AMT?" EvaluationPeriod="P2D">string values of selects &quot;AMTSupported from DCIM_AMTSettings&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="7" Name="Intel ASF?" EvaluationPeriod="P2D">string values of selects &quot;ASFEnabled from DCIM_ASFSettings&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="8" Name="BiosSetupPassword set?" EvaluationPeriod="PT12H">string values of selects &quot;IsSet from DCIM_BIOSPassword where ElementName=&apos;BiosSetupPassword&apos;&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="9" Name="BiosBootPassword set?" EvaluationPeriod="PT12H">string values of selects &quot;IsSet from DCIM_BIOSPassword where ElementName=&apos;BiosBootPassword&apos;&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="10" Name="Password Status Lock?" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Password Status Lock&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Password Status Lock&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="11" Name="RunningOS" EvaluationPeriod="PT12H">(preceding text of first &quot;%22&quot; of following text of first &quot;,Name=%22&quot; of it as trimmed string) of string values of selects &quot;Antecedent from DCIM_RunningOS&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="12" Name="ChassisPackageType#" EvaluationPeriod="PT12H">unique values of ( ( (it as string as integer) of values &quot;type&quot; of structures &quot;system_enclosure_or_chassis&quot; of smbios ); integer values of (selects &quot;ChassisPackageType from DCIM_Chassis&quot; of wmis &quot;root/dcim/sysman&quot;; selects &quot;ChassisTypes from Dell_Chassis&quot; of wmis &quot;root\DELLOMCI&quot;))</Property>
    <Property ID="13" Name="ChassisPackageTypeName" EvaluationPeriod="PT12H">( if exists it then it else ERROR &quot;UNKNOWN&quot; ) of (tuple string items ( unique values of ( ( (it as string as integer) of values &quot;type&quot; of structures &quot;system_enclosure_or_chassis&quot; of smbios ); integer values of (selects &quot;ChassisPackageType from DCIM_Chassis&quot; of wmis &quot;root/dcim/sysman&quot;; selects &quot;ChassisTypes from Dell_Chassis&quot; of wmis &quot;root\DELLOMCI&quot;)) ) of &quot;Unknown, Other, Unknown, Desktop, Low Profile Desktop, Pizza Box, Mini Tower, Tower, Portable, Laptop, Notebook, Hand Held, Docking Station, All in One, Sub Notebook, Space-Saving, Lunch Box, Main System Chassis, Expansion Chassis, SubChassis, Bus Expansion Chassis, Peripheral Chassis, Storage Chassis, Rack Mount Chassis, Sealed-Case PC, Multi-system chassis, CompactPCI, AdvancedTCA, Blade, Blade Enclosure, Tablet, Convertible, Detachable&quot;)</Property>
    <Property ID="14" Name="Num Lock (state@boot?)" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Num Lock&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Num Lock&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="15" Name="USB" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;USB&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;USB&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="16" Name="Signed Firmware Update" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Signed Firmware Update&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Signed Firmware Update&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="17" Name="TPM PPI ACPI Support" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;TPM PPI ACPI Support&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;TPM PPI ACPI Support&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="18" Name="Trusted Execution" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Trusted Execution&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Trusted Execution&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="19" Name="OROM Keyboard Access" EvaluationPeriod="PT6H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;OROM Keyboard Access&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;OROM Keyboard Access&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="20" Name="Enable Legacy Option ROMs" EvaluationPeriod="PT6H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Enable Legacy Option ROMs&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Enable Legacy Option ROMs&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="21" Name="Wake-On-LAN" EvaluationPeriod="PT12H">(string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Wake-On-LAN&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="22" Name="Processor Virtualization Technology" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Processor Virtualization Technology&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Processor Virtualization Technology&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="23" Name="AC Power Recovery Mode" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;AC Power Recovery Mode&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;AC Power Recovery Mode&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="24" Name="Embedded SATA Controller" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Embedded SATA Controller&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Embedded SATA Controller&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="25" Name="CurrentValueName of Attributes of DCIM_BIOSEnumeration" EvaluationPeriod="P2D">unique values of (item 0 of it &amp; &quot;: &quot; &amp; unique value of (if ( /* 0 means there are no options to choose from */ (0 = item 1 of it as integer) OR /* 0 means the selection is invalid */ (0 = following text of last &quot;, &quot; of item 2 of it as integer) OR /* if the selection is outside the number of possible values, then it is invalid */ (item 1 of it as integer &lt; following text of last &quot;, &quot; of item 2 of it as integer) ) then &quot;UNKNOWN&quot; else ( (tuple string items ( (it as integer - 1) of following text of last &quot;, &quot; of it ) of item 2 of it) of it ) ) of it) of (string value of property &quot;AttributeName&quot; of it , number of string values of properties &quot;PossibleValuesDescription&quot; of it, (concatenation &quot;, &quot; of (if exists it whose(it as trimmed string != &quot;&quot;) then it else &quot;UNKOWN&quot;) of string values of properties &quot;PossibleValuesDescription&quot; of it) &amp; &quot;, &quot; &amp; (if (exists string values whose(it != &quot;0&quot;) of properties &quot;CurrentValue&quot; of it) then (string value of properties &quot;CurrentValue&quot; of it) else &quot;0&quot;) ) of ( select objects &quot;AttributeName,CurrentValue,PossibleValuesDescription from DCIM_BIOSEnumeration&quot; of it ; select objects &quot;AttributeName,CurrentValue,PossibleValuesDescription from CIM_BIOSEnumeration&quot; of it ) of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="26" Name="exists &quot;root\DELLOMCI&quot;" EvaluationPeriod="PT6H">exists wmi &quot;root\DELLOMCI&quot;</Property>
    <Property ID="27" Name="DCIM_EthernetPort" EvaluationPeriod="PT12H">selects &quot;ElementName,PermanentAddress,EnabledDefault,EnabledState,LinkTechnology,TOEEnabledState from DCIM_EthernetPort&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="28" Name="DCIM_Chassis" EvaluationPeriod="PT12H">selects &quot;BreachDescription,ChassisPackageType,FirstPowerOnDate,ManufactureDate,PackageType,SecurityBreach from DCIM_Chassis&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="29" Name="DCIM_Chip" EvaluationPeriod="PT12H">selects &quot;Manufacturer,ElementName,Model,ElementName from DCIM_Chip&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="30" Name="DCIM_DesktopMonitor" EvaluationPeriod="PT12H">selects &quot;Description,ColorDepthBits,ColorModePreset,DisplayMode,EDIDGamma,EDIDVersionNumber,HealthState,ManufactureDate,PhysicalSizeH,PhysicalSizeV,PrimaryStatus,ProductCode,SerialNumber,StandbyModeSupported,SuspendModeSupported,VeryLowPowerSupported from DCIM_DesktopMonitor&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="31" Name="DCIM_ControllerView" EvaluationPeriod="PT12H">selects &quot;BusType,ControllerFirmwareVersion,Device,DriverVersion,ElementName,PrimaryStatus,ProductName from DCIM_ControllerView&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="32" Name="DCIM_PhysicalMemory" EvaluationPeriod="PT12H">selects &quot;BankLabel,Capacity,DataWidth,ElementName,FormFactor,ManufactureDate,Manufacturer,MemoryType,Model,PartNumber,SerialNumber,SKU,Speed from DCIM_PhysicalMemory&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="33" Name="DCIM_Slot" EvaluationPeriod="PT12H">selects &quot;ConnectorDescription,ConnectorLayout,ConnectorType,ElementName,Number from DCIM_Slot&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="34" Name="DCIM_USBPort" EvaluationPeriod="PT12H">selects &quot;ElementName,EnabledDefault,EnabledState,HealthState from DCIM_USBPort&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="35" Name="DCIM_Memory" EvaluationPeriod="PT12H">selects &quot;BlockSize,ElementName,EnabledState,HealthState,NumberOfBlocks,PrimaryStatus from DCIM_Memory&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="36" Name="DCIM_PCIDevice" EvaluationPeriod="PT12H">selects &quot;BusNumber,Description,DeviceNumber,ElementName,EnabledState,FunctionNumber,HealthState,PrimaryStatus from DCIM_PCIDevice&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="37" Name="DCIM_DisplayController" EvaluationPeriod="PT12H">selects &quot;ElementName,Name from DCIM_DisplayController&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="38" Name="DCIM_Fan" EvaluationPeriod="PT12H">selects &quot;ActiveCooling,ElementName,EnabledState,HealthState,PrimaryStatus,VariableSpeed from DCIM_Fan&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="39" Name="DCIM_NumericSensor" EvaluationPeriod="PT12H">selects &quot;BaseUnits,CurrentState,ElementName,EnabledState,HealthState,PrimaryStatus,RateUnits,SensorType,ValueFormulation from DCIM_NumericSensor&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="40" Name="DCIM_Sensor" EvaluationPeriod="PT12H">selects &quot;CurrentState,ElementName,EnabledState,HealthState,PrimaryStatus,SensorType from DCIM_Sensor&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="41" Name="DCIM_Button" EvaluationPeriod="PT12H">selects &quot;ButtonPurpose,ButtonType,DeviceID from DCIM_Button&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="42" Name="DCIM_BootSourceSetting" EvaluationPeriod="PT12H">selects &quot;ElementName,FailThroughSupported,StructuredBootString from DCIM_BootSourceSetting&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="43" Name="DCIM_AssetAcquisition" EvaluationPeriod="PT12H">selects &quot;* from DCIM_AssetAcquisition&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="44" Name="DCIM_AssetSystemInformation" EvaluationPeriod="PT12H">selects &quot;* from DCIM_AssetSystemInformation&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="45" Name="DCIM_Location" EvaluationPeriod="PT12H">selects &quot;* from DCIM_Location&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="46" Name="DCIM_AssetSupportInformation" EvaluationPeriod="PT12H">selects &quot;* from DCIM_AssetSupportInformation&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="47" Name="DCIM_AssetOwnerInformation" EvaluationPeriod="PT12H">selects &quot;* from DCIM_AssetOwnerInformation&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="48" Name="Owner Tag" EvaluationPeriod="P1D">(it as trimmed string) of string values whose(it as trimmed string != &quot;&quot;) of selects &quot;PropertyOwnershipTag from DCIM_Chassis&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="49" Name="Asset Tag" EvaluationPeriod="P1D">(it as trimmed string) of string values whose(it as trimmed string != &quot;&quot;) of selects &quot;ElementName from DCIM_Chassis&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="50" Name="DCIM_Battery" EvaluationPeriod="PT12H">selects &quot;* from DCIM_Battery&quot; of wmi &quot;root\dcim\sysman&quot;</Property>
    <Property ID="51" Name="WoL - Possible Values Desc" EvaluationPeriod="PT12H">concatenations &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Wake-On-LAN&apos;&quot; of wmi &quot;root\dcim\sysman&quot;)</Property>
    <Property ID="52" Name="WoL - StringDesc">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Wake-On-LAN&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of &quot;Disable, 2, 3, LAN, 5, 6, LAN with PXE Boot&quot; | ERROR &quot;UNKNOWN&quot;</Property>
    <Property ID="53" Name="WoL - Possible Values #" EvaluationPeriod="PT12H">concatenations &quot;, &quot; of (string values of selects &quot;PossibleValues from DCIM_BIOSEnumeration where AttributeName=&apos;Wake-On-LAN&apos;&quot; of wmi &quot;root\dcim\sysman&quot;)</Property>
    <Property ID="54" Name="Deep Sleep Control" EvaluationPeriod="PT12H">tuple string item ( (it - 1) of integer (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Deep Sleep Control&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) ) of concatenation &quot;, &quot; of (string values of selects &quot;PossibleValuesDescription from DCIM_BIOSEnumeration where AttributeName=&apos;Deep Sleep Control&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | (string value of selects &quot;CurrentValue from DCIM_BIOSEnumeration where AttributeName=&apos;Deep Sleep Control&apos;&quot; of wmi &quot;root\dcim\sysman&quot;) | ERROR &quot;UNKNOWN&quot;</Property>
  </Analysis>
