<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Certificates - Windows</Title>
    <Description><![CDATA[<P>This analysis provides information on the current state of the Windows Certificate Store.</P>
<P>This analysis relies on <STRONG>Fixlet</STRONG>: <STRONG>Invoke - Certificate Store Probe - Windows</STRONG> in the C3-Inventory site</P>
<P>Information on using this content is available here: <A href="https://github.com/strawgate/C3-Inventory/wiki/Certificate-Store">https://github.com/strawgate/C3-Inventory/wiki/Certificate-Store</A></P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists value &quot;Last Updated Date&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store&quot; of native registry</Relevance>
    <Domain>BESC</Domain>
    <Property ID="7" Name="Certificates - Trusted Third-Party Root Authorities - Windows" EvaluationPeriod="P1D">values &quot;subject&quot; of keys of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\AuthRoot&quot; of native registry</Property>
    <Property ID="8" Name="Certificates - Trusted Intermediate Authorities - Windows" EvaluationPeriod="P1D">values &quot;subject&quot; of keys of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\CA&quot; of native registry</Property>
    <Property ID="9" Name="Certificates - Trusted Root Authorities - Windows" EvaluationPeriod="P1D">values &quot;subject&quot; of keys of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\Root&quot; of native registry</Property>
    <Property ID="10" Name="Certificates - Trusted Publishers - Windows" EvaluationPeriod="P1D">values &quot;subject&quot; of keys of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\TrustedPublisher&quot; of native registry</Property>
    <Property ID="11" Name="Certificates - Trusted Roots with Private Key - Windows" EvaluationPeriod="P1D">values &quot;subject&quot; of keys whose (value &quot;Private Key&quot; of it as string as boolean = true) of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\Root&quot; of native registry</Property>
    <Property ID="12" Name="Certificates - Remote Desktop - Windows" EvaluationPeriod="P1D">values &quot;subject&quot; of keys of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\Remote Desktop&quot; of native registry</Property>
    <Property ID="13" Name="Certificates - Trusted Code Signers - Windows" EvaluationPeriod="P1D">values &quot;subject&quot; of keys whose (value &quot;Usage&quot; of it as string contains &quot;Code Signing&quot;) of keys of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine&quot; of native registry</Property>
    <Property ID="14" Name="Certificates - My Certificates - Windows" EvaluationPeriod="P1D">(values &quot;subject&quot; of it, value &quot;Not Before&quot; of it, value &quot;Not After&quot; of it) of keys of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\My&quot; of native registry</Property>
    <Property ID="15" Name="Certificates - Last Probe - Windows" EvaluationPeriod="PT6H">(value &quot;Last Updated Date&quot; of it as string as date &amp; (value &quot;Last Updated Time&quot; of it as string as time_of_day &amp; local time zone)) of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store&quot; of native registry</Property>
    <Property ID="16" Name="Certificates - My Certificates Expiring in 30 Days - Windows" EvaluationPeriod="P1D">(values &quot;subject&quot; of it, value &quot;Not After&quot; of it) of keys whose ((it &gt; 0 * day and it &lt; 30 * day) of (value &quot;Not After Date&quot; of it as string as date &amp; (value &quot;Not After Time&quot; of it as string as time_of_day &amp; local time zone) - now)) of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\My&quot; of native registry</Property>
    <Property ID="17" Name="Certificates - My Certificates Expiring in 7 Days - Windows" EvaluationPeriod="PT12H">(values &quot;subject&quot; of it, value &quot;Not After&quot; of it) of keys whose ((it &gt; 0 * day and it &lt; 7 * day) of (value &quot;Not After Date&quot; of it as string as date &amp; (value &quot;Not After Time&quot; of it as string as time_of_day &amp; local time zone) - now)) of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\My&quot; of native registry</Property>
    <Property ID="18" Name="Certificates - My Certificates Expiring in 1 Day - Windows" EvaluationPeriod="PT15M">(values &quot;subject&quot; of it, value &quot;Not After&quot; of it) of keys whose ((it &gt; 0 * day and it &lt; 1 * day) of (value &quot;Not After Date&quot; of it as string as date &amp; (value &quot;Not After Time&quot; of it as string as time_of_day &amp; local time zone) - now)) of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\My&quot; of native registry</Property>
    <Property ID="19" Name="Certificates - My Expired Certificates - Windows" EvaluationPeriod="P1D">(values &quot;subject&quot; of it, value &quot;Not After&quot; of it) of keys whose ((it &lt; 0 * day) of (value &quot;Not After Date&quot; of it as string as date &amp; (value &quot;Not After Time&quot; of it as string as time_of_day &amp; local time zone) - now)) of keys &quot;HKEY_LOCAL_MACHINE\Software\C3 Inventory\Certificate Store\LocalMachine\My&quot; of native registry</Property>
  </Analysis>
</BES>
