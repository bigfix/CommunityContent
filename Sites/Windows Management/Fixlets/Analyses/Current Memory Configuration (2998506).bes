<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Current Memory Configuration</Title>
    <Description>Returns the current configuration of Physical Memory installed. </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists wmi</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 25 Mar 2016 18:14:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Memory Configuration" EvaluationPeriod="P1D">((((string value of it as integer)/(1024*1024)) as string) &amp; &quot; MB&quot;) of (selects &quot;Capacity from Win32_PhysicalMemory where MemoryType!=&apos;11&apos;&quot; of wmi)</Property>
    <Property ID="3" Name="Memory Configuration | Speed" EvaluationPeriod="P1D">((((string value of Property &quot;Capacity&quot; of it as integer)/(1024*1024*1024)) as string) &amp; &quot; GB | &quot; &amp; (string value of property &quot;Speed&quot; of it)&amp; &quot; MHz&quot;) of select objects &quot;* from Win32_PhysicalMemory where MemoryType!=&apos;11&apos;&quot; of wmi</Property>
  </Analysis>
</BES>
