<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Stability - Windows</Title>
    <Description><![CDATA[<FONT size=2>
<P>This analysis provides stability information for Windows devices.</P>
<P>Kudos, compliments, and credit for the majority of this analysis to: jgstew</P>
<P>The original analysis this is based off of is available here: <A href="https://bigfix.me/analysis/details/2994781">https://bigfix.me/analysis/details/2994781</A></P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P></FONT>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Stability - Recent Hard Reboots - Windows" EvaluationPeriod="P1D">number of descriptions of records ((integers in(item 0 of it + item 1 of it - 1,maximum of (item 0 of it + item 1 of it - 2500;item 1 of it))) of (record count of it, oldest record number of it)) whose (event id of it = 41) of system event log</Property>
    <Property ID="3" Name="Stability - WER Type/Count - Windows" EvaluationPeriod="P1D">if (version of operating system &gt; &quot;6.0&quot;) then ((it, multiplicity of it) of unique values of preceding texts of firsts &quot;_&quot; of names of folders of folders whose(name of it = &quot;ReportArchive&quot; OR name of it = &quot;ReportQueue&quot;) of ((folders &quot;AppData\Local\Microsoft\Windows\WER&quot; of folders whose(exists folder &quot;AppData\Local\Microsoft\Windows\WER&quot; of it) of folder &quot;C:\Users&quot;);(folder &quot;C:\ProgramData\Microsoft\Windows\WER&quot;))) else ERROR &quot;NotApplicable&quot;</Property>
    <Property ID="4" Name="Stability - WER Critical Lines - Windows" EvaluationPeriod="P1D">if (version of operating system &gt; &quot;6.0&quot;) then (sum of (multiplicity of it) of unique values whose(it = &quot;Critical&quot; OR it = &quot;Kernel&quot;) of preceding texts of firsts &quot;_&quot; of names of folders of folders whose(name of it = &quot;ReportArchive&quot; OR name of it = &quot;ReportQueue&quot;) of ((folders &quot;AppData\Local\Microsoft\Windows\WER&quot; of folders whose(exists folder &quot;AppData\Local\Microsoft\Windows\WER&quot; of it) of folder &quot;C:\Users&quot;);(folder &quot;C:\ProgramData\Microsoft\Windows\WER&quot;))) else ERROR &quot;NotApplicable&quot;</Property>
    <Property ID="6" Name="Stability - Reliability Score - Windows" EvaluationPeriod="PT12H">tuple string items 0 of concatenations &quot;, &quot; of string values of selects (&quot;SystemStabilityIndex FROM Win32_ReliabilityStabilityMetrics WHERE TimeGenerated &gt;= &quot; &amp; ((year of it as string &amp; month of it as two digits &amp; day_of_month of it as two digits) of date (local time zone) of it) of (now - 1*day) ) of wmis</Property>
    <Property ID="7" Name="Stability - Average of recent Reliability Scores - Windows" EvaluationPeriod="PT12H">( (sum of (it as floating point) of elements of item 1 of it) / item 0 of it) of (number of elements of it, it) of sets of string values of selects (&quot;SystemStabilityIndex FROM Win32_ReliabilityStabilityMetrics WHERE TimeGenerated &gt;= &quot; &amp; ((year of it as string &amp; month of it as two digits &amp; day_of_month of it as two digits) of date (local time zone) of it) of (now - 1*day) ) of wmis</Property>
    <Property ID="8" Name="Stability - Recent Blue Screen - Windows" EvaluationPeriod="P1D">number of descriptions of records ((integers in(item 0 of it + item 1 of it - 1,maximum of (item 0 of it + item 1 of it - 2500;item 1 of it))) of (record count of it, oldest record number of it)) whose (event id of it = 41) of system event log</Property>
    <Property ID="11" Name="Events - System Log - Oldest - Windows" EvaluationPeriod="P1D">time written of record (oldest record number of system event log) of system event log</Property>
  </Analysis>
</BES>
