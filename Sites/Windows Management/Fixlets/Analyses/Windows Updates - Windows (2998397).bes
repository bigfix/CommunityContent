<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Windows Updates - Windows</Title>
    <Description><![CDATA[Provides the current configuration of WSUS on the target system
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Domain>BES </Domain>
    <Property ID="1" Name="WSUS - Client Group - Windows" EvaluationPeriod="P1D">values &quot;TargetGroup&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WindowsUpdate&quot; of native registry</Property>
    <Property ID="2" Name="WSUS - Update Server - Windows" EvaluationPeriod="P1D">values &quot;WUServer&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WindowsUpdate&quot; of native registry</Property>
    <Property ID="3" Name="WSUS - Automatic Update Method - Windows" EvaluationPeriod="P1D">(if (it = &quot;2&quot;) then (&quot;Notify before download.&quot;) else (if (it = &quot;3&quot;) then (&quot;Automatically download and notify of installation.&quot;) else (if (it = &quot;4&quot;) then &quot;Automatic download and scheduled installation&quot; else (if (it = &quot;5&quot;) then &quot;Automatic Updates is required, but end users can configure it.&quot; else ERROR &quot;Value not recognized&quot;)))) of (value &quot;AUOptions&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update&quot; of native registry as string)</Property>
    <Property ID="4" Name="WSUS - Minor Updates Silent Installation - Windows" EvaluationPeriod="P1D">if (value &quot;AutoInstallMinorUpdates&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WindowsUpdate&quot; of native registry as string | &quot;0&quot; = &quot;1&quot; ) then &quot;Enabled&quot; else &quot;Disabled&quot;</Property>
    <Property ID="5" Name="WSUS - Automatic Update State - Windows" EvaluationPeriod="P1D">if (value &quot;NoAutoUpdate&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WindowsUpdate&quot; of native registry as string | &quot;0&quot; = &quot;1&quot; ) then &quot;Disabled&quot; else &quot;Enabled&quot;</Property>
    <Property ID="6" Name="WSUS - No Reboot with Logged On User - Windows" EvaluationPeriod="P1D">(if (it = &quot;-1&quot;) then (&quot;Not Configured&quot;) else (if (it = &quot;0&quot;) then &quot;Disabled&quot; else (if (it = &quot;1&quot;) then &quot;Enabled&quot; else ERROR &quot;Unknown Value&quot;))) of (value &quot;NoAutoRebootWithLoggedOnUsers&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\WindowsUpdate\AU&quot; of native registry as string | &quot;-1&quot;)</Property>
  </Analysis>
</BES>
