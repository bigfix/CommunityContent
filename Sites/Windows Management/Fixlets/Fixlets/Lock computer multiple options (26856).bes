  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Lock computer multiple options</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>true</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2021-06-09</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 10 Jun 2021 07:30:24 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to lock the computer for 24 hours</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Lock computer for 24 hours

action lock until &quot;{now + (24 * hour)}&quot; &quot;{parameter &quot;action issue date&quot; of action}&quot;</ActionScript>
    </DefaultAction>
    <Action ID="Action28137">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to to lock the computer for&amp;nbsp;7 days</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Lock computer for 7 days

action lock until &quot;{now + (7 * day)}&quot; &quot;{parameter &quot;action issue date&quot; of action}&quot;</ActionScript>
    </Action>
    <Action ID="Action28138">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to to lock the computer for custom&amp;nbsp; time (in hours)</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Lock computer for custom hours
action parameter query &quot;_hours_lock&quot; with description &quot;Lock the system for this many hours [hh]&quot;

action lock until &quot;{now + (parameter &quot;_hours_lock&quot; as integer) * hour}&quot; &quot;{parameter &quot;action issue date&quot; of action}&quot; for client</ActionScript>
    </Action>
    <Action ID="Action28139">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to lock the computer indefinitely </PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Lock computer indefinitely
action lock indefinite &quot;{parameter &quot;action issue date&quot; of action}&quot;
continue if { lock string of action lock state = &quot;Yes&quot; }</ActionScript>
    </Action>
  </Task>
</BES>
