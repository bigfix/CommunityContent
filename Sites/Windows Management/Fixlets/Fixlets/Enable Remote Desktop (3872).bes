<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Enable Remote Desktop</Title>
    <Description><![CDATA[&lt;enter a description of the problem and the corrective action here&gt; ]]></Description>
    <Relevance>name of operating system as lowercase starts with &quot;win&quot;</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2012-08-20</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 09 Oct 2014 13:57:44 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Enter your action script here

waithidden cmd.exe /C reg add &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server&quot; /v fDenyTSConnections /t REG_DWORD /d 0 /f

waithidden cmd.exe /C netsh firewall set service type = remotedesktop mode = enable</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
