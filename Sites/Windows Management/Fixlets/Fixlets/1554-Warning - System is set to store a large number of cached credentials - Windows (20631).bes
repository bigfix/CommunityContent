<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - System is set to store a large number of cached credentials - Windows</Title>
    <Description><![CDATA[This fixlet is relevant on computers that are configured to store more than the last 3 logged on&nbsp;user's credentials
<P>For general information or to report issues with C3 Protect content please visit GitHub here: <A href="https://github.com/strawgate/C3-Protect">https://github.com/strawgate/C3-Protect</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[value "CachedLogonsCount" of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" of native registry as integer > 3]]></Relevance>
    <Category>Credential Caching</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-01</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:19:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
  </Fixlet>
</BES>
