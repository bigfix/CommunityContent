<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Net Logon - Disable Debug Logging</Title>
    <Description><![CDATA[<P>If you are having accounts getting locked out... it is helpful to enable netlogon debug logging to track down where the problem is coming from.&nbsp; This task will enable debug logging on Windows Servers.</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Netlogon\Parameters&quot; of native registry</Relevance>
    <Relevance>exists value &quot;DBFlag&quot; whose (it as integer != 0) of key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Netlogon\Parameters&quot; of native registry</Relevance>
    <Category>Troubleshooting</Category>
    <Source>dsmith</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2013-02-19</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 19 Feb 2013 18:21:38 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to Disable Debug Logging.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//now configure debug setting
regset &quot;[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Netlogon\Parameters]&quot; &quot;DBFlag&quot;=dword:0
//restart netlogon service
waithidden net stop &quot;netlogon&quot;
waithidden net start &quot;netlogon&quot;</ActionScript>
    </DefaultAction>
    <Action ID="Action1657">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to read the Microsoft KB 109626.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://support.microsoft.com/kb/109626</ActionScript>
    </Action>
  </Task>
</BES>
