<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Rollback Patch Task: KB971033</Title>
    <Description><![CDATA[This task will roll back the Microsoft Patch: KB971033.<BR><BR>This task is applicable on: Windows 7, Windows 7 x64. ]]></Description>
    <Relevance>( (exists key whose (name of it starts with &quot;x86_microsoft-windows-s..technologies-deploy_31bf3856ad364e35_none&quot; AND exists value &quot;7.1.7600.16395&quot; of keys of it) of it) of item 1 of it) of (key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\Packages&quot; of it, key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\SideBySide\Winners&quot; of it) of native registry OR (( (exists key whose (name of it starts with &quot;amd64_microsoft-windows-s..technologies-deploy_31bf3856ad364e35_none&quot; AND exists value &quot;7.1.7600.16395&quot; of keys of it) of it) of item 1 of it) of (key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\Packages&quot; of it, key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\SideBySide\Winners&quot; of it) of native registry)</Relevance>
    <Relevance>((name of it = &quot;Win7&quot; AND not x64 of it AND NOT ia64 of it) of operating system OR (name of it = &quot;Win7&quot; AND x64 of it AND NOT ia64 of it) of operating system)</Relevance>
    <Category>Rollback</Category>
    <Source>Rollback Task Wizard</Source>
    <SourceReleaseDate>2019-01-25</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Rollback Task Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sat, 26 Jan 2019 06:00:28 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">if {x64 of operating system}
wait {pathname of windows folder}\sysnative\wusa.exe /uninstall /kb:971033 /quiet /norestart
else
wait {pathname of system folder}\wusa.exe /uninstall /kb:971033 /quiet /norestart
endif
action requires restart
</ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
  </Task>
