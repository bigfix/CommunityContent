<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Find Ransomware Files on K Drive</Title>
    <Description><![CDATA[Find files with specified extension on&nbsp;K drive. ]]></Description>
    <Relevance>name of operating system starts with &quot;Win&quot;</Relevance>
    <Relevance>exists folder &quot;k:\&quot;</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-04</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 16 May 2017 02:41:39 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[waithidden cmd /c if exist k:\ransomware_list.txt del k:\ransomware_list.txt /q /f
waithidden cmd /c dir k:\*.wn k:\*.wcry /a /s >k:\ransomware_list.txt]]></ActionScript>
    </DefaultAction>
  </Task>
</BES>
