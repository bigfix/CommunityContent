<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Uninstall: Internet-Explorer 11 (Windows 64BIT)</Title>
    <Description><![CDATA[<P>UniInstall Internet explorer 11&nbsp;via the DISM tool.&nbsp; This action will be relevant on Windows OS's that have Internet Explorer 11 installed</P>]]></Description>
    <Relevance>name of operating systems as lowercase starts with &quot;win&quot;</Relevance>
    <Relevance>exists regapp &quot;iexplore.exe&quot; and product version of regapp &quot;iexplore.exe&quot; as string starts with &quot;11.&quot;</Relevance>
    <Category>Uninstall</Category>
    <Source>AVP-Jeff Schafer</Source>
    <SourceReleaseDate>2022-07-13</SourceReleaseDate>
    <SourceSeverity>CRITICAL</SourceSeverity>
    <MIMEField>
      <Name>bigfixme-added-time</Name>
      <Value>Wed, 26 Dec 2012 15:35:15 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-modification-time</Name>
      <Value>Wed, 26 Dec 2012 15:35:15 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-keywords</Name>
      <Value>Uninstall Feature Internet Explorer Optional</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-ID</Name>
      <Value>1048</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 13 Jul 2022 22:18:48 +0000</Value>
    </MIMEField>
    <Domain>SYST</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to&amp;nbsp;remove IE 11 on targeted systems with no forced reboot (Note: Reboot will be required to complete)</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action uses wow64 redirection {not x64 of operating system}
delete __appendfile
appendfile &quot;{pathname of system folder}\dism.exe&quot; /online /NoRestart /Remove-Capability /CapabilityName:Browser.InternetExplorer~~~~0.0.11.0 /quiet
delete __Download\remove_ie_11.bat
move __appendfile __Download\remove_ie_11.bat
waithidden __Download\remove_ie_11.bat
action requires restart
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action28254">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to&amp;nbsp;&amp;nbsp;remove IE 11 on targeted system with immediate foreced reboot (Warning).</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action uses wow64 redirection {not x64 of operating system}
delete __appendfile
appendfile &quot;{pathname of system folder}\dism.exe&quot; /online /Remove-Capability /CapabilityName:Browser.InternetExplorer~~~~0.0.11.0 /quiet
delete __Download\remove_ie_11.bat
move __appendfile __Download\remove_ie_11.bat
waithidden __Download\remove_ie_11.bat
action requires restart</ActionScript>
    </Action>
    <Action ID="Action28255">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to review Microsoft website on how to disable IE 11</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">https://docs.microsoft.com/en-us/troubleshoot/developer/browsers/installation/disable-internet-explorer-windows</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </Action>
  </Task>
</BES>
