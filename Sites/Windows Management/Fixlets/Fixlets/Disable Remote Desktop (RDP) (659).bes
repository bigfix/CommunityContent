<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Disable Remote Desktop (RDP)</Title>
    <Description>Disable remote desktop settings in the registry. (RDP) </Description>
    <Relevance>name of operating system starts with &quot;Win&quot;</Relevance>
    <Relevance>exists value &quot;fDenyTSConnections&quot; whose (it = 0) of key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server&quot; of registry</Relevance>
    <Category>Configuration</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2012-11-05</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 06 Nov 2012 00:35:31 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
regset &quot;[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Terminal Server]&quot; &quot;fDenyTSConnections&quot;=dword:00000001
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action898">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn more about this setting.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://technet.microsoft.com/en-us/library/cc782195(v=ws.10).aspx</ActionScript>
    </Action>
  </Task>
</BES>
