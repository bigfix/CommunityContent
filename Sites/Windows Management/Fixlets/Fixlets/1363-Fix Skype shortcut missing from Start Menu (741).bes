<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Fix Skype shortcut missing from Start Menu
  ID       : 741
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T14:47:18
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Fix Skype shortcut missing from Start Menu</Title>
    <Description>Fix Skype shortcut missing from Start Menu </Description>
    <Relevance>(name of it = &quot;WinVista&quot; or name of it = &quot;Win7&quot;) of operating system</Relevance>
    <Relevance>exists key whose (value &quot;displayname&quot; of it as string contains &quot;Skype&quot; of it AND value &quot;displayname&quot; of it as string as lowercase does not contain &quot;Click to Call&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>(value &quot;DisplayIcon&quot; of key whose (value &quot;displayname&quot; of it as string contains &quot;Skype&quot; of it AND value &quot;displayname&quot; of it as string as lowercase does not contain &quot;Click to Call&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry) as string as lowercase contains &quot;Skype.exe&quot; as lowercase</Relevance>
    <Relevance>exists file ((value &quot;DisplayIcon&quot; of key whose (value &quot;displayname&quot; of it as string contains &quot;Skype&quot; of it AND value &quot;displayname&quot; of it as string as lowercase does not contain &quot;Click to Call&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry) as string)</Relevance>
    <Relevance>not exists file &quot;C:\ProgramData\Microsoft\Windows\Start Menu\Programs\Skype.lnk&quot; AND not exists file &quot;C:\ProgramData\Microsoft\Windows\Start Menu\Programs\Skype\Skype.lnk&quot;</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2011-08-04</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 04 Aug 2011 21:26:26 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[delete __appendfile
delete makeshortcut.vbs
appendfile   Set oWS = WScript.CreateObject("WScript.Shell")
appendfile   sLinkFile = "C:\ProgramData\Microsoft\Windows\Start Menu\Programs\Skype.lnk"
appendfile   Set oLink = oWS.CreateShortcut(sLinkFile)
appendfile   oLink.TargetPath = "{(value "DisplayIcon" of key whose (value "displayname" of it as string contains "Skype" of it AND value "displayname" of it as string as lowercase does not contain "Click to Call" as lowercase) of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry as string)}"
appendfile   '    oLink.Arguments = ""
appendfile   '    oLink.Description = "Skype"
appendfile   '    oLink.HotKey = ""
appendfile   '    oLink.IconLocation = "{(value "DisplayIcon" of key whose (value "displayname" of it as string contains "Skype" of it AND value "displayname" of it as string as lowercase does not contain "Click to Call" as lowercase) of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry as string)}, 2"
appendfile   '    oLink.WindowStyle = "1"
appendfile   '    oLink.WorkingDirectory = "{parent folder of file (value "DisplayIcon" of key whose (value "displayname" of it as string contains "Skype" of it AND value "displayname" of it as string as lowercase does not contain "Click to Call" as lowercase) of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry as string)}"
appendfile   oLink.Save
move __appendfile makeshortcut.vbs
waithidden "{pathname of system folder & "\cscript.exe"}" makeshortcut.vbs]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
