<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Set Default Profile Picture - Windows 10</Title>
    <Description><![CDATA[<P>Sets the default profile&nbsp;picture for all users in Windows 10.</P>
<P><STRONG>*** Files need to be the same picture, just different names ***</STRONG></P>]]></Description>
    <Relevance>true</Relevance>
    <Category>Bigfix.me</Category>
    <Source>Internal</Source>
    <SourceID>n0m4d1c</SourceID>
    <SourceReleaseDate>2018-10-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 09 Nov 2018 23:24:00 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//*********************************************************************
//	Insert prefetch for your PNG files
//*********************************************************************

delete &quot;C:\ProgramData\Microsoft\User Account Pictures\guest.png&quot;
delete &quot;C:\ProgramData\Microsoft\User Account Pictures\user.png&quot;
delete &quot;C:\ProgramData\Microsoft\User Account Pictures\user-32.png&quot;
delete &quot;C:\ProgramData\Microsoft\User Account Pictures\user-40.png&quot;
delete &quot;C:\ProgramData\Microsoft\User Account Pictures\user-48.png&quot;
delete &quot;C:\ProgramData\Microsoft\User Account Pictures\user-192.png&quot;

copy &quot;__Download\guest.png&quot; &quot;C:\ProgramData\Microsoft\User Account Pictures\guest.png&quot;
copy &quot;__Download\user.png&quot; &quot;C:\ProgramData\Microsoft\User Account Pictures\user.png&quot;
copy &quot;__Download\user-32.png&quot; &quot;C:\ProgramData\Microsoft\User Account Pictures\user-32.png&quot;
copy &quot;__Download\user-40.png&quot; &quot;C:\ProgramData\Microsoft\User Account Pictures\user-40.png&quot;
copy &quot;__Download\user-48.png&quot; &quot;C:\ProgramData\Microsoft\User Account Pictures\user-48.png&quot;
copy &quot;__Download\user-192.png&quot; &quot;C:\ProgramData\Microsoft\User Account Pictures\user-192.png&quot;

waithidden cmd.exe /C reg add &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer&quot; /v UseDefaultTile /t REG_DWORD /d 1 /f</ActionScript>
    </DefaultAction>
  </Task>
</BES>
