<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Enable SMBv1 Server - Windows 7, Windows Server 2008r2, Windows Vista, Windows Server 2008
  ID       : 24315
  Author   : brolly33
  Domain   : BESC
  Imported : 2017-05-15T11:05:11
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Enable SMBv1 Server - Windows 7, Windows Server 2008r2, Windows Vista, Windows Server 2008</Title>
    <Description><![CDATA[<P>To support WannaCry2.0 SMB workaround if you cannot apply MS17-010 patch.</P>
<P><A href="https://support.microsoft.com/en-us/help/2696547/how-to-enable-and-disable-smbv1,-smbv2,-and-smbv3-in-windows-vista,-windows-server-2008,-windows-7,-windows-server-2008-r2,-windows-8,-and-windows-server-2012">https://support.microsoft.com/en-us/help/2696547/how-to-enable-and-disable-smbv1,-smbv2,-and-smbv3-in-windows-vista,-windows-server-2008,-windows-7,-windows-server-2008-r2,-windows-8,-and-windows-server-2012</A></P>
<P>Recommended you apply MS17-010 using the published Fixlets.</P>]]></Description>
    <Relevance>(if( name of operating system starts with &quot;Win&quot; ) then platform id of operating system != 3 else false) AND (if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true )</Relevance>
    <Relevance>(name of it = &quot;Win2008R2&quot; OR name of it = &quot;Win2008&quot; or name of it = &quot;Win7&quot; or name of it = &quot;WinVista&quot;) of operating system</Relevance>
    <Relevance>not exists key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters&quot; whose (value &quot;SMB1&quot; of it as integer = 1) of (native registries)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2017-05-15</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 15 May 2017 17:28:12 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">regset &quot;[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters]&quot; &quot;SMB1&quot;=dword:00000001
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
