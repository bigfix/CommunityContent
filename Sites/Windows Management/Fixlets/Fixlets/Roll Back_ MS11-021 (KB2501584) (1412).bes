<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Roll Back: MS11-021 (KB2501584)</Title>
    <Description><![CDATA[<FONT face=Verdana color=#333333><FONT face=Verdana color=#333333><FONT face=Verdana color=#333333>
<P align=left><STRONG><FONT size=2>This&nbsp;task is to&nbsp;prevent the MS11-021 patch bug&nbsp;from causing Microsoft Excel to open slowly and or crash as defind in the following article:</FONT></STRONG></P>
<P align=left><FONT size=2>The Office File Validation Add-In for Office 2003 and Office 2007 has appeared on Microsoft</FONT></P>
<P align=left><FONT size=2>Update (</FONT></FONT></FONT></FONT><FONT face=Verdana color=#0065de><FONT face=Verdana color=#0065de><FONT face=Verdana color=#0065de size=2><A href="http://support.microsoft.com/kb/2501584/">KB2501584</A></FONT></FONT></FONT><FONT face=Verdana color=#333333><FONT face=Verdana color=#333333><FONT face=Verdana color=#333333><FONT size=2>) as an important update. However,&nbsp;it has a negative effect when opening large</FONT></P>
<P align=left><FONT size=2>.XLS files from network shares using Excel 2003. Some large files that have opened in&nbsp;seconds</FONT></P>
<P align=left><FONT size=2>before the add-in is installed now take ten minutes afterwards. The same file copied to the</FONT></P>
<P align=left><FONT size=2>local drive will open in&nbsp;seconds again. This is admitted in </FONT><A href="http://support.microsoft.com/kb/2501584/"><FONT size=2>KB2501584</FONT></A><FONT size=2> under known issues: "Opening files from a</FONT></P>
<P align=left><FONT size=2>network share that have many charts or points of data will take longer to open in Office</FONT></P>
<P><FONT size=2>2003".</FONT></P>
<P><STRONG><FONT size=2>Please see Microsoft Support article&nbsp;</FONT></STRONG><A href="http://support.microsoft.com/kb/2570623"><STRONG><FONT size=2>http://support.microsoft.com/kb/2570623</FONT></STRONG></A><STRONG><FONT size=2>&nbsp;for more information.</FONT></STRONG></P></FONT></FONT></FONT>]]></Description>
    <Relevance>((name of it = &quot;WinXP&quot;) AND service pack major version of it = 3) of operating system</Relevance>
    <Relevance>EXISTS regapp &quot;EXCEL.EXE&quot;</Relevance>
    <Relevance><![CDATA[version of regapp "EXCEL.EXE" <= "11" as version]]></Relevance>
    <Relevance>EXISTS value &quot;UninstallString&quot; OF key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{90140000-2005-0000-0000-0000000FF1CE}&quot; OF registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2011-07-25</SourceReleaseDate>
    <SourceSeverity>Important</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 01 Aug 2011 15:57:49 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">waithidden {pathname of system folder}\MsiExec.exe /X{{90140000-2005-0000-0000-0000000FF1CE} /qn</ActionScript>
    </DefaultAction>
  </Task>
</BES>
