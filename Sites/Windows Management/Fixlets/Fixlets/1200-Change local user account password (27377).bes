<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Change local user account password</Title>
    <Description><![CDATA[<P><LABEL for=secret><STRONG><FONT size=3>About this Task</FONT></STRONG></LABEL></P>
<BLOCKQUOTE style="MARGIN-RIGHT: 0px" dir=ltr>
<P><LABEL for=secret>This task changes a specified local&nbsp;user account password using a secure parameter.</LABEL></P>
<P><LABEL for=secret>This task is applicable on:&nbsp;Windows&nbsp;with version&nbsp;greater than 9.5&nbsp;of the BESClient.</LABEL></P></BLOCKQUOTE>
<P dir=ltr><LABEL for=secret><STRONG><FONT size=3>Action Description</FONT></STRONG></LABEL></P>
<UL dir=ltr>
<LI>
<DIV style="MARGIN-RIGHT: 0px"><LABEL for=secret><STRONG>Action1: Change specified local&nbsp;user account password.</STRONG></LABEL></DIV></LI></UL>
<BLOCKQUOTE style="MARGIN-RIGHT: 0px" dir=ltr>
<P style="MARGIN-RIGHT: 0px"><LABEL for=secret>This action prompts for an existing&nbsp;local user account name and changes&nbsp;its password to the value specified in the "Password" field under "Customization Options".</LABEL></P></BLOCKQUOTE>
<P style="MARGIN-RIGHT: 0px" dir=ltr><LABEL for=secret><STRONG><FONT color=#008000 size=3>Customization Options</FONT></STRONG></LABEL></P>
<BLOCKQUOTE style="MARGIN-RIGHT: 0px" dir=ltr>
<P><LABEL for=secret>Password:</LABEL> <INPUT id=secret type=password name=secret>
<P><LABEL for=secret2>Verify password:</LABEL> <INPUT id=secret2 type=password name=secret2><script>document.body.ontakeaction = function () {
    var theSecret = document.getElementById("secret").value;
    var theSecret2 = document.getElementById("secret2").value;

    if (!theSecret || !theSecret2) {
        alert("Password fields cannot be left blank. Please enter a password in the Description tab.");
        return false;
    } else if (theSecret !== theSecret2) {
        alert("Passwords do not match. Please re-enter matching passwords in the Description tab.");
        return false;
    } else {
        TakeSecureFixletAction(
            Relevance('id of current fixlet'),
            Relevance('id of current bes site'),
            "Action1",
            {},
            { secret: theSecret }
        );
    }

    return false;
};</script> </P></BLOCKQUOTE>
<P dir=ltr><STRONG><FONT color=#ff0000 size=3>Important Notes</FONT></STRONG></P>
<UL dir=ltr>
<LI>
<DIV>You must enter a password in order to take an action</DIV>
<LI>
<DIV>Because of the way secure parameters work, you cannot use this task in&nbsp;a baseline, target an action dynamically by property (e.g., automatic groups), use add additional actions.</DIV></LI></UL>
<P>This fixlet is based on the following post on bigfix.me:<BR><A href="https://bigfix.me/fixlet/details/3670">https://bigfix.me/fixlet/details/3670</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[version of client >= "9.5"]]></Relevance>
    <Relevance>not exists service &quot;NTDS&quot;</Relevance>
    <Category>Accounts</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2025-07-23</SourceReleaseDate>
    <MIMEField>
      <Name>bigfixme-ID</Name>
      <Value>6076</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-modification-time</Name>
      <Value>Fri, 15 May 2015 06:54:17 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-added-time</Name>
      <Value>Fri, 15 May 2015 06:54:17 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-keywords</Name>
      <Value>password secure parameters verification</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 23 Jul 2025 12:18:08 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink></PreLink>
        <Link>Change</Link>
        <PostLink>&amp;nbsp;specified local&amp;nbsp;user account password.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action parameter query &quot;username&quot; with description &quot;Please specify the name of an existing local user account&quot;

if {exists ((name of it as string as lowercase) of users) whose (it as string as lowercase contains parameter &quot;username&quot; of action)}

waithidden &quot;C:\Windows\System32\net.exe&quot; user {parameter &quot;username&quot; of action} {parameter &quot;secret&quot; of action}

continue if {exit code of action = 0}
else
exit 1
endif
</ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
