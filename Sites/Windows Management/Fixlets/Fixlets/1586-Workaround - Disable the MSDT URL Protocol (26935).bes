<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Workaround - Disable the MSDT URL Protocol</Title>
    <Description>Workaroud provided by Microsoft for CVE-2022-30190. </Description>
    <Relevance><![CDATA[(version of client >= "6.0.0.0") AND (exists true whose (if true then (exists (operating system) whose (it as string as lowercase contains "win" as lowercase)) else false))]]></Relevance>
    <Relevance>exists key &quot;HKEY_CLASSES_ROOT\ms-msdt&quot; of registry</Relevance>
    <Category>Workaround</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2022-06-01</SourceReleaseDate>
    <CVENames>CVE-2022-30190</CVENames>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 01 Jun 2022 02:39:09 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">dos reg export HKEY_CLASSES_ROOT\ms-msdt C:\ms-msdt_bak
dos reg delete HKEY_CLASSES_ROOT\ms-msdt /f</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
