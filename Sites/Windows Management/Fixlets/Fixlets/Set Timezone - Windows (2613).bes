    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink></PreLink>
        <Link>Set to Eastern Time.</Link>
        <PostLink></PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait cmd.exe /C tzutil /s &quot;Eastern Standard Time&quot;</ActionScript>
    </DefaultAction>
    <Action ID="Action2868">
      <Description>
        <PreLink></PreLink>
        <Link>Set to custom timezone.</Link>
        <PostLink>&amp;nbsp;</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action parameter query &quot;Timezone&quot; with description &quot;Please type the timezone that you&apos;d like to set. Use the list from the fixlet details.&quot;

wait cmd.exe /C tzutil /s &quot;{parameter &quot;Timezone&quot; of action}&quot;</ActionScript>
    </Action>
    <Action ID="Action2869">
      <Description>
        <PreLink></PreLink>
        <Link>Set to Central Time.</Link>
        <PostLink></PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait cmd.exe /C tzutil /s &quot;Central Standard Time&quot;</ActionScript>
    </Action>
    <Action ID="Action2870">
      <Description>
        <PreLink></PreLink>
        <Link>Set to Mountain Time.</Link>
        <PostLink></PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait cmd.exe /C tzutil /s &quot;Mountain Standard Time&quot;</ActionScript>
    </Action>
    <Action ID="Action2871">
