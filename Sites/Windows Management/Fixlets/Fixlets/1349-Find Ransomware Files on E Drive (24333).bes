<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Find Ransomware Files on E Drive</Title>
    <Description><![CDATA[Find files with specified extension on&nbsp;E drive. ]]></Description>
    <Relevance>name of operating system starts with &quot;Win&quot;</Relevance>
    <Relevance>exists folder &quot;e:\&quot;</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-04</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 16 May 2017 02:39:33 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[waithidden cmd /c if exist e:\ransomware_list.txt del e:\ransomware_list.txt /q /f
waithidden cmd /c dir e:\*.wn e:\*.wcry /a /s >e:\ransomware_list.txt]]></ActionScript>
    </DefaultAction>
  </Task>
</BES>
