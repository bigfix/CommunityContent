<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Wifi + LAN Detect and enable</Title>
    <Description><![CDATA[Detects if there is no longer an active LAN network connection and a&nbsp;disabled WIFI network connection. If the LAN connection is gone,&nbsp;the action will enable the WIFI adapter. ]]></Description>
    <Relevance>(exists  select &quot;netconnectionid from win32_NetworkAdapter where NetEnabled = &apos;FALSE&apos; and PhysicalAdapter=&apos;TRUE&apos; and ServiceName = &apos;NETwNb64&apos;&quot; whose (string value of it != &quot;&quot;) of WMI) AND (NOT exists adapter whose (not exists wifi of it and gateway of it as string!= &quot;0.0.0.0&quot; and address of it as string!= &quot;0.0.0.0&quot;) of network)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2017-08-08</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 08 Aug 2017 20:10:19 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//Alpha code - does not accomodate multiple wifi adapters
wait netsh interface set interface &quot;{string value of select &quot;netconnectionid from win32_NetworkAdapter where NetEnabled = &apos;FALSE&apos; and PhysicalAdapter=&apos;TRUE&apos; and  ServiceName = &apos;NETwNb64&apos;&quot; of WMI}&quot; admin=enable
wait ipconfig /release
wait ipconfig /renew</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
