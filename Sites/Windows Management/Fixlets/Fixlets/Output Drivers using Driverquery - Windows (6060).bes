  Imported : 2015-05-12T11:58:47
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Output Drivers using Driverquery - Windows</Title>
    <Description><![CDATA[<P>This task will dump the details of the installed windows drivers to log files, which can be reported on using relevance.</P>
<P>&nbsp;</P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>not exists files whose(name of it as lowercase starts with &quot;info_driverquery_&quot; AND name of it as lowercase ends with &quot;.csv&quot;) of folders &quot;Logs&quot; of folders &quot;__Global&quot; of ( (if (exists properties whose(it as string starts with &quot;data folder of &quot; AND it as string contains &quot;client&quot;)) then (data folder of client) else NULL)|(folder &quot;/var/opt/BESClient/__BESData&quot;)|(folder &quot;/Library/Application Support/BigFix/BES Agent/__BESData&quot;)|(folder &quot;__BESData&quot; of parent folder of client) )</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2014-03-28</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 12 May 2015 18:58:07 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// delete "{pathname of client folder}\__BESData\__Global\Logs\driverquery.csv"
dos driverquery /V /fo CSV > "{pathname of folders "Logs" of folders "__Global" of ( (if (exists properties whose(it as string starts with "data folder of " AND it as string contains "client")) then (data folder of client) else NULL)|(folder "/var/opt/BESClient/__BESData")|(folder "/Library/Application Support/BigFix/BES Agent/__BESData")|(folder "__BESData" of parent folder of client) )}\info_driverquery_verbose.csv"
dos driverquery /SI /fo CSV > "{pathname of folders "Logs" of folders "__Global" of ( (if (exists properties whose(it as string starts with "data folder of " AND it as string contains "client")) then (data folder of client) else NULL)|(folder "/var/opt/BESClient/__BESData")|(folder "/Library/Application Support/BigFix/BES Agent/__BESData")|(folder "__BESData" of parent folder of client) )}\info_driverquery_signed.csv"
]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
