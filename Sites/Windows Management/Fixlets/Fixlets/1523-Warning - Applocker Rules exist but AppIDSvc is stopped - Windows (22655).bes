  Imported : 2016-11-22T09:18:58
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - Applocker Rules exist but AppIDSvc is stopped - Windows</Title>
    <Description><![CDATA[<P>There are Applocker rules defined but the AppIDSvc is stopped! This means rules&nbsp;may be <STRONG>ENFORCED</STRONG>.</P>
<P>For general information or to report issues with C3 Protect content please visit GitHub here: <A href="https://github.com/strawgate/C3-Protect">https://github.com/strawgate/C3-Protect</A></P>]]></Description>
    <Relevance>state of service &quot;AppIDSvc&quot; != &quot;Running&quot;</Relevance>
    <Relevance>exists keys of key &quot;HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\SrpV2&quot; of native registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-17</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:19:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action23648">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait sc config AppIDSvc start= auto
wait net start AppIDSvc</ActionScript>
    </Action>
  </Fixlet>
</BES>
