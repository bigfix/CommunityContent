<!--
  BigFix Fixlet Export

  Title    : BigTweet Scheduled Task Setup v2.1
  ID       : 6113
  Author   : menglish
  Domain   : BES
  Imported : 2015-06-26T08:56:15
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>BigTweet Scheduled Task Setup v2.1</Title>
    <Description><![CDATA[<P><STRONG><FONT size=3>Action&nbsp;Parameters:</FONT></STRONG></P>
<P>&nbsp;<INPUT onfocus="if (this.value == 'OP Name') {this.value = '';}" onblur="if (this.value == '') {this.value = 'OP Name';}" id=RemoteOP title="Enter the Exporting IEM Server Operator Name" value="OP Name" name=RemoteOP>&nbsp;<FONT color=#0080ff><STRONG>&lt;&lt;&nbsp;</STRONG></FONT> Enter the&nbsp;IEM Server Operator Name<BR>&nbsp;<INPUT id=RemoteOPPass title="Enter the Exporting IEM Server Operator Password" type=password name=RemoteOPPass>&nbsp;&nbsp; <FONT color=#0080ff><STRONG>&lt;&lt;</STRONG></FONT>&nbsp; Enter the&nbsp;IEM Server Operator Password&nbsp;<BR>&nbsp;<INPUT onfocus="if (this.value == 'bigfix\administrator') {this.value = '';}" onblur="if (this.value == '') {this.value = 'bigfix\administrator';}" id=TaskAdmin title="Enter the account to run the scheduled task" value=bigfix\administrator name=TaskAdmin>&nbsp;<FONT color=#0080ff><STRONG>&lt;&lt;&nbsp;</STRONG></FONT> Enter the account name to run the scheduled task<BR>&nbsp;<INPUT id=TaskPass title="Enter the account password to run the scheduled task" type=password name=TaskPass>&nbsp;&nbsp; <FONT color=#0080ff><STRONG>&lt;&lt;</STRONG></FONT>&nbsp; Enter the account password to run the scheduled task<BR><script>
			document.body.ontakeaction = function() {
				var theRemoteOP = document.getElementById( "RemoteOP" ).value;
				var theRemoteOPPass = document.getElementById( "RemoteOPPass" ).value;
				var theTaskAdmin = document.getElementById( "TaskAdmin" ).value;
				var theTaskPass = document.getElementById( "TaskPass" ).value;
				TakeSecureFixletAction( Relevance('id of current fixlet'), Relevance('id of current bes site'), "Action1", {}, { RemoteOP: theRemoteOP , RemoteOPPass: theRemoteOPPass , TaskAdmin: theTaskAdmin , TaskPass: theTaskPass } );
				return false;
			}
			</script><BR><STRONG>_____________________________________________________________________________________________________</STRONG> </P>
<P><STRONG><FONT size=4>BigTweet</FONT></STRONG></P><SPAN lang=EN><FONT size=3 face=Calibri><FONT size=3 face=Calibri>
<P dir=ltr align=left>This requires two tasks. 1)BigTweet Scheduled Task Setup v2.1 & 2)BigTweet v2.1</P>
<P dir=ltr align=left>BigTweet allows you to interface with Twitter and their free highly scalable SMS system for notifications.</P>
<P dir=ltr align=left>This example will use a BigFix Rest API Query within a scheduled task&nbsp;to report on the number of fixlets that are relevant in a specific site. If relevant fixlets are found, it will send a tweet (using twt) which will notify you via text messaging.</P><B>
<P dir=ltr align=left>Setup:</P>
<UL></B>
<P dir=ltr align=left>
<LI>Twitter SMS Relay Account
<UL>
<LI>Create a Twitter Account used for relaying SMS (example @BigTweet111)
<LI>Under Account Settings, set ‘Tweet privacy’ to ‘Protect my Tweets’
<P></P></LI></UL>
<P dir=ltr align=left></P>
<LI>BigFix Server
<UL>
<LI>Create the directory ‘c:\BigTweet’
<LI>Download and install .net 4 </FONT></FONT></SPAN><A href="http://www.microsoft.com/en-us/download/details.aspx?id=17851"><FONT size=3 face=Calibri><FONT size=3 face=Calibri><SPAN lang=EN><FONT color=#000080>http://www.microsoft.com/en-us/download/details.aspx?id=17851</FONT></FONT></FONT></SPAN></A>
<P><FONT color=#000080></FONT></P></LI></UL><FONT size=3 face=Calibri><FONT size=3 face=Calibri><SPAN lang=EN>
<P dir=ltr align=left><FONT color=#000080></FONT></P>
<LI>TWT
<UL>
<LI>Download twt </FONT></FONT></SPAN><A href="https://code.google.com/p/twt/"><FONT size=3 face=Calibri><FONT size=3 face=Calibri><SPAN lang=EN><FONT color=#800080>https://code.google.com/p/twt/</FONT></FONT></FONT></SPAN></A>
<LI><FONT size=3 face=Calibri><FONT size=3 face=Calibri><SPAN lang=EN>Extract binary and xml configuration file to ‘c:\BigTweet’</SPAN></FONT></FONT>
<LI><FONT size=3 face=Calibri><FONT size=3 face=Calibri><SPAN lang=EN>Configure OAUTH against your Twitter SMS Relay Account using command twt –config
<P></P></LI></UL>
<P dir=ltr align=left></P>
<LI>Twitter Follow Accounts
<UL>
<LI>In order to receive these Twitter SMS Notifications, users must follow the Twitter SMS Relay Account and turn on Mobile Notifications for this user.</SPAN></LI></UL></LI></UL>
<P><STRONG><FONT color=#ff0000>Note:</FONT></STRONG> By Default, this is scheduled to run once every hour.&nbsp;</P></FONT></FONT>]]></Description>
    <Relevance>exists main gather service</Relevance>
    <Relevance><![CDATA[version of client >= "9.0"]]></Relevance>
    <Relevance>(name of operating system starts with &quot;Win&quot;)</Relevance>
    <Category>IEM Maintenance</Category>
    <Source>mike.english@us.ibm.com</Source>
    <SourceReleaseDate>2015-06-24</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 24 Jun 2015 17:01:55 +0000</Value>
    </MIMEField>
    <Domain>BES </Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[action parameter query "sitename" with description "Please enter the site name to check relevant fixlets against:" with default value "Enterprise Security"

//Check for C:\BigTweet
if {not exist folder "C:\BigTweet"}
	dos mkdir "C:\BigTweet"
endif

//Create BigTweet Batfile
delete __appendfile

//login to API and obtain query results
appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\IEM CLI\iem.exe%22"} login -q --server=localhost --user={parameter "RemoteOP" of action} --password={parameter "RemoteOPPass" of action}

appendfile {preceding text of last "\" of (expand environment string of (image path of service "FILLDB")) & "\IEM CLI\iem.exe%22"} get query --relevance "sum of (Applicable Computer Count of it as integer) of bes fixlets whose ((name of site of it = ""{parameter "sitename" of action}"") AND ((Applicable Computer Count of it > 0)))" > "C:\BigTweet\alert.xml"

delete "c:\BigTweet\bigtweet.bat"
copy __appendfile "c:\BigTweet\bigtweet.bat"

//Create Scheduled Task
dos schtasks /create /sc hourly /mo 1 /tn "BigTweet_{parameter "sitename" of action}" /tr "c:\BigTweet\bigtweet.bat" /ru {parameter "TaskAdmin" of action} /rp {parameter "TaskPass" of action}]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
