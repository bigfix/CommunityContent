<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Replace IP in hosts file on Windows</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2022-10-13</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 13 Oct 2022 12:33:37 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[parameter "OldAddress" = "192.168.1.1"
parameter "NewAddress" = "192.168.1.2"

createfile until end
{ ( (if (it contains (parameter "OldAddress" of action as string & " ") ) then ( ( (parameter "NewAddress" of action as string & " ") & substring after (parameter "OldAddress" of action as string) of it) & "%0D%0A") else it & "%0D%0A") ) of ( (concatenation "    " of substrings separated by "%09" of it) of ( (lines of file "C:\Windows\System32\drivers\etc\hosts") as string) ) }
end


delete "C:\Windows\System32\drivers\etc\hosts_old"
move "C:\Windows\System32\drivers\etc\hosts" "C:\Windows\System32\drivers\etc\hosts_old"
move __createfile "C:\Windows\System32\drivers\etc\hosts"]]></ActionScript>
    </DefaultAction>
  </Task>
</BES>
