<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Delete Identity Finder temp file if one exists over 2GB in size
  ID       : 1415
  Author   : jgstew
  Domain   : BESC
  Imported : 2013-03-11T16:09:32
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Delete Identity Finder temp file if one exists over 2GB in size</Title>
    <Description><![CDATA[<P>WARNING: This fixlet should not be used without first investigating the cause, as it should not ever be relevant unless there is a problem. This fixlet was created to deal with a specific issue where Identity Finder left behind temp files over 10GB in size on many machines and this was used to clean it up. This is not normal or typical behavior, so any machine reporting as relevant should be investigated. If for some reason there is more than 1 file over 2GB in the user's IDF temp folder then it will report back as failed even though it deleted one of them since there will still be another. It will take multiple runs to clear it up if that is the case.</P>
<P>This fixlet will delete an Identity Finder (IDF) temp file if there is one that is over 2GB in size. This is to address a specific issue that was experienced with Identity Finder that most likely no longer applies. This will not be relevant on most computers and only be relevant if there is at least one IDF temp file over 2GB in size located in the user's temp folder for IDF. This fixlet does not clear out all Identity Finder temp files. </P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists folder &quot;users&quot; of drive of system folder</Relevance>
    <Relevance><![CDATA[(2*1024*1024*1024) < size of descendant whose(size of it = maximum of sizes of descendants of folders "AppData\Local\Temp\Identity Finder\Identity Finder" of folders whose (exists folder "AppData\Local\Temp\Identity Finder\Identity Finder" of it) of folder "users" of drive of system folder) of folders "AppData\Local\Temp\Identity Finder\Identity Finder" of folders whose (exists folder "AppData\Local\Temp\Identity Finder\Identity Finder" of it) of folder "users" of drive of system folder]]></Relevance>
    <Relevance>exists folders &quot;AppData\Local\Temp\Identity Finder\Identity Finder&quot; of folders of folders of folder &quot;users&quot; of drive of system folder</Relevance>
    <Relevance>not exists running application whose(name of it = &quot;IdentityFinder.exe&quot;)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2012-10-08</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 11 Mar 2013 20:55:36 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">delete &quot;{pathname of descendant whose(size of it = maximum of sizes of descendants of folders &quot;AppData\Local\Temp\Identity Finder\Identity Finder&quot; of folders whose (exists folder &quot;AppData\Local\Temp\Identity Finder\Identity Finder&quot; of it) of folder &quot;users&quot; of drive of system folder) of folders &quot;AppData\Local\Temp\Identity Finder\Identity Finder&quot; of folders whose (exists folder &quot;AppData\Local\Temp\Identity Finder\Identity Finder&quot; of it) of folder &quot;users&quot; of drive of system folder}&quot;</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
