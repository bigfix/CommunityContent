delete __Download\screenCapture.bat
move __createfile __Download\screenCapture.bat
delete __Download\screenCapture.exe
action uses wow64 redirection {not x64 of operating system}
// reference:  https://forum.bigfix.com/t/trying-to-run-a-linux-sh-script-in-a-bigfix-action/17748/6  (using cd &&)
waithidden cmd /c cd __Download && screenCapture.bat
delete {parameter "CurrentUserTempFolder"}\screenCapture.exe
copy __Download\screenCapture.exe {parameter "CurrentUserTempFolder"}\screenCapture.exe

// take screenshot of currently active window
//override wait
//hidden=true
//runas=currentuser
//wait {parameter "CurrentUserTempFolder"}\screenCapture.exe {parameter "CurrentUserTempFolder"}\ScreenShotActiveWindow.png ""
//delete __Download\ScreenShotActiveWindow.png
//move {parameter "CurrentUserTempFolder"}\ScreenShotActiveWindow.png __Download\ScreenShotActiveWindow.png

// take screenshot of fullscreen
override wait
hidden=true
runas=currentuser
wait {parameter "CurrentUserTempFolder"}\screenCapture.exe {parameter "CurrentUserTempFolder"}\ScreenShot.png
delete __Download\ScreenShot.png
move {parameter "CurrentUserTempFolder"}\ScreenShot.png __Download\ScreenShot.png

// Clean up
delete {parameter "CurrentUserTempFolder"}\screenCapture.exe

delete __Download\ScreenShot.png.base64
waithidden powershell -ExecutionPolicy Bypass -command "[convert]::ToBase64String((get-content '{ pathname of download file "ScreenShot.png" }' -encoding byte)) | set-content( '__Download\ScreenShot.png.base64' )"
delete "{pathname of folders "Logs" of folders "__Global" of data folders of client}\ScreenShot.png.base64"
copy __Download\ScreenShot.png.base64 "{pathname of folders "Logs" of folders "__Global" of data folders of client}\ScreenShot.png.base64"
notify client ForceRefresh

// http://optipng.sourceforge.net/  PNG optimizer
