-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Enable Microsoft-Windows-Subsystem-Linux (Ubuntu BASH) - Windows Features</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>x64 of operating system</Relevance>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists values whose(&quot;Microsoft-Windows-Subsystem-Linux&quot; = name of it AND it as string as integer = 255) of keys &quot;Updates&quot; of keys of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\Packages&quot; of (x64 registries; x32 registries)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-20</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sat, 21 May 2016 04:58:23 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// disable wow64 redirection if x64 bit OS
action uses wow64 redirection {not x64 of operating system}

// https://www.raymond.cc/blog/add-or-remove-windows-features-through-the-command-prompt/
// dism /online /get-features
// dism /online /Get-FeatureInfo /FeatureName:Microsoft-Windows-Subsystem-Linux
//Feature Name : Microsoft-Windows-Subsystem-Linux
//Display Name : Windows Subsystem for Linux (Beta)
//Description : Provides services and environments for running native user-mode Linux shells and tools on Windows.
//Restart Required : Required


// http://www.infralib.com/2013/02/running-64bit-cmd-via-32bit-sccm-client/
waithidden &quot;{pathname of system folder}\dism.exe&quot; /NoRestart /Quiet /online /enable-feature /FeatureName:Microsoft-Windows-Subsystem-Linux

// Restart Required
action requires restart

//  Raw Registry Location:
// HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\Packages\Microsoft-Windows-Lxss-Optional-Package~31bf3856ad364e35~amd64~~10.0.14342.1000\Updates
//  Related:
// https://bigfix.me/fixlet/details/823
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
