-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Configuration: Allow Windows Update to be used for Installing Features - Windows 8 or later TODO</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[version of operating system >= "6.2"]]></Relevance>
    <Relevance>not exists values &quot;RepairContentServerSource&quot; whose(it as string = &quot;2&quot;) of keys &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Servicing&quot; of (x64 registries;x32 registries)</Relevance>
    <Category>Configuration</Category>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2015-01-13</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 13 Jan 2015 20:26:58 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
//  http://msdn.microsoft.com/en-us/library/hh506443%28v=vs.110%29.aspx
//  http://support.microsoft.com/kb/900935
//  http://technet.microsoft.com/en-us/library/hh825020.aspx
//  http://community.spiceworks.com/how_to/show/30581-install-net-3-5-on-windows-8
//  http://blogs.technet.com/b/yungchou/archive/2013/12/19/windows-server-2012-r2-installation-options-and-features-on-demand-part-2-of-5.aspx
//  https://www.vanstechelman.eu/windows-group-policy-encyclopedia/fbb6a5344049e798501f7b5a273784e6/specify-settings-for-optional-component-installation-and-component
//  http://windowsitpro.com/article/windowsserver2012/set-central-wim-file-145040
//  http://windowsitpro.com/article/windowsserver2012/add-net-framework-35-vhd-145039
//  http://www.howtogeek.com/116184/how-to-see-which-group-policies-are-applied-to-your-pc-and-user-account/
//  http://technet.microsoft.com/en-us/library/dn482065.aspx
//  http://msdn.microsoft.com/en-us/library/hh506443(v=vs.110).aspx
//  http://msdn.microsoft.com/en-us/library/windows/desktop/hh848079(v=vs.85).aspx
//  http://blogs.technet.com/b/joscon/archive/2013/03/29/features-on-demand-part-2.aspx


//   netsh winhttp set proxy proxyservername:portnumber


// Set reg to allow WU to be contacted directly
regset   &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Servicing]&quot; &quot;RepairContentServerSource&quot;=dword:00000002
regset64 &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Servicing]&quot; &quot;RepairContentServerSource&quot;=dword:00000002
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
