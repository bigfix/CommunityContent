<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Update: Debug Diagnostic Tool v2 Update 1 - Windows</Title>
    <Description><![CDATA[<P>This task will deploy: Debug Diagnostic Tool v2 Update 1.</P>
<P>&nbsp;</P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance><![CDATA[not exists keys whose(value "DisplayName" of it as string contains "Debug Diagnostics" AND value "DisplayVersion" of it as string as version >= "2.1.0.7") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries;x32 registries)]]></Relevance>
    <Category>Software Distribution</Category>
    <Source>Software Distribution Wizard</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2014-06-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 12 May 2015 19:23:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here </Link>
        <PostLink>to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//  http://download.microsoft.com/download/B/4/6/B46E9984-5DF2-4B56-AE32-D60A88C2A6D8/DebugDiagx86.msi
//  http://download.microsoft.com/download/B/4/6/B46E9984-5DF2-4B56-AE32-D60A88C2A6D8/DebugDiagx64.msi

begin prefetch block
	if{x64 of operating system}
		add prefetch item name=DebugDiag.msi sha1=e50ba364d41a0db7a8055345892164832858fe81 size=22421504 url=http://download.microsoft.com/download/B/4/6/B46E9984-5DF2-4B56-AE32-D60A88C2A6D8/DebugDiagx64.msi
	else
		add prefetch item name=DebugDiag.msi sha1=627f063bb42e9016ddc0eee27db57e1f694154c7 size=17412096 url=http://download.microsoft.com/download/B/4/6/B46E9984-5DF2-4B56-AE32-D60A88C2A6D8/DebugDiagx86.msi
	endif
end prefetch block

wait "{pathname of system folder & "\msiexec.exe"}" /i "{(pathname of client folder of current site) & "\__Download\DebugDiag.msi"}" /qn /norestart
]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
