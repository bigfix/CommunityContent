<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Warning - Applocker Application Identity service may not be running
  ID       : 22654
  Author   : strawgate
  Domain   : BESC
  Imported : 2016-11-22T09:18:50
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - Applocker Application Identity service may not be running</Title>
    <Description><![CDATA[<P>This fixlet will be applicable on machines that do not have the application identity service running.</P>
<P>The Application Identity Service is required for Applocker to work.</P>
<P>For general information or to report issues with C3 Protect content please visit GitHub here: <A href="https://github.com/strawgate/C3-Protect">https://github.com/strawgate/C3-Protect</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>NOT in proxy agent context</Relevance>
    <Relevance>(product info string of operating system = &quot;Enterprise&quot; or product info string of operating system = &quot;Server&quot;)</Relevance>
    <Relevance>state of service &quot;AppIDSvc&quot; != &quot;Running&quot;</Relevance>
    <Category>Application Whitelisting</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-04-19</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:19:03 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action23647">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait sc config AppIDSvc start= auto
wait net start AppIDSvc</ActionScript>
    </Action>
  </Fixlet>
</BES>
