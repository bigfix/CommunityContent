<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Custom Task - Add account to local administrators</Title>
    <Description><![CDATA[<P><STRONG><FONT size=4>Add Account to Local Admin</FONT></STRONG></P>
<P>This action will prompt you for the domain and username you would like to add to the local administrators group. This prompt occurs before you select the computers you will target with the action.</P>
<P>Please enter this in the following&nbsp;format without quotes: <FONT color=#800040><STRONG>DOMAIN\admin_username</STRONG></FONT></P>
<P><FONT color=#800040><FONT color=#000000>Example: </FONT></FONT><FONT color=#800040><STRONG>TESTDOMAIN\admin_abc123</STRONG></FONT></P>
<P><STRONG>Note: Check your spelling!&nbsp; Take care to apply to the computer you mean to!</STRONG></P>
<P>This task should report completed once the username can be found in&nbsp;the administrators group.</P>]]></Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;Win2003&quot; AND NOT x64 of it) OR (name of it = &quot;Win2003&quot; AND x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR ((name of it = &quot;Win2008&quot; or (name of it = &quot;WinVista&quot; and product type of it != nt workstation product type)) AND NOT x64 of it) OR ((name of it = &quot;Win2008&quot; or (name of it = &quot;WinVista&quot; and product type of it != nt workstation product type)) AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it) OR name of it = &quot;Win2008R2&quot; OR name of it = &quot;WinXPe&quot; OR name of it = &quot;Win8&quot; OR (name of it = &quot;Win8&quot; AND x64 of it)) of operating system AND TRUE</Relevance>
    <Source>Internal</Source>
    <SourceID>swi101</SourceID>
    <SourceReleaseDate>2013-09-06</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 11 Sep 2013 13:02:03 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action parameter query &quot;DomainAndUsername&quot; with description &quot;Please specify the DOMAIN\admin_username to add to Administrators&quot;

waithidden &quot;C:\Windows\System32\net.exe&quot; localgroup administrators {parameter &quot;DomainAndUsername&quot; of action} /add</ActionScript>
      <SuccessCriteria Option="CustomRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
