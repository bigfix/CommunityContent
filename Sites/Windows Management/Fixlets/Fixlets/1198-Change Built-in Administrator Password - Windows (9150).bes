<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Change Built-in Administrator Password - Windows</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[exists users whose( exists (it as lowercase) whose(it = "administrator") of names of it AND exists password ages whose(it = 0 * second OR it > 8 * day) of it)]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-02-16</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 16 Feb 2016 22:18:01 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
// Related: https://bigfix.me/fixlet/details/3670
// https://forum.bigfix.com/t/newer-actionscript-commands/11677

parameter &quot;username&quot; = &quot;administrator&quot;

// http://www-01.ibm.com/support/knowledgecenter/SS63NW_9.2.0/com.ibm.tivoli.tem.doc_9.2/Platform/Action/c_action_log.html
action log command

waithidden net user {parameter &quot;username&quot;} { sha256 of concatenation &quot;&quot; of (it as string) of ( (it / second) of uptime of operating system ; (it / second) of (now - (&quot;01 Jan 1970 00:00:00&quot; as universal time)) ) }

continue if {exit code of action = 0}
</ActionScript>
    </DefaultAction>
  </Task>
</BES>
