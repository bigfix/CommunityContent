<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Enable SMBv1 protocols on the SMB client - Windows Vista, Windows Server 2008, Windows 7, Windows Server 2008 R2, Windows 8, and Windows Server 2012
  ID       : 24317
  Author   : brolly33
  Domain   : BESC
  Imported : 2017-05-15T12:11:02
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Enable SMBv1 protocols on the SMB client - Windows Vista, Windows Server 2008, Windows 7, Windows Server 2008 R2, Windows 8, and Windows Server 2012</Title>
    <Description><![CDATA[<P>To support WannaCry2.0 SMB workaround if you cannot apply MS17-010 patch.</P>
<P><A href="https://support.microsoft.com/en-us/help/2696547/how-to-enable-and-disable-smbv1,-smbv2,-and-smbv3-in-windows-vista,-windows-server-2008,-windows-7,-windows-server-2008-r2,-windows-8,-and-windows-server-2012">https://support.microsoft.com/en-us/help/2696547/how-to-enable-and-disable-smbv1,-smbv2,-and-smbv3-in-windows-vista,-windows-server-2008,-windows-7,-windows-server-2008-r2,-windows-8,-and-windows-server-2012</A></P>
<P>Recommended you apply MS17-010 using the published Fixlets.<BR></P>]]></Description>
    <Relevance>(if( name of operating system starts with &quot;Win&quot; ) then platform id of operating system != 3 else false) AND (if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true )</Relevance>
    <Relevance>(name of it = &quot;Win2008R2&quot; OR name of it = &quot;Win2008&quot; or name of it = &quot;Win7&quot; or name of it = &quot;WinVista&quot; or name of it = &quot;Win2012&quot; or name of it = &quot;Win8&quot;) of operating system</Relevance>
    <Relevance>not exists key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\services\LanmanWorkstation&quot; whose (exists value &quot;DependOnService&quot; whose (it as string as lowercase contains &quot;MRxSmb10&quot; as lowercase)of it) of native registry</Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\services\mrxsmb10&quot; whose (value &quot;Start&quot; of it = 4) of native registry</Relevance>
    <Category>workaround</Category>
    <Source>brolly33</Source>
    <SourceReleaseDate>2017-05-15</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 15 May 2017 18:54:46 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Enter your action script here
wait sc.exe config lanmanworkstation depend= bowser/mrxsmb10/mrxsmb20/nsi
wait sc.exe config mrxsmb10 start= manual</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
