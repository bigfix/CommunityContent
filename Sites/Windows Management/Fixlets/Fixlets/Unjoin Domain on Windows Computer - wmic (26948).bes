<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Unjoin Domain on Windows Computer - wmic</Title>
    <Description><![CDATA[This Task will change the computer name of a Windows computer.&nbsp; This is valid only for clients that are not joined to a Domain. ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>if exists property &quot;in proxy agent context&quot; then not in proxy agent context else true</Relevance>
    <Relevance>exists netbios domainnames of local computers of active directories</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2019-05-20</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 04 Oct 2019 17:39:01 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action uses wow64 redirection false
waithidden wmic.exe computersystem where name!=null call unjoindomainorworkgroup
action requires restart RenameComputer</ActionScript>
    </DefaultAction>
  </Task>
</BES>
