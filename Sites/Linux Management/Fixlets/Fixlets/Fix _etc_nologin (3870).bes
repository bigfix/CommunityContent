<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Fix /etc/nologin
  ID       : 3870
  Author   : sinucus
  Domain   : BESC
  Imported : 2014-10-09T06:53:24
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Fix /etc/nologin</Title>
    <Description></Description>
    <Relevance>exists file &quot;/etc/redhat-release&quot; whose (exists line whose (exists match (regex &quot;Red Hat Enterprise Linux (Client|Server) release 5&quot;) of it) of it) AND NOT exists file &quot;/etc/vmware-release&quot; whose (exists line whose (it contains &quot;VMware ESX&quot;) of it) AND not exists file &quot;/etc/enterprise-release&quot; whose (exists line whose (it contains &quot;Enterprise Linux Enterprise Linux&quot;) of it) AND (if exists property &quot;in proxy agent context&quot; then (not in proxy agent context) else true) AND (if exists property &quot;android&quot; of type &quot;operating system&quot; then (not android of operating system) else true)</Relevance>
    <Relevance><![CDATA[version of client >= "7.2.4.75"]]></Relevance>
    <Relevance>not exists lines whose (it starts with &quot;/bin/rm -f /etc/nologin&quot;) of file &quot;/etc/rc.d/rc.local&quot;</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2013-07-30</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-first-propagation</Name>
      <Value>Tue, 20 Sep 2011 03:22:23 +0000</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 05 Aug 2014 12:29:09 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-sh"><![CDATA[#!/bin/sh
echo "/bin/rm -f /etc/nologin" >> /etc/rc.d/rc.local]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
