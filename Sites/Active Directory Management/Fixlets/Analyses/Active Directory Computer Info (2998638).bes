    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Computer Description">string values of selects (&quot;DS_description from DS_Computer where DS_Name=&apos;&quot; &amp; (computer name) &amp; &quot;&apos;&quot;) of wmi &quot;root\directory\ldap&quot; </Property>
    <Property ID="2" Name="Computer Member Of">string values of selects (&quot;DS_MemberOf from DS_Computer where DS_Name=&apos;&quot; &amp; (computer name) &amp; &quot;&apos;&quot;) of wmi &quot;root\directory\ldap&quot;</Property>
