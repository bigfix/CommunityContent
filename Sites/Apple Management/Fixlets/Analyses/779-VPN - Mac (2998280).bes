  <Analysis>
    <Title>VPN - Mac</Title>
    <Description><![CDATA[Provides information on the current VPN configuration in Mac OS
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Domain>BES </Domain>
    <Property ID="1" Name="VPN - PPTP Connections - Mac" EvaluationPeriod="P1D">(string &quot;UserDefinedName&quot; of it, string &quot;SubType&quot; of dictionary &quot;Interface&quot; of it, string &quot;CommRemoteAddress&quot; of dictionary &quot;PPP&quot; of it) of dictionaries whose (exists dictionary &quot;IPv4&quot; of it and string &quot;SubType&quot; of dictionary &quot;Interface&quot; of it = &quot;PPTP&quot;) of values of entries of dictionary &quot;NetworkServices&quot; of dictionary of file &quot;preferences.plist&quot; of folder &quot;/Library/Preferences/SystemConfiguration&quot;</Property>
    <Property ID="2" Name="VPN - IPSec Connections - Mac" EvaluationPeriod="P1D">(string &quot;UserDefinedName&quot; of it, string &quot;Type&quot; of dictionary &quot;Interface&quot; of it, string &quot;RemoteAddress&quot; of dictionary &quot;IPSec&quot; of it) of dictionaries whose (exists dictionary &quot;IPv4&quot; of it and string &quot;Type&quot; of dictionary &quot;Interface&quot; of it = &quot;IPSec&quot;) of values of entries of dictionary &quot;NetworkServices&quot; of dictionary of file &quot;preferences.plist&quot; of folder &quot;/Library/Preferences/SystemConfiguration&quot;</Property>
    <Property ID="3" Name="VPN - L2TP Connections - Mac" EvaluationPeriod="P1D">(string &quot;UserDefinedName&quot; of it, string &quot;SubType&quot; of dictionary &quot;Interface&quot; of it, string &quot;CommRemoteAddress&quot; of dictionary &quot;PPP&quot; of it) of dictionaries whose (exists dictionary &quot;IPv4&quot; of it and string &quot;SubType&quot; of dictionary &quot;Interface&quot; of it = &quot;L2TP&quot;) of values of entries of dictionary &quot;NetworkServices&quot; of dictionary of file &quot;preferences.plist&quot; of folder &quot;/Library/Preferences/SystemConfiguration&quot;</Property>
