<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>SPSS Installation and Licensing - Mac OS X</Title>
    <Description><![CDATA[&lt;enter a description of the analysis here&gt; ]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance>exists folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 17 Dec 2014 19:15:10 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Versions" EvaluationPeriod="PT6H">unique values of versions of folders &quot;SPSSStatistics.app&quot; of folders of folder &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="2" Name="Install Folders" EvaluationPeriod="PT12H">unique values of pathnames of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="3" Name="License Files" EvaluationPeriod="PT12H">unique values of pathnames of files &quot;lservrc&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="4" Name="License File Contents" EvaluationPeriod="P2D">unique values of lines whose(it as trimmed string != &quot;&quot;) of files &quot;lservrc&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="5" Name="License Expirations" EvaluationPeriod="PT6H">unique values of (preceding texts of firsts &quot;, exclusive&quot; of following texts of lasts &quot;, expires Midnight of &quot; of it) of lines containing &quot;, expires Midnight of &quot; whose (it contains &quot;, exclusive&quot;) of files &quot;lservrc&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="6" Name="License Status" EvaluationPeriod="PT6H">unique values of ( ( ( (if (it &lt; current date) then &quot;Expired on &quot; else &quot;Expires on &quot;) &amp; following text of first &quot;, &quot; of (it as string) ) of maxima of (it as date) of (following text of last &quot; &quot; of preceding text of first &quot;, &quot; of it &amp; &quot; &quot; &amp; preceding text of first &quot; &quot; of it &amp; &quot; &quot; &amp; following text of last &quot;, &quot; of it) of (it as trimmed string) of (preceding texts of firsts &quot;, exclusive&quot; of following texts of lasts &quot;, expires Midnight of &quot; of it) of lines containing &quot;, expires Midnight of &quot; whose (it contains &quot;, exclusive&quot;) of it) of files &quot;lservrc&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot; )</Property>
    <Property ID="7" Name="Network License Files" EvaluationPeriod="PT12H">unique values of pathnames of files &quot;spssprod.inf&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="8" Name="Network License File Contents" EvaluationPeriod="P2D">unique values of lines whose (it as trimmed string != &quot;&quot;) of files &quot;spssprod.inf&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="9" Name="Network License Server (keys)" EvaluationPeriod="PT6H">unique values of (it as trimmed string) whose (it != &quot;&quot;) of keys &quot;DaemonHost&quot; of files &quot;spssprod.inf&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="14" Name="Network License Server (Filtered)" EvaluationPeriod="PT12H">unique values of (it as trimmed string) whose (it != &quot;&quot; AND ( /* The following should be true of any License Server that is a domain name, or an IPV4 address */ 2 &lt;= number of substrings separated by &quot;.&quot; of it )) of keys &quot;DaemonHost&quot; of files &quot;spssprod.inf&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;</Property>
    <Property ID="15" Name="Valid License?" EvaluationPeriod="PT6H">( ( ( (exists (it as trimmed string) whose (it != &quot;&quot; AND ( /* The following should be true of any License Server that is a domain name, or an IPV4 address */ 2 &lt;= number of substrings separated by &quot;.&quot; of it )) of keys &quot;DaemonHost&quot; of files &quot;spssprod.inf&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of it ) OR disjunction of ( (if (it &lt; (current date+30*day)) then FALSE else TRUE) of maxima of (it as date) of (following text of last &quot; &quot; of preceding text of first &quot;, &quot; of it &amp; &quot; &quot; &amp; preceding text of first &quot; &quot; of it &amp; &quot; &quot; &amp; following text of last &quot;, &quot; of it) of (it as trimmed string) of (preceding texts of firsts &quot;, exclusive&quot; of following texts of lasts &quot;, expires Midnight of &quot; of it) of lines containing &quot;, expires Midnight of &quot; whose (it contains &quot;, exclusive&quot;) of files &quot;lservrc&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of it) ) of it, name of it ) of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot; )</Property>
    <Property ID="16" Name="All Licenses Valid? (of v20+ of SPSS)" EvaluationPeriod="PT6H">conjunction of ( ( ( (exists (it as trimmed string) whose (it != &quot;&quot; AND ( /* The following should be true of any License Server that is a domain name, or an IPV4 address */ 2 &lt;= number of substrings separated by &quot;.&quot; of it )) of keys &quot;DaemonHost&quot; of files &quot;spssprod.inf&quot; of it ) OR disjunction of ( (if (it &lt; (current date+30*day)) then FALSE else TRUE) of maxima of (it as date) of (following text of last &quot; &quot; of preceding text of first &quot;, &quot; of it &amp; &quot; &quot; &amp; preceding text of first &quot; &quot; of it &amp; &quot; &quot; &amp; following text of last &quot;, &quot; of it) of (it as trimmed string) of (preceding texts of firsts &quot;, exclusive&quot; of following texts of lasts &quot;, expires Midnight of &quot; of it) of lines containing &quot;, expires Midnight of &quot; whose (it contains &quot;, exclusive&quot;) of files &quot;lservrc&quot; of it) ) of folders &quot;SPSSStatistics.app/Contents/bin&quot; of it ) of folders whose(name of it as trimmed string as integer &gt;= 20) of folders &quot;/Applications/IBM/SPSS/Statistics&quot; )</Property>
    <Property ID="17" Name="Valid License for newest installed version of SPSS?" EvaluationPeriod="PT12H">( ( ( (exists (it as trimmed string) whose (it != &quot;&quot; AND ( /* The following should be true of any License Server that is a domain name, or an IPV4 address */ 2 &lt;= number of substrings separated by &quot;.&quot; of it )) of keys &quot;DaemonHost&quot; of files &quot;spssprod.inf&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of it ) OR disjunction of ( (if (it &lt; (current date+30*day)) then FALSE else TRUE) of maxima of (it as date) of (following text of last &quot; &quot; of preceding text of first &quot;, &quot; of it &amp; &quot; &quot; &amp; preceding text of first &quot; &quot; of it &amp; &quot; &quot; &amp; following text of last &quot;, &quot; of it) of (it as trimmed string) of (preceding texts of firsts &quot;, exclusive&quot; of following texts of lasts &quot;, expires Midnight of &quot; of it) of lines containing &quot;, expires Midnight of &quot; whose (it contains &quot;, exclusive&quot;) of files &quot;lservrc&quot; of folders &quot;SPSSStatistics.app/Contents/bin&quot; of it) ) of it, name of it ) of folders whose(name of it as trimmed string as integer = unique value of maxima of (it as trimmed string as integer) of names of folders of folders &quot;/Applications/IBM/SPSS/Statistics&quot;) of folders &quot;/Applications/IBM/SPSS/Statistics&quot; )</Property>
  </Analysis>
</BES>
