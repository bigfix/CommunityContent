<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>FileVault 2 - Audit - Mac</Title>
    <Description><![CDATA[<P>Provides audit information about FileVault on the system. </P>
<P>Information on using this content is available here: <A href="https://github.com/strawgate/C3-Protect/wiki/FileVault-2">https://github.com/strawgate/C3-Protect/wiki/FileVault-2</A></P>
<P>For general information or to report issues with C3 Protect content please visit GitHub here: <A href="https://github.com/strawgate/C3-Protect">https://github.com/strawgate/C3-Protect</A></P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance>exists folder &quot;FileVault&quot; of folder &quot;__Global&quot; of data folder of client</Relevance>
    <Domain>BESC</Domain>
    <Property ID="3" Name="FileVault 2 - Personal Recovery Key - Mac">(following text of first &quot;: &quot; of it as boolean) of (lines containing &quot;Personal Key Exists:&quot; of it) of file &quot;RecoverySettings.txt&quot; of folder &quot;FileVault&quot; of folder &quot;__Global&quot; of data folder of client</Property>
    <Property ID="4" Name="FileVault 2 - Institutional Recovery Key - Mac">(following text of first &quot;: &quot; of it as boolean) of (lines containing &quot;Institutional Key Exists:&quot; of it) of file &quot;RecoverySettings.txt&quot; of folder &quot;FileVault&quot; of folder &quot;__Global&quot; of data folder of client</Property>
    <Property ID="5" Name="FileVault 2 - Status - Mac" EvaluationPeriod="P1D">line 1 of file &quot;Status.txt&quot; of folder &quot;FileVault&quot; of folder &quot;__Global&quot; of data folder of client</Property>
    <Property ID="6" Name="FileVault 2 - Encryption Progress - Mac" EvaluationPeriod="P1D">(if (exists lines containing &quot;Progress&quot; of it) then (lines containing &quot;Progress&quot; of it) else nothing) of (file &quot;Status.txt&quot; of folder &quot;FileVault&quot; of folder &quot;__Global&quot; of data folder of client)</Property>
    <Property ID="7" Name="FileVault 2 - Enabled Users - Mac" EvaluationPeriod="P1D">lines of file &quot;Users.txt&quot; of folder &quot;FileVault&quot; of folder &quot;__Global&quot; of data folder of client</Property>
    <Property ID="8" Name="FileVault 2 - Deferred Users - Mac" EvaluationPeriod="P1D">(if (exists lines containing &quot;Deferred enablement&quot; of it) then (lines containing &quot;Deferred enablement&quot; of it) else nothing) of (file &quot;Status.txt&quot; of folder &quot;FileVault&quot; of folder &quot;__Global&quot; of data folder of client)</Property>
  </Analysis>
</BES>
