<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Adobe Acrobat Pro DC 15.010.20056 - Adobe Acrobat Pro DC 15.x - Mac OS X</Title>
    <Description><![CDATA[<P>Use this action to update Adobe Acrobat Pro DC to version 15.010.20056. This action is relevant on Macs running Mavericks or newer with a previous version of Adobe Acrobat Pro DC installed.</P>
<P>Adobe Acrobat Pro DC Update 15.010.20056 Planned Update (Continuous Track), January 12, 2016</P>
<P><A href="https://helpx.adobe.com/acrobat/release-note/release-notes-acrobat-reader.html">https://helpx.adobe.com/acrobat/release-note/release-notes-acrobat-reader.html</A></P>
<P>Action 1: Use this when Acrobat Pro DC is not running otherwise the update will fail. Acrobat Pro DC needs to be closed in order for the update to succesfully install. If you would like to forcibly close Acrobat Pro DC, then use Action 2.</P>
<P>Action 2: Use this to forcibly close Acrobat Pro DC by killing the process, and then proceed with installing the update.</P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.9.0"]]></Relevance>
    <Relevance><![CDATA[exists application whose (name of it = "Adobe Acrobat.app" and version of it < "15.010.20056" AND version of it >= "15.0")]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-01-17</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 18 Jan 2016 02:10:02 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch AcrobatDCUpd1501020056.pkg sha1:981d1367eb9e1926bba62549764ef9b90700d6a9 size:249165728 http://ardownload.adobe.com/pub/adobe/acrobat/mac/AcrobatDC/1501020056/AcrobatDCUpd1501020056.pkg sha256:240341d7407b4f29cf1b527e841ecc61657da092a17fa2dd109a0b92ab3a789b

// Delete the Acrobat DC Update PKG in case it already exists
wait /bin/sh -c &quot;rm &apos;/private/tmp/AcrobatDCUpd1501020056.pkg&apos; &quot;

// Kill all Acrobat processes to forcibly close Acrobat DC
// Uncomment the next line to forcibly close Acrobat DC by killing the process
// wait /bin/sh -c &quot;/usr/bin/killall &apos;AdobeAcrobat&apos; &quot;

// Move the downloaded Acrobat DC Update PKG to the temp directory
move &quot;{posix path of file &quot;AcrobatDCUpd1501020056.pkg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/AcrobatDCUpd1501020056.pkg&quot;

// Install the Acrobat DC update
wait installer -pkg &quot;/private/tmp/AcrobatDCUpd1501020056.pkg&quot; -target /

// Delete the Acrobat DC Update PKG in the temp directory
wait /bin/sh -c &quot;rm &apos;/private/tmp/AcrobatDCUpd1501020056.pkg&apos; &quot;

// Uncomment the next line to require a restart after installing the update
// action requires restart</ActionScript>
    </DefaultAction>
    <Action ID="Action8240">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to upgrade to Adobe Acrobat Pro DC&amp;nbsp;regardless of whether Acrobat&amp;nbsp;Pro DC is running. </PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch AcrobatDCUpd1501020056.pkg sha1:981d1367eb9e1926bba62549764ef9b90700d6a9 size:249165728 http://ardownload.adobe.com/pub/adobe/acrobat/mac/AcrobatDC/1501020056/AcrobatDCUpd1501020056.pkg sha256:240341d7407b4f29cf1b527e841ecc61657da092a17fa2dd109a0b92ab3a789b

// Delete the Acrobat DC Update PKG in case it already exists
wait /bin/sh -c &quot;rm &apos;/private/tmp/AcrobatDCUpd1501020056.pkg&apos; &quot;

// Kill all Acrobat processes to forcibly close Acrobat DC
// Uncomment the next line to forcibly close Acrobat DC by killing the process
wait /bin/sh -c &quot;/usr/bin/killall &apos;AdobeAcrobat&apos; &quot;

// Move the downloaded Acrobat DC Update PKG to the temp directory
move &quot;{posix path of file &quot;AcrobatDCUpd1501020056.pkg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/AcrobatDCUpd1501020056.pkg&quot;

// Install the Acrobat DC update
wait installer -pkg &quot;/private/tmp/AcrobatDCUpd1501020056.pkg&quot; -target /

// Delete the Acrobat DC Update PKG in the temp directory
wait /bin/sh -c &quot;rm &apos;/private/tmp/AcrobatDCUpd1501020056.pkg&apos; &quot;

// Uncomment the next line to require a restart after installing the update
// action requires restart</ActionScript>
    </Action>
  </Fixlet>
</BES>
