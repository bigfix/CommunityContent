<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>SECURITY - Allow Password Changes (MAC)</Title>
    <Description>Activates Keychain Sync with AD password </Description>
    <Relevance>mac of operating system</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2017-01-10</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 10 Jan 2017 22:34:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-sh">#!/bin/sh
# Enter your action script here
sudo defaults write &quot;/Users/*/Library/Preferences/com.apple.keychainaccess.plist&quot; SyncLoginPassword - bool true
</ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
