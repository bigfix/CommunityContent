    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process through the IBM Endpoint Manager server.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch OSXUpdCombo10.10.2.dmg sha1:6B2465514B16FFD89D625A17C06F05D04760C130 size:840280237 http://supportdownload.apple.com/download.info.apple.com/Apple_Support_Area/Apple_Software_Updates/Mac_OS_X/downloads/031-17315.20150128.Cxx4r/OSXUpdCombo10.10.2.dmg sha256:DC5B256D4711FC54999EA050EF37D551071BB0322F79602E9576DF80F0C1C5B4

wait cp &quot;{posix path of file &quot;OSXUpdCombo10.10.2.dmg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/Volumes/OSXUpdCombo10.10.2&quot; &quot;/private/tmp/OSXUpdCombo10.10.2.dmg&quot;

wait rm -rf &quot;/private/tmp/OSXUpdCombo10.10.2.dmg&quot;

wait cp -r &quot;/Volumes/OSXUpdCombo10.10.2/OSXUpdCombo10.10.2.pkg&quot; &quot;/private/tmp/OSXUpdCombo10.10.2.pkg&quot;

wait /bin/bash -c &quot;devname=`df | grep OSXUpdCombo10.10.2 | awk &apos;{{print $1}&apos;`; hdiutil detach -force $devname;&quot;

wait installer -pkg &quot;/private/tmp/OSXUpdCombo10.10.2.pkg&quot; -target /

action requires restart</ActionScript>
    </DefaultAction>
    <Action ID="Action4419">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process through the Apple Software Update tool.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">if{(string &quot;ProductVersion&quot; of dictionary of file &quot;/System/Library/CoreServices/SystemVersion.plist&quot;) = &quot;10.10.1&quot;}
	wait softwareupdate -i OSXUpd10.10.2-10.10.2
else
	wait softwareupdate -i OSXUpdCombo10.10.2-10.10.2
endif

action requires restart</ActionScript>
    </Action>
