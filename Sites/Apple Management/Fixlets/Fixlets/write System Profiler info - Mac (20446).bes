<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>write System Profiler info - Mac</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance>not exists folders &quot;/tmp/system_profiler/&quot;</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-02</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 03 May 2016 20:41:06 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// NOTE: the relevance depends on this target_folder location and should also be changed so they match
parameter "target_folder" = "/tmp/system_profiler/"

folder create { parameter "target_folder" }

wait sh -c "system_profiler -listDataTypes > {parameter "target_folder"}_spOut_listDataTypes.txt"

// dump system_profiler data into separate .txt files
wait sh -c { ("%22" & it & "%22") of concatenations ";" of ("system_profiler " & it & " > " & parameter "target_folder" & it & ".txt") of (it as trimmed string) whose(it as lowercase starts with "sp") of unique values of lines of files "_spOut_listDataTypes.txt" of folder ( parameter "target_folder" ) }
// dump system_profiler data into separate .xml files (plist format)
wait sh -c { ("%22" & it & "%22") of concatenations ";" of ("system_profiler -xml " & it & " > " & parameter "target_folder" & it & ".spx") of (it as trimmed string) whose(it as lowercase starts with "sp") of unique values of lines of files "_spOut_listDataTypes.txt" of folder ( parameter "target_folder" ) }

// Delete empty txt files
wait sh -c { ("%22" & it & "%22") of concatenations ";" of ("rm -f '" & it & "'") of pathnames of files whose(0 = size of it AND name of it starts with "SP") of folder ( parameter "target_folder" ) }

// Delete empty spx/xml/plist files
wait sh -c { ("%22" & it & "%22") of concatenations ";" of ("rm -f '" & it & "'") of pathnames of files whose(name of it as lowercase ends with ".spx" AND name of it starts with "SP" AND 0 = (number of values of arrays "_items" of dictionaries of values of arrays of it) of it) of folder ( parameter "target_folder" ) }
]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
