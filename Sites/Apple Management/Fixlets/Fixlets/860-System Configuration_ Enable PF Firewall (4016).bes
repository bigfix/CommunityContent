<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>System Configuration: Enable PF Firewall</Title>
    <Description><![CDATA[<DIV class=subsection>This fixlet adds the "-e" flag to the ProgramArguments of the /System/Library/LaunchDaemons/com.apple.pfctl.plist. </DIV>
<P class=subsection>This&nbsp; enables the pf firewall to start at system boot.</P>
<P class=subsection>This fixlet is applicable on Mac OS X 10.9 or later.</P>
<DIV class=subsection>WARNING: Enabling the pf firewall can lock you out of your system if it's not properly configured! Make sure you test this!</DIV>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.9"]]></Relevance>
    <Relevance>not (exists strings whose (it as lowercase = &quot;-e&quot;) of values of array of values of entries whose (key of it = &quot;ProgramArguments&quot;) of dictionary of file &quot;/System/Library/LaunchDaemons/com.apple.pfctl.plist&quot;)</Relevance>
    <Category>System Configuration</Category>
    <Source>Internal</Source>
    <SourceID>rzm102</SourceID>
    <SourceReleaseDate>2014-06-13</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 13 Jun 2014 19:20:26 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Enter your action script here
wait bash -c &quot;defaults write /System/Library/LaunchDaemons/com.apple.pfctl ProgramArguments &apos;(pfctl, -f, /etc/pf.conf, -e)&apos;&quot;
wait chmod 644 /System/Library/LaunchDaemons/com.apple.pfctl.plist
wait plutil -convert xml1 /System/Library/LaunchDaemons/com.apple.pfctl.plist
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
