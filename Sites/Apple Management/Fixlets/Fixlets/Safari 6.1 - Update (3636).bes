<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Safari 6.1 - Update</Title>
    <Description><![CDATA[<DIV class=FixletMessage>
<TABLE>
<TBODY>
<TR>
<TD>
<P>This update is recommended for all Safari users and includes several improvements to performance, usability, compatibility and security.</P></TD></TR></TBODY></TABLE></DIV>
<DIV class=FixletMessage>This fixlet will use the built in Apple Software Update tools to update Safari to version 6.1 on Mac OS X 10.7.5 and 10.8.5 based machines.&nbsp; Access to the public Internet by each client&nbsp;is required for this fixlet to function.</DIV>
<DIV class=FixletProperty>
<H4>CVE:</H4>CVE-2013-1036, CVE-2013-1037, CVE-2013-1038, CVE-2013-1039, CVE-2013-1040, CVE-2013-1041, CVE-2013-1042, CVE-2013-1043, CVE-2013-1044, CVE-2013-1045, CVE-2013-1046, CVE-2013-1047, CVE-2013-2842, CVE-2013-5125, CVE-2013-5126, CVE-2013-5127, CVE-2013-5128, CVE-2013-2848, CVE-2013-5129, CVE-2013-5130, CVE-2013-5131</DIV>]]></Description>
    <Relevance>(name of operating system = &quot;Mac OS X&quot;) AND (if exists property &quot;in proxy agent context&quot; then (not in proxy agent context) else true) AND (if exists property &quot;android&quot; of type &quot;operating system&quot; then (not android of operating system) else true)</Relevance>
    <Relevance><![CDATA[(exists string "ProductVersion" whose ((it as version >= "10.7.5" AND it as version < "10.8") OR (it as version >= "10.8.5" AND it as version < "10.9")) of dictionary of it) of file "/System/Library/CoreServices/SystemVersion.plist"]]></Relevance>
    <Relevance><![CDATA[exists application whose (version of it < "6.1" AND name of it = "Safari.app")]]></Relevance>
    <Category>Security Update</Category>
    <Source>Apple</Source>
    <SourceID>APPLE-SA-2013-10-22-2</SourceID>
    <SourceReleaseDate>2013-10-22</SourceReleaseDate>
    <CVENames>CVE-2013-1036, CVE-2013-1037, CVE-2013-1038, CVE-2013-1039, CVE-2013-1040, CVE-2013-1041, CVE-2013-1042, CVE-2013-1043, CVE-2013-1044, CVE-2013-1045, CVE-2013-1046, CVE-2013-1047, CVE-2013-2842, CVE-2013-5125, CVE-2013-5126, CVE-2013-5127, CVE-2013-5128, CVE-2013-2848, CVE-2013-5129, CVE-2013-5130, CVE-2013-5131</CVENames>
    <MIMEField>
      <Name>x-fixlet-first-propagation</Name>
      <Value>Thu, 18 Apr 2013 22:42:40 +0000</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>PTCH Patch Apple Safari Application</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 24 Oct 2013 13:20:38 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[if {system version >= "10.7" as version AND system version < "10.8" as version}
	wait sh -c "softwareupdate -i Safari6.1Lion-6.1"
endif

if {system version >= "10.8" as version}
	wait sh -c "softwareupdate -i Safari6.1MountainLion-6.1"
endif]]></ActionScript>
    </DefaultAction>
    <Action ID="Action3905">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to view more information from Apple on this update.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://support.apple.com/kb/HT5701</ActionScript>
    </Action>
  </Fixlet>
</BES>
