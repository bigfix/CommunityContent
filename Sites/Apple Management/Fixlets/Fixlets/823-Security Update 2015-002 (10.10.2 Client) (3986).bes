dleShortVersionString" of it & ".0.0.0.")) & "." & string "SourceVersion" of it) of dictionary of it as version < "14.1.0.2782010073000000") of it)) OR (exists folder "/System/Library/Extensions/System.kext/PlugIns/Mach.kext/Contents/" whose (exists file "version.plist" whose (((parenthesized part 1 of match (regex "^\.?(([0-9]+\.?){3})\.") of (string "CFBundleShortVersionString" of it & ".0.0.0.")) & "." & string "SourceVersion" of it) of dictionary of it as version < "14.1.0.2782010073000000") of it)) OR (exists folder "/System/Library/Extensions/System.kext/PlugIns/Private.kext/Contents/" whose (exists file "version.plist" whose (((parenthesized part 1 of match (regex "^\.?(([0-9]+\.?){3})\.") of (string "CFBundleShortVersionString" of it & ".0.0.0.")) & "." & string "SourceVersion" of it) of dictionary of it as version < "14.1.0.2782010073000000") of it)) OR (exists folder "/System/Library/Extensions/System.kext/PlugIns/Unsupported.kext/Contents/" whose (exists file "version.plist" whose (((parenthesized part 1 of match (regex "^\.?(([0-9]+\.?){3})\.") of (string "CFBundleShortVersionString" of it & ".0.0.0.")) & "." & string "SourceVersion" of it) of dictionary of it as version < "14.1.0.2782010073000000") of it))]]></Relevance>
