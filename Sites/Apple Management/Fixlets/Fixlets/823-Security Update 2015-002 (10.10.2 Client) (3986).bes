    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process through the IBM Endpoint Manager server.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch SecUpd2015-002Yosemite.dmg sha1:d37cdab99470650043fd479ed0bfc27181b260fe size:5433396 http://supportdownload.apple.com/download.info.apple.com/Apple_Support_Area/Apple_Software_Updates/Mac_OS_X/downloads/031-18425.20150309.B6D35/SecUpd2015-002Yosemite.dmg sha256:e213db40947392a046148d466b27105281b76f182eaee1ac116694824e3c4aa8

wait cp &quot;{posix path of file &quot;SecUpd2015-002Yosemite.dmg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/Volumes/SecUpd2015-002Yosemite&quot; &quot;/private/tmp/SecUpd2015-002Yosemite.dmg&quot;

wait rm -rf &quot;/private/tmp/SecUpd2015-002Yosemite.dmg&quot;

wait cp -r &quot;/Volumes/SecUpd2015-002Yosemite/SecUpd2015-002Yosemite.pkg&quot; &quot;/private/tmp/SecUpd2015-002Yosemite.pkg&quot;

wait /bin/bash -c &quot;devname=`df | grep SecUpd2015-002Yosemite | awk &apos;{{print $1}&apos;`; hdiutil detach -force $devname;&quot;

wait installer -pkg &quot;/private/tmp/SecUpd2015-002Yosemite.pkg&quot; -target /

action requires restart</ActionScript>
    </DefaultAction>
    <Action ID="Action4438">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process through the Apple Software Update tool.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait softwareupdate -i &quot;Security Update 2015-002-1.0&quot;

action requires restart</ActionScript>
    </Action>
