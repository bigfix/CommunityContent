    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process through the IBM Endpoint Manager server.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[continue if {(version of operating system < "10.10" as version) OR (version of client >= "9.2.4.2" as version)}

prefetch SecUpd2015-003YosemiteCPU.dmg sha1:7226993d49b5393eeccb3226ddbd1b71599b2963 size:5190131 http://supportdownload.apple.com/download.info.apple.com/Apple_Support_Area/Apple_Software_Updates/Mac_OS_X/downloads/031-19686-20150319-5F671036-CDA1-11E4-81AB-C077A153B4CE/SecUpd2015-003YosemiteCPU.dmg sha256:1408845eed7bffad51413227e8bce87e863bd994b658c993c76846a23f69597a

wait cp "{posix path of file "SecUpd2015-003YosemiteCPU.dmg" of folder "__Download" of client folder of current site}" "/private/tmp/"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/Volumes/SecUpd2015-003YosemiteCPU" "/private/tmp/SecUpd2015-003YosemiteCPU.dmg"

wait rm -rf "/private/tmp/SecUpd2015-003YosemiteCPU.dmg"

wait cp -r "/Volumes/SecUpd2015-003YosemiteCPU/SecUpd2015-003YosemiteCPU.pkg" "/private/tmp/SecUpd2015-003YosemiteCPU.pkg"

wait /bin/bash -c "devname=`df | grep SecUpd2015-003YosemiteCPU | awk '{{print $1}'`; hdiutil detach -force $devname;"

wait installer -pkg "/private/tmp/SecUpd2015-003YosemiteCPU.pkg" -target /

action requires restart]]></ActionScript>
    </DefaultAction>
    <Action ID="Action4477">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process through the Apple Software Update tool.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[continue if {(version of operating system < "10.10" as version) OR (version of client >= "9.2.4.2" as version)}

wait softwareupdate -i "Security Update 2015-003-1.0"

action requires restart]]></ActionScript>
    </Action>
    <Action ID="Action4478">
      <Description>
