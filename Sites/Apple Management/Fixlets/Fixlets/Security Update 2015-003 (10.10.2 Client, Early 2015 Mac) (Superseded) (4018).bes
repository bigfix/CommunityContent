<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Security Update 2015-003 (10.10.2 Client, Early 2015 Mac) (Superseded)</Title>
    <Description><![CDATA[<DIV class=FixletMessage><TABLE><TBODY><TR><TD><P>Security Update 2015-003 is recommended for all users and improves the security of Mac OS X.</P>
<P>This update is available via the IBM Endpoint Manager server, which is the default action, and Apple Software Update on the endpoint.</P>
<P>The default action does not require internet connection on the endpoints. This action downloads the installer to the IBM Endpoint Manager server and then installs the update to the endpoints.</P>
<P><STRONG>Note: </STRONG>If you want to use Apple Software Update, ensure that the endpoints have continuous internet connection to install the update successfully.</P>
<P><STRONG>Note: </STRONG>Affected computers may report back as 'Pending Restart' once the patch has run successfully, but will not report back their final status until the computer has been restarted.</P></TD></TR></TBODY></TABLE></DIV>
<DIV class=FixletProperty>
<H4>File Size:</H4>4.95 MB</DIV>
<DIV class=FixletProperty>
<H4>CVE:</H4>CVE-2015-1065, CVE-2015-1061</DIV>]]></Description>
    <Relevance>(exists string &quot;ProductVersion&quot; whose (it as string = &quot;10.10.2&quot;) of dictionary of it) of file &quot;/System/Library/CoreServices/SystemVersion.plist&quot;</Relevance>
    <Relevance><![CDATA[(if ((parenthesized part 1 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist")) as integer) < ((parenthesized part 1 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2513")) as integer) then true else if ((parenthesized part 1 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist")) as integer) > ((parenthesized part 1 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2513")) as integer) then false else if ((parenthesized part 2 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist")) as string) < ((parenthesized part 2 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2513")) as string) then true else if ((parenthesized part 2 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist")) as string) > ((parenthesized part 2 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2513")) as string) then false else if ((parenthesized part 3 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist") as integer)) < ((parenthesized part 3 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2513") as integer)) then true else false) AND (if ((parenthesized part 1 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist")) as integer) > ((parenthesized part 1 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2000")) as integer) then true else if ((parenthesized part 1 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist")) as integer) < ((parenthesized part 1 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2000")) as integer) then false else if ((parenthesized part 2 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist")) as string) > ((parenthesized part 2 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2000")) as string) then true else if ((parenthesized part 2 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist")) as string) < ((parenthesized part 2 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2000")) as string) then false else if ((parenthesized part 3 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of string "ProductBuildVersion" of dictionary of file "/System/Library/CoreServices/SystemVersion.plist") as integer)) > ((parenthesized part 3 of (first match (regex "([0-9]+)([A-Z])([0-9]+)") of "14C2000") as integer)) then true else false)]]></Relevance>
