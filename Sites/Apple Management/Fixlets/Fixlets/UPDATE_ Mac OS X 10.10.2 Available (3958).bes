    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process through the IBM Endpoint Manager server.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch OSXUpd10.10.2-10.10.2.dmg sha1:8b5b07e3ac81b101fb4cb89b0a9c6d8fe551d598 size:554331370 http://supportdownload.apple.com/download.info.apple.com/Apple_Support_Area/Apple_Software_Updates/Mac_OS_X/downloads/031-17158.20150127.ilntx/osxupd10.10.2.dmg sha256:08f02e87adfb06b73dcec6dc55e07e2e88cb661cfb5869d6664a93d2935ebef5

wait cp &quot;{posix path of file &quot;OSXUpd10.10.2-10.10.2.dmg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/Volumes/OSXUpd10.10.2&quot; &quot;/private/tmp/OSXUpd10.10.2-10.10.2.dmg&quot;

wait rm -rf &quot;/private/tmp/OSXUpd10.10.2-10.10.2.dmg&quot;

wait cp -r &quot;/Volumes/OSXUpd10.10.2/OSXUpd10.10.2.pkg&quot; &quot;/private/tmp/OSXUpd10.10.2.pkg&quot;

wait /bin/bash -c &quot;devname=`df | grep OSXUpd10.10.2 | awk &apos;{{print $1}&apos;`; hdiutil detach -force $devname;&quot;

wait installer -pkg &quot;/private/tmp/OSXUpd10.10.2.pkg&quot; -target /

action requires restart</ActionScript>
    </DefaultAction>
    <Action ID="Action4394">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to initiate the deployment process through the Apple Software Update tool.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait softwareupdate -i OSXUpd10.10.2-10.10.2

action requires restart</ActionScript>
    </Action>
    <Action ID="Action4395">
