<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>System Configuration: Always Show Scroll Bars</Title>
    <Description><![CDATA[<P>This task will enable OS X applications to always show their scroll bars (Always).</P>
<P>This changes the default behavior of only showing scroll bars while scrolling (WhenScrolling or Automatic)</P>
<P>This task is applicable on Mac OS X 10.8 or later.</P>
<P>If you have questions or concerns please visit <A href="http://clc.its.psu.edu/help">http://clc.its.psu.edu/help</A> to submit a SysMan Help Request.</P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.8"]]></Relevance>
    <Relevance>not exists file &quot;/Library/Preferences/.GlobalPreferences.plist&quot; whose (string &quot;AppleShowScrollBars&quot; of dictionary of it = &quot;Always&quot;)</Relevance>
    <Category>System Configuration</Category>
    <Source>Internal</Source>
    <SourceID>rzm102</SourceID>
    <SourceReleaseDate>2014-07-30</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 30 Jul 2014 14:15:58 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Enter your action script here
wait /usr/bin/defaults write &quot;/Library/Preferences/.GlobalPreferences.plist&quot; AppleShowScrollBars -string &quot;Always&quot;</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
