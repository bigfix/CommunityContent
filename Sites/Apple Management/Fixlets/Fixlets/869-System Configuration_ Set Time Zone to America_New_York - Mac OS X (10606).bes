<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>System Configuration: Set Time Zone to America/New_York - Mac OS X</Title>
    <Description><![CDATA[<P>This task will set the the system time zone to 'America/New_York' using the "systemsetup" utility.</P>
<P>System Preferences &gt; Date &amp; Time &gt; Time Zone</P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance>exists file &quot;/usr/sbin/systemsetup&quot;</Relevance>
    <Relevance>not exists file &quot;/etc/localtime&quot; whose (sha1 of it = sha1 of file &quot;/usr/share/zoneinfo/America/New_York&quot;)</Relevance>
    <Category>System Configuration</Category>
    <Source>SysMan</Source>
    <SourceID>mah60</SourceID>
    <SourceReleaseDate>2014-04-22</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 23 Apr 2014 13:31:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait /usr/sbin/systemsetup -settimezone &quot;America/New_York&quot;</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
