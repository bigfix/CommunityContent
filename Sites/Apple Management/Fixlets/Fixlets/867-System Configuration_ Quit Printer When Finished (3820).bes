<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>System Configuration: Quit Printer When Finished</Title>
    <Description><![CDATA[<P>This fixlet configures printers to auto-quit after printing.</P>
<P>The default behavior is to leave the printer window open when&nbsp;finished printing. This&nbsp;changes the default to quit the printer after finished.&nbsp;</P>
<P>This fixlet is applicable on Mac OS X 10.5 or later.</P>
<P>If you have questions or concerns please visit <A href="http://clc.its.psu.edu/help">http://clc.its.psu.edu/help</A> to submit a SysMan Help Request.</P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.5"]]></Relevance>
    <Relevance>not exists file &quot;/Library/Preferences/com.apple.print.PrintingPrefs.plist&quot; whose (boolean &quot;Quit When Finished&quot; of dictionary of it = True)</Relevance>
    <Category>System Configuration</Category>
    <Source>Internal</Source>
    <SourceID>rzm102</SourceID>
    <SourceReleaseDate>2014-07-30</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 30 Jul 2014 18:06:48 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait defaults write &quot;/Library/Preferences/com.apple.print.PrintingPrefs.plist&quot; &quot;Quit When Finished&quot; -bool true
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
