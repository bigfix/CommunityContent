<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>System Configuration: Enable BlueTooth Radio</Title>
    <Description><![CDATA[<P>Enable the BlueTooth radio on OS X.</P>
<P>This fixlet is applicable on Mac OS X 10.9 or later</P>
<P>If you have questions or concerns please visit <A href="http://clc.its.psu.edu/help">http://clc.its.psu.edu/help</A> to submit a SysMan Help Request.</P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance>not exists file &quot;/Library/Preferences/com.apple.Bluetooth.plist&quot; whose (boolean &quot;ControllerPowerState&quot; of dictionary of it = True)</Relevance>
    <Category>System Configuration</Category>
    <Source>Internal</Source>
    <SourceID>rzm102</SourceID>
    <SourceReleaseDate>2016-08-19</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 19 Aug 2016 13:40:39 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Disable power
wait defaults write /Library/Preferences/com.apple.Bluetooth.plist ControllerPowerState -bool true
// Reload the daemon
wait launchctl unload /System/Library/LaunchDaemons/com.apple.blued.plist
wait launchctl load /System/Library/LaunchDaemons/com.apple.blued.plist
</ActionScript>
    </DefaultAction>
  </Task>
</BES>
