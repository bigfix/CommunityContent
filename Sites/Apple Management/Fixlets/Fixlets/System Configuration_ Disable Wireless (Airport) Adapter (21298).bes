<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>System Configuration: Disable Wireless (Airport) Adapter</Title>
    <Description><![CDATA[<DIV class=subsection>Disable the Wireless (Airport) radio on OS X.
<P>This fixlet is applicable on Mac OS X 10.9 or later</P>
<P>If you have questions or concerns please visit <A href="http://clc.its.psu.edu/help">http://clc.its.psu.edu/help</A> to submit a SysMan Help Request.</P></DIV>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.10"]]></Relevance>
    <Relevance>boolean &quot;PowerEnabled&quot; of dictionaries of values of entries of dictionaries of values of entries of dictionary &quot;Interface&quot; of dictionaries of values of entries of dictionaries of values of entries of dictionary &quot;Sets&quot; of dictionaries of file &quot;/Library/Preferences/SystemConfiguration/preferences.plist&quot; = True</Relevance>
    <Category>System Configuration</Category>
    <Source>Internal</Source>
    <SourceID>rzm102</SourceID>
    <SourceReleaseDate>2016-08-19</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 19 Aug 2016 14:00:24 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// disable airport radio
wait networksetup -setairportpower airport off</ActionScript>
    </DefaultAction>
  </Task>
</BES>
