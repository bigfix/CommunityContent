<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Firmware Password for Mac OS X</Title>
    <Description><![CDATA[<P>This fixlet checks to see if the firmware password is set (an optionally sets the password)&nbsp;for a Mac.</P>
<P>Because of the potential impact to performance, I only execute this Task once every 6 hours when using it to audit the password status. This was deemed frequent enough to appropriately record the encryption status, but not so frequent that it adversely impacted overall performance of the targeted computers or their Agents. </P>]]></Description>
    <Relevance>(operating system as string starts with &quot;Mac OS X&quot;)</Relevance>
    <Category>FIRMWARE STATUS</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2014-07-27</SourceReleaseDate>
    <MIMEField>
      <Name>bigfixme-added-time</Name>
      <Value>Mon, 19 Aug 2013 11:08:07 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-modification-time</Name>
      <Value>Mon, 19 Aug 2013 11:17:29 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-keywords</Name>
      <Value>FileVault FileVault2 Macintosh Encryption</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 17 Apr 2015 23:00:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to Audit the&amp;nbsp;Firmware password.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[delete __createfile
createfile until ##END##


#!/bin/sh

FIRMWARESTATUS="/private/tmp/firmware_status.txt"

if [ -z "`which setregproptool`" ]; then
/usr/sbin/diskutil quiet mount Recovery\ HD
if [ ! -d "/Volumes/Recovery HD/" ]; then
echo "ERROR - cannot retrive setregproptool from recovery partition. OS version may be too old." > /private/tmp/firmware_status.txt
exit 0
fi
/usr/bin/hdiutil attach -nobrowse -quiet /Volumes/Recovery\ HD/com.apple.recovery.boot/BaseSystem.dmg
cp "/Volumes/`ls -b /Volumes/ | grep "OS X Base System"`/Applications/Utilities/Firmware Password Utility.app/Contents/Resources/setregproptool" /usr/bin
/usr/bin/hdiutil detach "/Volumes/`ls -b /Volumes/ | grep "OS X Base System"`" -force
/usr/sbin/diskutil umount Recovery\ HD
fi


/usr/bin/setregproptool -c
FIRMWARESET=`echo "$?"`
if [ $FIRMWARESET -eq 0 ]; then
echo "Password Set in Firmware" > /private/tmp/firmware_status.txt
else
SYSTEMUSESNVRAM=`nvram security-mode`
if [ -n "$SYSTEMUSESNVRAM" ]; then
NVRAMPASSWORD=`nvram security-password`
if [ -n "$NVRAMPASSWORD" ]; then
echo "Password Set in NVRAM" > /private/tmp/firmware_status.txt
else
echo "Password NOT Set in NVRAM" > /private/tmp/firmware_status.txt
fi
else
echo "Password NOT Set in Firmware" > /private/tmp/firmware_status.txt
fi
fi

exit 0

##END##

delete fwstatus.sh
move __createfile fwstatus.sh
wait /bin/sh fwstatus.sh
delete fwstatus.sh

if {exists file "firmware_status.txt" of folder "/private/tmp"}
setting "_FirmwarePassword"="{lines of file "firmware_status.txt" of folder "/private/tmp"}" on "{now}" for client
else
setting "_FirmwarePassword"="FAILED" on "{now}" for client
endif
]]></ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action5520">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to Set the Firmware password.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[action parameter query "PASSWORD" with description "Enter the new firmware password"
delete __createfile
createfile until ##END##


#!/bin/sh

FIRMWARESTATUS="/private/tmp/firmware_status.txt"

if [ -z "`which setregproptool`" ]; then
/usr/sbin/diskutil quiet mount Recovery\ HD
if [ ! -d "/Volumes/Recovery HD/" ]; then
echo "ERROR - cannot retrive setregproptool from recovery partition. OS/HW version may be too old." > /private/tmp/firmware_status.txt
exit 1
fi
/usr/bin/hdiutil attach -nobrowse -quiet /Volumes/Recovery\ HD/com.apple.recovery.boot/BaseSystem.dmg
cp "/Volumes/`ls -b /Volumes/ | grep "OS X Base System"`/Applications/Utilities/Firmware Password Utility.app/Contents/Resources/setregproptool" /usr/bin
/usr/bin/hdiutil detach "/Volumes/`ls -b /Volumes/ | grep "OS X Base System"`" -force
/usr/sbin/diskutil umount Recovery\ HD
fi

/usr/bin/setregproptool -c
FIRMWARESET=`echo "$?"`
if [ $FIRMWARESET -eq 0 ]; then
echo "Password already in Firmware, can't change" > /private/tmp/firmware_status.txt
exit 1
else
SYSTEMUSESNVRAM=`nvram security-mode`
if [ -n "$SYSTEMUSESNVRAM" ]; then
/usr/bin/python efipw.py -p "{parameter "PASSWORD"}"
else
/usr/bin/setregproptool -m command -p "{parameter "PASSWORD"}"
fi
fi


/usr/bin/setregproptool -c
FIRMWARESET=`echo "$?"`
if [ $FIRMWARESET -eq 0 ]; then
echo "Password Set in Firmware" > /private/tmp/firmware_status.txt
else
SYSTEMUSESNVRAM=`nvram security-mode`
if [ -n "$SYSTEMUSESNVRAM" ]; then
NVRAMPASSWORD=`nvram security-password`
if [ -n "$NVRAMPASSWORD" ]; then
echo "Password Set in NVRAM" > /private/tmp/firmware_status.txt
else
echo "Password NOT Set in NVRAM" > /private/tmp/firmware_status.txt
fi
else
echo "Password NOT Set in Firmware" > /private/tmp/firmware_status.txt
fi
fi


##END##

delete fwstatus.sh
move __createfile fwstatus.sh

createfile until ##END##

#!/usr/bin/env python
"""
    EFIPW (C) 2010 by Paul Makowski (my.hndl@gmail.com)
    http://paulmakowski.wordpress.com/
    License: GPLv3
"""
from optparse import OptionParser
import os
import binascii

parser = OptionParser(version="%prog 0.2b")

if os.geteuid(): parser.error("Must be run as root. (e.g. sudo ./efipw.py [options])")

parser.add_option("-p", "--password", dest="newPassword", metavar="PASSWORD", type="string", help="set new EFI password")

(options, args) = parser.parse_args()

# lolCrypt: Apple's lolzy encryption function
def lolCrypt(input):
    output = ""
    for i in range(0, len(input)): output += (chr(ord(input[i]) ^ 170)) # 170 in decimal is 10101010 in binary; this is the key...don't tell anyone ;)
    return output

def splitLen(seq, length): return [seq[i:i+length] for i in range(0, len(seq), length)]

if options.newPassword:
    newMode = "command"
    if len(options.newPassword) > 48: print "Password cannot be longer than 48 characters; new password not set."
    else:
        newPassword = splitLen(binascii.hexlify(lolCrypt(options.newPassword)), 2)
        for i in range(len(newPassword)): newPassword[i] = '%' + newPassword[i]
        newPassword = ''.join(newPassword)
        p = os.popen('nvram security-password=' + newPassword,"r")
        p = os.popen('nvram security-mode=' + newMode,"r")


##END##

delete efipw.py
move __createfile efipw.py


wait /bin/sh fwstatus.sh
//secure remove this file as it has a password in it
wait /usr/bin/srm fwstatus.sh
wait /usr/bin/srm efipw.py

if {exists file "firmware_status.txt" of folder "/private/tmp"}
setting "_FirmwarePassword"="{lines of file "firmware_status.txt" of folder "/private/tmp"}" on "{now}" for client
else
setting "_FirmwarePassword"="FAILED" on "{now}" for client
endif]]></ActionScript>
      <SuccessCriteria Option="CustomRelevance"></SuccessCriteria>
    </Action>
  </Fixlet>
</BES>
