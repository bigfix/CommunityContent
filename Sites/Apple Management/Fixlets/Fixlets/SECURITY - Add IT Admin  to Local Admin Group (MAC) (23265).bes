  <Fixlet>
    <Title>SECURITY - Add IT Admin to Local Admin Group (MAC)</Title>
    <Description>This fixlet will allow AD users to be administrators on the local machine for OSX. </Description>
    <Relevance>mac of operating system</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-29</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 16 Jan 2017 20:02:15 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-sh">#!/bin/sh
# Enter your action script here
sudo dseditgroup -o edit -a &quot;domain\group&quot; -t group admin
sudo dseditgroup -o edit -a &quot;domain\group&quot; -t group admin
sudo dseditgroup -o edit -a &quot;domain\group&quot; -t group admin
sudo dseditgroup -o edit -a &quot;domain\group&quot; -t group admin</ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
