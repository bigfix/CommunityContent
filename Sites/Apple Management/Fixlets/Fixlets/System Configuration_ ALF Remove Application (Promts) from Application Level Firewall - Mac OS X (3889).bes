<!--
  BigFix Fixlet Export

  Title    : System Configuration: ALF Remove Application (Promts) from Application Level Firewall - Mac OS X
  ID       : 3889
  Author   : rustymyers
  Domain   : BESC
  Imported : 2014-10-13T10:54:30
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>System Configuration: ALF Remove Application (Promts) from Application Level Firewall - Mac OS X</Title>
    <Description><![CDATA[<P>This task removes an application and turns on the Application Level Firewall included with Mac OS X. </P>
<P>The path to the application is requested when starting the action.<BR><FONT color=#ff0000>WARNING: This task suffers from lack of relevance because of action parameter. Running it multiple times may cause unexpected results, including multiple entries for the same application.</FONT></P>
<P>The default firewall state is off for Mac OS X.</P>
<P>This fixlet is applicable on Mac OS X 10.6 or later.</P>
<P>If you have questions or concerns please visit <A href="http://clc.its.psu.edu/help">http://clc.its.psu.edu/help</A> to submit a SysMan Help Request.</P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.6" as version]]></Relevance>
    <Relevance>exists file &quot;/usr/libexec/ApplicationFirewall/socketfilterfw&quot;</Relevance>
    <Category>System Configuration</Category>
    <Source>SysMan</Source>
    <SourceID>rzm102</SourceID>
    <SourceReleaseDate>2014-10-13</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 13 Oct 2014 15:57:10 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action parameter query &quot;apppath&quot; with description &quot;Enter path of application&quot;
wait /usr/libexec/ApplicationFirewall/socketfilterfw --remove &quot;{parameter apppath}&quot;
wait /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
