<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Troubleshooting - RES ONE Workspace Suite - Disable Tracing - Windows</Title>
    <Description>Disables Workspace Manager tracing on the targeted client. </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists value &quot;Trace&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager&quot; of x32 registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-06-17</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 22:01:51 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Source Release Date: 2016-06-17
// Enter your action script here
regdelete &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager]&quot; &quot;Trace&quot;
regdelete &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager]&quot; &quot;TraceDetailed&quot;
regdelete &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager]&quot; &quot;TraceFile&quot;
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
