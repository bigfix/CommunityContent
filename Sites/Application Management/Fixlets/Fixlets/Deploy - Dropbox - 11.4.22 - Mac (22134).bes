      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch B1415A7223F47864FFA60E75D5A33F2A9619EB40.dmg sha1:B1415A7223F47864FFA60E75D5A33F2A9619EB40 size:94459975 https://clientupdates.dropboxstatic.com/client/Dropbox%2011.4.22.dmg sha256:46F1BD6C6DCA392BCC848613FA695D621F3F3970402C482D2DC41375FDE19F98

delete &quot;/tmp/B1415A7223F47864FFA60E75D5A33F2A9619EB40.dmg&quot;

move &quot;__Download/B1415A7223F47864FFA60E75D5A33F2A9619EB40.dmg&quot; &quot;/tmp/B1415A7223F47864FFA60E75D5A33F2A9619EB40.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTB1415A7223F47864FFA60E75D5A33F2A9619EB40&quot; &quot;/tmp/B1415A7223F47864FFA60E75D5A33F2A9619EB40.dmg&quot;

wait sh -c &quot;rm /tmp/B1415A7223F47864FFA60E75D5A33F2A9619EB40.dmg&quot;

wait cp -R /tmp/BESMNTPTB1415A7223F47864FFA60E75D5A33F2A9619EB40/* /tmp/BESTEMPB1415A7223F47864FFA60E75D5A33F2A9619EB40

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTB1415A7223F47864FFA60E75D5A33F2A9619EB40/. /tmp/BESTEMPB1415A7223F47864FFA60E75D5A33F2A9619EB40&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTB1415A7223F47864FFA60E75D5A33F2A9619EB40 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPB1415A7223F47864FFA60E75D5A33F2A9619EB40/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPB1415A7223F47864FFA60E75D5A33F2A9619EB40&apos;&quot;
</ActionScript>
