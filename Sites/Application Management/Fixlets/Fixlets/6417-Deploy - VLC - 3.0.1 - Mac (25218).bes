move &quot;__Download/1D58133445BB8C0D23B5AC605F4D9CD830BD7F68.dmg&quot; &quot;/tmp/1D58133445BB8C0D23B5AC605F4D9CD830BD7F68.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT1D58133445BB8C0D23B5AC605F4D9CD830BD7F68&quot; &quot;/tmp/1D58133445BB8C0D23B5AC605F4D9CD830BD7F68.dmg&quot;

wait sh -c &quot;rm /tmp/1D58133445BB8C0D23B5AC605F4D9CD830BD7F68.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT1D58133445BB8C0D23B5AC605F4D9CD830BD7F68/. /tmp/BESTEMP1D58133445BB8C0D23B5AC605F4D9CD830BD7F68&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT1D58133445BB8C0D23B5AC605F4D9CD830BD7F68 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP1D58133445BB8C0D23B5AC605F4D9CD830BD7F68/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP1D58133445BB8C0D23B5AC605F4D9CD830BD7F68&apos;&quot;
