  Imported : 2013-07-02T10:56:46
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Deploy LibreOffice 4.0.4</Title>
    <Description><![CDATA[This task will deploy LibreOffice 4.0.4 <BR><BR>This task is applicable on Mac OS X 10.5, Mac OS X 10.6, Mac OS X 10.7 and Mac OS X 10.8 ]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[(system version >= "10.5" AND system version < "10.9")]]></Relevance>
    <Relevance><![CDATA[not exists application whose (name of it as string is "LibreOffice.app" and ((version of it) >= "4.0.4.2" as version)) of applications folder]]></Relevance>
    <Category>Software Deployment</Category>
    <Source>Mac Software Deployment Wizard</Source>
    <SourceReleaseDate>2026-09-17</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Mac Software Deployment Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 02 Jul 2013 12:59:43 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch LibreOffice_4.0.4_MacOS_x86.dmg sha1:10718000ce6ba97a345dbcd34db45ba9dd21833d size:167191065 http://download.documentfoundation.org/libreoffice/stable/4.0.4/mac/x86/LibreOffice_4.0.4_MacOS_x86.dmg
wait hdiutil attach -quiet -nobrowse -mountpoint &quot;/tmp/LIBREOFFICE&quot; &quot;{posix path of file &quot;LibreOffice_4.0.4_MacOS_x86.dmg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot;
continue if {exists folder &quot;/tmp/LIBREOFFICE/LibreOffice.app&quot;}
wait /bin/rm -rf &quot;/Applications/LibreOffice.app&quot;
wait /bin/cp -Rfp &quot;/tmp/LIBREOFFICE/LibreOffice.app&quot; &quot;/Applications&quot;
wait /usr/bin/hdiutil detach -force &quot;/tmp/LIBREOFFICE&quot;
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
