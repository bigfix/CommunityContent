wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPT72820314FD5230A22E180E3B453F648908D6C51E" "/tmp/72820314FD5230A22E180E3B453F648908D6C51E.dmg"

wait sh -c "rm /tmp/72820314FD5230A22E180E3B453F648908D6C51E.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPT72820314FD5230A22E180E3B453F648908D6C51E/. /tmp/BESTEMP72820314FD5230A22E180E3B453F648908D6C51E"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPT72820314FD5230A22E180E3B453F648908D6C51E | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMP72820314FD5230A22E180E3B453F648908D6C51E/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMP72820314FD5230A22E180E3B453F648908D6C51E'"
