<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update - Dropbox - 22.4.24.0 - Windows</Title>
    <Description>This fixlet is for Update - Dropbox - 22.4.24.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 81013160 * 2) and (exists value "DisplayVersion" whose (it as string as version < "22.4.24.0") of keys whose (value "DisplayName" of it as string is "Dropbox" and value "UninstallString" of it as string contains "DropboxUninstaller.exe") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2017-04-03</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:dropbox:dropbox:22.4.24.0:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:dropbox:dropbox:22.4.24.0</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch F70C2221F7CCABFAE8A0C9C54FF3838A424903E6.exe sha1:F70C2221F7CCABFAE8A0C9C54FF3838A424903E6 size:81013160 https://clientupdates.dropboxstatic.com/client/Dropbox%2022.4.24%20Offline%20Installer.exe sha256:37D27D3EBD0426BE061495E9EFD4D67F7E3DD3B582F89FEA6A31B45B3FB9BEB0

// If DropBox is already launching on login then don&apos;t change
if {exists value &quot;Dropbox&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Run&quot; of x32 registry}
	override wait
	hidden=true
	wait &quot;__Download\F70C2221F7CCABFAE8A0C9C54FF3838A424903E6.exe&quot; /S

// Remove run entry if it isn&apos;t there already
else
	override wait
	hidden=true
	wait &quot;__Download\F70C2221F7CCABFAE8A0C9C54FF3838A424903E6.exe&quot; /S

	// Remove the RunOnce Shortcut
	regdelete &quot;[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Run]&quot; &quot;Dropbox&quot;

endif

// Always delete the desktop shortcut
delete &quot;{value of variable &quot;PUBLIC&quot; of environment}\Desktop\Dropbox.lnk&quot;
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
