<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Upgrade: Office Web Components 2003 - Windows</Title>
    <Description>&lt;P&gt;This Task installs the Office Web Components, which are require to view some of the reports in WebReports.&lt;/P&gt;
&lt;P&gt;Adapted from&amp;nbsp;the IBM fixlet:&amp;nbsp; Missing Office Web Components - BES Console - OWC 2003&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;
&lt;P&gt;&lt;STRONG&gt;References:&lt;/STRONG&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href=&quot;http://www.microsoft.com/en-us/download/details.aspx?id=1878&quot;&gt;http://www.microsoft.com/en-us/download/details.aspx?id=1878&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href=&quot;http://www.microsoft.com/en-us/download/details.aspx?id=22276&quot;&gt;http://www.microsoft.com/en-us/download/details.aspx?id=22276&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&lt;A href=&quot;http://support2.microsoft.com/kb/972129&quot;&gt;http://support2.microsoft.com/kb/972129&lt;/A&gt;&lt;/P&gt;
&lt;P&gt;&amp;nbsp;&lt;/P&gt;</Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance>/* Windows Vista or Higher */ version of operating system &gt;= &quot;6.0&quot;</Relevance>
    <Relevance>not (exists files &quot;owc11.dll&quot; whose (version of it &gt;= &quot;12.0.6211.1000&quot;) of folders &quot;\Microsoft Shared\Web Components\11&quot; of folders (value &quot;CommonFilesDir&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion&quot; of registry as string))</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2014-10-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 03 Oct 2014 19:26:51 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch owc11.exe sha1:1fc5601201c531d254f1fefa09288b2c9e3304c5 size:18470712 http://download.microsoft.com/download/c/f/f/cff746cd-f17c-40d8-acf2-50d2200ad28b/owc11.exe  sha256:83cf93b09fa76dcfadf29ad0a1908f9dabfca24feedc7c1d4a82cd2aacd57b3d

prefetch owc2007sp1-kb937961-fullfile-en-us.exe sha1:9a3e44ca5621c82724fa070b20ae67030a24aa07 size:6593384 http://download.microsoft.com/download/5/2/e/52e465ed-d515-4d7d-a5a6-c895ee773243/owc2007sp1-kb937961-fullfile-en-us.exe

wait __Download\owc11.exe /quiet /passive /norestart
wait __Download\owc2007sp1-kb937961-fullfile-en-us.exe /quiet /passive /norestart
//wait msiexec.exe /i owc11.msi reboot=reallysuppress /q

//run &quot;{pathname of client folder of site &quot;BESSupport&quot; &amp; &quot;\RunQuiet.exe&quot;}&quot; &quot;{pathname of client folder of site &quot;BESSupport&quot; &amp; &quot;\qchain.exe&quot;}&quot;
action may require restart
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
