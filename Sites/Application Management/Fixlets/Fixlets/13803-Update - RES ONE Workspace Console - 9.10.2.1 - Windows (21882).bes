<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update - RES ONE Workspace Console - 9.10.2.1 - Windows</Title>
    <Description><![CDATA[<P>Updates the corresponding RES ONE Workspace 2015 SR1 Component to RES ONE Workspace 2015 SR2 (Version&nbsp;9.10.2.1)</P>
<P>If your console is also a client <STRONG>this fixlet will upgrade the client </STRONG>at the same time as it upgrades the console.</P>
<P>If your console is also a relay <STRONG>this fixlet will upgrade the relay</STRONG> at the same time as it upgrades the console.</P>
<P>If your relay is also the root RES server please use the corresponding Update Server Fixlet instead.</P>]]></Description>
    <Relevance>NOT exists main gather service</Relevance>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[exists key "HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager" whose (value "Version" of it as string as version < "9.10.2.1" as version) of x32 registry /* Client is older version */]]></Relevance>
    <Relevance><![CDATA[exists file (pathname of parent folder of parent folder of file of service "res" & "\pwrtech.exe") /* Console is Installed */]]></Relevance>
    <Category>Upgrade</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-10-03</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 22:01:55 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Source Release Date: 2016-10-03
prefetch RES-ONE-Workspace-2015-Auto-Service-Pack-9.10.2.1.exe sha1:F3C645642109BE0C9FD6D7B971B8F0990D8BEBC1 size:48951144 http://downloads.ressoftware.com/downloads/cdm/9.10.2.1/RES-ONE-Workspace-2015-Auto-Service-Pack-9.10.2.1.exe sha256:EC95C5F04FFF41C25E302A226D09733C6BE73FC90C48D97D8C5026CB7AAD4CF2

waithidden &quot;__Download\RES-ONE-Workspace-2015-Auto-Service-Pack-9.10.2.1.exe&quot;</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
