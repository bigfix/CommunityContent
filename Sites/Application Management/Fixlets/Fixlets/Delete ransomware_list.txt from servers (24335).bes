<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Delete ransomware_list.txt from servers</Title>
    <Description>Delete txt files containing ransomware scan </Description>
    <Relevance>exists folder &quot;c:\&quot;</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-04</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 16 May 2017 02:46:56 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">waithidden cmd /c if exist c:\ransomware_list.txt del c:\ransomware_list.txt /q /f
