action requires restart &quot;!SHA!&quot;

delete &quot;/tmp/CF8EFEFC157E4B833A1E63BE9ED491C541B27DF7.dmg&quot;

move &quot;__Download/CF8EFEFC157E4B833A1E63BE9ED491C541B27DF7.dmg&quot; &quot;/tmp/CF8EFEFC157E4B833A1E63BE9ED491C541B27DF7.dmg&quot;

