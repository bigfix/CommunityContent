wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPT8C7972B787C6B9FC7DF4DE39B0CA5A21B02BD316" "/tmp/8C7972B787C6B9FC7DF4DE39B0CA5A21B02BD316.dmg"

