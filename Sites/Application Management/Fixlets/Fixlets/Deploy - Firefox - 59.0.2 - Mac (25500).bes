wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPT8C7972B787C6B9FC7DF4DE39B0CA5A21B02BD316 | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

