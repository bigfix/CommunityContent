<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>BHBC CUSTOM: AC 120319: shockwave remover mk1</Title>
    <Description>An update to the Adobe uninstaller published by jgstew here: https://www.bigfix.me/fixlet/details/775 I&apos;ve modified it to work on 32bit or 64bit shockwave on 64 bit systems.

Uploaded 2nd version after changing the /s to /quiet in the new msiexec syntax</Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance>exists (keys whose (value &quot;DisplayName&quot; of it as string as lowercase starts with &quot;adobe shockwave player&quot; AND value &quot;DisplayName&quot; of it as string as lowercase does not contain &quot;update&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of it) of (x64 registry;x32 registry)</Relevance>
    <Category>uninstaller</Category>
    <Source>Internal</Source>
    <SourceID>acybulski</SourceID>
    <SourceReleaseDate>2019-12-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 04 Dec 2019 19:21:10 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Enter your action script here
if {exists (keys whose (value &quot;DisplayName&quot; of it as string as lowercase starts with &quot;adobe shockwave player&quot; AND value &quot;DisplayName&quot; of it as string as lowercase does not contain &quot;update&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of it) of (x64 registry)}
waithidden {value &quot;uninstallstring&quot; of (keys whose (value &quot;DisplayName&quot; of it as string as lowercase starts with &quot;adobe shockwave player&quot; AND value &quot;DisplayName&quot; of it as string as lowercase does not contain &quot;update&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of it) of (x64 registry)} /quiet
elseif {exists (keys whose (value &quot;DisplayName&quot; of it as string as lowercase starts with &quot;adobe shockwave player&quot; AND value &quot;DisplayName&quot; of it as string as lowercase does not contain &quot;update&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of it) of (x32 registry)}
waithidden {value &quot;uninstallstring&quot; of (keys whose (value &quot;DisplayName&quot; of it as string as lowercase starts with &quot;adobe shockwave player&quot; AND value &quot;DisplayName&quot; of it as string as lowercase does not contain &quot;update&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of it) of (x32 registry)} /quiet
endif</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
