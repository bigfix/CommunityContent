<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Get External Public IP - HTTP - VBScript - Windows</Title>
    <Description>&amp;lt;enter a description of the task here&amp;gt; </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>not exists files whose(name of it as lowercase starts with &quot;public_ip_http_vbs.log&quot; AND name of it as lowercase ends with &quot;.log&quot; AND (now - modification time of it) &lt; 9*day ) of folders &quot;Logs&quot; of folders &quot;__Global&quot; of data folders of client</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2016-05-04</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 05 May 2016 21:02:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
// http://myip.dnsomatic.com
// http://whatismyip.org
// http://icanhazip.com
// http://ipecho.net/plain
// http://externip.com

parameter &quot;ProviderPublicIP&quot; = &quot;http://ipecho.net/plain&quot;

delete __createfile
// http://superuser.com/questions/404926/how-to-get-my-external-ip-address-over-nat-from-the-windows-command-line
createfile until END_OF_FILE
Option Explicit
Dim http : Set http = CreateObject( &quot;MSXML2.ServerXmlHttp&quot; )
http.Open &quot;GET&quot;, &quot;{parameter &quot;ProviderPublicIP&quot;}&quot;, False
http.Send
Wscript.Echo http.responseText   &apos;or do whatever you want with it
Set http = Nothing
END_OF_FILE

delete __Download\get_ip.vbs
copy __createfile __Download\get_ip.vbs

// http://stackoverflow.com/questions/16158083/skip-microsofts-message-at-beginning-of-a-file
waithidden cmd /C cscript __Download\get_ip.vbs //Nologo &gt; &quot;{pathname of folders &quot;Logs&quot; of folders &quot;__Global&quot; of data folders of client}\public_ip_http_vbs.log&quot;
</ActionScript>
    </DefaultAction>
  </Task>
</BES>
