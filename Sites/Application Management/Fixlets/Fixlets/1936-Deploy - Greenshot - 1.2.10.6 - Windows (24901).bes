<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - Greenshot - 1.2.10.6 - Windows</Title>
    <Description>This fixlet is for Deploy - Greenshot - 1.2.10.6 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 1783200 * 2) and (not exists keys "Greenshot_is1" of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2018-01-27</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:greenshot:greenshot:1.2.10.6:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:greenshot:greenshot:1.2.10.6</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:05 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 4E3AC7A53F0F368B9218BF717162D5E073A0F7DF.exe sha1:4E3AC7A53F0F368B9218BF717162D5E073A0F7DF size:1783200 https://github.com//greenshot/greenshot/releases/download/Greenshot-RELEASE-1.2.10.6/Greenshot-INSTALLER-1.2.10.6-RELEASE.exe sha256:1687311B4E7A3720BE20490E8ED6CC772A32336A7BED8896E475B8EC616C6B81

delete greenshot.inf
delete __createfile

createfile until _end_
[Setup]
SetupType=full
_end_

move __createfile greenshot.inf

//No JOB Completion here
override wait
hidden=true
wait "__Download\4E3AC7A53F0F368B9218BF717162D5E073A0F7DF.exe" /VERYSILENT /SP- /NORESTART /LOADINF="{(pathname of client folder of current site) & "\greenshot.inf"}"

waithidden reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run" /v "Greenshot" /f

waithidden taskkill /f /fi "imagename eq iexplore.exe" /fi "username eq System"]]></ActionScript>
    </DefaultAction>
  </Fixlet>
