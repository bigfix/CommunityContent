  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>TSM - Un-Configure Tivoli Storage Manager if dsm.opt is present - Apple</Title>
    <Description><![CDATA[<P>This action will configure TSM</P>
<P>&nbsp;</P>
<P>References:</P>
<P><A href="http://pic.dhe.ibm.com/infocenter/tsmfbinf/v6/index.jsp?topic=%2Fcom.ibm.itsm.fbws.doc%2Fhelp%2Fref%2Fcdp_ref_InstallCmdSyntax.html">http://pic.dhe.ibm.com/infocenter/tsmfbinf/v6/index.jsp?topic=%2Fcom.ibm.itsm.fbws.doc%2Fhelp%2Fref%2Fcdp_ref_InstallCmdSyntax.html</A><BR><A href="http://pic.dhe.ibm.com/infocenter/tsminfo/v6r2/index.jsp?topic=%2Fcom.ibm.itsm.client.doc%2Fc_cfg_dsmcutil_cmdwin.html">http://pic.dhe.ibm.com/infocenter/tsminfo/v6r2/index.jsp?topic=%2Fcom.ibm.itsm.client.doc%2Fc_cfg_dsmcutil_cmdwin.html</A><BR><A href="http://www.itninja.com/software/tivoli/tivoli-storage-manager/3-383">http://www.itninja.com/software/tivoli/tivoli-storage-manager/3-383</A></P>]]></Description>
    <Relevance>(name of operating system = &quot;Mac OS X&quot;) AND (if exists property &quot;in proxy agent context&quot; then (not in proxy agent context) else true) AND (if exists property &quot;android&quot; of type &quot;operating system&quot; then (not android of operating system) else true)</Relevance>
    <Relevance>exists folder &quot;/Applications/Tivoli Storage Manager&quot;</Relevance>
    <Relevance>exists file &quot;/Library/Application Support/tivoli/tsm/client/ba/bin/dsmcad&quot;</Relevance>
    <Relevance>exists file &quot;/Library/Application Support/tivoli/tsm/client/ba/bin/dsmagent&quot;</Relevance>
    <Relevance>exists file &quot;/Library/Preferences/Tivoli Storage Manager/dsm.opt&quot; OR exists file &quot;/Library/Preferences/Tivoli Storage Manager/dsm.sys&quot;</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2012-11-27</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 13 Dec 2012 18:26:20 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[delete "{(client folder of current site as string) & "/__appendfile"}"
appendfile #!/bin/sh
appendfile /bin/sleep 2
appendfile /sbin/SystemStarter stop dsmcad
appendfile exit 0
wait chmod 555 "{(client folder of current site as string) & "/__appendfile"}"
run {"/bin/sh -c %22trap '' 15;'" & (client folder of current site as string) & "/__appendfile'%22"}
delete "/Library/Preferences/Tivoli Storage Manager/dsm.opt.backup"
delete "/Library/Preferences/Tivoli Storage Manager/dsm.sys.backup"
move "/Library/Preferences/Tivoli Storage Manager/dsm.opt" "/Library/Preferences/Tivoli Storage Manager/dsm.opt.backup"
move "/Library/Preferences/Tivoli Storage Manager/dsm.sys" "/Library/Preferences/Tivoli Storage Manager/dsm.sys.backup"]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
