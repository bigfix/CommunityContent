      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 8131421DA79C2306F2CB8D3A328CB2699F230EB9.dmg sha1:8131421DA79C2306F2CB8D3A328CB2699F230EB9 size:98538791 https://clientupdates.dropboxstatic.com/client/Dropbox%2019.4.13.dmg sha256:22143FC23732C27A0FBC1E4C626BB7D32C847CCF5B5884789F592A73A33E8904

delete &quot;/tmp/8131421DA79C2306F2CB8D3A328CB2699F230EB9.dmg&quot;

move &quot;__Download/8131421DA79C2306F2CB8D3A328CB2699F230EB9.dmg&quot; &quot;/tmp/8131421DA79C2306F2CB8D3A328CB2699F230EB9.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT8131421DA79C2306F2CB8D3A328CB2699F230EB9&quot; &quot;/tmp/8131421DA79C2306F2CB8D3A328CB2699F230EB9.dmg&quot;

wait sh -c &quot;rm /tmp/8131421DA79C2306F2CB8D3A328CB2699F230EB9.dmg&quot;

wait cp -R /tmp/BESMNTPT8131421DA79C2306F2CB8D3A328CB2699F230EB9/* /tmp/BESTEMP8131421DA79C2306F2CB8D3A328CB2699F230EB9

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT8131421DA79C2306F2CB8D3A328CB2699F230EB9/. /tmp/BESTEMP8131421DA79C2306F2CB8D3A328CB2699F230EB9&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT8131421DA79C2306F2CB8D3A328CB2699F230EB9 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP8131421DA79C2306F2CB8D3A328CB2699F230EB9/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP8131421DA79C2306F2CB8D3A328CB2699F230EB9&apos;&quot;
</ActionScript>
