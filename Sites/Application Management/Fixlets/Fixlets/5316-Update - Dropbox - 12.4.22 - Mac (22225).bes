wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTB57EF5686541019D0CC63FE0394E3E1E51DFA82A&quot; &quot;/tmp/B57EF5686541019D0CC63FE0394E3E1E51DFA82A.dmg&quot;

