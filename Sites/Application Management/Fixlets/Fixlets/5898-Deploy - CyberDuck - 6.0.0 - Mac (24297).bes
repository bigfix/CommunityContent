move &quot;__Download/888DFBD65D63BDED696DAD10DD66CFEC4E03650F.zip&quot; &quot;/tmp/888DFBD65D63BDED696DAD10DD66CFEC4E03650F.zip&quot;

wait sh -c &quot;unzip -a &apos;/tmp/888DFBD65D63BDED696DAD10DD66CFEC4E03650F.zip&apos; -d &apos;/tmp/888DFBD65D63BDED696DAD10DD66CFEC4E03650F&apos;&quot;

