delete moveArchive.bat
//move all the extracted files and folders to our new folder.
createfile until _end_
@ECHO OFF
{concatenations "%0d%0a" of (("move %22" & item 1 of it as string & "%22 %22" & parameter "baseFolder" & "" & item 0 of it as string & "%22") of ((name of it, pathname of it) of files whose (name of it != "RunAsCurrentUser.exe" AND name of it != "compressedPackageData.bftemp") of it) of (download folder) ; ("move %22" & it as string & "%22 %22" & parameter "baseFolder" & "%22") of ((pathname of it) of folders whose (pathname of it does not end with (preceding text of last "\" of parameter "baseFolder" as string)) of it) of (download folder))}
_end_
move __createfile moveArchive.bat
waithidden moveArchive.bat



// Run setup process
delete __createfile
delete run.bat

// Use .bat to set working directy to packages root, for setup command.
createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
"setup.exe" /s /V"/qn"
_end_

move __createfile run.bat

// You will not be able to stop or take action on an applicable BES Client until your installer completes,
// so ensure no user input is required.
// If your package absolutely must interact with the user, replace waithidden with run.
