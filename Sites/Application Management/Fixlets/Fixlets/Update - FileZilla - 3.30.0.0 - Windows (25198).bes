    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
// FileZilla adds an x32 reg key even if you use the x64 installer....
if {x64 of operating system and (exists value &quot;InstallLocation&quot; whose (it as string contains &quot;Program Files\&quot;) of keys whose (value &quot;DisplayName&quot; of it as string starts with &quot;FileZilla Client&quot;) of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x32 registries))}
	prefetch 7B82112AC69B3299B1E244A114FCB494C41871E2.exe sha1:7B82112AC69B3299B1E244A114FCB494C41871E2 size:7906720 https://astuteinternet.dl.sourceforge.net/project/filezilla/FileZilla_Client/3.30.0/FileZilla_3.30.0_win64-setup.exe sha256:D63E0A0464AE9EC9673523BED0E4B760B7F91B178D018D280B7C9BDB6ED4B9AC

	override wait
	hidden=true
	completion=job
	wait &quot;__Download\7B82112AC69B3299B1E244A114FCB494C41871E2.exe&quot; /S /user=all
else
	prefetch 13F8F7D3C3BDCFC8C7D3EC86D1589738E809FB3B.exe sha1:13F8F7D3C3BDCFC8C7D3EC86D1589738E809FB3B size:7670520 https://phoenixnap.dl.sourceforge.net/project/filezilla/FileZilla_Client/3.30.0/FileZilla_3.30.0_win32-setup.exe sha256:72DDFFC7C452A7BFA8C738E27FBF1C14EA690BCDC15D480E2BE0D768A0914010

	override wait
	hidden=true
	completion=job
	wait &quot;__Download\13F8F7D3C3BDCFC8C7D3EC86D1589738E809FB3B.exe&quot; /S /user=all
endif
</ActionScript>
    </DefaultAction>
