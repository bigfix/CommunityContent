      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch BB88D96CF9B1504D36303A998BC0133E6CE80B3F.dmg sha1:BB88D96CF9B1504D36303A998BC0133E6CE80B3F size:118115909 https://clientupdates.dropboxstatic.com/dbx-releng/client/Dropbox%2048.4.58.dmg sha256:E28B4D399D3CD90FD1DB4CF8B614841F2E9807702A8DBC4A748DAB07FDD8995C

delete &quot;/tmp/BB88D96CF9B1504D36303A998BC0133E6CE80B3F.dmg&quot;

move &quot;__Download/BB88D96CF9B1504D36303A998BC0133E6CE80B3F.dmg&quot; &quot;/tmp/BB88D96CF9B1504D36303A998BC0133E6CE80B3F.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTBB88D96CF9B1504D36303A998BC0133E6CE80B3F&quot; &quot;/tmp/BB88D96CF9B1504D36303A998BC0133E6CE80B3F.dmg&quot;

wait sh -c &quot;rm /tmp/BB88D96CF9B1504D36303A998BC0133E6CE80B3F.dmg&quot;

wait cp -R /tmp/BESMNTPTBB88D96CF9B1504D36303A998BC0133E6CE80B3F/* /tmp/BESTEMPBB88D96CF9B1504D36303A998BC0133E6CE80B3F

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTBB88D96CF9B1504D36303A998BC0133E6CE80B3F/. /tmp/BESTEMPBB88D96CF9B1504D36303A998BC0133E6CE80B3F&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTBB88D96CF9B1504D36303A998BC0133E6CE80B3F | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPBB88D96CF9B1504D36303A998BC0133E6CE80B3F/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPBB88D96CF9B1504D36303A998BC0133E6CE80B3F&apos;&quot;
