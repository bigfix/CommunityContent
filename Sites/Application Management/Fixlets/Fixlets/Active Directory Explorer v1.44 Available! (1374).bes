<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Active Directory Explorer v1.44 Available!</Title>
    <Description><![CDATA[<P>Active Directory Explorer (AD Explorer) is an advanced Active Directory (AD) viewer and editor. You can use AD Explorer to easily navigate an AD database, define favorite locations, view object properties and attributes without having to open dialog boxes, edit permissions, view an object's schema, and execute sophisticated searches that you can save and re-execute.</P>
<P>AD Explorer also includes the ability to save snapshots of an AD database for off-line viewing and comparisons. When you load a saved snapshot, you can navigate and explorer it as you would a live database. If you have two snapshots of an AD database you can use AD Explorer's comparison functionality to see what objects, attributes and security permissions changed between them.</P>]]></Description>
    <Relevance>name of operating system starts with &quot;Win&quot;</Relevance>
    <Relevance>not exists file &quot;AdExplorer.exe&quot; of windows folder</Relevance>
    <Category>Install</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2013-01-10</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 10 Jan 2013 18:31:30 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here </Link>
        <PostLink>to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action parameter query &quot;EULA&quot; with description &quot;Click OK if you agree to the SysInternals EULA (see http://technet.microsoft.com/en-us/sysinternals/bb963907) on behalf of the System Account on the endpoint(s).&quot; and with default value &quot;I AGREE&quot;
continue if {parameter &quot;EULA&quot; = &quot;I AGREE&quot;}
prefetch AdExplorer.zip sha1:f7e154e519ca0b593a55e980715a3a4bbb2d391d size:249327 http://download.sysinternals.com/files/AdExplorer.zip
prefetch unzip.exe sha1:84debf12767785cd9b43811022407de7413beb6f size:204800 http://software.bigfix.com/download/redist/unzip-6.0.exe sha256:2122557d350fd1c59fb0ef32125330bde673e9331eb9371b454c2ad2d82091ac
utility __Download\unzip.exe
waithidden __Download\unzip.exe -qq -o -d &quot;{pathname of client folder of current site}\__Download&quot; __Download\AdExplorer.zip
copy &quot;{pathname of client folder of current site}\__Download\AdExplorer.exe&quot; &quot;{pathname of windows folder}\AdExplorer.exe&quot;
continue if {version of file &quot;AdExplorer.exe&quot; of windows folder = &quot;1.44.0.0&quot;}
//Set EULA agreement flags
regset &quot;[HKEY_CURRENT_USER\Software\Sysinternals\AdExplorer]&quot; &quot;EulaAccepted&quot;=dword:00000001
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action878">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn about Peter Hahndorf&apos;s research into accepting Sysinternals Licenses.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://peter.hahndorf.eu/blog/2010/03/07/WorkAroundSysinternalsLicensePopups.aspx</ActionScript>
    </Action>
    <Action ID="Action1623">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn more about this application.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://technet.microsoft.com/en-us/sysinternals/bb963907</ActionScript>
    </Action>
  </Task>
