      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch BBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD.dmg sha1:BBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD size:110375017 https://clientupdates.dropboxstatic.com/dbx-releng/client/Dropbox%2043.4.50.dmg sha256:AE400277041CE5AE8E2568F9A0B21E27139651E6013337B2A27AB0D8E35AD5EE

delete &quot;/tmp/BBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD.dmg&quot;

move &quot;__Download/BBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD.dmg&quot; &quot;/tmp/BBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTBBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD&quot; &quot;/tmp/BBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD.dmg&quot;

wait sh -c &quot;rm /tmp/BBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD.dmg&quot;

wait cp -R /tmp/BESMNTPTBBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD/* /tmp/BESTEMPBBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTBBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD/. /tmp/BESTEMPBBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTBBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPBBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPBBFE22FD0F8FB6C76FDEF4EC9DE784DB50B0F2BD&apos;&quot;
</ActionScript>
