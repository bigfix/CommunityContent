      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 819752AA73A43B01DD06ABB5CF98B791099B942C.dmg sha1:819752AA73A43B01DD06ABB5CF98B791099B942C size:25329166 https://adiumx.cachefly.net/Adium_1.5.10.2.dmg sha256:EA1A1016A383C59198C43F37576EDB0045E391F46CA5402B0F6365E9D5D7F395

delete &quot;/tmp/819752AA73A43B01DD06ABB5CF98B791099B942C.dmg&quot;

move &quot;__Download/819752AA73A43B01DD06ABB5CF98B791099B942C.dmg&quot; &quot;/tmp/819752AA73A43B01DD06ABB5CF98B791099B942C.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT819752AA73A43B01DD06ABB5CF98B791099B942C&quot; &quot;/tmp/819752AA73A43B01DD06ABB5CF98B791099B942C.dmg&quot;

wait sh -c &quot;rm /tmp/819752AA73A43B01DD06ABB5CF98B791099B942C.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT819752AA73A43B01DD06ABB5CF98B791099B942C/. /tmp/BESTEMP819752AA73A43B01DD06ABB5CF98B791099B942C&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT819752AA73A43B01DD06ABB5CF98B791099B942C | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP819752AA73A43B01DD06ABB5CF98B791099B942C/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP819752AA73A43B01DD06ABB5CF98B791099B942C&apos;&quot;
</ActionScript>
