<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update - CDBurnerXP - 4.5.7.6282 - Windows</Title>
    <Description>This fixlet is for Update - CDBurnerXP - 4.5.7.6282 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance>(windows of operating system) and (version of operating system &gt;= &quot;6.1&quot;) and (if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true) and (free space of drive of client &gt; 6231616 * 2) and exists (key of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of ( x32 registry; (if exists x64 registry then x64 registry else nothing) )) whose (value &quot;DisplayName&quot; of it as string is &quot;CDBurnerXP&quot; and value &quot;DisplayVersion&quot; of it as string as version &lt; &quot;4.5.7.6282&quot; as version)</Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//Comment

prefetch D0BC565378471FA5275855F960390F135026C0B2 sha1:D0BC565378471FA5275855F960390F135026C0B2 size:6231616 https://cdburnerxp.se/downloadsetup.exe sha256:9F753020720699FA88083DF8007BBF79BEA560A16FD30BA69AC66E2F8DC4FDB9

parameter &quot;baseFolder&quot; =  &quot;__Download/&quot;

delete &quot;{parameter &quot;baseFolder&quot;}CDBurnerXP.exe&quot;
move &quot;__Download/D0BC565378471FA5275855F960390F135026C0B2&quot; &quot;{parameter &quot;baseFolder&quot;}CDBurnerXP.exe&quot; 

parameter &quot;logFolder&quot; = &quot;{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs&quot;
folder create &quot;{parameter &quot;logFolder&quot;}&quot;
parameter &quot;logFile&quot; = &quot;PGW.log&quot;

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd &quot;{parameter &quot;baseFolder&quot;}&quot;
mkdir &quot;{parameter &quot;logFolder&quot;}&quot;

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | &quot;Debugger&quot; as string} - CDBurnerXP &gt;&gt; &quot;{parameter &quot;logFolder&quot;}/{parameter &quot;logFile&quot;}&quot;

&quot;CDBurnerXP.exe&quot; /VERYSILENT &gt;&gt; &quot;{parameter &quot;logFolder&quot;}/{parameter &quot;logFile&quot;}&quot; 2&gt;&amp;1

echo Return code: %errorlevel% &gt;&gt; &quot;{parameter &quot;logFolder&quot;}/{parameter &quot;logFile&quot;}&quot;
echo. &gt;&gt; &quot;{parameter &quot;logFolder&quot;}/{parameter &quot;logFile&quot;}&quot;

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
