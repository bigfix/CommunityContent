<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - Greenshot - 1.2.8.12 - Windows</Title>
    <Description>This fixlet is for Deploy - Greenshot - 1.2.8.12 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 1374661 * 2) and (not exists keys "Greenshot_is1" of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2016-10-04</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:greenshot:greenshot:1.2.8.12:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:greenshot:greenshot:1.2.8.12</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 8D0354D68D0E00BD5753B50738FFB115EA8FBD4C.exe sha1:8D0354D68D0E00BD5753B50738FFB115EA8FBD4C size:1374661 https://github.com//greenshot/greenshot/releases/download/Greenshot-RELEASE-1.2.8.12/Greenshot-INSTALLER-1.2.8.12-RELEASE.exe sha256:D229D905BB8141F2CDF4C82899B66B437A5ED6A0BEB3BDCF701FDB3416AC7D74

delete greenshot.inf
delete __createfile

createfile until _end_
[Setup]
SetupType=full
_end_

move __createfile greenshot.inf

//No JOB Completion here
override wait
hidden=true
wait "__Download\8D0354D68D0E00BD5753B50738FFB115EA8FBD4C.exe" /VERYSILENT /SP- /NORESTART /LOADINF="{(pathname of client folder of current site) & "\greenshot.inf"}"

waithidden reg delete "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run" /v "Greenshot" /f

waithidden taskkill /f /fi "imagename eq iexplore.exe" /fi "username eq System"]]></ActionScript>
    </DefaultAction>
  </Fixlet>
