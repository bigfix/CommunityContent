<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Start Identity Finder IDFEndpointService if not running</Title>
    <Description>If for some reason the Identity Finder Endpoint Service stops running, this action will start it up.</Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists service &quot;IDFEndpointService&quot;</Relevance>
    <Relevance>not exists running service &quot;IDFEndpointService&quot;</Relevance>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2011-11-23</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 29 Nov 2011 18:34:06 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">waithidden net start IDFEndpointService</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
