      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 76858C813E9974B187EDFD71CE6D83C6506D6A3C.dmg sha1:76858C813E9974B187EDFD71CE6D83C6506D6A3C size:58415011 http://download.gimp.org/mirror/pub/gimp/v2.8/osx/gimp-2.8.18-x86_64.dmg sha256:2430A1A1A12D146B5198175FA1878D9CF556A3903707E536A51C9429BF664ECC

delete &quot;/tmp/76858C813E9974B187EDFD71CE6D83C6506D6A3C.dmg&quot;

move &quot;__Download/76858C813E9974B187EDFD71CE6D83C6506D6A3C.dmg&quot; &quot;/tmp/76858C813E9974B187EDFD71CE6D83C6506D6A3C.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT76858C813E9974B187EDFD71CE6D83C6506D6A3C&quot; &quot;/tmp/76858C813E9974B187EDFD71CE6D83C6506D6A3C.dmg&quot;

wait sh -c &quot;rm /tmp/76858C813E9974B187EDFD71CE6D83C6506D6A3C.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT76858C813E9974B187EDFD71CE6D83C6506D6A3C/. /tmp/BESTEMP76858C813E9974B187EDFD71CE6D83C6506D6A3C&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT76858C813E9974B187EDFD71CE6D83C6506D6A3C | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP76858C813E9974B187EDFD71CE6D83C6506D6A3C/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP76858C813E9974B187EDFD71CE6D83C6506D6A3C&apos;&quot;
</ActionScript>
