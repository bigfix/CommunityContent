<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Config - 1E NightWatchman Maintenance Window - 2am on Weekends - Win\Mac
  ID       : 24164
  Author   : strawgate
  Domain   : BESC
  Imported : 2017-05-02T07:26:33
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - 1E NightWatchman Maintenance Window - 2am on Weekends - Win\Mac</Title>
    <Description><![CDATA[<P>This Fixlet configures 1E to wake the machine into a maintenance window at 2am on Saturday and Sunday for&nbsp;1 hour. At the end of the maintenance window the computer will be left to do whatever it is normally configured to do.</P>
<P>The monitor will be not be turned on when this occurs.</P>
<P>This will overwrite any previously configured Maintenance Windows.</P>
<P>For general information or to report issues with C3 Power Management content please visit GitHub here: <A href="https://github.com/strawgate/C3-Power-Management">https://github.com/strawgate/C3-Power-Management</A></P>]]></Description>
    <Relevance>windows of operating system or mac of operating system</Relevance>
    <Relevance>if (Windows of Operating System) then (exists file &quot;NightWatchman.exe&quot; of folder (preceding text of last &quot;\&quot; of (it as string) of value &quot;InstallationDirectory&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry)) else (exists file &quot;nightwatchman&quot; of folder &quot;/Library/Application Support/1E/NightWatchman&quot;)</Relevance>
    <Relevance>if (windows of Operating System) then ( exists (values &quot;TurnOnMonitor&quot; whose (it != &quot;OFF&quot;) of it; values &quot;SaturdayCloseAction&quot; whose (it != &quot;Nothing&quot;) of it;  values &quot;SundayCloseAction&quot; whose (it != &quot;Nothing&quot;) of it; values &quot;SaturdayOpenTime&quot; whose (it != &quot;02:00&quot;) of it; values &quot;SundayOpenTime&quot; whose (it != &quot;02:00&quot;) of it;   values &quot;SaturdayPeriodMins&quot; whose (it as string != &quot;60&quot;) of it; values &quot;SundayPeriodMins&quot; whose (it as string != &quot;60&quot;) of it) of (keys &quot;MaintenanceWindow&quot; of keys &quot;1E\NightWatchman&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry) ) else ( (exists (strings &quot;Action&quot; whose (it != &quot;Nothing&quot;) of it; strings &quot;OpenAt&quot; whose (it != &quot;02:00&quot;) of it; strings &quot;OpenForMins&quot; whose (it != &quot;60&quot;) of it) of dictionaries whose (string &quot;Day&quot; of it = &quot;Saturday&quot; or string &quot;Day&quot; of it = &quot;Sunday&quot;) of values of arrays &quot;MaintenanceWindowSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot;) or (number of values of array &quot;MaintenanceWindowSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; != 2) )</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-09-06</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">parameter &quot;Setting&quot;=&quot;maintenancewnd&quot;

parameter &quot;1ECLI&quot;=&quot;{if (windows of operating system) then (pathname of file &quot;NightWatchman.exe&quot; of folder (value &quot;InstallationDirectory&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry as string)) else (pathname of file &quot;nightwatchman&quot; of folder &quot;/Library/Application Support/1E/NightWatchman&quot;) }&quot;

if {Windows of Operating System}

	wait &quot;{parameter &quot;1ECLI&quot;}&quot; -{parameter &quot;Setting&quot;}=&quot;monitorstate=off|SAT(02:00,60,0)|SUN(02:00,60,0)&quot;

elseif {Mac of Operating System}


	wait &quot;{parameter &quot;1ECLI&quot;}&quot; -{parameter &quot;Setting&quot;} sat=02:00,60,0 sun=02:00,60,0

endif</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
