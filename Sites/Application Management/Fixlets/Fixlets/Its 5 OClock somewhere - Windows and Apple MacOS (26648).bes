<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Its 5 OClock somewhere - Windows and Apple MacOS</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>(mac of operating system) OR (windows of operating system)</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2019-09-19</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 19 Sep 2019 11:46:23 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">

if{ mac of operating system }
// http://osxdaily.com/2012/07/04/set-system-time-mac-os-x-command-line/

wait date {concatenations of (month of it as two digits as string;day_of_month of it as two digits as string; &quot;1700&quot;;last 2 of (year of it as string) ) of current date}

endif

if{ windows of operating system }

wait CMD /C time 17:00:00.99

endif

// Related:
//      - https://bigfix.me/fixlet/details/2587
//      - https://bigfix.me/fixlet/details/2613
</ActionScript>
    </DefaultAction>
  </Task>
</BES>
