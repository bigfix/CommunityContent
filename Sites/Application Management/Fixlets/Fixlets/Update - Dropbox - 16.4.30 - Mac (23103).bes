wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT86868692790239EBD3E1CA7C7772733B8A39CDD7 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

