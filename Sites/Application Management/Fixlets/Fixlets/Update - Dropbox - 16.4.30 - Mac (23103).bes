move &quot;__Download/86868692790239EBD3E1CA7C7772733B8A39CDD7.dmg&quot; &quot;/tmp/86868692790239EBD3E1CA7C7772733B8A39CDD7.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT86868692790239EBD3E1CA7C7772733B8A39CDD7&quot; &quot;/tmp/86868692790239EBD3E1CA7C7772733B8A39CDD7.dmg&quot;

