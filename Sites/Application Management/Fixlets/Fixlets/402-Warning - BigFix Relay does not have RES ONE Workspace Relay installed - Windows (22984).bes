<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Warning - BigFix Relay does not have RES ONE Workspace Relay installed - Windows</Title>
    <Description>This fixlet is relevant on BigFix Relays that are not currently running the RES Relay software. </Description>
    <Relevance>exists relay service OR exists main gather service</Relevance>
    <Relevance>windows of operating system</Relevance>
    <Relevance>not exists service &quot;RESRLS&quot;</Relevance>
    <Relevance>exists service &quot;res&quot;</Relevance>
    <Category>Audit</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <SourceSeverity>Important</SourceSeverity>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 04:04:04 +0000</Value>
    </MIMEField>
    <Domain>RESS</Domain>
  </Fixlet>
</BES>
