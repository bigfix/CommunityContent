<!--
  BigFix Task Export

  Title    : Uninstall: Google Calendar Sync
  ID       : 791
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T22:06:48
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Uninstall: Google Calendar Sync</Title>
    <Description><![CDATA[<P>This task will uninstall Google Calendar Sync</P>
<P>Google Calendar Sync was found to close Outlook during sync when Zimbra (UCS) is installed.</P>]]></Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance>exists value &quot;UninstallString&quot; whose (it as string as lowercase contains &quot;uninstall.exe&quot; as lowercase) of key whose (value &quot;displayname&quot; of it as string as lowercase contains (&quot;Google Calendar Sync&quot; as lowercase) of it) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Category>Uninstaller</Category>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2011-12-16</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 16 Dec 2011 20:18:36 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Close GoogleCalendarSync.exe
waithidden taskkill /F /IM GoogleCalendarSync.exe
continue if{not exists running application whose (name of it as lowercase = &quot;GoogleCalendarSync.exe&quot; as lowercase)}
// Close Outlook.exe
waithidden taskkill /F /IM outlook.exe
continue if{not exists running application whose (name of it as lowercase = &quot;outlook.exe&quot; as lowercase)}
//Google Calendar Sync is a NSIS style install/uninstall
// http://nsis.sourceforge.net/Docs/Chapter3.html#3.2
wait {value &quot;UninstallString&quot; whose (it as string as lowercase contains &quot;uninstall.exe&quot; as lowercase) of key whose (value &quot;displayname&quot; of it as string as lowercase contains (&quot;Google Calendar Sync&quot; as lowercase) of it) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry} /S
action may require restart</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
