  <Fixlet>
    <Title>WinSCP Update 5.11.2</Title>
    <Description>WinSCP Software Update to Version 5.11.2 </Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 9166680 * 2) and (exists value "DisplayVersion" whose (it as string as version < "5.11.2") of keys whose (value "DisplayName" of it as string starts with "WinSCP") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>WinSCP</Source>
    <SourceReleaseDate>2017-10-13</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 13 Oct 2017 12:18:56 +0000</Value>
    </MIMEField>
