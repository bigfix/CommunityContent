<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Upgrade: Notepad++ v6.5.3</Title>
    <Description><![CDATA[<P>This task will deploy: Notepad++ v6.5.3</P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* WinXP or later */ version of operating system >= "5.1"]]></Relevance>
    <Relevance><![CDATA[not exists keys whose (value "DisplayName" of it as string as lowercase contains "Notepad++" as lowercase AND value "DisplayVersion" of it as string as version >="6.5.3" as version) of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry]]></Relevance>
    <Category>Software Sharing</Category>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2014-01-22</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 22 Jan 2014 22:07:22 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here </Link>
        <PostLink>to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch npp.6.5.3.Installer.exe sha1:bceb472ffb5ca2ebc65cac4754d592fa137ea2bc size:7598942 http://download.tuxfamily.org/notepadplus/6.5.3/npp.6.5.3.Installer.exe

wait __Download\npp.6.5.3.Installer.exe /S</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
