<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update: Adobe ETLA Creative Cloud: Adobe Photoshop 2014 CC 15.2.2 x64 - Windows</Title>
    <Description>This task will update Adobe Photoshop from version 15 to version 15.2.2</Description>
    <Relevance>x64 of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or later */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[exists keys whose (value "DisplayName" of it as string contains "Adobe Photoshop" AND (it >= "15.0" as version AND it < "15.2.2" as version) of (value "DisplayVersion" of it as string as version)) of keys "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries;x32 registries)]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2015-04-17</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 17 Apr 2015 20:09:00 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
prefetch setup.zip sha1:af9959a51c8d7b9f20084c73d6b5ac96270c34fb size:258885169 http://swupdl.adobe.com/updates/oobe/aam20/win/AdobePhotoshopCC2014-15.0/15.2.2/setup.zip

//  - This unzip is a compiled verion of unzip v5.52 fom http://info-zip.org/
//  - https://www.virustotal.com/en/file/8d9b5190aace52a1db1ac73a65ee9999c329157c8e88f61a772433323d6b7a4a/analysis
prefetch unzip.exe sha1:84debf12767785cd9b43811022407de7413beb6f size:204800 http://software.bigfix.com/download/redist/unzip-6.0.exe sha256:2122557d350fd1c59fb0ef32125330bde673e9331eb9371b454c2ad2d82091ac

// ADD TO UTILITY CACHE (to use in multiple tasks)
utility __Download\unzip.exe

waithidden __Download\unzip.exe -o &quot;{pathname of file &quot;setup.zip&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; -d &quot;{pathname of folder &quot;__Download&quot; of client folder of current site}&quot;

// --mode=silent --skipProcessCheck=1
waithidden __Download\AdobePatchInstaller.exe --mode=silent
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
