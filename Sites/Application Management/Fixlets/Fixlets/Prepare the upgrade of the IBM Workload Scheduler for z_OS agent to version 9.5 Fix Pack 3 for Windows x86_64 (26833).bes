  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Prepare the upgrade of the IBM Workload Scheduler for z/OS agent to version 9.5 Fix Pack 3 for Windows x86_64</Title>
    <Description><![CDATA[<P>Prepare the upgrade of the IBM Workload Scheduler for z/OS agent to version 9.5 Fix Pack 3 for Windows x86_64</P>
<P>The following fixlet performs the following actions:</P>
<UL>
<LI>Downloads the images from the BigFix server / relay.
<LI>Extracts the images.
<LI>Checks if the IBM Workload Scheduler command line tools are running (conman, composer, fileaid). If they are running, the action fails.
<LI>Enables the Install fixlet for the upgrade.</LI></UL>]]></Description>
    <Relevance>x64 of operating system</Relevance>
    <Relevance><![CDATA[version of client >= "8.2"]]></Relevance>
    <Relevance>(not exists file &quot;__TWSUpgrade.lck&quot; of folder it) of (pathname of client folder of current site)</Relevance>
    <Relevance><![CDATA[((name of it = "Win2008" AND (service pack major version of it as integer) >= 1) OR (name of it = "Win2008R2") OR (name of it = "Win2012") OR (name of it = "Win2012R2") OR (name of it = "Win10") OR (name of it = "Win7") OR (name of it = "Win8") OR (name of it = "Win8.1") OR (name of it = "Win2016") OR (name of it = "Win2019") OR (name of it = "Win2016") OR (name of it = "Win2019")) of operating system]]></Relevance>
    <Relevance><![CDATA[exists ((((following text of first "DN_UserOwner=" of element whose (it contains "DN_UserOwner=") of it) , (following text of first "DN_InstallationPath=" of element whose (it contains "DN_InstallationPath=") of it) , (following text of first "DN_MajorVersion=" of element whose (it contains "DN_MajorVersion=") of it) , (following text of first "DN_MinorVersion=" of element whose (it contains "DN_MinorVersion=") of it) , (if ((following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) != "") then (following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) else "0") , (following text of first "DN_Agent=" of element whose (it contains "DN_Agent=") of it) , (maximum of (lasts 2 of substrings separated by "-" of ((if it != "" then it else "00") of concatenation "-" of (following texts of firsts "DN_PackageName=" of elements whose (it contains "FP_TWS") of it)) as integer))) of (set of items 1 of (item 0 of it, elements of item 1 of it) whose (item 1 of it contains ("/" & item 0 of it & "_DN"))) of (unique values of preceding texts of firsts "_DN" of following texts of firsts "/Tivoli/Workload_Scheduler/" of elements of it, it) of (if (exists file "TWSRegistry.dat" of windows folder AND exists file "TWSRegistry.dat" of system folder) then (set of ((lines of file "TWSRegistry.dat" of windows folder) ; (lines of file "TWSRegistry.dat" of system folder))) else (if (exists file "TWSRegistry.dat" of windows folder) then (set of lines of file "TWSRegistry.dat" of windows folder) else (set of lines of file "TWSRegistry.dat" of system folder)))) whose ((item 5 of it = "LWA") AND ((((item 2 of it as integer = 9 AND item 3 of it as integer = 3 AND item 4 of it as integer = 0 AND item 6 of it as integer > 2) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 4 AND item 4 of it as integer = 0) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 5 AND item 4 of it as integer = 0 AND item 6 of it as integer < 3)) AND (exists file ".zcentric" of folder (item 1 of it as string & "/_uninstall/ACTIONTOOLS"))))))]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2012-01-17</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 21 Jan 2021 16:47:49 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
// Download image from the BigFix server / relay
prefetch 9.5.0-IBM-IWS-WIN_X86_64_ZOS_AGENT-FP0003.zip sha1:b1c7143459850b542931c1d59f5185cf7bda721b size:650213601 SWDProtocol://127.0.0.1:52311/uploads/b1c7143459850b542931c1d59f5185cf7bda721b/9.5.0-IBM-IWS-WIN_X86_64_ZOS_AGENT-FP0003.zip.bfswd sha256:61d3db0b0e2c775c775f4cfc3b1fd51ebd2b2f193fecb50eb09d379553ae3cd2
parameter "Image" = "9.5.0-IBM-IWS-WIN_X86_64_ZOS_AGENT-FP0003.zip"

// Download unzip.exe from the BigFix server / relay
prefetch unzip.exe sha1:9c242a8c1fe79831ed396e51e05d1d258b9856a3 size:190976 SWDProtocol://127.0.0.1:52311/uploads/9c242a8c1fe79831ed396e51e05d1d258b9856a3/unzip-windows.exe.bfswd sha256:80fbfe33609b0e95ebbd9dbf1fd7a5adfb5a71c598417cdc2336d05c51e55cc4

// Create subfolder TWA in %TEMP%
folder create "{value of variable "TEMP" of environment}\TWA"

// Create subfolder tws953 in %TEMP%\TWA
folder create "{value of variable "TEMP" of environment}\TWA\tws953"

// Cleanup subfolder 953
folder delete "{value of variable "TEMP" of environment}\953"

// Create subfolder 953
folder create "{value of variable "TEMP" of environment}\953"

// Retrieve TMP from relevance
parameter "TMP" = "{value of variable "TEMP" of environment}\953"

// Extract image to $TMP\TWS
if {not exists folder "TWS" of folder (parameter "TMP") | false}
	waithidden "{pathname of client folder of current site & "\__Download\unzip.exe"}" -o "{pathname of client folder of current site & "\__Download\" & parameter "Image"}" -d "{parameter "TMP"}"
	continue if {exit code of action = 0}
endif


// Retrieve ActionTools from relevance
parameter "ActionTools" = "{parameter "TMP" & "\TWS\WINDOWS_X86_64\ACTIONTOOLS"}"

// Retrieve UserOwner from relevance
parameter "UserOwner" = "{(preceding text of first "-" of it | it) of concatenation "-" of items 0 of ((((following text of first "DN_UserOwner=" of element whose (it contains "DN_UserOwner=") of it) , (following text of first "DN_InstallationPath=" of element whose (it contains "DN_InstallationPath=") of it) , (following text of first "DN_MajorVersion=" of element whose (it contains "DN_MajorVersion=") of it) , (following text of first "DN_MinorVersion=" of element whose (it contains "DN_MinorVersion=") of it) , (if ((following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) != "") then (following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) else "0") , (following text of first "DN_Agent=" of element whose (it contains "DN_Agent=") of it) , (maximum of (lasts 2 of substrings separated by "-" of ((if it != "" then it else "00") of concatenation "-" of (following texts of firsts "DN_PackageName=" of elements whose (it contains "FP_TWS") of it)) as integer))) of (set of items 1 of (item 0 of it, elements of item 1 of it) whose (item 1 of it contains ("/" & item 0 of it & "_DN"))) of (unique values of preceding texts of firsts "_DN" of following texts of firsts "/Tivoli/Workload_Scheduler/" of elements of it, it) of (if (exists file "TWSRegistry.dat" of windows folder AND exists file "TWSRegistry.dat" of system folder) then (set of ((lines of file "TWSRegistry.dat" of windows folder) ; (lines of file "TWSRegistry.dat" of system folder))) else (if (exists file "TWSRegistry.dat" of windows folder) then (set of lines of file "TWSRegistry.dat" of windows folder) else (set of lines of file "TWSRegistry.dat" of system folder)))) whose ((item 5 of it = "LWA") AND ((((item 2 of it as integer = 9 AND item 3 of it as integer = 3 AND item 4 of it as integer = 0 AND item 6 of it as integer > 2) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 4 AND item 4 of it as integer = 0) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 5 AND item 4 of it as integer = 0 AND item 6 of it as integer < 3)) AND (exists file ".zcentric" of folder (item 1 of it as string & "/_uninstall/ACTIONTOOLS"))))))}"

// Retrieve InstallationPath from relevance
parameter "SourceInstallationPath" = "{(preceding text of first "-" of it | it) of concatenation "-" of items 1 of ((((following text of first "DN_UserOwner=" of element whose (it contains "DN_UserOwner=") of it) , (following text of first "DN_InstallationPath=" of element whose (it contains "DN_InstallationPath=") of it) , (following text of first "DN_MajorVersion=" of element whose (it contains "DN_MajorVersion=") of it) , (following text of first "DN_MinorVersion=" of element whose (it contains "DN_MinorVersion=") of it) , (if ((following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) != "") then (following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) else "0") , (following text of first "DN_Agent=" of element whose (it contains "DN_Agent=") of it) , (maximum of (lasts 2 of substrings separated by "-" of ((if it != "" then it else "00") of concatenation "-" of (following texts of firsts "DN_PackageName=" of elements whose (it contains "FP_TWS") of it)) as integer))) of (set of items 1 of (item 0 of it, elements of item 1 of it) whose (item 1 of it contains ("/" & item 0 of it & "_DN"))) of (unique values of preceding texts of firsts "_DN" of following texts of firsts "/Tivoli/Workload_Scheduler/" of elements of it, it) of (if (exists file "TWSRegistry.dat" of windows folder AND exists file "TWSRegistry.dat" of system folder) then (set of ((lines of file "TWSRegistry.dat" of windows folder) ; (lines of file "TWSRegistry.dat" of system folder))) else (if (exists file "TWSRegistry.dat" of windows folder) then (set of lines of file "TWSRegistry.dat" of windows folder) else (set of lines of file "TWSRegistry.dat" of system folder)))) whose ((item 5 of it = "LWA") AND ((((item 2 of it as integer = 9 AND item 3 of it as integer = 3 AND item 4 of it as integer = 0 AND item 6 of it as integer > 2) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 4 AND item 4 of it as integer = 0) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 5 AND item 4 of it as integer = 0 AND item 6 of it as integer < 3)) AND (exists file ".zcentric" of folder (item 1 of it as string & "/_uninstall/ACTIONTOOLS"))))))}"

// Retrieve MajorVersion from relevance
parameter "SourceMajorVersion" = "{(preceding text of first "-" of it | it) of concatenation "-" of items 2 of ((((following text of first "DN_UserOwner=" of element whose (it contains "DN_UserOwner=") of it) , (following text of first "DN_InstallationPath=" of element whose (it contains "DN_InstallationPath=") of it) , (following text of first "DN_MajorVersion=" of element whose (it contains "DN_MajorVersion=") of it) , (following text of first "DN_MinorVersion=" of element whose (it contains "DN_MinorVersion=") of it) , (if ((following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) != "") then (following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) else "0") , (following text of first "DN_Agent=" of element whose (it contains "DN_Agent=") of it) , (maximum of (lasts 2 of substrings separated by "-" of ((if it != "" then it else "00") of concatenation "-" of (following texts of firsts "DN_PackageName=" of elements whose (it contains "FP_TWS") of it)) as integer))) of (set of items 1 of (item 0 of it, elements of item 1 of it) whose (item 1 of it contains ("/" & item 0 of it & "_DN"))) of (unique values of preceding texts of firsts "_DN" of following texts of firsts "/Tivoli/Workload_Scheduler/" of elements of it, it) of (if (exists file "TWSRegistry.dat" of windows folder AND exists file "TWSRegistry.dat" of system folder) then (set of ((lines of file "TWSRegistry.dat" of windows folder) ; (lines of file "TWSRegistry.dat" of system folder))) else (if (exists file "TWSRegistry.dat" of windows folder) then (set of lines of file "TWSRegistry.dat" of windows folder) else (set of lines of file "TWSRegistry.dat" of system folder)))) whose ((item 5 of it = "LWA") AND ((((item 2 of it as integer = 9 AND item 3 of it as integer = 3 AND item 4 of it as integer = 0 AND item 6 of it as integer > 2) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 4 AND item 4 of it as integer = 0) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 5 AND item 4 of it as integer = 0 AND item 6 of it as integer < 3)) AND (exists file ".zcentric" of folder (item 1 of it as string & "/_uninstall/ACTIONTOOLS"))))))}"

// Retrieve MinorVersion from relevance
parameter "SourceMinorVersion" = "{(preceding text of first "-" of it | it) of concatenation "-" of items 3 of ((((following text of first "DN_UserOwner=" of element whose (it contains "DN_UserOwner=") of it) , (following text of first "DN_InstallationPath=" of element whose (it contains "DN_InstallationPath=") of it) , (following text of first "DN_MajorVersion=" of element whose (it contains "DN_MajorVersion=") of it) , (following text of first "DN_MinorVersion=" of element whose (it contains "DN_MinorVersion=") of it) , (if ((following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) != "") then (following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) else "0") , (following text of first "DN_Agent=" of element whose (it contains "DN_Agent=") of it) , (maximum of (lasts 2 of substrings separated by "-" of ((if it != "" then it else "00") of concatenation "-" of (following texts of firsts "DN_PackageName=" of elements whose (it contains "FP_TWS") of it)) as integer))) of (set of items 1 of (item 0 of it, elements of item 1 of it) whose (item 1 of it contains ("/" & item 0 of it & "_DN"))) of (unique values of preceding texts of firsts "_DN" of following texts of firsts "/Tivoli/Workload_Scheduler/" of elements of it, it) of (if (exists file "TWSRegistry.dat" of windows folder AND exists file "TWSRegistry.dat" of system folder) then (set of ((lines of file "TWSRegistry.dat" of windows folder) ; (lines of file "TWSRegistry.dat" of system folder))) else (if (exists file "TWSRegistry.dat" of windows folder) then (set of lines of file "TWSRegistry.dat" of windows folder) else (set of lines of file "TWSRegistry.dat" of system folder)))) whose ((item 5 of it = "LWA") AND ((((item 2 of it as integer = 9 AND item 3 of it as integer = 3 AND item 4 of it as integer = 0 AND item 6 of it as integer > 2) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 4 AND item 4 of it as integer = 0) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 5 AND item 4 of it as integer = 0 AND item 6 of it as integer < 3)) AND (exists file ".zcentric" of folder (item 1 of it as string & "/_uninstall/ACTIONTOOLS"))))))}"

// Retrieve MaintenanceVersion from relevance
parameter "SourceMaintenanceVersion" = "{(preceding text of first "-" of it | it) of concatenation "-" of items 4 of ((((following text of first "DN_UserOwner=" of element whose (it contains "DN_UserOwner=") of it) , (following text of first "DN_InstallationPath=" of element whose (it contains "DN_InstallationPath=") of it) , (following text of first "DN_MajorVersion=" of element whose (it contains "DN_MajorVersion=") of it) , (following text of first "DN_MinorVersion=" of element whose (it contains "DN_MinorVersion=") of it) , (if ((following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) != "") then (following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) else "0") , (following text of first "DN_Agent=" of element whose (it contains "DN_Agent=") of it) , (maximum of (lasts 2 of substrings separated by "-" of ((if it != "" then it else "00") of concatenation "-" of (following texts of firsts "DN_PackageName=" of elements whose (it contains "FP_TWS") of it)) as integer))) of (set of items 1 of (item 0 of it, elements of item 1 of it) whose (item 1 of it contains ("/" & item 0 of it & "_DN"))) of (unique values of preceding texts of firsts "_DN" of following texts of firsts "/Tivoli/Workload_Scheduler/" of elements of it, it) of (if (exists file "TWSRegistry.dat" of windows folder AND exists file "TWSRegistry.dat" of system folder) then (set of ((lines of file "TWSRegistry.dat" of windows folder) ; (lines of file "TWSRegistry.dat" of system folder))) else (if (exists file "TWSRegistry.dat" of windows folder) then (set of lines of file "TWSRegistry.dat" of windows folder) else (set of lines of file "TWSRegistry.dat" of system folder)))) whose ((item 5 of it = "LWA") AND ((((item 2 of it as integer = 9 AND item 3 of it as integer = 3 AND item 4 of it as integer = 0 AND item 6 of it as integer > 2) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 4 AND item 4 of it as integer = 0) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 5 AND item 4 of it as integer = 0 AND item 6 of it as integer < 3)) AND (exists file ".zcentric" of folder (item 1 of it as string & "/_uninstall/ACTIONTOOLS"))))))}"

// Retrieve AgentType from relevance
parameter "AgentType" = "{(preceding text of first "-" of it | it) of concatenation "-" of items 5 of ((((following text of first "DN_UserOwner=" of element whose (it contains "DN_UserOwner=") of it) , (following text of first "DN_InstallationPath=" of element whose (it contains "DN_InstallationPath=") of it) , (following text of first "DN_MajorVersion=" of element whose (it contains "DN_MajorVersion=") of it) , (following text of first "DN_MinorVersion=" of element whose (it contains "DN_MinorVersion=") of it) , (if ((following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) != "") then (following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) else "0") , (following text of first "DN_Agent=" of element whose (it contains "DN_Agent=") of it) , (maximum of (lasts 2 of substrings separated by "-" of ((if it != "" then it else "00") of concatenation "-" of (following texts of firsts "DN_PackageName=" of elements whose (it contains "FP_TWS") of it)) as integer))) of (set of items 1 of (item 0 of it, elements of item 1 of it) whose (item 1 of it contains ("/" & item 0 of it & "_DN"))) of (unique values of preceding texts of firsts "_DN" of following texts of firsts "/Tivoli/Workload_Scheduler/" of elements of it, it) of (if (exists file "TWSRegistry.dat" of windows folder AND exists file "TWSRegistry.dat" of system folder) then (set of ((lines of file "TWSRegistry.dat" of windows folder) ; (lines of file "TWSRegistry.dat" of system folder))) else (if (exists file "TWSRegistry.dat" of windows folder) then (set of lines of file "TWSRegistry.dat" of windows folder) else (set of lines of file "TWSRegistry.dat" of system folder)))) whose ((item 5 of it = "LWA") AND ((((item 2 of it as integer = 9 AND item 3 of it as integer = 3 AND item 4 of it as integer = 0 AND item 6 of it as integer > 2) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 4 AND item 4 of it as integer = 0) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 5 AND item 4 of it as integer = 0 AND item 6 of it as integer < 3)) AND (exists file ".zcentric" of folder (item 1 of it as string & "/_uninstall/ACTIONTOOLS")))))) & "Z"}"

// Retrieve FixPack from relevance
parameter "SourceFixPack" = "{(preceding text of first "-" of it | it) of concatenation "-" of ((items 6 of ((((following text of first "DN_UserOwner=" of element whose (it contains "DN_UserOwner=") of it) , (following text of first "DN_InstallationPath=" of element whose (it contains "DN_InstallationPath=") of it) , (following text of first "DN_MajorVersion=" of element whose (it contains "DN_MajorVersion=") of it) , (following text of first "DN_MinorVersion=" of element whose (it contains "DN_MinorVersion=") of it) , (if ((following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) != "") then (following text of first "DN_MaintenanceVersion=" of element whose (it contains "DN_MaintenanceVersion=") of it) else "0") , (following text of first "DN_Agent=" of element whose (it contains "DN_Agent=") of it) , (maximum of (lasts 2 of substrings separated by "-" of ((if it != "" then it else "00") of concatenation "-" of (following texts of firsts "DN_PackageName=" of elements whose (it contains "FP_TWS") of it)) as integer))) of (set of items 1 of (item 0 of it, elements of item 1 of it) whose (item 1 of it contains ("/" & item 0 of it & "_DN"))) of (unique values of preceding texts of firsts "_DN" of following texts of firsts "/Tivoli/Workload_Scheduler/" of elements of it, it) of (if (exists file "TWSRegistry.dat" of windows folder AND exists file "TWSRegistry.dat" of system folder) then (set of ((lines of file "TWSRegistry.dat" of windows folder) ; (lines of file "TWSRegistry.dat" of system folder))) else (if (exists file "TWSRegistry.dat" of windows folder) then (set of lines of file "TWSRegistry.dat" of windows folder) else (set of lines of file "TWSRegistry.dat" of system folder)))) whose ((item 5 of it = "LWA") AND ((((item 2 of it as integer = 9 AND item 3 of it as integer = 3 AND item 4 of it as integer = 0 AND item 6 of it as integer > 2) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 4 AND item 4 of it as integer = 0) OR (item 2 of it as integer = 9 AND item 3 of it as integer = 5 AND item 4 of it as integer = 0 AND item 6 of it as integer < 3)) AND (exists file ".zcentric" of folder (item 1 of it as string & "/_uninstall/ACTIONTOOLS"))))))) as string)}"

// Retrieve ProcessFile
parameter "ProcessFile" = "{value of variable "TEMP" of environment}\TWA\tws953\tws953_process_{parameter "UserOwner"}.txt"

// Call twsCheckInstance.cmd to check whether command line tools are still running
if {(parameter "AgentType" = "FTA") | false}
	waithidden "{parameter "ActionTools"}\twsCheckInstance.cmd" "{parameter "SourceInstallationPath"}" "cmdLines" "{parameter "ProcessFile"}"

	// Continue if the return code of the previous command was 0
	continue if {exit code of action = 0}
endif

// Create new filelistJobsWnt_bck86
if {(((parameter "SourceMajorVersion" = "8") AND (((parameter "SourceMinorVersion" = "5") AND (parameter "SourceMaintenanceVersion" = "1")) OR ((parameter "SourceMinorVersion" = "6") AND (parameter "SourceMaintenanceVersion" = "0")))) OR (parameter "SourceMajorVersion" = "9")) | false}
	delete "{parameter "ActionTools"}\filelistJobsWnt_bck86"

	// Delete __createfile
	delete __createfile

	// Create new filelistJobsWnt_bck86
	createfile until EOF
bin\joblnch.exe
bin\taskLauncher.exe
EOF

	// Move filelistJobsWnt_bck86 to ACTIONTOOLS
	move __createfile "{parameter "ActionTools"}\filelistJobsWnt_bck86"
endif

// Delete __createfile
delete __createfile


// Merge TWSRegistry.dat to %SystemRoot%\TWSRegistry.dat
if { exists matches (regex (concatenation of "/Tivoli/Workload_Scheduler/" & (parameter "UserOwner") & ".+")) of lines of file "TWSRegistry.dat" of system folder | false }
   // Delete __createfile
   delete __createfile

   // Create merged TWSRegistry.dat (x86_64)
   createfile until EOF
{if (exists file "TWSRegistry.dat" of windows folder) then (concatenation "%0d%0a" of lines of file "TWSRegistry.dat" of windows folder) & "%0d%0a" & (concatenation "%0d%0a" of ((matches (regex (concatenation of "/Tivoli/Workload_Scheduler/" & (parameter "UserOwner") & ".+")) of lines of file "TWSRegistry.dat" of system folder))) else ((concatenation "%0d%0a" of ((matches (regex (concatenation of "/Tivoli/Workload_Scheduler/" & (parameter "UserOwner") & ".+")) of lines of file "TWSRegistry.dat" of system folder)))) }
EOF

   // Delete %SystemRoot%\TWSRegistry.dat
   delete "{windows folder}\TWSRegistry.dat"

   // Move __createfile to %SystemRoot%\TWSRegistry.dat
   move __createfile "{windows folder}\TWSRegistry.dat"

   // Delete __createfile
   delete __createfile

   // Create reduced TWSRegistry.dat (x86)
   createfile until EOF
{concatenation "%0d%0a" of lines whose (it does not contain ("/Tivoli/Workload_Scheduler/" & (parameter "UserOwner"))) of file "TWSRegistry.dat" of system folder}
EOF

   // Delete %SystemRoot%\system32\TWSRegistry.dat
   delete "{system folder}\TWSRegistry.dat"

   // Move __createfile to %SystemRoot%\system32\TWSRegistry.dat
   move __createfile "{system folder}\TWSRegistry.dat"

   // Delete __createfile
   delete __createfile
endif

// Create the lock file
if {(parameter "AgentType" = "FTA") | false}
	createfile until EOF
UserOwner={parameter "UserOwner"}
SourceInstallationPath={parameter "SourceInstallationPath"}
SourceMajorVersion={parameter "SourceMajorVersion"}
SourceMinorVersion={parameter "SourceMinorVersion"}
SourceMaintenanceVersion={parameter "SourceMaintenanceVersion"}
SourceFixPack={parameter "SourceFixPack"}
TargetMajorVersion=9
TargetMinorVersion=5
TargetMaintenanceVersion=0
TargetFixPack=3
AgentType={parameter "AgentType"}
EOF
else
	createfile until EOF
UserOwner={parameter "UserOwner"}
SourceInstallationPath={parameter "SourceInstallationPath"}
SourceMajorVersion={parameter "SourceMajorVersion"}
SourceMinorVersion={parameter "SourceMinorVersion"}
SourceMaintenanceVersion={parameter "SourceMaintenanceVersion"}
SourceFixPack={parameter "SourceFixPack"}
TargetMajorVersion=9
TargetMinorVersion=5
TargetMaintenanceVersion=0
TargetFixPack=3
AgentType={parameter "AgentType"}
EOF
endif

// Delete __TWSUpgrade.lck in BigFix subfolder
delete "{pathname of client folder of current site}\__TWSUpgrade.lck"

// Move __createfile to _TWSUpgrade.lck in BigFix subfolder
move __createfile "{pathname of client folder of current site}\__TWSUpgrade.lck"]]></ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
