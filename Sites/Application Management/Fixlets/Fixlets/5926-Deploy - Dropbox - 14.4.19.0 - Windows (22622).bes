      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch D8968BDE718EE0BD8700C4C74B677A5C59848803.exe sha1:D8968BDE718EE0BD8700C4C74B677A5C59848803 size:78023072 https://clientupdates.dropboxstatic.com/client/Dropbox%2014.4.19%20Offline%20Installer.exe sha256:A0827474448EF4EC4E65D61E00757F7812DF9E9004B6D944FDEDEDE6D88DEFE7

override wait
hidden=true
wait &quot;__Download\D8968BDE718EE0BD8700C4C74B677A5C59848803.exe&quot; /S

regdelete &quot;[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Run]&quot; &quot;Dropbox&quot;

delete &quot;{value of variable &quot;PUBLIC&quot; of environment}\Desktop\Dropbox.lnk&quot;
</ActionScript>
    </DefaultAction>
