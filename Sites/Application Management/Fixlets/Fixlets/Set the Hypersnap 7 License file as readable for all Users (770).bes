<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Task Export

  Title    : Set the Hypersnap 7 License file as readable for all Users
  ID       : 770
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T21:24:28
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Set the Hypersnap 7 License file as readable for all Users</Title>
    <Description>This will fix a license issue with Hypersnap license file </Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance>exists key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;HyperSnap&quot; as lowercase) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>exists value &quot;UninstallString&quot; whose (it as string as lowercase contains &quot;hpruninst.exe&quot;) of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;HyperSnap&quot; as lowercase) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>exists file (value &quot;UninstallString&quot; whose (it as string as lowercase contains &quot;hpruninst.exe&quot;) of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;HyperSnap&quot; as lowercase) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry as string)</Relevance>
    <Relevance><![CDATA[exists file (pathname of parent folder of file (value "UninstallString" whose (it as string as lowercase contains "hpruninst.exe") of key whose (value "DisplayName" of it as string as lowercase contains "HyperSnap" as lowercase) of key "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry as string) & "\HprSnap7.hs7lic")]]></Relevance>
    <Relevance><![CDATA[1179817 != effective access mode for "Users" of dacl of security descriptor of file (pathname of parent folder of file (value "UninstallString" whose (it as string as lowercase contains "hpruninst.exe") of key whose (value "DisplayName" of it as string as lowercase contains "HyperSnap" as lowercase) of key "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry as string) & "\HprSnap7.hs7lic")]]></Relevance>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2012-02-24</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 18 Jun 2012 16:00:41 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Reference: http://forum.bigfix.com/viewtopic.php?id=372
// Reference: http://technet.microsoft.com/en-us/library/bb490872.aspx
// cacls.exe is a command line utility for changing security permissions for files or folders
//  /t   : Changes DACLs of specified files in the current directory and all subdirectories.
//  /e   : Edits a DACL instead of replacing it.
//  /g   User : permission   : Grants access rights to the specified user.
waithidden cmd.exe /C cacls.exe "{(pathname of parent folder of file (value "UninstallString" whose (it as string as lowercase contains "hpruninst.exe") of key whose (value "DisplayName" of it as string as lowercase contains "HyperSnap" as lowercase) of key "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry as string) & "\HprSnap7.hs7lic")}" /E /G Users:R]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
