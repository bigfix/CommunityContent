      <Value>Thu, 26 Nov 2015 09:10:54 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action6897">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process. </PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch DellCertFix.exe sha1:c497112138eaf1d0ffa6818ea234f7f7ebb2c43f size:16768 https://dellupdater.dell.com/Downloads/APP009/DellCertFix.exe sha256:7c84bedcd80bb2ad5c03818e66b9cd40874617d4344968b8033bdd37724d85f9

waithidden DellCertFix.exe

action requires restart &quot;c497112138eaf1d0ffa6818ea234f7f7ebb2c43f&quot;
</ActionScript>
    </Action>
