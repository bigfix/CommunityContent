<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall Tanium Client</Title>
    <Description><![CDATA[This task will uninstall the Tanium Client<BR><BR>This task is applicable on all windows computers that have the tanium service installed. ]]></Description>
    <Relevance>exists service &quot;TaniumClient&quot;</Relevance>
    <Category>Uninstall</Category>
    <Source>www.tanium.com</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2011-11-16</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 31 Oct 2012 14:41:00 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// pull uninstall command out of registry and run it
waithidden {(if (exists key "HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Tanium Client" of registry) then "%22" & (value "UninstallString" of key "HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Tanium Client" of registry as string) & "%22" else if (exists key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Tanium\Tanium Client" of registry) then "%22" & (value "UninstallString" of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Tanium\Tanium Client" of registry as string) & "%22" else "No Value - uh oh") & " /S"}]]></ActionScript>
    </DefaultAction>
    <Action ID="Action889">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to read forum related to this fixlet.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri"><![CDATA[http://forums.tanium.com/viewtopic.php?f=9&t=87]]></ActionScript>
    </Action>
  </Fixlet>
</BES>
