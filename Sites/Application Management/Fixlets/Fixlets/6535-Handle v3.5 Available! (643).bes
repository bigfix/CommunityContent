<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Handle v3.5 Available!</Title>
    <Description><![CDATA[Ever wondered which program has a particular file or directory open? Now you can find out. <EM>Handle</EM> is a utility that displays information about open handles for any process in the system. You can use it to see the programs that have a file open, or to see the object types and names of all the handles of a program. ]]></Description>
    <Relevance>name of operating system starts with &quot;Win&quot;</Relevance>
    <Relevance>not exists file &quot;Handle.exe&quot; of system x64 folder</Relevance>
    <Category>Software Distribution</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2012-10-26</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 26 Oct 2012 20:02:55 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here </Link>
        <PostLink>to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action parameter query &quot;EULA&quot; with description &quot;Click OK if you agree to the SysInternals EULA (see http://technet.microsoft.com/en-us/sysinternals/bb469936) on behalf of the System Account on the endpoint(s).&quot; and with default value &quot;I AGREE&quot;
continue if {parameter &quot;EULA&quot; = &quot;I AGREE&quot;}
prefetch Handle.zip sha1:41de536a7f03fc1eadefc724f128738e9a610461 size:227624 http://download.sysinternals.com/files/Handle.zip
prefetch unzip.exe sha1:84debf12767785cd9b43811022407de7413beb6f size:204800 http://software.bigfix.com/download/redist/unzip-6.0.exe sha256:2122557d350fd1c59fb0ef32125330bde673e9331eb9371b454c2ad2d82091ac
utility __Download\unzip.exe
parameter &quot;OPENSSL_FOLDER&quot; = &quot;{pathname of parent folder  of client}\openSSL&quot;
action uses wow64 redirection false
waithidden __Download\unzip.exe -qq -o -d &quot;{pathname of parent folder of client}&quot; __Download\Handle.zip
copy &quot;{pathname of parent folder of client}\Handle.exe&quot; &quot;{pathname of system x64 folder}\Handle.exe&quot;
continue if {version of file &quot;Handle.exe&quot; of system x64 folder = &quot;3.50.0.0&quot;}
action uses wow64 redirection {x64 of operating system}
//Set EULA agreement flags
regset &quot;[HKEY_CURRENT_USER\Software\Sysinternals\Handle]&quot; &quot;EulaAccepted&quot;=dword:00000001
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action877">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn more about this application.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://technet.microsoft.com/en-us/sysinternals/bb896655.aspx</ActionScript>
    </Action>
    <Action ID="Action878">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn about Peter Hahndorf&apos;s research into accepting Sysinternals Licenses.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://peter.hahndorf.eu/blog/2010/03/07/WorkAroundSysinternalsLicensePopups.aspx</ActionScript>
    </Action>
  </Task>
</BES>
