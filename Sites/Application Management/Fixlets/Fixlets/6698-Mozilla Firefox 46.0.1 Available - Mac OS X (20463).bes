<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Mozilla Firefox 46.0.1 Available - Mac OS X</Title>
    <Description>This fixlet was created using the &quot;Fixlet Maker&quot; wizard and then cleaned up significantly. </Description>
    <Relevance><![CDATA[(name of operating system = "Mac OS X") AND (if system version >= "10.6" then version of client >= "8.2" else true)]]></Relevance>
    <Relevance><![CDATA[exists application "Firefox.app" whose (version of it as string = "46.0" or version of it < "46.0.1" as version)]]></Relevance>
    <Category>Update</Category>
    <Source>Firefox</Source>
    <SourceReleaseDate>2016-05-03</SourceReleaseDate>
    <SourceSeverity>Important</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-template-os</Name>
      <Value>Mac</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>PatchManagement 3rdPartyApp Mozilla Firefox</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-template-id</Name>
      <Value>mozillaFirefoxMacTemplate</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-product-name</Name>
      <Value>Mozilla Firefox</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-vendor-name</Name>
      <Value>Mozilla</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:42:52 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action21325">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch Firefox_46.0.1.dmg sha1:29b851c262a317b030a4845119fa42177d76cd18 size:87088879 http://download-installer.cdn.mozilla.net/pub/firefox/releases/46.0.1/mac/en-US/Firefox%2046.0.1.dmg sha256:7ab6508b098023840d63ec622beb9f8ff4c68922f11aa769acf351dae5baa231

move "{posix path of file "Firefox_46.0.1.dmg" of folder "__Download" of client folder of current site}" "/private/tmp/Firefox_46.0.1.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint  "/Volumes/Firefox_46.0.1" "/private/tmp/Firefox_46.0.1.dmg"

wait cp -r "/Volumes/Firefox_46.0.1/Firefox.app" "/Applications/"

wait hdiutil detach -force "/Volumes/Firefox_46.0.1"

wait /bin/sh -c "rm '/private/tmp/Firefox_46.0.1.dmg' "

if {0 < size of intersection of (set of (names of processes as lowercase); set of ("firefox"))}
	action requires restart 29b851c262a317b030a4845119fa42177d76cd18
endif]]></ActionScript>
    </Action>
    <Action ID="Action21326">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to upgrade Firefox regardless of whether or not Firefox is currently running.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch Firefox_46.0.1.dmg sha1:29b851c262a317b030a4845119fa42177d76cd18 size:87088879 http://download-installer.cdn.mozilla.net/pub/firefox/releases/46.0.1/mac/en-US/Firefox%2046.0.1.dmg sha256:7ab6508b098023840d63ec622beb9f8ff4c68922f11aa769acf351dae5baa231

move &quot;{posix path of file &quot;Firefox_46.0.1.dmg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/Firefox_46.0.1.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint  &quot;/Volumes/Firefox_46.0.1&quot; &quot;/private/tmp/Firefox_46.0.1.dmg&quot;

wait sh -c &quot;killall &apos;firefox&apos; &quot;

wait cp -r &quot;/Volumes/Firefox_46.0.1/Firefox.app&quot; &quot;/Applications/&quot;

wait hdiutil detach -force &quot;/Volumes/Firefox_46.0.1&quot;

wait /bin/sh -c &quot;rm &apos;/private/tmp/Firefox_46.0.1.dmg&apos; &quot;
</ActionScript>
    </Action>
    <Action ID="Action21327">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> for security-related information from Mozilla.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://www.sans.org/top20/#c1</ActionScript>
    </Action>
  </Fixlet>
</BES>
