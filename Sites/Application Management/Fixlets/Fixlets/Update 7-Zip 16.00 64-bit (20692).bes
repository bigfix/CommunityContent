<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Update 7-Zip 16.00 64-bit
  ID       : 20692
  Author   : BrianCanFixIT
  Domain   : BESC
  Imported : 2016-05-25T00:01:34
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update 7-Zip 16.00 64-bit</Title>
    <Description><![CDATA[<P>Updates 7-Zip to version 16.00.</P>
<P>Removes ALL other installations, with the choice of installing the MSI or EXE version.</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[exists key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND (if exists value "DisplayVersion" of it then value "DisplayVersion" of it as string as version else maximum of (matches (regex "([0-9]+\.[0-9]+)") of (value "DisplayName" of it as string) as version)) < "16.00") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registry)]]></Relevance>
    <Category>Security Update</Category>
    <SourceReleaseDate>2016-05-16</SourceReleaseDate>
    <SourceSeverity>Critical</SourceSeverity>
    <CVENames>CVE-2016-2335; CVE-2016-2334</CVENames>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 25 May 2016 06:55:56 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to remove the EXE version and update the MSI version.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 7z1600-x64.msi sha1:8082b8910fe38619930b9950eb5f6a8af70fccd0 size:1664000 http://www.7-zip.org/a/7z1600-x64.msi sha256:6b7061d9f4b54d78dab760c01a3290fd453783987366c4804ede7001337f1c79

// Remove the 64-bit EXE version
if {exists key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND value "UninstallString" of it as string as lowercase contains "uninstall") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registry)}
waithidden {value "UninstallString" of key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND value "UninstallString" of it as string as lowercase contains "uninstall") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registry)} /S
endif

// Remove old 64-bit MSI versions
if {exists key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND value "DisplayVersion" of it as string as version < "16.00" AND name of it starts with "{") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registry)}
delete __createfile
delete uninstall.bat
createfile until _end_
{ concatenations "%0d%0a" of ((pathname of system folder & "\msiexec.exe /X ")  & (preceding text of last "}}" of it) & "}} /quiet /norestart") of names of keys whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND value "DisplayVersion" of it as string as version < "16.00" AND name of it starts with "{") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registry) }
_end_
move __createfile uninstall.bat
waithidden uninstall.bat
endif

// Install
waithidden "{pathname of system folder & "\msiexec.exe"}" /i "{(pathname of client folder of current site) & "\__Download\7z1600-x64.msi"}" /qn /QN REBOOT=ReallySuppress
parameter "Exitcode" = "{if exist exit code of action then exit code of action as string else "0"}"
if {parameter "Exitcode" != "0"}
	action requires restart 8082b8910fe38619930b9950eb5f6a8af70fccd0
endif
exit {parameter "Exitcode"}]]></ActionScript>
    </DefaultAction>
    <Action ID="Action21561">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to remove the MSI version and update the EXE version.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 7z1600-x64.exe sha1:5b410e628bfbf282f2329f94e91cc962a8f6233c size:1378405 http://www.7-zip.org/a/7z1600-x64.exe sha256:df16084ed1044a59193e87abd5d3b2de404b4a6d93da8f56eac5206642ce2b4d

// Removes the 64-bit MSI versions
if {exists key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND name of it starts with "{") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registry)}
delete __createfile
delete uninstall.bat
createfile until _end_
{ concatenations "%0d%0a" of ((pathname of system folder & "\msiexec.exe /X ")  & (preceding text of last "}}" of it) & "}} /quiet /norestart") of names of keys whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND name of it starts with "{") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registry) }
_end_
move __createfile uninstall.bat
waithidden uninstall.bat
endif

// Install
waithidden "__Download\7z1600-x64.exe" /S
action requires restart 5b410e628bfbf282f2329f94e91cc962a8f6233c]]></ActionScript>
    </Action>
  </Fixlet>
</BES>
