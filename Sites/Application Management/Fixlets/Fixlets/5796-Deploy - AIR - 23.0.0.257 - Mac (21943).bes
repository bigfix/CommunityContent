    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 452584BCC65F1084C6D6DB011E0803631553A8AD.dmg sha1:452584BCC65F1084C6D6DB011E0803631553A8AD size:20467467 http://download.macromedia.com/air/mac/download/23.0/AdobeAIR.dmg sha256:39339DBBD3218EB1BAD35C29EE8B9B4DE1BA23E7C013111ED6DB9A0A7D55FE49

delete &quot;/tmp/452584BCC65F1084C6D6DB011E0803631553A8AD.dmg&quot;

move &quot;__Download/452584BCC65F1084C6D6DB011E0803631553A8AD.dmg&quot; &quot;/tmp/452584BCC65F1084C6D6DB011E0803631553A8AD.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT452584BCC65F1084C6D6DB011E0803631553A8AD&quot; &quot;/tmp/452584BCC65F1084C6D6DB011E0803631553A8AD.dmg&quot;

wait sh -c &quot;rm /tmp/452584BCC65F1084C6D6DB011E0803631553A8AD.dmg&quot;

wait cp -R /tmp/BESMNTPT452584BCC65F1084C6D6DB011E0803631553A8AD/* /tmp/BESTEMP452584BCC65F1084C6D6DB011E0803631553A8AD

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT452584BCC65F1084C6D6DB011E0803631553A8AD/. /tmp/BESTEMP452584BCC65F1084C6D6DB011E0803631553A8AD&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT452584BCC65F1084C6D6DB011E0803631553A8AD | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;/tmp/BESTEMP452584BCC65F1084C6D6DB011E0803631553A8AD/Adobe\ AIR\ Installer.app/Contents/MacOS/Adobe\ AIR\ Installer -silent -eulaAccepted&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP452584BCC65F1084C6D6DB011E0803631553A8AD&apos;&quot;

action requires restart &quot;452584BCC65F1084C6D6DB011E0803631553A8AD&quot;
</ActionScript>
