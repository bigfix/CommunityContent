      <Value>{&quot;lastmodified&quot;:&quot;Wed Jan 31 2024 22:09:47 GMT-0500&quot;,&quot;product&quot;:&quot;Firefox Updater&quot;,&quot;version&quot;:&quot;1.0&quot;,&quot;vendor&quot;:&quot;NYU IT&quot;,&quot;comment&quot;:null,&quot;creator&quot;:&quot;eg2428@ad.nyu.edu&quot;,&quot;owner&quot;:&quot;eg2428@ad.nyu.edu&quot;,&quot;pkgvariablekey&quot;:&quot;SWD_Package_eg2428@ad.nyu.edu_1706756970583605&quot;,&quot;pkgTag&quot;:&quot;&quot;,&quot;description&quot;:null,&quot;categories&quot;:[],&quot;os&quot;:[],&quot;fullInstallCommand&quot;:null,&quot;runAsSystem&quot;:null,&quot;useCommandLine&quot;:false,&quot;site&quot;:null,&quot;files&quot;:[{&quot;filename&quot;:&quot;nyu.jpg&quot;,&quot;dateadded&quot;:&quot;Wed, 31 Jan 2024 22:09:46 -0500&quot;,&quot;folderoffset&quot;:&quot;&quot;,&quot;file_url&quot;:&quot;&quot;,&quot;size&quot;:1350,&quot;sha1&quot;:&quot;2db68f2d42b82151016720f4d1f7cd873d97c794&quot;,&quot;sha256&quot;:&quot;5e1b1b36e066c9cc2685f46cbd397459fbf0aa846b42a029b93097c1dd8f08e0&quot;,&quot;compressed_data_for_package&quot;:false,&quot;id&quot;:&quot;2db68f2d42b82151016720f4d1f7cd873d97c794_1706756987020974&quot;,&quot;uploadSuffix&quot;:&quot;bfswd&quot;,&quot;fileHostedStatus&quot;:0,&quot;included&quot;:false,&quot;msi_metadata&quot;:null,&quot;exe_metadata&quot;:null,&quot;spb_metadata&quot;:null,&quot;osd_metadata&quot;:null,&quot;appv_metadata&quot;:null,&quot;ReferenceID&quot;:&quot;669841&quot;,&quot;ReferenceName&quot;:&quot;/2db68f2d42b82151016720f4d1f7cd873d97c794/nyu.jpg&quot;,&quot;HasAnonymousReference&quot;:false,&quot;rpm_metadata&quot;:null,&quot;appx_metatdata&quot;:null}],&quot;relativePath&quot;:&quot;&quot;,&quot;fileLoadingCount&quot;:0,&quot;fileOrphanCount&quot;:0,&quot;fixletBrokenCount&quot;:0}</Value>
