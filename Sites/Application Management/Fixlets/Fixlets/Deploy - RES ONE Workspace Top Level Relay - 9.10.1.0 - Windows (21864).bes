    <Domain>BESC</Domain>
    <Action ID="Action22798">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Source Release Date: 2016-10-03
if {x64 of operating system}
	prefetch WMRELAY.MSI sha1:79820c3a7ff54a1cd723c7fd670ef1e0deb84bf6 size:2846720 http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Relay-Server(x64)-9.10.1.0.msi
else
	prefetch WMRELAY.MSI sha1:e68d4c183d4b6dea4da9e441f7fa08fcc480e0a6 size:2846720 http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Relay-Server(x86)-9.10.1.0.msi
endif

// action log all

// If your action dies here you did not select an authentication method!
continue if {parameter "dbAuthMethod" of action != "Select an Authentication Type"}

if {parameter "dbAuthMethod" of action = "Relay"}
	if {parameter "rlParent" of action = "Current BigFix Relay"}
		// This Relay List will provide 127.0.0.1 if the current device is a relay
		//parameter "ParentRelay"="{preceding text of first ":" of name of registration server}"

		// This Relay List will provide the relay's parent if the current device is a relay
		parameter "ParentRelay"="{((if ((it does not contain "127.0.0.1" and it does not contain "::1") of name of registration server) then (preceding text of first ":" of name of registration server) else (preceding text of first ":" of following text of first "://" of value of setting "_BESRelay_PostResults_ParentRelayURL" of client)) & ":" & parameter "RESRELPORT" of action)}"

	else
		parameter "ParentRelay"="{parameter "rlParent" of action & ":" & parameter "RESRELPORT" of action}"
	endif
else
	parameter "ParentRelay"=""
endif

//
// Create Relay GUID
//

delete __createfile
delete wuid_patch.ps1

createfile until _done_
$WUID_PATH = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WUID"

if (! (Get-ItemProperty -Path $WUID_PATH -ErrorAction SilentlyContinue).'(default)') {{
    New-Item -Path $WUID_PATH -ItemType Directory -force
    Set-ItemProperty -Path $WUID_PATH -name '(default)' -Value ([GUID]::NewGuid()).ToString('B').ToUpper()
}
_done_

copy __createfile wuid_patch.ps1

waithidden powershell.exe -executionpolicy bypass -file "wuid_patch.ps1"

//
// Install Relay using Windows Authentication
//

if {parameter "dbAuthMethod" of action = "Windows"}

delete __createfile
delete relayconfig.xml
delete relayconfigu.xml

createfile until __done
<?xml version="1.0" encoding="UTF-16"?>
<relayserver>
  <environments>
    <environment guid="{(parameter "RESEnvGUID" of action)}">
      <enabled>yes</enabled>
      <environmentname>{parameter "dbName" of action}@{parameter "dbServer" of action}</environmentname>
      <local>
        <providertype>0</providertype>
        <haschanged>yes</haschanged>
        <cachelocation>{value of variable "ALLUSERSPROFILE" of environment & "\RES\Relay Server"}</cachelocation>
      </local>
      <remote>
        <providertype>2</providertype>
        <haschanged>yes</haschanged>
        <dbserver>{parameter "dbServer" of action}</dbserver>
        <dbname>{parameter "dbName" of action}</dbname>
        <dbuser>
        </dbuser>
        <dbwinauth>yes</dbwinauth>
        <dbpassword encrypted="yes">
        </dbpassword>
        <dbtype>MSSQL</dbtype>
        <dbprotocolencryption>no</dbprotocolencryption>
      </remote>
    </environment>
  </environments>
 <port>{parameter "RESRELPORT" of action}</port>
</relayserver>
__done
move __createfile relayconfig.xml

wait CMD /U /C Type "relayconfig.xml" >> "relayconfigu.xml"

wait msiexec /i "__Download\WMRELAY.msi" ConfigFile="{pathname of client folder of current site}\relayconfigu.xml" SERVICEACCOUNTNAME="{parameter "adServiceAccountUsername" of action}" SERVICEACCOUNTPASSWORD="{parameter "adServiceAccountPassword" of action}" /qn

wait net start RESRLS

//
// Install Relay using SQL Authentication
//

elseif {parameter "dbAuthMethod" of action = "SQL"}

wait msiexec /i "__Download\WMRELAY.msi" DBTYPE=MSSQL DBSERVER={parameter "dbServer" of action} DBNAME="{parameter "dbName" of action}" DBUSER="{parameter "SQLUser" of action}" DBPASSWORD="{parameter "SQLPass" of action}" PORT={parameter "RESRELPORT" of action} /qn

wait "{pathname of system folder}\netsh.exe" firewall add portopening protocol=tcp port={parameter "RESRELPORT" of action} name="RES Relay" mode=ENABLE profile=ALL

wait net start RESRLS

endif

notify client forcerefresh
]]></ActionScript>
    </Action>
  </Fixlet>
</BES>
