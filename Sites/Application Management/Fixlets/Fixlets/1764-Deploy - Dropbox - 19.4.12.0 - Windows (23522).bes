      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 9B1847AC5A2F5B2CE63CF32A4CB12C29AAE37675.exe sha1:9B1847AC5A2F5B2CE63CF32A4CB12C29AAE37675 size:78913960 https://clientupdates.dropboxstatic.com/client/Dropbox%2019.4.13%20Offline%20Installer.exe sha256:60849E96BE14B393B962E4C20180B348270EFA8C8B0A41BE8F3C2FD2423E73DB

override wait
hidden=true
wait &quot;__Download\9B1847AC5A2F5B2CE63CF32A4CB12C29AAE37675.exe&quot; /S

regdelete &quot;[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Run]&quot; &quot;Dropbox&quot;

delete &quot;{value of variable &quot;PUBLIC&quot; of environment}\Desktop\Dropbox.lnk&quot;
</ActionScript>
