<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - Thunderbird - 52.7.0 - Windows</Title>
    <Description>This fixlet is for Deploy - Thunderbird - 52.7.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 40506936 * 2) and (not exists keys whose (value "DisplayName" of it as string starts with "Mozilla Thunderbird") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2018-03-26</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:mozilla:thunderbird:52.7.0:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:mozilla:thunderbird:52.7.0</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 1D4D34C0AD4461BCADDA2481CCAE67DA5F884442.exe sha1:1D4D34C0AD4461BCADDA2481CCAE67DA5F884442 size:40506936 https://download.mozilla.org/?product=thunderbird-52.7.0-SSL&amp;os=win&amp;lang=en-US sha256:0C42A8D13A60EABB812A35290458217BEB1E7AE77DBA29E8667CAECA7B633935

delete setup.ini
delete __createfile

createfile until _end_
[Install]
DesktopShortcut=false
_end_

move __createfile setup.ini

override wait
hidden=true
completion=job
wait "__Download\1D4D34C0AD4461BCADDA2481CCAE67DA5F884442.exe" /INI="{(pathname of client folder of current site) & "\setup.ini"}"

delete "{value of variable "PUBLIC" of environment}\Desktop\Mozilla Thunderbird.lnk"]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
