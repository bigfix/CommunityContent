<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Install OpenSSH-Server on Ubuntu 12.04</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>name of operating system contains &quot;Ubuntu&quot;</Relevance>
    <Relevance>exists file &quot;availableApps.txt&quot; whose (exists lines whose (it starts with &quot;openssh-server&quot;) of it) of parent folder of client</Relevance>
    <Relevance>NOT exists file &quot;installedApps.txt&quot; whose (exists lines whose (it starts with &quot;openssh-server&quot;) of it) of parent folder of client</Relevance>
    <Category>Installation</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2013-04-27</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 30 Apr 2013 04:47:20 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[delete __appendfile
appendfile #!/bin/sh
appendfile apt-get install -q -y openssh-server > output.txt
delete "installer.sh"
delete "output.txt"
move __appendfile "installer.sh"
wait chmod +x installer.sh
wait ./installer.sh
//lastly update the list of currently installed applications
delete __appendfile
appendfile #!/bin/sh
appendfile dpkg --get-selections > "{pathname of parent folder of client}/installedApps.txt"
delete "installedApps.sh"
delete "{pathname of parent folder of client}/installedApps.txt"
move __appendfile "installedApps.sh"
wait chmod +x installedApps.sh
wait ./installedApps.sh
]]></ActionScript>
    </DefaultAction>
  </Task>
</BES>
