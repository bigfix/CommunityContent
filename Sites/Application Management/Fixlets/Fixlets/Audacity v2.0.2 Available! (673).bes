<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Audacity v2.0.2 Available!</Title>
    <Description><![CDATA[<H1 style="FONT-FAMILY: Verdana, Arial, sans-serif; COLOR: rgb(103,103,103); FONT-SIZE: 2em; FONT-WEIGHT: normal" class=ms-rteElement-H1>Install Audacity 1.3.13 (Unicode) Fixlet</H1>
<DIV style="FONT-FAMILY: Verdana, Arial, sans-serif; COLOR: rgb(103,103,103); FONT-SIZE: 11px" sizset="169" sizcache="184"><STRONG>License:</STRONG> Open Source / Freeware<BR>
<DIV><STRONG>Target OS:</STRONG> Windows</DIV>
<DIV><STRONG>Command Line:</STRONG> audacity-win-unicode-1.3.13.exe /SP- /VERYSILENT /NORESTART /MERGETASKS="!desktopicon"</DIV></DIV>]]></Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance>not exists keys whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Audacity 1.3&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Category>Installation</Category>
    <Source>jgstew</Source>
    <SourceReleaseDate>2012-11-28</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 28 Nov 2012 21:55:08 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch audacity-win-2.0.2.exe sha1:25e474e8612417e9e97935a726fc6d5e87c77af4 size:21415874 http://audacity.googlecode.com/files/audacity-win-2.0.2.exe
wait __Download\audacity-win-2.0.2.exe /SP- /VERYSILENT /NORESTART /MERGETASKS=&quot;!desktopicon&quot;?
</ActionScript>
    </DefaultAction>
    <Action ID="Action923">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn more about Audacity.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://audacity.sourceforge.net/download/windows</ActionScript>
    </Action>
    <Action ID="Action924">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to Audacity FAQ.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri"><![CDATA[http://audacity.sourceforge.net/help/faq?s=install&item=lame-mp3]]></ActionScript>
    </Action>
    <Action ID="Action925">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to Audacity Setup Guide.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://www.jrsoftware.org/ishelp/index.php?topic=setupcmdline</ActionScript>
    </Action>
  </Task>
