<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Cb Response - Force Sensor Check-In</Title>
    <Description>This Task can be used to force the Carbon Black Response Sensor to immediately check in with the server. </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[version of client >= "9.0"]]></Relevance>
    <Relevance>(state of service whose (display name of it = &quot;Carbon Black Sensor&quot;) = &quot;Running&quot;) | False</Relevance>
    <Category>Troubleshooting</Category>
    <Source>Carbon Black</Source>
    <SourceReleaseDate>2016-01-21</SourceReleaseDate>
    <SourceSeverity>N/A</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 06 Sep 2016 07:38:55 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">waithidden sc control carbonblack 200</ActionScript>
    </DefaultAction>
  </Task>
</BES>
