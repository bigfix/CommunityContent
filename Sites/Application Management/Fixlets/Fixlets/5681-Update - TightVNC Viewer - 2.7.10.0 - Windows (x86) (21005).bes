<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update - TightVNC Viewer - 2.7.10.0 - Windows (x86)</Title>
    <Description>This fixlet is for Update - TightVNC Viewer - 2.7.10.0 - Windows (x86) and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance>(windows of operating system) and (not x64 of operating system) and (version of operating system &gt;= &quot;6.1&quot;) and (if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true) and (free space of drive of client &gt; 2105344 * 2) and (exists (key of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of ( x32 registry )) whose (value &quot;DisplayName&quot; of it as string starts with &quot;TightVNC&quot; and value &quot;DisplayVersion&quot; of it as string as version &lt; &quot;2.7.10.0&quot; as version) and exists file (pathname of program files x32 folder &amp; &quot;\TightVNC\tvnviewer.exe&quot;))</Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//Comment

prefetch F619E5C7FBC63744AD8606F20AC11D237EABB132 sha1:F619E5C7FBC63744AD8606F20AC11D237EABB132 size:2105344 http://www.tightvnc.com/download/2.7.10/tightvnc-2.7.10-setup-32bit.msi sha256:1B09204B1D22F20ADCA1C505E8F407938AD5382A095B8B0DD26CB1F626E9EE7C

parameter &quot;baseFolder&quot; =  &quot;__Download/&quot;

delete &quot;{parameter &quot;baseFolder&quot;}TightVNC Viewer.msi&quot;
move &quot;__Download/F619E5C7FBC63744AD8606F20AC11D237EABB132&quot; &quot;{parameter &quot;baseFolder&quot;}TightVNC Viewer.msi&quot; 

parameter &quot;logFolder&quot; = &quot;{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs&quot;
folder create &quot;{parameter &quot;logFolder&quot;}&quot;
parameter &quot;logFile&quot; = &quot;PGW.log&quot;

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd &quot;{parameter &quot;baseFolder&quot;}&quot;
mkdir &quot;{parameter &quot;logFolder&quot;}&quot;

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | &quot;Debugger&quot; as string} - TightVNC Viewer &gt;&gt; &quot;{parameter &quot;logFolder&quot;}/{parameter &quot;logFile&quot;}&quot;

msiexec /i &quot;TightVNC Viewer.msi&quot; /quiet /norestart ADDLOCAL=&quot;Viewer&quot; VIEWER_ASSOCIATE_VNC_EXTENSION=1 &gt;&gt; &quot;{parameter &quot;logFolder&quot;}/{parameter &quot;logFile&quot;}&quot; 2&gt;&amp;1

echo Return code: %errorlevel% &gt;&gt; &quot;{parameter &quot;logFolder&quot;}/{parameter &quot;logFile&quot;}&quot;
echo. &gt;&gt; &quot;{parameter &quot;logFolder&quot;}/{parameter &quot;logFile&quot;}&quot;

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
