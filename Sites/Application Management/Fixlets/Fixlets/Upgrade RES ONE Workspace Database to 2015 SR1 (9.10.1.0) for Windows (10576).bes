<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Upgrade RES ONE Workspace Database to 2015 SR1 (9.10.1.0) for Windows</Title>
    <Description><![CDATA[This&nbsp;fixlet will&nbsp;upgrade your existing&nbsp;Windows&nbsp;RES ONE Workspace&nbsp;agent, console, and database to 2015 SR1. (9.10.1.0) Please be sure to run this fixlet <STRONG><U>FIRST</U></STRONG> before you upgrade any other agents or consoles. ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[exists file (pathname of parent folder of parent folder of file of service "res" & "\pwrtech.exe")]]></Relevance>
    <Relevance>exists service &quot;res&quot;</Relevance>
    <Relevance><![CDATA[exists file (pathname of parent folder of parent folder of file of service "res" & "\pfwsmgr.exe")]]></Relevance>
    <Relevance>not exists value &quot;RelayServerConfig&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager&quot; of x32 registry</Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager&quot; whose (value &quot;Version&quot; of it != &quot;9.10.1.0&quot;) of x32 registry</Relevance>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-03-21</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 24 Mar 2016 13:41:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//CDM release 01/11/2016
prefetch Auto-Upgrade-RES-ONE-Workspace-2015-SR1.exe sha1:fac3075d33bb778c225aa32086f116429efdbf30 size:48136400 http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-Auto-Service-Pack-9.10.1.0.exe

waithidden &quot;__Download\Auto-Upgrade-RES-ONE-Workspace-2015-SR1.exe&quot;</ActionScript>
    </DefaultAction>
    <Action ID="Action11337">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to download the RES-ONE-Workspace-2015-SR1-Upgrade-Guide.pdf</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Upgrade-Guide.pdf</ActionScript>
    </Action>
    <Action ID="Action11338">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to download the RES-ONE-Workspace-2015-SR1-Release-Notes.pdf</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Release-Notes.pdf</ActionScript>
    </Action>
    <Action ID="Action11339">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to download the RES-ONE-Workspace-2015-SR1-Administration-Guide.pdf</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Administration-Guide.pdf</ActionScript>
    </Action>
  </Fixlet>
</BES>
