<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Task Export

  Title    : Enable Whitelisting
  ID       : 10556
  Author   : RESQA
  Domain   : SYST
  Imported : 2016-03-24T05:00:40
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Enable Whitelisting</Title>
    <Description>This task will enable whitelisting </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists setting &quot;RES_IEM_Integration_Endpoint&quot; whose (value of it = &quot;1&quot;) of client</Relevance>
    <Relevance><![CDATA[exists file (pathname of parent folder of parent folder of file of service "res" & "\pwrtech.exe")]]></Relevance>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-03-21</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 01 Dec 2015 10:32:12 +0000</Value>
    </MIMEField>
    <Domain>SYST</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//SourceReleaseDate: 20160321-102103


delete __createfile
delete "{(value of variable "temp" of environment) & "\enablewhitelist.xml"}"

createfile until __done



<?xml version="1.0"?>
<!-- RES ONE Workspace Building Block -->
<!-- Created by BigFix on 11-8-2015 15:30:14 -->
<respowerfuse>
	<version>9.10.0.0</version>
	<buildingblock>
		<appguardsettings>
			<mode>enabled</mode>
			<logevents>yes</logevents>
			<showmessage>yes</showmessage>
			<checkrunningappsonrefresh>terminateapp</checkrunningappsonrefresh>
			<message encrypted="yes"></message>
			<allowmessagedisabling>yes</allowmessagedisabling>
			<checkhashes>yes</checkhashes>
			<discoverhashes/>
			<discoverhashesonce/>
			<exceptions/>
		</appguardsettings>
    <appguardfiletypes complete="yes">
			<mode>enabled</mode>
			<logevents>yes</logevents>
			<showmessage>yes</showmessage>
			<message encrypted="yes"></message>
			<allowmessagedisabling>yes</allowmessagedisabling>
			<exceptions/>
		</appguardfiletypes>
	</buildingblock>
</respowerfuse>



__done

copy __createfile "{(value of variable "temp" of environment) & "\enablewhitelist.xml"}"
wait "{(pathname of parent folder of parent folder of file of service "res" & "\pwrtech.exe")}" /add "{(value of variable "temp" of environment) & "\enablewhitelist.xml"}"
]]></ActionScript>
    </DefaultAction>
  </Task>
</BES>
