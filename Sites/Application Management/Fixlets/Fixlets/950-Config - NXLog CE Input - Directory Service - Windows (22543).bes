<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - NXLog CE Input - Directory Service - Windows</Title>
    <Description><![CDATA[<P>This Fixlet configures NXLog Community Edition to monitor the, "Directory Service" Windows Event Log.</P>
<P>This will not work unless you have enabled modular management using <STRONG>Fixlet:</STRONG> Config - NXLog CE - Enable Modular Management - Windows</P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists values &quot;installdir&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\nxlog&quot; of x32 registries</Relevance>
    <Relevance>/* Is a Domain Controller */ (it = 4 or it = 5) of integer value of Selects &quot;DomainRole from Win32_ComputerSystem&quot; of wmi</Relevance>
    <Relevance>not exists files &quot;Directory_Service.conf&quot; of folders &quot;Input&quot; of folders &quot;conf&quot; of folders (values &quot;installdir&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\nxlog&quot; of x32 registries as string)</Relevance>
    <Category>NXLog CE</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-11-07</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[parameter "nxlog"="{pathnames of folders (values "installdir" of keys "HKEY_LOCAL_MACHINE\Software\nxlog" of x32 registries as string)}"
parameter "nxlog_conf"="{pathnames of folders "conf" of folders (values "installdir" of keys "HKEY_LOCAL_MACHINE\Software\nxlog" of x32 registries as string)}"

folder create "{parameter "nxlog_conf"}\Input"

createfile until _end_
<Input eventlog_activedirectory>
    Module      im_msvistalog
    Query <QueryList> \
           <Query Id="0"> \
            <Select Path="Directory Service">*</Select> \
           </Query> \
          </QueryList>
</Input>

<Route eventlog_activedirectory>
    Path        eventlog_activedirectory => out
</Route>

_end_

delete "{parameter "nxlog_conf"}\Input\Directory_Service.conf"

copy __createfile "{parameter "nxlog_conf"}\Input\Directory_Service.conf"]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
