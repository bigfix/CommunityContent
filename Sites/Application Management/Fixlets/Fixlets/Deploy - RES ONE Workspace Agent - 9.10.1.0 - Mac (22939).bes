<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - RES ONE Workspace Agent - 9.10.1.0 - Mac</Title>
    <Description>&lt;DIV id=fixletMessage2 class=FixletMessage&gt;
&lt;DIV id=paramFixletDescription&gt;
&lt;P&gt;Deploy a new RES ONE Workspace 2015 SR1 Agent!&lt;/P&gt;
&lt;P&gt;This parameterized Fixlet allows you to deploy RES ONE Workspace Agent that connects via Relay Authentication to a RES ONE Workspace Relay (This is the only form of agent to environment connection currently supported).&lt;/P&gt;
&lt;P&gt;To deploy an agent you must determine what it&apos;s parent relay is going to be to connect into the environment as well as whether or not to inherit settings.&lt;/P&gt;
&lt;P&gt;&lt;STRONG&gt;Relay Parent&amp;nbsp;Selection&lt;/STRONG&gt;:&lt;BR&gt;This dropdown is populated with the current RES Relays deployed in the environment as well as a value, &quot;Current BigFix Relay&quot; which uses the currently configured BigFix Agent relay as the RES ONE Workspace Agent&apos;s relay.&lt;/P&gt;
&lt;P&gt;&lt;FONT color=#ff0000&gt;&lt;STRONG&gt;NOTES: Grayed out settings used in this fixlet are configured via the Environment Configuration section of the Deployment Wizard!&lt;/STRONG&gt;&lt;/FONT&gt;&lt;BR&gt;- For &lt;STRONG&gt;&quot;Relay&quot;&lt;/STRONG&gt; authentication, the Environment Configuration section below must be populated&lt;STRONG&gt;.&lt;/STRONG&gt;&lt;/P&gt;&lt;/DIV&gt;

&lt;DIV id=plainOrdinaryFixletDescription&gt;Failed to load parameterized fixlet.&lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
    loaded = false;
	
	function loadGlobalization() {
		var globalization = EvaluateRelevance(&apos;(messages of it) of fixlets whose ( name of it = &quot;Parameterized Fixlet Library&quot;) of all bes sites whose (name of it = &quot;BES Support&quot;)&apos;);
		var regex = /\s*&lt;DIV id=globalizationMessageDiv  style=&quot;display:none;&quot;&gt;([\x00-\x7F]+)\s*&lt;\/Div&gt;/i;
		var matches = regex.exec(globalization);
		var globalizationSanitized = matches[1].replace(/&lt;br&gt;/gi, &quot;&quot;);
		return globalizationSanitized;
	}
	
	function loadUtils() {
		return EvaluateRelevance(&apos;unique value of values of mime fields whose (name of it = &quot;vrt_utils.js&quot;) of fixlets whose ( name of it = &quot;Parameterized Fixlet Library&quot;) of all bes sites whose (name of it = &quot;BES Support&quot;)&apos;);
	}
	
    function loadScript(url, callback) {
		var head = document.getElementsByTagName(&quot;head&quot;)[0]; 
		var script = document.createElement(&quot;script&quot;);
		script.type = &quot;text/javascript&quot;;
		script.text = loadUtils() + loadGlobalization();
        script.onreadystatechange = callback;
        script.onload = callback;
		
        head.appendChild(script);
    }

    function scriptLoaded() {
        if (!loaded) {
            var paramFixletDescription = document.getElementById(&apos;paramFixletDescription&apos;);
            var plainOrdinaryFixletDescription = document.getElementById(&apos;plainOrdinaryFixletDescription&apos;);
			
            if (typeof FixletUtils !== &apos;undefined&apos;) {
                loaded = true;
                paramFixletDescription.style.display = &quot;block&quot;;
                plainOrdinaryFixletDescription.style.display = &quot;none&quot;;
				
                FixletUtils.initFixletRender();
            } else {
                paramFixletDescription.style.display = &quot;none&quot;;
                plainOrdinaryFixletDescription.style.display = &quot;block&quot;;
            }
        }
    }
	
    loadScript(&quot;vrt_fixletUtils.js&quot;, scriptLoaded);
&lt;/script&gt;
</Description>
    <Relevance>not exists file &quot;/usr/local/bin/resauthd&quot;</Relevance>
    <Relevance>name of operating system as lowercase starts with &quot;mac os x&quot;</Relevance>
    <Relevance>system version &gt;= &quot;10.8.5&quot;</Relevance>
    <Relevance>system version &lt;= &quot;11.10&quot;</Relevance>
    <Category>Upgrade</Category>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <MIMEField>
      <Name>x-res-release-display-name</Name>
      <Value>RES ONE Workspace 2015 SR1</Value>
    </MIMEField>
    <MIMEField>
      <Name>parametermetadatatag</Name>
      <Value>{
&quot;Section1&quot; :{
	&quot;Name&quot;: &quot;Method&quot;,
	&quot;Title&quot;: &quot;Agent Configuration&quot;,
	&quot;UIType&quot;: &quot;accordion&quot;,
	&quot;Values&quot;: [
	{
	    &quot;Name&quot;: &quot;rlParent&quot;,
	    &quot;Title&quot;: &quot;Relay Parent&quot;, 
	    &quot;Description&quot;: &quot;Select the parent of this relay&quot;,
		&quot;UIType&quot;: &quot;select&quot;,
		&quot;Override&quot;: &quot;true&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;\&quot;Current BigFix Relay\&quot;;unique values of ((concatenation of (hostname of computer of it as lowercase;\&quot;:\&quot;; value of it)) of results of property 5 of fixlets whose (name of it = \&quot;RES ONE Workspace - Relay - Universal\&quot;) of site of current fixlet;substrings separated by \&quot;,\&quot; of (values of shared variables whose (name of it contains \&quot;RelayServers\&quot;) of wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot;) of site of current fixlet) as lowercase)&quot;
	},
	{
	    &quot;Name&quot;: &quot;dbAuthMethod&quot;,
	    &quot;Title&quot;: &quot;Authentication&quot;,
	    &quot;Description&quot;: &quot;Authentication Method&quot;,
	    &quot;UIType&quot;: &quot;Select&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
		&quot;ValueType&quot;: &quot;specified&quot;,
		&quot;Values&quot;: [&quot;Relay&quot;]
	}
	]
},
&quot;Section5&quot; : {
	&quot;Name&quot;: &quot;EnvConfig&quot;,
	&quot;Title&quot;: &quot;Environment Configuration&quot;,
	&quot;UIType&quot;: &quot;accordion&quot;,
	&quot;Values&quot;: [
	{
	    &quot;Name&quot;: &quot;RESEnvPwdHash&quot;,
	    &quot;Title&quot;: &quot;RES Environment Password Hash&quot;, 
	    &quot;Description&quot;: &quot;Enter the RES Environment Password Hash&quot;,
		&quot;UIType&quot;: &quot;Textbox&quot;,
		&quot;Encrypt&quot;: &quot;false&quot;,
		&quot;SubUIType&quot;: &quot;password&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;values of shared variables whose (name of it contains \&quot;respw_hash\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;
	},
	{
	    &quot;Name&quot;: &quot;RESRELPORT&quot;,
	    &quot;Title&quot;: &quot;RES Relay Port&quot;, 
	    &quot;Description&quot;: &quot;Enter the RES Relay Port&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
		&quot;UIType&quot;: &quot;Textbox&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;values of shared variables whose (name of it contains \&quot;resrelport\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;
	},
	{
	    &quot;Name&quot;: &quot;RESEnvGUID&quot;,
	    &quot;Title&quot;: &quot;RES Environment GUID&quot;, 
	    &quot;Description&quot;: &quot;Enter the RES Environment GUID&quot;,
		&quot;UIType&quot;: &quot;Textbox&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;unique values of (values of shared variables whose (name of it contains \&quot;EnvironmentGUID\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet);(values of results of properties whose (name of it = \&quot;RES ONE Workspace Database - Site GUID - Windows\&quot;) of fixlets whose (name of it = \&quot;RES ONE Workspace - Database - Windows\&quot;) of site of current fixlet))&quot;
	}
]
}
}</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action23936">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Source Release Date: 2016-12-05
begin prefetch block
  add prefetch item name=RESWMosXAgent.pkg sha1=a1ca5d8d577708406eb63976ee35aa34f86d2a88 size=321558 url=http://downloads.ressoftware.com/downloads/cdm/040116/agents/reswmad-9.10.1.0-1.3280.pkg sha256=fc408509018ed6b95db7ae33435f3317c3f119d46cd86ce43cc6a293f9a1e617
end prefetch block

if {parameter &quot;rlParent&quot; of action = &quot;Current BigFix Relay&quot;}
	// This Relay List will provide 127.0.0.1 if the current device is a relay
	parameter &quot;RelayList&quot;=&quot;{(preceding text of first &quot;:&quot; of name of registration server as lowercase) &amp; &quot;:&quot; &amp; parameter &quot;RESRELPORT&quot; of action}&quot;

	// This Relay List will provide the relay&apos;s parent if the current device is a relay
	//parameter &quot;RelayList&quot;=&quot;{((if ((it does not contain &quot;127.0.0.1&quot; and it does not contain &quot;::1&quot;) of name of registration server) then (preceding text of first &quot;:&quot; of name of registration server) else (preceding text of first &quot;:&quot; of following text of first &quot;://&quot; of value of setting &quot;_BESRelay_PostResults_ParentRelayURL&quot; of client)) &amp; &quot;:&quot; &amp; parameter &quot;RESRELPORT&quot; of action)}&quot;
else
	parameter &quot;RelayList&quot;=&quot;{parameter &quot;rlParent&quot; of action}&quot;
endif

wait sh -c &quot;installer -pkg &apos;__Download/RESWMosXAgent.pkg&apos; -target /&quot;

delete __createfile

createfile until __end
sed -i &apos;s/LearningMode=no/LearningMode=yes/g&apos; /etc/res/resauthd.conf
sed -i &apos;s/AllowAny=no/AllowAny=yes/g&apos; /etc/res/resauthd.conf
rm /etc/res/reswmad.conf
touch /etc/res/reswmad.conf
echo RSENVGUID={(parameter &quot;RESEnvGUID&quot; of action)} &gt;&gt; /etc/res/reswmad.conf
echo RSPASSWORD={(parameter &quot;RESEnvPwdHash&quot; of action)} &gt;&gt; /etc/res/reswmad.conf
echo RSPWHASHED=Yes &gt;&gt; /etc/res/reswmad.conf
echo RSLIST={parameter &quot;RelayList&quot;} &gt;&gt; /etc/res/reswmad.conf
launchctl load /Library/LaunchDaemons/com.ressoftware.reswmad.plist
launchctl load /Library/LaunchDaemons/com.ressoftware.resauthd.plist
__end

move __createfile agent_config.sh
wait bash agent_config.sh
delete agent_config.sh
delete run.sh
     </ActionScript>
    </Action>
  </Fixlet>
</BES>
