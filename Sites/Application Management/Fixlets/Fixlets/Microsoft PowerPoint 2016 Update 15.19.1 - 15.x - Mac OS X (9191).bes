<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Microsoft PowerPoint 2016 Update 15.19.1 - 15.x - Mac OS X</Title>
    <Description><![CDATA[<P>Use this action to update Microsoft PowerPoint 2016 for Mac to version 15.19.1. The update is relevant on Macs running Yosemite or newer with PowerPoint 2016 installed.</P>
<P>Update 15.19.1 was released on February 16, 2016</P>
<P>MS16-015: <A href="https://support.microsoft.com/en-us/kb/3134241">https://support.microsoft.com/en-us/kb/3134241</A></P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.10.0"]]></Relevance>
    <Relevance><![CDATA[exists application whose (name of it = "Microsoft PowerPoint.app" and version of it < "15.19.1" AND version of it >= "15.15.0")]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-01-17</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sun, 21 Feb 2016 22:09:06 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch Microsoft_PowerPoint_15.19.1_160212_Updater.pkg sha1:d48fe2f7e82500f25f43296815487a4c3b8895f6 size:811302476 http://officecdn.microsoft.com/pr/C1297A47-86C4-4C1F-97FA-950631F94777/OfficeMac/Microsoft_PowerPoint_15.19.1_160212_Updater.pkg sha256:e05a33662330705a2f09242b1a0f242ba7465b90e1757957484a8f5bdc7f522b

// Delete the PowerPoint Update PKG in case it exists
wait /bin/sh -c &quot;rm &apos;/private/tmp/Microsoft_PowerPoint_15.19.1_160212_Updater.pkg&apos; &quot;

// Kill all PowerPoint processes to forcibly close PowerPoint
// Uncomment the next line to forcibly close PowerPoint by killing the process
// wait /usr/bin/killall -9 &quot;Microsoft PowerPoint&quot;

// Move the downloaded PowerPoint Update PKG to the temp directory
move &quot;{posix path of file &quot;Microsoft_PowerPoint_15.19.1_160212_Updater.pkg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/Microsoft_PowerPoint_15.19.1_160212_Updater.pkg&quot;

// Install the PowerPoint Update
wait installer -pkg &quot;/private/tmp/Microsoft_PowerPoint_15.19.1_160212_Updater.pkg&quot; -target /

// Delete the PowerPoint Update PKG in the temp directory
wait /bin/sh -c &quot;rm &apos;/private/tmp/Microsoft_PowerPoint_15.19.1_160212_Updater.pkg&apos; &quot;

// Uncomment the next line to require a restart after the update
// action requires restart</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
