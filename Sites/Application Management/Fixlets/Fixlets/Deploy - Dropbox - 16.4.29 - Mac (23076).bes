    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch F19ADBE3F02B0DA6595BB859793312A779CA16E4.dmg sha1:F19ADBE3F02B0DA6595BB859793312A779CA16E4 size:95049050 https://clientupdates.dropboxstatic.com/client/Dropbox%2016.4.29.dmg sha256:47A5B0B09099A98E7A2AC60BE4C78C69367EE9A96EFDD7E82CF697DF85820DE9

delete &quot;/tmp/F19ADBE3F02B0DA6595BB859793312A779CA16E4.dmg&quot;

move &quot;__Download/F19ADBE3F02B0DA6595BB859793312A779CA16E4.dmg&quot; &quot;/tmp/F19ADBE3F02B0DA6595BB859793312A779CA16E4.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTF19ADBE3F02B0DA6595BB859793312A779CA16E4&quot; &quot;/tmp/F19ADBE3F02B0DA6595BB859793312A779CA16E4.dmg&quot;

wait sh -c &quot;rm /tmp/F19ADBE3F02B0DA6595BB859793312A779CA16E4.dmg&quot;

wait cp -R /tmp/BESMNTPTF19ADBE3F02B0DA6595BB859793312A779CA16E4/* /tmp/BESTEMPF19ADBE3F02B0DA6595BB859793312A779CA16E4

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTF19ADBE3F02B0DA6595BB859793312A779CA16E4/. /tmp/BESTEMPF19ADBE3F02B0DA6595BB859793312A779CA16E4&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTF19ADBE3F02B0DA6595BB859793312A779CA16E4 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPF19ADBE3F02B0DA6595BB859793312A779CA16E4/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPF19ADBE3F02B0DA6595BB859793312A779CA16E4&apos;&quot;
</ActionScript>
    </DefaultAction>
