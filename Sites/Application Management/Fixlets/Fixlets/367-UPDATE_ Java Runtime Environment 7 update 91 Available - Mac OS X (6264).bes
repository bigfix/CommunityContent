<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>UPDATE: Java Runtime Environment 7 update 91 Available - Mac OS X</Title>
    <Description><![CDATA[

<DIV class=FixletMessage>
<TABLE><TBODY><TR><TD><P>Oracle has released a new version of the Java SE Runtime Environment (JRE). Use the action below to update Java to version 7, update 91.</P><SPAN id=fixletLink></SPAN><P><B>Note:</B> Affected computers may report back as 'Pending Restart' once the patch has run successfully, but will not report back their final status until the computer has been restarted. <BR><BR><B>Important Note:</B> The Java Runtime Environment update does not remove versions of JRE older than JRE 7 update 91. Multiple versions of JRE may be present on affected computers after applying the action below. Fixlet message "Multiple JRE Versions Installed" (ID 7052001) can be used to uninstall older versions of the Java Runtime Environment.</P> <P><B>Important Note: </B>For more information about manually caching file downloads on the BES Server, please see the following BigFix Support Knowledge Base <A href="http://support.bigfix.com/cgi-bin/kbdirect.pl?id=390">article</A>.</P> <P><STRONG>Important Note:</STRONG> Choosing the "Upgrade to the latest JRE regardless of whether or not Internet Explorer, Firefox, or Java is currently running action" will close any running instance of Internet Explorer, Firefox, or Java on the client machines. Please schedule the update to occur at a time when a service interruption is acceptable.</P></TD></TR></TBODY></TABLE>
</DIV>

<DIV class=FixletProperty>

<H4>File Size:</H4>
28.1 MB
 </DIV>

<DIV class=FixletProperty>

<H4>CVE:</H4>
CVE-2015-4835; CVE-2015-4881; CVE-2015-4843; CVE-2015-4883; CVE-2015-4860; CVE-2015-4805; CVE-2015-4844; CVE-2015-4810; CVE-2015-4806; CVE-2015-4871; CVE-2015-4902; CVE-2015-4840; CVE-2015-4882; CVE-2015-4842; CVE-2015-4734; CVE-2015-4903; CVE-2015-4803; CVE-2015-4893; CVE-2015-4911; CVE-2015-4872
</DIV>]]></Description>
    <Relevance>(name of operating system = &quot;Mac OS X&quot;) AND (if exists property &quot;in proxy agent context&quot; then (not in proxy agent context) else true) AND (if exists property &quot;android&quot; of type &quot;operating system&quot; then (not android of operating system) else true)</Relevance>
    <Relevance><![CDATA[(exists string "ProductVersion" whose (it as version >= "10.7.3" AND (NOT(it as string = "10.7"))) of dictionary of it) of file "/System/Library/CoreServices/SystemVersion.plist"]]></Relevance>
    <Relevance>(exists folder &quot;/Library/PreferencePanes/JavaControlPanel.prefPane/Contents/&quot; whose (exists file &quot;Info.plist&quot; whose ((match (regex &quot;^([0-9]+\.[0-9]+\.[0-9]+)&quot;) of (string &quot;CFBundleShortVersionString&quot; of it)) of dictionary of it as version = &quot;1.7.0&quot;) of it))</Relevance>
    <Relevance><![CDATA[(exists folder "/Library/PreferencePanes/JavaControlPanel.prefPane/Contents/" whose (exists file "Info.plist" whose ((string "CFBundleShortVersionString" of dictionary of it as version = "1.7.0") or (((parenthesized part 1 of it & "." & parenthesized part 2 of it) of match (regex "^([0-9]+\.[0-9]+\.[0-9]+)_([0-9]+)") of (string "CFBundleShortVersionString" of it)) of dictionary of it as version < "1.7.0.91")) of it))]]></Relevance>
    <Category>Security Update</Category>
    <Source>Oracle</Source>
    <SourceID>21270433</SourceID>
    <SourceReleaseDate>2015-10-20</SourceReleaseDate>
    <SourceSeverity>Critical</SourceSeverity>
    <CVENames>CVE-2015-4835; CVE-2015-4881; CVE-2015-4843; CVE-2015-4883; CVE-2015-4860; CVE-2015-4805; CVE-2015-4844; CVE-2015-4810; CVE-2015-4806; CVE-2015-4871; CVE-2015-4902; CVE-2015-4840; CVE-2015-4882; CVE-2015-4842; CVE-2015-4734; CVE-2015-4903; CVE-2015-4803; CVE-2015-4893; CVE-2015-4911; CVE-2015-4872</CVENames>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>PTCH Patch Oracle Java Application</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-product</Name>
      <Value>JavaOracle</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 04:04:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action6840">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch jre-7u91-macosx-x64.dmg sha1:e51e89d7edeaed40aa931aa5b79d9dbb1cbfab14 size:51150928 http://download.oracle.com/MANUAL_BES_CACHING_REQUIRED/jre-7u79-macosx-x64.dmg sha256:650f4dc4a09345be796cf0ff03e37049df31d7e37c62815237ac8b7d7a1b04ed

wait cp &quot;{posix path of file &quot;jre-7u91-macosx-x64.dmg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/Volumes/jre-7u91-macosx-x64&quot;  &quot;/private/tmp/jre-7u91-macosx-x64.dmg&quot;

wait rm -rf &quot;/private/tmp/jre-7u91-macosx-x64.dmg&quot;

wait cp -r &quot;/Volumes/jre-7u91-macosx-x64/Java 7 update 91.pkg&quot; &quot;/private/tmp/Java 7 update 91.pkg&quot;

wait /bin/bash -c &quot;devname=`df | grep jre-7u91-macosx-x64 | awk &apos;{{print $1}&apos;`; hdiutil detach -force $devname;&quot;

wait installer -pkg &quot;/private/tmp/Java 7 update 91.pkg&quot; -target /

action may require restart &quot;e51e89d7edeaed40aa931aa5b79d9dbb1cbfab14&quot;
</ActionScript>
    </Action>
