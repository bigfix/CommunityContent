<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - VMWare Player 12.x - 12.1.1.6932 - Windows (x64)</Title>
    <Description>This fixlet is for Deploy - VMWare Player 12.x - 12.1.1.6932 - Windows (x64) and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.

Notes about this Fixlet:
VMWare Workstation Player requires a license for commercial use. This Fixlet will only deploy a trial version of VMWare Player. A separate fixlet must be used to license VMware Player on the workstations.</Description>
    <Relevance><![CDATA[(windows of operating system) and (x64 of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 73130024 * 2) and (not exists regapp ("vmplayer.exe"))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceID>!FixletID!</SourceID>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 22:01:55 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Comment

prefetch D63E0D2B95E1BA23AFD1A9D04137B0FF8EA58CFC sha1:D63E0D2B95E1BA23AFD1A9D04137B0FF8EA58CFC size:73130024 https://download3.vmware.com/software/player/file/VMware-player-12.1.1-3770994.exe sha256:1CD93C067785D80D347F4479826F9399DD713573EC04659F74477917E605BFD1

parameter "baseFolder" =  "__Download/"

delete "{parameter "baseFolder"}VMWare Player 12.x.exe"
move "__Download/D63E0D2B95E1BA23AFD1A9D04137B0FF8EA58CFC" "{parameter "baseFolder"}VMWare Player 12.x.exe"

parameter "logFolder" = "{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs"
folder create "{parameter "logFolder"}"
parameter "logFile" = "PGW.log"

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
mkdir "{parameter "logFolder"}"

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | "Debugger" as string} - VMWare Player 12.x >> "{parameter "logFolder"}/{parameter "logFile"}"

"VMWare Player 12.x.exe" /s /nsr /v EULAS_AGREED=1 >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

echo Return code: %errorlevel% >> "{parameter "logFolder"}/{parameter "logFile"}"
echo. >> "{parameter "logFolder"}/{parameter "logFile"}"

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
