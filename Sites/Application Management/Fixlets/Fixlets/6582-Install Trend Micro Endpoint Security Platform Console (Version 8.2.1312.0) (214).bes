<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install Trend Micro Endpoint Security Platform Console (Version 8.2.1312.0)</Title>
    <Description><![CDATA[
<DIV class=FixletMessage>
<TABLE><TBODY><TR><TD><P><FONT size=2><B>Installs the Trend Micro Endpoint Security Platform Console 8.2.1312.0 on the selected Windows computers.<BR>The version of the server must be 8.2.1312.0 to ensure database version compatibility.<BR><BR></B></FONT><FONT size=2>For more information on the Trend Micro Endpoint Security Platform Console, please visit the following support web pages:</P> <UL> <LI><A href="http://support.bigfix.com/bes/install/consolereq.html">Trend Micro Endpoint Security Platform Console System Requirements</A></FONT></LI></UL></TD></TR></TBODY></TABLE>
</DIV>
<DIV class=FixletProperty>
<H4>File Size:</H4>
57.1 MB
 </DIV>
]]></Description>
    <Relevance>NOT exists service &quot;BESRootServer&quot;</Relevance>
    <Relevance><![CDATA[((it = "Win7" OR it = "Win2008R2" OR it = "Win2008" OR it = "WinVista") of name of it OR ((name of it = "Win2003" AND service pack major version of it >= 1) OR ((it = "WinXP" OR it = "WinXP-2003") of name of it AND service pack major version of it >= 2))) of operating system]]></Relevance>
    <Relevance>not exists regapp &quot;BESConsole.exe&quot;</Relevance>
    <Relevance>if (exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\Brand&quot; whose (exists value &quot;value&quot; of it) of registry) then (value &quot;value&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\BigFix\Brand&quot; of registry as string = &quot;Trend&quot;) else (&quot;Trend&quot;=&quot;BigFix&quot;)</Relevance>
    <Relevance>evaluation of client license = false</Relevance>
    <Relevance>version of registration server = &quot;8.2.1312.0&quot;</Relevance>
    <Relevance><![CDATA[version of regapp "iexplore.exe" >= "7"]]></Relevance>
    <Category>Upgrade</Category>
    <Source>IBM</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2012-08-21</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-first-propagation</Name>
      <Value>Mon, 21 Nov 2011 22:07:36 +0000</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 22 Aug 2012 20:31:00 +0000</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>BES Deploy Console</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to install the Trend Micro Endpoint Security Platform Console to the default location.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch BESConsole.exe sha1:6f87bd8e16c09c95f413836d80c55a3ce4e11e75 size:59830784 http://software.bigfix.com/download/bes/82/Trend-BES-Console-8.2.1312.0.exe
delete __Local\Get\BESConsole.exe
// If the next line fails, there is not enough free space to complete this action
continue if {59830784  < free space of drive of client folder of current site}
move __Download\BESConsole.exe __Local\Get\BESConsole.exe
delete __Local\Get\ActionSite.afxm
copy "{parent folder of client as string & "\ActionSite.afxm"}" __Local\Get\ActionSite.afxm
regset "[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\windows\Installer]" "Logging"="voicewarmupx"
wait __Local\Get\BESConsole.exe /s /v"/l*voicewarmup \"{location of client}\besconsoleinstall.log\" REBOOT=ReallySuppress MSIRESTARTMANAGERCONTROL=Disable /qn"
delete __Local\Get\BESConsole.exe
delete __Local\Get\ActionSite.afxm
action may require restart]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
