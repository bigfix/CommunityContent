    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22.dmg sha1:5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22 size:10167007 https://s3.amazonaws.com/BBSW-download/TextWrangler_5.5.2.dmg sha256:046AFF569123D39782981F52D918A1B51F18CAEFCA4AC0436DCC193EDFD96C08

delete &quot;/tmp/5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22.dmg&quot;

move &quot;__Download/5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22.dmg&quot; &quot;/tmp/5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22&quot; &quot;/tmp/5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22.dmg&quot;

wait sh -c &quot;rm /tmp/5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22/. /tmp/BESTEMP5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP5E20B281ADDDAF307EF56CEC1B8CBCC55A443D22&apos;&quot;
</ActionScript>
