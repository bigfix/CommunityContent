      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 60F52A2DC451F5D3B9F088B57877DF557D3C5AAF.dmg sha1:60F52A2DC451F5D3B9F088B57877DF557D3C5AAF size:37349043 http://download.videolan.org/pub/videolan/vlc/2.2.4/macosx/vlc-2.2.4.dmg sha256:FD071B9817C9EFCCAC5A144D69893A4A5323CBDE4A74D5691C3CF3AB979D4160

delete &quot;/tmp/60F52A2DC451F5D3B9F088B57877DF557D3C5AAF.dmg&quot;

move &quot;__Download/60F52A2DC451F5D3B9F088B57877DF557D3C5AAF.dmg&quot; &quot;/tmp/60F52A2DC451F5D3B9F088B57877DF557D3C5AAF.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT60F52A2DC451F5D3B9F088B57877DF557D3C5AAF&quot; &quot;/tmp/60F52A2DC451F5D3B9F088B57877DF557D3C5AAF.dmg&quot;

wait sh -c &quot;rm /tmp/60F52A2DC451F5D3B9F088B57877DF557D3C5AAF.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT60F52A2DC451F5D3B9F088B57877DF557D3C5AAF/. /tmp/BESTEMP60F52A2DC451F5D3B9F088B57877DF557D3C5AAF&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT60F52A2DC451F5D3B9F088B57877DF557D3C5AAF | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP60F52A2DC451F5D3B9F088B57877DF557D3C5AAF/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP60F52A2DC451F5D3B9F088B57877DF557D3C5AAF&apos;&quot;
