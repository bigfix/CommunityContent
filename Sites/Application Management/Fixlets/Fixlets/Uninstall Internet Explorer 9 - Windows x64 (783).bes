<!--
  BigFix Fixlet Export

  Title    : Uninstall Internet Explorer 9 - Windows x64
  ID       : 783
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T22:00:12
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall Internet Explorer 9 - Windows x64</Title>
    <Description>This Fixlet will uninstall Internet Explorer 9 </Description>
    <Relevance>x64 of operating system</Relevance>
    <Relevance>(name of it = &quot;WinVista&quot; or name of it = &quot;Win7&quot;) of operating system</Relevance>
    <Relevance>exists version of regapp &quot;iexplore.exe&quot; AND &quot;9.0&quot; as version = version of regapp &quot;iexplore.exe&quot;</Relevance>
    <Relevance><![CDATA[exists files whose (name of it contains "Microsoft-Windows-InternetExplorer" and name of it contains "9.4.8112.16421") of folder (parent folder of system folder as string & "\servicing\Packages")]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2011-08-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 07 Dec 2012 04:01:35 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait {parent folder of system folder as string}\sysnative\pkgmgr /up:Microsoft-Windows-InternetExplorer-Package-TopLevel~31bf3856ad364e35~amd64~~9.4.8112.16421 /quiet /norestart
wait {parent folder of system folder as string}\sysnative\pkgmgr /up:Microsoft-Windows-InternetExplorer-Package~31bf3856ad364e35~amd64~en-US~9.4.8112.16421 /quiet /norestart
wait {parent folder of system folder as string}\sysnative\pkgmgr /up:Microsoft-Windows-InternetExplorer-Package~31bf3856ad364e35~amd64~~9.4.8112.16421 /quiet /norestart
wait {parent folder of system folder as string}\sysnative\pkgmgr /up:Microsoft-Windows-InternetExplorer-VistaPlus-Update~31bf3856ad364e35~amd64~~9.4.8112.16421 /quiet /norestart
wait {parent folder of system folder as string}\sysnative\pkgmgr /up:Microsoft-Windows-InternetExplorer-Optional-Package~31bf3856ad364e35~amd64~en-US~9.4.8112.16421 /quiet /norestart
wait {parent folder of system folder as string}\sysnative\pkgmgr /up:Microsoft-Windows-InternetExplorer-Optional-Package~31bf3856ad364e35~amd64~~9.4.8112.16421 /quiet /norestart
wait {parent folder of system folder as string}\sysnative\pkgmgr /up:Microsoft-Windows-InternetExplorer-Package-MiniLP~31bf3856ad364e35~amd64~en-US~9.4.8112.16421 /quiet /norestart
action requires restart</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
