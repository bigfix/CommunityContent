      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch AC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A.dmg sha1:AC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A size:55358955 https://download.mozilla.org/?product=firefox-latest-ssl&os=osx&lang=en-US sha256:D30AA9862A8ADC21E98D447BFEB3E50D40CBFC5AA3F9A8CDD2502A8E4C8B6C47

delete "/tmp/AC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A.dmg"

move "__Download/AC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A.dmg" "/tmp/AC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPTAC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A" "/tmp/AC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A.dmg"

wait sh -c "rm /tmp/AC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPTAC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A/. /tmp/BESTEMPAC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPTAC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMPAC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMPAC81961D4D7F9E4B6B8FF9C1764AA617B96CAA1A'"
]]></ActionScript>
