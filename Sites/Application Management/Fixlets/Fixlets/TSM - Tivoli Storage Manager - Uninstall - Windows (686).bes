<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>TSM - Tivoli Storage Manager - Uninstall - Windows</Title>
    <Description>This action will uninstall TSM.</Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists key whose (value &quot;displayname&quot; of it as string contains &quot;IBM Tivoli Storage Manager Client&quot; of it and value &quot;uninstallstring&quot; of it as string as lowercase contains &quot;msiexec&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry</Relevance>
    <Category>Uninstall</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2012-11-19</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 04 Dec 2012 16:05:43 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">Wait msiexec.exe /X {name of key whose (value &quot;displayname&quot; of it as string contains &quot;IBM Tivoli Storage Manager Client&quot; of it and value &quot;uninstallstring&quot; of it as string as lowercase contains &quot;msiexec&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry} /qn</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
