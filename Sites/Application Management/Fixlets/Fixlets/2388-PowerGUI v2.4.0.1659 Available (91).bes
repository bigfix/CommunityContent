<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>PowerGUI v2.4.0.1659 Available</Title>
    <Description>Install the PowerGUI editor for PowerShell Scripting. </Description>
    <Relevance>name of operating system as string contains &quot;Win&quot;</Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1&quot; whose (value &quot;Install&quot; of it as integer = 1) of registry</Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\PowerShellEngine&quot; whose (value &quot;PowerShellVersion&quot; of it as string = &quot;2.0&quot;) of registry</Relevance>
    <Relevance><![CDATA[NOT (exists key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\PowerShellSnapIns\PowerGUI" of registry) OR (exists key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\PowerShellSnapIns\PowerGUI" whose (value "Version" of it as string as version < "2.4.0.1659") of registry)]]></Relevance>
    <Category>Update</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2011-04-21</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 01 Oct 2012 21:23:15 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this software.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
download http://www.powergui.org/servlet/KbServlet/download/1983-102-2817/PowerGUI.2.4.0.1659.msi
continue if {(size of it = 13075456 AND sha1 of it = "83259bbfde9f937e4e4cd53a12cc46bfbc8ecf5d") of file "PowerGUI.2.4.0.1659.msi" of folder "__Download"}
wait "{pathname of system folder & "\msiexec.exe"}" /i "{(pathname of client folder of current site) & "\__Download\PowerGUI.2.4.0.1659.msi"}" /qn /norestart
]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action239">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn more about PowerGUI.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://www.powergui.org</ActionScript>
    </Action>
  </Fixlet>
</BES>
