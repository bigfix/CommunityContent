    <Domain>BESC</Domain>
    <Action ID="Action23932">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Source Release Date: 2016-12-05

// action log all

// If your action dies here you did not select an authentication method!
continue if {parameter "dbAuthMethod" of action != "Select an Authentication Type"}

parameter "PowerShellExe"="{ pathname of file ((it as string) of value "Path" of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\ShellIds\Microsoft.PowerShell" of native registry) }"

delete __createfile
delete relayconfig.xml
delete relayconfigu.xml
delete relayconfig.ps1

//
// Reconfigure Relay using SQL Authentication
//

if {parameter "dbAuthMethod" of action = "SQL"}
continue if {parameter "SQLUser" of action != ""}
createfile until __done
<?xml version="1.0" encoding="UTF-16"?>
<relayserver>
  <environments>
    <environment guid="{(parameter "RESEnvGUID" of action)}">
      <enabled>yes</enabled>
      <environmentname>{parameter "dbName" of action}@{parameter "dbServer" of action}</environmentname>
      <local>
        <providertype>0</providertype>
        <haschanged>yes</haschanged>
        <cachelocation>{value of variable "ALLUSERSPROFILE" of environment & "\RES\Relay Server"}</cachelocation>
      </local>
      <remote>
        <providertype>2</providertype>
        <haschanged>yes</haschanged>
        <dbserver>{parameter "dbServer" of action}</dbserver>
        <dbname>{parameter "dbName" of action}</dbname>
        <dbuser>{parameter "SQLUser" of action}</dbuser>
        <dbwinauth>no</dbwinauth>
        <dbpassword encrypted="no" storefipsencrypted="yes">"{parameter "SQLPass" of action}"</dbpassword>
        <dbtype>MSSQL</dbtype>
        <dbprotocolencryption>no</dbprotocolencryption>
      </remote>
    </environment>
  </environments>
 <port>{parameter "RESRELPORT" of action}</port>
</relayserver>
__done
move __createfile relayconfig.xml

wait CMD /U /C Type "relayconfig.xml" >> "relayconfigu.xml"
delete __createfile

createfile until __done
$UserName = "NT Authority\SYSTEM"
$Password = ""
$svc_Obj= Get-WmiObject Win32_Service -filter "name='resrls'"
$StopStatus = $svc_Obj.StopService()
$ChangeService = $svc_Obj.change($null,$null,$null,$null,$null,$null,$UserName,$Password,$null,$null,$null)

__done
move __createfile relayconfig.ps1
//
// Install Relay using SQL Authentication
//

elseif {parameter "dbAuthMethod" of action = "Windows"}
continue if {parameter "adServiceAccountUsername" of action != ""}
createfile until __done
<?xml version="1.0" encoding="UTF-16"?>
<relayserver>
  <environments>
    <environment guid="{(parameter "RESEnvGUID" of action)}">
      <enabled>yes</enabled>
      <environmentname>{parameter "dbName" of action}@{parameter "dbServer" of action}</environmentname>
      <local>
        <providertype>0</providertype>
        <haschanged>yes</haschanged>
        <cachelocation>{value of variable "ALLUSERSPROFILE" of environment & "\RES\Relay Server"}</cachelocation>
      </local>
      <remote>
        <providertype>2</providertype>
        <haschanged>yes</haschanged>
        <dbserver>{parameter "dbServer" of action}</dbserver>
        <dbname>{parameter "dbName" of action}</dbname>
        <dbuser>
        </dbuser>
        <dbwinauth>yes</dbwinauth>
        <dbpassword encrypted="no">
		</dbpassword>
        <dbtype>MSSQL</dbtype>
        <dbprotocolencryption>no</dbprotocolencryption>
      </remote>
    </environment>
  </environments>
 <port>{parameter "RESRELPORT" of action}</port>
</relayserver>
__done
move __createfile relayconfig.xml

wait CMD /U /C Type "relayconfig.xml" >> "relayconfigu.xml"
delete __createfile

createfile until __done
$UserName = "{parameter "adServiceAccountUsername" of action}"
$Password = "{parameter "adServiceAccountPassword" of action}"
$svc_Obj= Get-WmiObject Win32_Service -filter "name='resrls'"
$StopStatus = $svc_Obj.StopService()
$ChangeService = $svc_Obj.change($null,$null,$null,$null,$null,$null,$UserName,$Password,$null,$null,$null)

__done
move __createfile relayconfig.ps1
endif

wait "{pathname of file of service "resrls"}" /configfile="{pathname of client folder of current site}\relayconfigu.xml" /silent

override wait
hidden=true
completion=job
wait "{parameter "PowershellExe"}" -ExecutionPolicy Bypass -File relayconfig.ps1

waithidden net start resrls
delete relayconfig.xml
delete relayconfigu.xml
delete relayconfig.ps1
delete __createfile

notify client forcerefresh
]]></ActionScript>
    </Action>
  </Task>
</BES>
