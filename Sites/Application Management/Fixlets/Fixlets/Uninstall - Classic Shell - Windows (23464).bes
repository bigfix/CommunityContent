<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall - Classic Shell - Windows</Title>
    <Description>This fixlet is for Uninstall - Classic Shell - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (exists value "UninstallString" whose (it as string contains "MsiExec") of keys whose (value "DisplayName" of it as string is "Classic Shell") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2017-02-16</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:classic_shell:classic_shell:*:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:classic_shell:classic_shell</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:38:17 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
override wait
hidden=true
completion=job
wait msiexec /x &quot;{name of keys whose (value &quot;DisplayName&quot; of it as string is &quot;Classic Shell&quot; and value &quot;UninstallString&quot; of it as string contains &quot;MsiExec&quot;) of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x32 registries; x64 registries)}&quot; /qn
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
