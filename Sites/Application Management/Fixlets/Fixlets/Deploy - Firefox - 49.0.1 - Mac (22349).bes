    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:38:17 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F.dmg sha1:028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F size:85200627 https://download.mozilla.org/?product=firefox-49.0.1-SSL&os=osx&lang=en-US sha256:4A1B91C93AA3C0D2E530622C2D4203246446409BCC4D0155C2724BD21886669F

delete "/tmp/028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F.dmg"

move "__Download/028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F.dmg" "/tmp/028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPT028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F" "/tmp/028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F.dmg"

wait sh -c "rm /tmp/028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPT028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F/. /tmp/BESTEMP028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPT028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMP028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMP028FC8F02F17D7330BCE5EF4278DA813E8DA0B7F'"
]]></ActionScript>
