delete &quot;/tmp/6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9.dmg&quot;

move &quot;__Download/6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9.dmg&quot; &quot;/tmp/6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9&quot; &quot;/tmp/6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9.dmg&quot;

wait sh -c &quot;rm /tmp/6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9/. /tmp/BESTEMP6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT6D2E5158F101DAD94EDE3D5CF5FDA8FE9FD3C3B9 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

