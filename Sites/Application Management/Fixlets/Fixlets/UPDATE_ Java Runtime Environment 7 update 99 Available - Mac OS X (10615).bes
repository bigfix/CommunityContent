<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>UPDATE: Java Runtime Environment 7 update 99 Available - Mac OS X</Title>
    <Description><![CDATA[<DIV class=FixletMessage>
<TABLE>
<TBODY>
<TR>
<TD>
<P>Oracle has released a new version of the Java SE Runtime Environment (JRE). Use the action below to update Java to version 7 update 99.</P><SPAN id=fixletLink></SPAN>
<P><B>Note:</B> Affected computers may report back as 'Pending Restart' once the patch has run successfully, but will not report back their final status until the computer has been restarted. <BR><BR><B>Important Note:</B> The Java Runtime Environment update does not remove versions of JRE older than JRE 7 update 99. Multiple versions of JRE may be present on affected computers after applying the action below. Fixlet message "Multiple JRE Versions Installed" (ID 7052001) can be used to uninstall older versions of the Java Runtime Environment.</P>
<P><B>Important Note: </B>For more information about manually caching file downloads on the BES Server, please see the following BigFix Support Knowledge Base <A href="http://support.bigfix.com/cgi-bin/kbdirect.pl?id=390">article</A>.</P>
<P><STRONG>Important Note:</STRONG> Choosing the "Upgrade to the latest JRE regardless of whether or not Internet Explorer, Firefox, or Java is currently running action" will close any running instance of Internet Explorer, Firefox, or Java on the client machines. Please schedule the update to occur at a time when a service interruption is acceptable.</P></TD></TR></TBODY></TABLE></DIV>
<DIV class=FixletProperty>
<H4>CVE:</H4>CVE-2016-0636 </DIV>]]></Description>
    <Relevance>(name of operating system = &quot;Mac OS X&quot;) AND (if exists property &quot;in proxy agent context&quot; then (not in proxy agent context) else true) AND (if exists property &quot;android&quot; of type &quot;operating system&quot; then (not android of operating system) else true)</Relevance>
    <Relevance><![CDATA[(exists string "ProductVersion" whose (it as version >= "10.7.3" AND (NOT(it as string = "10.7"))) of dictionary of it) of file "/System/Library/CoreServices/SystemVersion.plist"]]></Relevance>
    <Relevance>(exists folder &quot;/Library/PreferencePanes/JavaControlPanel.prefPane/Contents/&quot; whose (exists file &quot;Info.plist&quot; whose ((match (regex &quot;^([0-9]+\.[0-9]+\.[0-9]+)&quot;) of (string &quot;CFBundleShortVersionString&quot; of it)) of dictionary of it as version = &quot;1.7.0&quot;) of it))</Relevance>
    <Relevance><![CDATA[(exists folder "/Library/PreferencePanes/JavaControlPanel.prefPane/Contents/" whose (exists file "Info.plist" whose ((string "CFBundleShortVersionString" of dictionary of it as version = "1.7.0") or (((parenthesized part 1 of it & "." & parenthesized part 2 of it) of match (regex "^([0-9]+\.[0-9]+\.[0-9]+)_([0-9]+)") of (string "CFBundleShortVersionString" of it)) of dictionary of it as version < "1.7.0.99")) of it))]]></Relevance>
    <Category>Security Update</Category>
    <Source>Oracle</Source>
    <SourceID>22961080</SourceID>
    <SourceReleaseDate>2016-03-23</SourceReleaseDate>
    <SourceSeverity>Critical</SourceSeverity>
    <CVENames>CVE-2016-0636</CVENames>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>PTCH Patch Oracle Java Application</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-product</Name>
      <Value>JavaOracle</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 28 Mar 2016 06:15:42 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action11406">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch jre-7u99-macosx-x64.dmg sha1:663e2c10d22204f8be351a994e4d1279ba1cee4e size:51162814 url:{value of setting &quot;_BESClient_AllowCustomRepoDownloads&quot; of client | &quot;http://download.oracle.com/MANUAL_BES_CACHING_REQUIRED/&quot;}jre-7u99-macosx-x64.dmg sha256:b8116c9b87f7e0397acfe88321caee4b3067a732a284e8ba3fc6afb5b5949d77

wait cp &quot;{posix path of file &quot;jre-7u99-macosx-x64.dmg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/Volumes/jre-7u99-macosx-x64&quot;  &quot;/private/tmp/jre-7u99-macosx-x64.dmg&quot;

wait rm -rf &quot;/private/tmp/jre-7u99-macosx-x64.dmg&quot;

wait cp -r &quot;/Volumes/jre-7u99-macosx-x64/Java 7 update 99.pkg&quot; &quot;/private/tmp/Java 7 update 99.pkg&quot;

wait /bin/bash -c &quot;devname=`df | grep jre-7u99-macosx-x64 | awk &apos;{{print $1}&apos;`; hdiutil detach -force $devname;&quot;

wait installer -pkg &quot;/private/tmp/Java 7 update 99.pkg&quot; -target /

action may require restart &quot;663e2c10d22204f8be351a994e4d1279ba1cee4e&quot;
</ActionScript>
    </Action>
    <Action ID="Action11407">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> for more information about the latest version of JRE. </PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://www.oracle.com/technetwork/java/javase/7u-relnotes-515228.html</ActionScript>
    </Action>
