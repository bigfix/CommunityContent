    <MIMEField>
      <Name>parametermetadatatag</Name>
      <Value>{ &quot;Section0&quot; :{  &quot;Name&quot;: &quot;Connector&quot;,  &quot;Title&quot;: &quot;RES ONE Workspace Connector Configuration&quot;,  &quot;UIType&quot;: &quot;accordion&quot;,  &quot;Values&quot;: [  {      &quot;Name&quot;: &quot;ConnectorAuthMethod&quot;,      &quot;Title&quot;: &quot;Console Authentication Method&quot;,      &quot;Description&quot;: &quot;Console Authentication Method&quot;,      &quot;UIType&quot;: &quot;Select&quot;,   &quot;ValueType&quot;: &quot;specified&quot;,   &quot;Values&quot;: [&quot;Windows Authentication&quot;, &quot;SQL Authentication&quot;]  }  ]   }, &quot;Section2&quot; : {  &quot;Name&quot;: &quot;dbInfo&quot;,  &quot;Title&quot;: &quot;RES ONE Workspace Database Configuration&quot;,  &quot;UIType&quot;: &quot;accordion&quot;,  &quot;Values&quot;: [  {      &quot;Name&quot;: &quot;dbServer&quot;,      &quot;Title&quot;: &quot;Database Server&quot;,       &quot;Description&quot;: &quot;Enter the name of the Database Server to be used for the RES ONE Workspace Database&quot;,   &quot;UIType&quot;: &quot;Textbox&quot;,   &quot;Disabled&quot;: &quot;true&quot;,      &quot;ValueType&quot;: &quot;relevance&quot;,   &quot;Values&quot;: &quot;values of shared variables whose (name of it is \&quot;dbserver\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;  },  {      &quot;Name&quot;: &quot;dbName&quot;,      &quot;Title&quot;: &quot;Database Name&quot;,       &quot;Description&quot;: &quot;Enter the name of the Database on the DB Server to be used for the RES ONE Workspace Database&quot;,   &quot;UIType&quot;: &quot;Textbox&quot;,   &quot;Disabled&quot;: &quot;true&quot;,      &quot;ValueType&quot;: &quot;relevance&quot;,   &quot;Values&quot;: &quot;values of shared variables whose (name of it contains \&quot;dbname\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;  }  ] }, &quot;Section4&quot; : {  &quot;Name&quot;: &quot;SQLAuth&quot;,  &quot;Title&quot;: &quot;RES ONE Workspace Database SQL Authentication&quot;,  &quot;UIType&quot;: &quot;accordion&quot;,  &quot;Values&quot;: [  {      &quot;Name&quot;: &quot;SQLUser&quot;,      &quot;Title&quot;: &quot;Database User Name&quot;,       &quot;Description&quot;: &quot;Enter the name of the Active Directory environment&quot;,   &quot;UIType&quot;: &quot;Textbox&quot;,   &quot;Disabled&quot;: &quot;true&quot;,      &quot;ValueType&quot;: &quot;relevance&quot;,   &quot;Values&quot;: &quot;values of shared variables whose (name of it is \&quot;dbuser\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;  },  {      &quot;Name&quot;: &quot;SQLPass&quot;,      &quot;Title&quot;: &quot;Database User Password&quot;,       &quot;Description&quot;: &quot;Enter the name of the preconfigured security group&quot;,   &quot;UIType&quot;: &quot;Textbox&quot;,   &quot;Disabled&quot;: &quot;true&quot;,   &quot;Encrypt&quot;: &quot;true&quot;,   &quot;SubUIType&quot;: &quot;password&quot;,      &quot;ValueType&quot;: &quot;relevance&quot;,   &quot;Values&quot;: &quot;values of shared variables whose (name of it contains \&quot;dbpwd\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;  }  ] }, &quot;Section5&quot; : {  &quot;Name&quot;: &quot;SOAPConf&quot;,  &quot;Title&quot;: &quot;BigFix WebReports SOAP API Authentication&quot;,  &quot;UIType&quot;: &quot;accordion&quot;,  &quot;Values&quot;: [  {      &quot;Name&quot;: &quot;SOAPUrl&quot;,      &quot;Title&quot;: &quot;Web Reports SOAP URL&quot;,       &quot;Description&quot;: &quot;Enter the SOAP URL&quot;,   &quot;UIType&quot;: &quot;Textbox&quot;,   &quot;Disabled&quot;: &quot;true&quot;,      &quot;ValueType&quot;: &quot;relevance&quot;,   &quot;Values&quot;: &quot;values of shared variables whose (name of it is \&quot;soapurl\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;  },  {      &quot;Name&quot;: &quot;SOAPUser&quot;,      &quot;Title&quot;: &quot;SOAP User Name&quot;,       &quot;Description&quot;: &quot;Enter the name of the SOAP User&quot;,   &quot;UIType&quot;: &quot;Textbox&quot;,   &quot;Disabled&quot;: &quot;true&quot;,      &quot;ValueType&quot;: &quot;relevance&quot;,   &quot;Values&quot;: &quot;values of shared variables whose (name of it is \&quot;soapuser\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;  },  {      &quot;Name&quot;: &quot;SOAPPass&quot;,      &quot;Title&quot;: &quot;SOAP User Password&quot;,       &quot;Description&quot;: &quot;Enter the password for the SOAP User&quot;,   &quot;UIType&quot;: &quot;Textbox&quot;,   &quot;Disabled&quot;: &quot;true&quot;,   &quot;Encrypt&quot;: &quot;true&quot;,   &quot;SubUIType&quot;: &quot;password&quot;,      &quot;ValueType&quot;: &quot;relevance&quot;,   &quot;Values&quot;: &quot;values of shared variables whose (name of it contains \&quot;soappw\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;  }  ] } }</Value>
