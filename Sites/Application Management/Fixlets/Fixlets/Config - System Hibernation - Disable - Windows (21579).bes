<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - System Hibernation - Disable - Windows</Title>
    <Description>Disable System Hibernation </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power&quot; whose (exists value &quot;HibernateEnabled&quot; whose (it as string = &quot;1&quot;) of it) of registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2014-10-09</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Enter your action script here

waithidden cmd.exe /c powercfg -h off</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
