move &quot;__Download/B4C5FA4A2B45D6AB8D5024576BC2E8E11169ECF8.dmg&quot; &quot;/tmp/B4C5FA4A2B45D6AB8D5024576BC2E8E11169ECF8.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTB4C5FA4A2B45D6AB8D5024576BC2E8E11169ECF8&quot; &quot;/tmp/B4C5FA4A2B45D6AB8D5024576BC2E8E11169ECF8.dmg&quot;

wait sh -c &quot;rm /tmp/B4C5FA4A2B45D6AB8D5024576BC2E8E11169ECF8.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTB4C5FA4A2B45D6AB8D5024576BC2E8E11169ECF8/. /tmp/BESTEMPB4C5FA4A2B45D6AB8D5024576BC2E8E11169ECF8&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTB4C5FA4A2B45D6AB8D5024576BC2E8E11169ECF8 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

