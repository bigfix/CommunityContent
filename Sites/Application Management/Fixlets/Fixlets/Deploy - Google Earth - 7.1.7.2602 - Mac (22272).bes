      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 93DF274850E2B3D8523889BDEFA0F97CF7010502.dmg sha1:93DF274850E2B3D8523889BDEFA0F97CF7010502 size:89091424 https://dl.google.com/earth/client/GE7/release_7_1_7/googleearth-bundled-manualupdate-intel-7.1.7.2602.dmg sha256:82BC3B49F9DB82FAF4D3EA95C5563B9D475278AAA2476CDC977960D42F0CBFD0

delete &quot;/tmp/93DF274850E2B3D8523889BDEFA0F97CF7010502.dmg&quot;

move &quot;__Download/93DF274850E2B3D8523889BDEFA0F97CF7010502.dmg&quot; &quot;/tmp/93DF274850E2B3D8523889BDEFA0F97CF7010502.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT93DF274850E2B3D8523889BDEFA0F97CF7010502&quot; &quot;/tmp/93DF274850E2B3D8523889BDEFA0F97CF7010502.dmg&quot;

wait sh -c &quot;rm /tmp/93DF274850E2B3D8523889BDEFA0F97CF7010502.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT93DF274850E2B3D8523889BDEFA0F97CF7010502/. /tmp/BESTEMP93DF274850E2B3D8523889BDEFA0F97CF7010502&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT93DF274850E2B3D8523889BDEFA0F97CF7010502 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait installer -pkg &quot;/tmp/BESTEMP93DF274850E2B3D8523889BDEFA0F97CF7010502/Install Google Earth.pkg&quot; -target /

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP93DF274850E2B3D8523889BDEFA0F97CF7010502&apos;&quot;
