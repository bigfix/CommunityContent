<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Uninstall BigFix Dashboard (Backend Service)</Title>
    <Description><![CDATA[Uninstall BigFix Dashboard (Backend Service)&nbsp;from the server. ]]></Description>
    <Relevance>name of operating system starts with &quot;Win&quot;</Relevance>
    <Relevance>if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true</Relevance>
    <Relevance>exists service &quot;BigFix Dashboard&quot;</Relevance>
    <Relevance>exists key whose (value &quot;DisplayName&quot; of it as string contains &quot;BigFix Dashboard Backend Service&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Category>Uninstall</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2012-12-06</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 07 Dec 2012 01:02:44 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to uninstall this software.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
parameter &quot;app&quot;=&quot;{name of key whose (value &quot;DisplayName&quot; of it as string contains &quot;BigFix Dashboard Backend Service&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry}&quot;
waithidden msiexec.exe /x {parameter &quot;app&quot; as string} /quiet
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action1007">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://bigfix.me/dashboard</ActionScript>
    </Action>
  </Task>
</BES>
