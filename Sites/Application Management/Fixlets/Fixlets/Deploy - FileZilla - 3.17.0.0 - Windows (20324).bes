<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - FileZilla - 3.17.0.0 - Windows</Title>
    <Description>This fixlet is for Deploy - FileZilla - 3.17.0.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.0") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 6292952 * 2) and (not exists regapp ("filezilla.exe"))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceID>!FixletID!</SourceID>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Comment

prefetch E8A5C410B29A668CD6B454DDEDE03D517D244023 sha1:E8A5C410B29A668CD6B454DDEDE03D517D244023 size:6292952 http://iweb.dl.sourceforge.net/project/filezilla/FileZilla_Client/3.17.0/FileZilla_3.17.0_win32-setup.exe sha256:4ABAA13DFC581E59954B5E55FCB3E600C4334EC5F2FB51DA7699F9167CCCF196

parameter "baseFolder" =  "__Download/"

delete "{parameter "baseFolder"}FileZilla.exe"
move "__Download/E8A5C410B29A668CD6B454DDEDE03D517D244023" "{parameter "baseFolder"}FileZilla.exe"

parameter "logFolder" = "{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs"
folder create "{parameter "logFolder"}"
parameter "logFile" = "PGW.log"

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
mkdir "{parameter "logFolder"}"

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | "Debugger" as string} - FileZilla >> "{parameter "logFolder"}/{parameter "logFile"}"

"FileZilla.exe" /S /user=all >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

echo Return code: %errorlevel% >> "{parameter "logFolder"}/{parameter "logFile"}"
echo. >> "{parameter "logFolder"}/{parameter "logFile"}"

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
