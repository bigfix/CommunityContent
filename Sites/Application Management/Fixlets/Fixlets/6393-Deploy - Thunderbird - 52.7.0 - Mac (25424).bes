      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch FE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43.dmg sha1:FE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43 size:79417382 https://download.mozilla.org/?product=thunderbird-52.7.0-SSL&os=osx&lang=en-US sha256:62EF79941CDA1B71371BCF820660855CF1E16E4EE1940CFF0AAB3831DA77AC83

delete "/tmp/FE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43.dmg"

move "__Download/FE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43.dmg" "/tmp/FE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPTFE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43" "/tmp/FE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43.dmg"

wait sh -c "rm /tmp/FE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPTFE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43/. /tmp/BESTEMPFE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPTFE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43 | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMPFE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMPFE39FE86DA3FEF9FABF7A254D9BD87F3D7C30B43'"
]]></ActionScript>
