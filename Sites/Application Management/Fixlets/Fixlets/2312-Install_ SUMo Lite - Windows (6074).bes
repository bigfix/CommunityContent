<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install: SUMo Lite - Windows</Title>
    <Description><![CDATA[<P>This task will deploy: SUMo.<BR></P>
<P>&nbsp;</P>]]></Description>
    <Relevance><![CDATA[/* Windows XP or later */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[not exists keys whose(value "DisplayName" of it as string contains "SUMo" AND value "DisplayVersion" of it as string as version >= "3.13.7.261") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries;x32 registries)]]></Relevance>
    <Category>Software Distribution</Category>
    <Source>Software Distribution Wizard</Source>
    <SourceReleaseDate>2014-06-09</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 12 May 2015 22:50:40 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here </Link>
        <PostLink>to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
//  http://www.kcsoftwares.com/?sumo
// https://www.virustotal.com/en/file/0c09a1bbf8dbc00cbae9a1300d52214b19cd273044835305a4a78cfd0d4b0939/analysis/1431295253/
prefetch sumo_lite.exe sha1:f97a53a4e75dfce12ad9ad3e75c1c30399d43b2b size:1555872 http://www.kcsoftwares.com/files/sumo_lite.exe
wait __Download\sumo_lite.exe /SP- /VERYSILENT /SUPPRESSMSGBOXES /NOCANCEL /NORESTART
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
