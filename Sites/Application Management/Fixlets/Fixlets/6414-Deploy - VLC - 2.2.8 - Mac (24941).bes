      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch FA52A338A7E8C308147012E879029BBE7121CFD4.dmg sha1:FA52A338A7E8C308147012E879029BBE7121CFD4 size:36812908 http://download.videolan.org/pub/videolan/vlc/2.2.8/macosx/vlc-2.2.8.dmg sha256:4406E025C566C5703AB11E53070D3E399680DDFB8994B60CB753079DFFD2A027

delete &quot;/tmp/FA52A338A7E8C308147012E879029BBE7121CFD4.dmg&quot;

move &quot;__Download/FA52A338A7E8C308147012E879029BBE7121CFD4.dmg&quot; &quot;/tmp/FA52A338A7E8C308147012E879029BBE7121CFD4.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTFA52A338A7E8C308147012E879029BBE7121CFD4&quot; &quot;/tmp/FA52A338A7E8C308147012E879029BBE7121CFD4.dmg&quot;

wait sh -c &quot;rm /tmp/FA52A338A7E8C308147012E879029BBE7121CFD4.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTFA52A338A7E8C308147012E879029BBE7121CFD4/. /tmp/BESTEMPFA52A338A7E8C308147012E879029BBE7121CFD4&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTFA52A338A7E8C308147012E879029BBE7121CFD4 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPFA52A338A7E8C308147012E879029BBE7121CFD4/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPFA52A338A7E8C308147012E879029BBE7121CFD4&apos;&quot;
