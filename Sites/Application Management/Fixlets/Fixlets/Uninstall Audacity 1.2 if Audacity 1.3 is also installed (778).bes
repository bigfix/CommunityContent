<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Task Export

  Title    : Uninstall Audacity 1.2 if Audacity 1.3 is also installed
  ID       : 778
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T21:53:55
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Uninstall Audacity 1.2 if Audacity 1.3 is also installed</Title>
    <Description>Uninstall Audacity 1.2 if Audacity 1.3 is also installed. </Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance>exists key whose (value &quot;displayname&quot; of it as string as lowercase contains (&quot;Audacity 1.2&quot; as lowercase) of it) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>exists value &quot;UninstallString&quot; whose (it as string as lowercase contains &quot;unins000.exe&quot; as lowercase) of key whose (value &quot;displayname&quot; of it as string as lowercase contains (&quot;Audacity 1.2&quot; as lowercase) of it) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>exists keys whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Audacity 1.3&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2011-09-23</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 23 Sep 2011 21:08:34 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait {value &quot;UninstallString&quot; whose (it as string as lowercase contains &quot;unins000.exe&quot; as lowercase) of key whose (value &quot;displayname&quot; of it as string as lowercase contains (&quot;Audacity 1.2&quot; as lowercase) of it) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry} /VERYSILENT</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
