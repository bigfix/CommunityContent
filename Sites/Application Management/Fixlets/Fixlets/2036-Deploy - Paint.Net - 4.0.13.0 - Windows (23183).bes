<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - Paint.Net - 4.0.13.0 - Windows</Title>
    <Description>This fixlet is for Deploy - Paint.Net - 4.0.13.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 7055677 * 2) and (exists (keys of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\NET Framework Setup\NDP" of native registry) whose (value "Version" of key "Full" of it as string as version >= "4.6" as version)) and (not exists keys whose (value "DisplayName" of it as string starts with "paint.net") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2017-01-11</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:dotpdn:paint.net:4.0.13.0:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:dotpdn:paint.net:4.0.13.0</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch E9D74DB790B77C84290676ADBE9231554AA5D6C0.zip sha1:E9D74DB790B77C84290676ADBE9231554AA5D6C0 size:7055677 http://www.dotpdn.com/files/paint.net.4.0.13.install.zip sha256:89F0E57A884C70E8DA0EA13E597A6CB5D51B1CEC7AFA37DCA19DB74FC467D120
prefetch unzip.exe sha1:84debf12767785cd9b43811022407de7413beb6f size:204800 http://software.bigfix.com/download/redist/unzip-6.0.exe sha256:2122557d350fd1c59fb0ef32125330bde673e9331eb9371b454c2ad2d82091ac

prefetch 7za.zip sha1:9ce9ce89ebc070fea5d679936f21f9dde25faae0 size:384846 http://www.7-zip.org/a/7za920.zip

prefetch 7z1604.exe sha1:DD1CB1163C5572951C9CD27F5A8DD550B33C58A4 size:1110564 http://www.7-zip.org/a/7z1604.exe sha256:DBB2B11DEA9F4432291E2CBEFE14EBE05E021940E983A37E113600EEE55DAA95


waithidden __Download\unzip.exe -o &quot;{pathname of file &quot;7za.zip&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; 7za.exe -d &quot;{pathname of folder &quot;__Download&quot; of client folder of current site}&quot;

folder create &quot;__Download\7z&quot;

waithidden __Download\7za.exe x &quot;{pathname of file &quot;7z1604.exe&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; -o&quot;{pathname of folder &quot;__Download\7z&quot; of client folder of current site}&quot;

waithidden __Download\unzip.exe -o &quot;{pathname of file &quot;E9D74DB790B77C84290676ADBE9231554AA5D6C0.zip&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; -d &quot;{pathname of folder &quot;__Download&quot; of client folder of current site}&quot;

// Unzip Paint.Net Installer
waithidden &quot;{ (pathname of file &quot;7z.exe&quot; of folder &quot;7z&quot; of folder &quot;__Download&quot; of client folder of current site) }&quot; e -y -o&quot;{pathname of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;{pathname of file whose (name of it contains &quot;paint&quot;) of folder &quot;__Download&quot; of client folder of current site}&quot;

override wait
hidden=true
completion=job
wait msiexec /i &quot;{if (x64 of operating system) then (&quot;__Download\PaintDotNet_x64.msi&quot;) else (&quot;__Download\PaintDotNet_x86.msi&quot;)}&quot; /qn USINGWIZARD=1
</ActionScript>
    </DefaultAction>
  </Fixlet>
