      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 3D1EF32493CD58A449A4ABA00FA1C1CB223A9F08.dmg sha1:3D1EF32493CD58A449A4ABA00FA1C1CB223A9F08 size:79068004 https://download.mozilla.org/?product=thunderbird-52.2.0-SSL&os=osx&lang=en-US sha256:2D143D250D00883911168E45BD9518FF7C7EAA1BEA4AA19A494DC5B7781240F9

delete "/tmp/3D1EF32493CD58A449A4ABA00FA1C1CB223A9F08.dmg"

move "__Download/3D1EF32493CD58A449A4ABA00FA1C1CB223A9F08.dmg" "/tmp/3D1EF32493CD58A449A4ABA00FA1C1CB223A9F08.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPT3D1EF32493CD58A449A4ABA00FA1C1CB223A9F08" "/tmp/3D1EF32493CD58A449A4ABA00FA1C1CB223A9F08.dmg"

