<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Upgrade: Secunia PSI - Windows</Title>
    <Description>This task will install/upgrade Secunia PSI. </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[version of operating system >= "5.1"]]></Relevance>
    <Relevance><![CDATA[not exists keys whose(exists (it as string as trimmed string) whose(it starts with "Secunia PSI") of value "DisplayName" of it AND "3.0.0.7011" <= (it as string as version) of value "DisplayVersion" of it) of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries;x32 registries)]]></Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2015-06-10</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 10 Jun 2015 19:09:58 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
// http://secunia.com/PSISetup.exe
// https://www.virustotal.com/en/file/3f80ee352f085915607d01115a12cd5887a59e51aa8be68aa2af055752607541/analysis/1432490030/
prefetch PSISetup.exe sha1:2e17deba72fd5b48311524eb925646bec83b56c6 size:3272136 http://secunia.com/PSISetup.exe

// Installer type: NSIS
waithidden __Download\PSISetup.exe /S
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
