  <Fixlet>
    <Title>Update - RES ONE Workspace Agent - 9.10.1.003 - Windows</Title>
    <Description><![CDATA[<P>Updates an existing 9.10.1.0 agent to hotfix level 9.10.1.003.</P>
<P>This Hotfix applies only to Agents.</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[exists file (pathname of parent folder of parent folder of file of service "res" & "\pfwsmgr.exe")]]></Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager&quot; whose (value &quot;Version&quot; of it as string as version = &quot;9.10.1.0&quot; as version) of x32 registry</Relevance>
    <Category>Upgrade</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-10-03</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
