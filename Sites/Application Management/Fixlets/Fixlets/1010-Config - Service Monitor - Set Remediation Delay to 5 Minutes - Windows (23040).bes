<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - Service Monitor - Set Remediation Delay to 5 Minutes - Windows</Title>
    <Description><![CDATA[<P>Configures the BES Service Monitor (<STRONG>Fixlet: </STRONG>Invoke - Service Monitor - Windows) to only remediate service failure after 5 minutes of system uptime.</P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>not exists values whose (it = &quot;5&quot;) of settings &quot;besservicemonitor-settings-remediation-delay&quot; of client</Relevance>
    <Category>Service Monitor</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-10-25</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">setting &quot;besservicemonitor-settings-remediation-delay&quot;=&quot;5&quot; on &quot;{now}&quot; for client</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
