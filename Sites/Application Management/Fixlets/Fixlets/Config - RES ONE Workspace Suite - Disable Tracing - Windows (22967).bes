<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - RES ONE Workspace Suite - Disable Tracing - Windows</Title>
    <Description><![CDATA[&lt;Disables RES ONE Workspace tracing on the system and removes any local trace files&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists value &quot;Trace&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager&quot; of x32 registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Source Release Date: 2016-12-05

folder delete &quot;{name of drive of system folder}\RES Tracing&quot;

regdelete &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager]&quot; &quot;Trace&quot;
regdelete &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager]&quot; &quot;TraceDetailed&quot;
regdelete &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager]&quot; &quot;TraceFile&quot;</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
