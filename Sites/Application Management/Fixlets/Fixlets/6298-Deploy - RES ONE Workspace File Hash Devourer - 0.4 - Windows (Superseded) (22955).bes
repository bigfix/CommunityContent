#Not Automatically set on Windows 7
$PSScriptRoot = Split-Path $MyInvocation.MyCommand.Path -Parent

$InstallationDirectory = "${{env:ProgramFiles(x86)}\RES Software\File Hash Devourer"

remove-item $InstallationDirectory -Recurse -force -ErrorAction SilentlyContinue

move-item "$PSScriptRoot" "$InstallationDirectory" -force

& SchTasks /Create /F /SC Daily /ST 12:00 /TN "Devour File Hashes" /RU "SYSTEM" /TR "powershell.exe -executionpolicy Bypass -File '$InstallationDirectory\Bin\Devourer.ps1'"

_end_

move __createfile "__Download\FHD\install.ps1"

delete "__Download\FHD\Bin\Devourer.ps1"

createfile until _end_
#Not Automatically set on Windows 7
$PSScriptRoot = Split-Path $MyInvocation.MyCommand.Path -Parent

function load-config {{
    param (
        $Path
    )
    [XML] $XML = New-Object System.XML.XMLDocument

    $XML.Load($Path)

    return $XML
}

function write-log {{
    param(
        $Message
    )
    $LogFile = "$($Configuration.Config.LogDirectory)\FHD-$Runtime.log"

    $FormattedMessage = "$((get-date).tostring()) - $((Get-PSCallStack).FunctionName[1]) - $Message"

    write-verbose $FormattedMessage; $FormattedMessage >> $LogFile

    rotate-logs
}

function rotate-logs {{
    $Logs = @(get-item -Path "$($Configuration.Config.LogDirectory)\*" | ? {{ $_.LastWriteTime -lt (get-date).AddDays(-14) })

    foreach ($Log in $Logs) {{
        remove-item $Log -ErrorAction SilentlyContinue
    }
}

function Process-Extractors {{
    param (
        $File,
        $Staging
    )

    foreach ($Extractor in $Global:Configuration.Config.Extractor) {{
        Process-Extractor -Extractor $Extractor -File $File -Staging $Staging
    }

    return $Staging
}

function Process-Extractor {{
    param (
        $Extractor,
        $File,
        $Staging
    )

    #Match Extractor Filter
    if ($File.Extension -notlike $Extractor.Filter) {{ write-log "Skipping $File due to filter $($Extractor.Filter)" }

    #Swap Command Line Arguments with Values
    $CmdLine = $Extractor.CmdLine.ToString()
    $CmdLine = $CmdLine.replace("!Archive!","""$($File.FullName)""")
    $CmdLine = $CmdLine.replace("!Outdir!","""$Staging""")

    #Process Extraction
    start-process -FilePath $Extractor.exe -ArgumentList $CmdLine -Wait -WindowStyle hidden | out-null

}

function Process-Files {{
    param (
        $Files,
        $Staging,
        [switch] $Recursive,
        $Recursion = 1,
        $MaxRecursion = 3
    )

    if ($Recursive -and $Recursion -gt $MaxRecursion) {{
        return
    }

    write-log "Processing $($Files.Length) Files"

    #Loop through each file that has been recently modified
    foreach ($File in $Files) {{ # Make 7-Zip Overwrite do not prompt

        #Create Staging Area
        $Storage = $Staging + "\" + (([GUID]::NewGuid()).guid)

        new-item -Path $Storage -ItemType directory -ErrorAction SilentlyContinue | out-null

        write-log "Processing $(if ($Recursion -eq 2) {{"child "})$(if ($Recursion -eq 3) {{"grandchild "})$($File) in $Storage"

        #Process Archives
        $Output = Process-Extractors -Staging $Storage -File $File

        #Recurse if necessary
        if ((Get-ChildItem -Path $Output) -and $Recursive) {{
            Process-Files -Files (Get-ChildItem -Path $Output) -Staging $Staging -Recursive -Recursion ($Recursion + 1) | out-null
        }

        #The Parent Executables need to get hashed in addition to their contents
        #Nested executables are already captured by the parent so don't copy them again
        if (($Recursion -eq 1) -and $File.Extension -eq ".exe") {{ copy-item -Path $File.FullName -Destination "$Storage\$($File.Name)" -Container }

        #Baseline whatever we've got so far
        & .\Baseline.ps1 -Directory $Storage -OutDir $PSScriptRoot -Algorithm $Global:Configuration.Config.Algorithm -Container $Global:Configuration.Config.Container -Append -quiet | out-null

        #Cleanup Staging Area
        remove-item -Path $Storage -Recurse -ErrorAction SilentlyContinue
    }
}

cd $PSScriptRoot

$Runtime = (get-date).tostring("yyyyMMdd-HHmmss")

#Load Configuration
[XML]$Global:Configuration = load-config -Path "$PSScriptRoot\..\Configuration\Config.xml"

#Create Directory Structure
new-item $($Configuration.Config.LogDirectory) -ItemType directory -ErrorAction SilentlyContinue
new-item $($Configuration.Config.OutputDirectory) -ItemType directory -ErrorAction SilentlyContinue

if (test-path "$PSScriptRoot\AuthorizedFiles.txt" ) {{
    write-log "Previous AuthorizedFiles Found -- skipping scan and attempting import."
    & $PSScriptRoot\Import.ps1 -inputdir $PSScriptRoot -InputFilter "AuthorizedFiles.txt"
} else {{

    foreach ($Repository in $Configuration.Config.Repository) {{

        write-log "Processing $($Repository.Name) at $((resolve-path $Repository.Path).path)"
        write-log "Skipping files older than $([DateTime]$Repository.TimeStamp)"
        write-log "Using $($Repository.Staging) for temporary storage"

        #Clean Staging Directory
        remove-item $Repository.Staging -recurse -ErrorAction SilentlyContinue | out-null
        new-item $Repository.Staging -ItemType directory -ErrorAction SilentlyContinue | out-null

        #Verify Free Space
        if ( (get-item  $Repository.Staging).PSDrive.Free -lt ([int64]$Repository.MaxSize * 1.5)) {{
            write-log "Skipping $($Repository.Name) due to lack of free space. Only $((get-item  $Repository.Staging).PSDrive.Free) bytes free. Minimum is $([int64]$Repository.MaxSize * 1.5) bytes"
            continue;
        }

        #Get List of Files older than the TimeStamp in the Repository (Initialize Empty Array for PS <= 2.0)
		$Files = @(Get-ChildItem -force -Recurse (resolve-path $Repository.Path).path -Filter "*" -ErrorAction SilentlyContinue | ? {{$_.length -lt [int64]$Repository.MaxSize} | ? {{ $_.LastWriteTime -gt ([DateTime]$Repository.TimeStamp) })


        #Process File List
        Process-Files $Files -Staging (resolve-path $Repository.Staging).path -Recursive

        #Log Message
        write-log "Done Processing $($Repository.Name) at $((resolve-path $Repository.Path).path)"

        #Update Repository Timestamp
        $Repository.TimeStamp = (get-date).tostring()
        write-log "Updating timestamp for $($Repository.Name) to $($Repository.TimeStamp)"
        $Configuration.Save("$PSScriptRoot\..\Configuration\Config.xml")

    }
    write-log "Done processing repositories"

    write-log "Backing up Hashing Log to $($Configuration.Config.LogDirectory)\FHD-$Runtime-Hashing.log"
    move-item "$PSScriptRoot\AuthorizedFiles.log" "$($Configuration.Config.LogDirectory)\FHD-$Runtime-Hashing.log" -ErrorAction SilentlyContinue

    write-log "Preparing authorizedfiles for import: $($Configuration.Config.OutputDirectory)\AuthorizedFiles-$Runtime.tx"
    copy-item "$PSScriptRoot\AuthorizedFiles.txt" "$($Configuration.Config.OutputDirectory)\AuthorizedFiles-$Runtime.txt" -ErrorAction SilentlyContinue

    write-log "Running Authorized Files Import"
    & $PSScriptRoot\Import.ps1 -inputdir $PSScriptRoot -InputFilter "AuthorizedFiles.txt"

    write-log "Backing up Import Log to $($Configuration.Config.LogDirectory)\FHD-$Runtime-Import.log"
    move-item "$PSScriptRoot\Import.log" "$($Configuration.Config.LogDirectory)\FHD-$Runtime-Import.log" -ErrorAction SilentlyContinue
}

_end_

move __createfile "__Download\FHD\Bin\Devourer.ps1"

delete "__Download\FHD\Bin\Import.ps1"
createfile until _end_
param (
    $InputDir = ".",
    $InputFilter = "authfiles*.txt",
    $PwrTech = "${{env:ProgramFiles(x86)}\RES Software\Workspace Manager\PwrTech.exe"
)

#Not Automatically set on Windows 7
$PSScriptRoot = Split-Path $MyInvocation.MyCommand.Path -Parent

function write-log {{
    param(
        $Message
    )
    $LogFile = "$PSScriptRoot\Import.log"

    $FormattedMessage = "$((get-date).tostring()) - $((Get-PSCallStack).FunctionName[1]) - $Message"

    write-verbose $FormattedMessage; $FormattedMessage >> $LogFile
}

#Get List of Files older than the TimeStamp in the Repository (Initialize Empty Array for PS <= 2.0)
$Files = @(Get-ChildItem -force -Recurse (resolve-path $InputDir).path -Filter $InputFilter -ErrorAction SilentlyContinue)

foreach ($File in $Files) {{

try {{
    write-log "Processing $($File.FullName)"

    write-log "Deduplicating File Hashes"

    $Hashes = get-content -path $File.FullName

    write-log "Starting with $($Hashes.Count) hashes"

    $Hashes = $Hashes | Sort-Object | Get-Unique

	set-content -path $File.FullName -value $Hashes -force

    write-log "Deduplicated down to $($Hashes.count) hashes"

	write-log "Running: & ""$PwrTech"" /importhashes=""$($File.FullName)"" /createifnotexists"

    $Output = & "$PwrTech" /importhashes="$($File.FullName)" /createifnotexists | Out-String

    write-log $Output

	if (($Output -join "`r`n") -like "*Finished importing file hashes*") {{
		remove-item $File.FullName -erroraction silentlycontinue
		write-log "Success. Deleting $($File.FullName)"
	} else {{
		write-log "Failure. Leaving $($File.FullName)"
	}

    write-log "Done Processing $($File.FullName)"

    } catch {{
        write-log "Unrecognized Import Failure: $($_.Exception.Message) from $($_.Exception.ItemName)"
    }
}
_end_

move __createfile "__Download\FHD\Bin\Import.ps1"

delete "__Download\FHD\Bin\Baseline.ps1"

createfile until _end_
param (
    $Directory = "C:\",
    $OutFile = "$(Split-Path $MyInvocation.MyCommand.Path -Parent)\AuthorizedFiles.txt",
    $Algorithm = "SHA256",
    $Container = "",
    $LogFile = "$(Split-Path $MyInvocation.MyCommand.Path -Parent)\AuthorizedFiles.log",
    $Filter = "*.exe",
    [switch] $Append = $false,
    [switch] $FullPath = $false,
    [switch] $Quiet
)

#Not Automatically set on Windows 7
$PSScriptRoot = Split-Path $MyInvocation.MyCommand.Path -Parent

function write-log {{
    param(
        $Message
    )

    $FormattedMessage = "$((get-date).tostring()) - $((Get-PSCallStack).FunctionName[1]) - $Message"

    if (!($Quiet)) {{
        write-verbose $FormattedMessage; $FormattedMessage >> $LogFile
    }
}

Function get-authorizedfileinfo {{
    Param(
        [parameter(Mandatory=$True)]$file,
        [parameter(Mandatory=$false)][ValidateSet("MD5", "SHA1", "SHA256")]$Algorithm = "SHA256"
    )
    Switch ($Algorithm)
    {{
        "SHA1"  {{ $AlgorithmObj = New-Object System.Security.Cryptography.SHA1CryptoServiceProvider }
        "SHA256"  {{ $AlgorithmObj = New-Object System.Security.Cryptography.SHA256CryptoServiceProvider }
        "MD5"   {{ $AlgorithmObj = New-Object System.Security.Cryptography.MD5CryptoServiceProvider }
        Default {{ $AlgorithmObj = New-Object System.Security.Cryptography.SHA256CryptoServiceProvider }
    }
    $Hashstring = ([System.BitConverter]::ToString($AlgorithmObj.ComputeHash([System.IO.File]::ReadAllBytes($File.FullName)))) -replace ("-","")

    return @{{Hash = $Hashstring; Path = $File.FullName; Name = $File.Name}
}

if (!($Append)) {{
    remove-item $LogFile -ErrorAction SilentlyContinue
    remove-item $OutFile -ErrorAction SilentlyContinue
}

#Output Supplied Parameters
write-log "Log File: $LogFile"
write-log "Append Output: $Append"
write-log "Output File: $LogFile"
write-log "Input Directory: $Directory"
write-log "File Filter: $Filter"
write-log "Hashing Algorithm: $Algorithm"
write-log "Destination Container: $Container"
write-log "Use Full Path: $FullPath"

#Get File List to Hash
$Files = Get-ChildItem -force -Recurse $Directory -Filter "$Filter" -ErrorAction SilentlyContinue

foreach ($File in $Files) {{
    try {{
        write-log "Hashing: $($File.Name)"

        $FileInfo = get-authorizedfileinfo -file $File -Algorithm $Algorithm

        if (!($FileInfo.Path) -or !($FileInfo.Hash)) {{throw "Invalid Authorized File Info"}

        "$(if($FullPath){{$FileInfo.Path}else{{"*\$($FileInfo.Name)"})`t$($FileInfo.Hash)`t*`tAllow`t$Container" >> $OutFile
    } catch {{
        write-log "Error Hashing: $File"
    }
}
_end_

move __createfile "__Download\FHD\Bin\Baseline.ps1"

delete __createfile
delete "__Download\FHD\Configuration\Config.xml"

createfile until _end_
<Config>
  <Container></Container>
  <Algorithm>SHA256</Algorithm>
  <LogDirectory>..\Logs</LogDirectory>
  <OutputDirectory>..\Output</OutputDirectory>
  <Type>Delta</Type>
  <Repository Name="SHA1">
    <Path>{value of setting "_BESRelay_HTTPServer_ServerRootPath" of client}\bfmirror\downloads\sha1</Path>
    <Staging>..\Staging\SHA1</Staging>
    <TimeStamp>1/1/0001 12:00:00 AM</TimeStamp>
	<MaxSize>10737418240</MaxSize>
  </Repository>
   <Repository Name="Uploads">
    <Path>{value of setting "_BESRelay_HTTPServer_ServerRootPath" of client}\Uploads</Path>
    <Staging>..\Staging\Uploads</Staging>
    <TimeStamp>1/1/0001 12:00:00 AM</TimeStamp>
	<MaxSize>10737418240</MaxSize>
  </Repository>
  <Extractor Name="BFArchive">
    <Exe>..\Extractors\BFArchive\BFArchive.exe</Exe>
    <Filter>*</Filter>
    <CmdLine>-x !Archive! !Outdir!</CmdLine>
  </Extractor>
  <Extractor Name="7Zip">
