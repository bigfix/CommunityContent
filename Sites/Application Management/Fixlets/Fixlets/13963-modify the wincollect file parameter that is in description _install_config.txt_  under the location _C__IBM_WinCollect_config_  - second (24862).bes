<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>modify the wincollect file parameter that is in description &quot;install_config.txt&quot; under the location &quot;C:\IBM\WinCollect\config&quot; - second</Title>
    <Description><![CDATA[<P>This task will modify following parameters in file "install_config.txt".</P>
<P>ConfigurationServerPort=&nbsp;</P>
<P>Note: After completion of this task, run task "Restart wincollect service" to make the changes effective.</P>]]></Description>
    <Relevance>true</Relevance>
    <Category>N/A</Category>
    <Source>Internal</Source>
    <SourceID>niraj11032015</SourceID>
    <SourceReleaseDate>2015-03-11</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 11 Mar 2015 14:40:44 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Enter your action script here
// store the file location -- store the file location or ("C:\IBM\WinCollect\config\install_config.txt")
parameter "filename" = "{pathname of file ("C:\IBM\WinCollect\config\install_config.txt")}"

parameter "textToReplace" = "{(following text of first "ConfigurationServerPort=" of lines of it)of file "C:\IBM\WinCollect\config\install_config.txt"}"
parameter "newText" = ""




// iterate through the file replacing lines as necessary
appendfile {concatenation "%0d%0a" of ( if (it contains (parameter "textToReplace")) then ((preceding text of first (parameter "textToReplace") of it) & (parameter "newText") ) else it ) of lines of file (parameter "filename")}

//move "{parameter "filename"}" "{parameter "filename"}.bak"
move "{parameter "filename"}" "{parameter "filename"}.bak1"
// replace with the new file
move __appendfile "{parameter "filename"}"
dos net stop "WinCollect"
dos net start "WinCollect"
]]></ActionScript>
    </DefaultAction>
  </Task>
</BES>
