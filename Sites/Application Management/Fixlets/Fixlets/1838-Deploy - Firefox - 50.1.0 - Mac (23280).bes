      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch D346E9BC7F6F737AE6220DFAC50E6311E83D175D.dmg sha1:D346E9BC7F6F737AE6220DFAC50E6311E83D175D size:86311035 https://download.mozilla.org/?product=firefox-50.1.0-SSL&os=osx&lang=en-US sha256:B41ECE47D0AD891D8B9307C0F27B50D0DAAAAA7495DFA007AA12968A8CC68A6E

delete "/tmp/D346E9BC7F6F737AE6220DFAC50E6311E83D175D.dmg"

move "__Download/D346E9BC7F6F737AE6220DFAC50E6311E83D175D.dmg" "/tmp/D346E9BC7F6F737AE6220DFAC50E6311E83D175D.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPTD346E9BC7F6F737AE6220DFAC50E6311E83D175D" "/tmp/D346E9BC7F6F737AE6220DFAC50E6311E83D175D.dmg"

wait sh -c "rm /tmp/D346E9BC7F6F737AE6220DFAC50E6311E83D175D.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPTD346E9BC7F6F737AE6220DFAC50E6311E83D175D/. /tmp/BESTEMPD346E9BC7F6F737AE6220DFAC50E6311E83D175D"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPTD346E9BC7F6F737AE6220DFAC50E6311E83D175D | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMPD346E9BC7F6F737AE6220DFAC50E6311E83D175D/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMPD346E9BC7F6F737AE6220DFAC50E6311E83D175D'"
]]></ActionScript>
