<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update - Ghostscript - 9.23 - Windows</Title>
    <Description>This fixlet is for Update - Ghostscript - 9.23 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 25909024 * 2) and (exists value "DisplayVersion" whose (it as string as version < "9.23") of keys whose (name of it starts with "GPL Ghostscript") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2018-03-26</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:artifex:afpl_ghostscript:9.23:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:artifex:afpl_ghostscript:9.23</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 5D741922A801BF882B1FFF64E9D047AEBB622AC0.exe sha1:5D741922A801BF882B1FFF64E9D047AEBB622AC0 size:25909024 https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/gs923/gs923w32.exe sha256:5879B9970007490E62F1C1D9D6688BB633A069CDD5FC466DADB9EA8114C8C75A
//Remove Any Old GhostScript
delete __createfile
delete run.bat
createfile until _end_
{concatenation "%0d%0a" of (value "UninstallString" of it as string & " /S") of keys whose (name of it starts with "GPL Ghostscript" and value "UninstallString" of it as string contains "uninstgs.exe") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries)}
_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat

// Install Ghostscript
override wait
hidden=true
completion=job
wait "__Download\5D741922A801BF882B1FFF64E9D047AEBB622AC0.exe" /S /NCRC]]></ActionScript>
    </DefaultAction>
  </Fixlet>
