<!--
  BigFix Fixlet Export

  Title    : Uninstall: Hypersnap 6 - hpruninst.exe
  ID       : 794
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T22:09:08
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall: Hypersnap 6 - hpruninst.exe</Title>
    <Description>This fixlet uninstalls Hypersnap </Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance><![CDATA[exists key whose (value "displayname" of it as string contains "HyperSnap" of it AND value "uninstallstring" of it as string as lowercase contains "hpruninst.exe" AND value "DisplayVersion" of it as string as version < "7.0" as version) of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry]]></Relevance>
    <Category>Uninstall</Category>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2010-08-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 18 Jun 2012 15:30:34 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click&amp;nbsp; </PreLink>
        <Link>here </Link>
        <PostLink>&amp;nbsp;to deploy this action. </PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait {value &quot;uninstallstring&quot; of key whose (value &quot;displayname&quot; of it as string contains &quot;HyperSnap&quot; of it and value &quot;uninstallstring&quot; of it as string as lowercase contains &quot;hpruninst.exe&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry} -s</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
