      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch BD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9.dmg sha1:BD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9 size:15097394 http://go.microsoft.com/fwlink/?LinkID=229322 sha256:F53057921B1A3BC62A717C32A3970EAC67FD8C424456CFDCDF0B28D3E27A796C

delete &quot;/tmp/BD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9.dmg&quot;

move &quot;__Download/BD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9.dmg&quot; &quot;/tmp/BD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTBD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9&quot; &quot;/tmp/BD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9.dmg&quot;

wait sh -c &quot;rm /tmp/BD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTBD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9/. /tmp/BESTEMPBD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTBD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait installer -pkg &quot;/tmp/BESTEMPBD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9/silverlight.pkg&quot; -target /

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPBD5A55BE4AA7FD1FC33EFC64CEB3F51DA6D008C9&apos;&quot;
</ActionScript>
