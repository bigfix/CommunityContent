<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall - Google Chrome - Windows (x64)</Title>
    <Description>This fixlet is for Uninstall - Google Chrome - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (x64 of operating system) and (exists value "UninstallString" whose (it as string contains "MsiExec") of keys whose (value "DisplayName" of it as string is "Google Chrome") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2017-03-04</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:google:chrome:*:*:*:*:*:*:x64:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:google:chrome</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:05 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
override wait
hidden=true
completion=job
wait msiexec /x "{name of keys whose (value "DisplayName" of it as string is "Google Chrome" and value "UninstallString" of it as string contains "MsiExec") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries)}" /qn

// Google Chrome doesn't return when it's done so we have to wait for it
pause while {(exists keys whose (value "UninstallString" of it as string contains "Google\Chrome\") of keys "HKEY_LOCAL_MACHINE\Software\Google\Update\ClientState" of x32 registry) AND (now - active start time of action < 180 * second)}]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
