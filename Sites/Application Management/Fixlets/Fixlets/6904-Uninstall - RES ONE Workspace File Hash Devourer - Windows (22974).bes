<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall - RES ONE Workspace File Hash Devourer - Windows</Title>
    <Description>Remove the File Hash Devourer</Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>(exists folder &quot;\RES Software\File Hash Devourer&quot; of program files x32 folder) or (exists scheduled tasks whose (name of it is &quot;Devour File Hashes&quot;))</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 22:01:52 +0000</Value>
    </MIMEField>
    <Domain>RESS</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Source Release Date: 2016-12-05

//Remove the Tasks
waithidden schtasks /end /TN "Devour File Hashes" /f
waithidden schtasks /delete /TN "Devour File Hashes" /f

//Kill any hung executables
wait "{pathname of file "wmic.exe" of folder "wbem" of system folder}" PROCESS WHERE "ExecutablePath like '%\\File Hash Devourer\\Extractors\\%.exe'" DELETE

//Cleanup Installation Directory
// If the action fails here make sure there is nothing open in this directory
// Like a log file, command prompt, etc.
waithidden cmd.exe /c rmdir /s /q "{pathname of program files x32 folder & "\RES Software\File Hash Devourer"}"

]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
