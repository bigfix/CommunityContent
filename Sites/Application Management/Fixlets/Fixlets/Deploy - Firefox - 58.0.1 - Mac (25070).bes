move "__Download/6AE58CB3CC84ED5326B24638254A0A9818D4F183.dmg" "/tmp/6AE58CB3CC84ED5326B24638254A0A9818D4F183.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPT6AE58CB3CC84ED5326B24638254A0A9818D4F183" "/tmp/6AE58CB3CC84ED5326B24638254A0A9818D4F183.dmg"

wait sh -c "rm /tmp/6AE58CB3CC84ED5326B24638254A0A9818D4F183.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPT6AE58CB3CC84ED5326B24638254A0A9818D4F183/. /tmp/BESTEMP6AE58CB3CC84ED5326B24638254A0A9818D4F183"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPT6AE58CB3CC84ED5326B24638254A0A9818D4F183 | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMP6AE58CB3CC84ED5326B24638254A0A9818D4F183/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMP6AE58CB3CC84ED5326B24638254A0A9818D4F183'"
