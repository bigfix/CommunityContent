<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall - RES ONE Workspace Agent - Linux</Title>
    <Description>This task will uninstall RES ONE Workspace Agent. </Description>
    <Relevance>(unix of operating system and exists file &quot;/etc/res/resauthd.conf&quot; and exists file &quot;/usr/local/bin/reswmad&quot;)</Relevance>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:42:52 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Source Release Date: 2016-12-05
        delete __createfile
        delete agent_config.sh
        createfile until __end
        sed -i &apos;s/LearningMode=no/LearningMode=yes/g&apos; /etc/res/resauthd.conf
        sed -i &apos;s/AllowAny=no/AllowAny=yes/g&apos; /etc/res/resauthd.conf
        __end
        move __createfile agent_config.sh
        wait bash agent_config.sh
        wait chkconfig reswmad off
        wait /etc/init.d/reswmad stop
        wait rpm -e res-wm-agent
        delete __createfile
        delete agent_config.sh
        createfile until __end
        rm -f /var/log/reswmad.log
        rm -f /var/log/resauthd.log
        rm -f /var/log/res_unauthorized.log
        rm -f /etc/res/resauthd.pid
        rm -f /etc/res/reswmad.conf
        rm -f /etc/res/reswmad.pid
        rm -f /etc/res/sec_globauth.xml
        __end
        move __createfile agent_config.sh
        wait bash agent_config.sh
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
