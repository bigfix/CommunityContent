<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Execute RES2BES SOAP Connector</Title>
    <Description><![CDATA[
      <P>This task will execute the RES2BES SOAP Connector which is responsible for refreshing the approved applications (whitelist) dashboard data.</P>
<P><STRONG>Note:</STRONG> This task should be taken as a re-occouring task happening at least once a day, but no more frequently than once an hour.</P>
    ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists setting &quot;RES_IEM_Integration_Endpoint&quot; whose (value of it = &quot;1&quot;) of client</Relevance>
    <Relevance><![CDATA[exists file (pathname of parent folder of parent folder of file of service "res" & "\pwrtech.exe") AND exists file (pathname of parent folder of parent folder of file of service "res" & "\res2bes\res2bes.exe")]]></Relevance>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-03-21</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 01 Dec 2015 10:32:12 +0000</Value>
    </MIMEField>
    <Domain>SYST</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//SourceReleaseDate: 20160321-102103


wait {"%22" & pathname of parent folder of parent folder of file of service "res" & "\res2bes\res2bes.exe%22" & " %22" & pathname of parent folder of parent folder of file of service "res" & "\res2bes\settings.config%22"}

]]></ActionScript>
    </DefaultAction>
  </Task>
</BES>
