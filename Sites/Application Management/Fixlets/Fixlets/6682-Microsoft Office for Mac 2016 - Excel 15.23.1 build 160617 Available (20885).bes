<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Microsoft Office for Mac 2016 - Excel 15.23.1 build 160617 Available</Title>
    <Description><![CDATA[<DIV class=FixletMessage>

<TABLE>

<TBODY>

<TR>

<TD>

<P>Microsoft Office for Mac 2016 - Excel (15.23.1 build 160617).</P>

<P>Use the action below to update Microsoft Office for Mac 2016 Microsoft Excel to the latest version.</P>

<P><STRONG>Note: </STRONG>To avoid any service interruptions on the endpoints, use the default action only when the endpoints do not have running instances of related applications such as Microsoft Office Excel. If any of the related application is running on the endpoints, the default action might fail. Schedule the update to occur at a time when the client machine is not using these applications.</P>

<P><STRONG>Note: </STRONG>Affected computers may report back as 'Pending Restart' once the patch has run successfully, but will not report back their final status until the computer has been restarted.</P></TD></TR></TBODY></TABLE></DIV>

<DIV class=FixletProperty>

<H4>File Size:</H4>977 MB </DIV>

<DIV class=FixletProperty>

<H4>CVE:</H4>CVE-2016-0198 </DIV>]]></Description>
    <Relevance>name of operating system = &quot;Mac OS X&quot;</Relevance>
    <Relevance><![CDATA[exists application whose (name of it = "Microsoft Excel.app" AND version of it = "15" as version AND (version of it < "15.23.1" OR version of it as string = "15.23")) OR exists string "CFBundleVersion" whose (it as version < "15.23.16061700") of dictionary of file "/Applications/Microsoft Excel.app/Contents/Info.plist"]]></Relevance>
    <Category>Security Update</Category>
    <Source>Microsoft</Source>
    <SourceID>KB3165798</SourceID>
    <SourceReleaseDate>2016-06-18</SourceReleaseDate>
    <SourceSeverity>Important</SourceSeverity>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 22:01:55 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to update the Microsoft Excel to the latest version.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch Microsoft_Excel_15.23.1_160617_Updater.pkg sha1:89e2a2e7da969bda7e601e77c5a387e76950d58f size:892395195 http://officecdn.microsoft.com/pr/C1297A47-86C4-4C1F-97FA-950631F94777/OfficeMac/Microsoft_Excel_15.23.1_160617_Updater.pkg sha256:44b2c132b3d49da28c8320b8bce9336d109b1d6adc1b546ec87eea4c8fa3d9e5



// move the pkg file to a temp directory
wait cp &quot;{posix path of file &quot;Microsoft_Excel_15.23.1_160617_Updater.pkg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot;  &quot;/private/tmp/Microsoft_Excel_15.23.1_160617_Updater.pkg&quot;

continue if{not (exists process whose (name of it as lowercase = &quot;Microsoft Excel&quot; as lowercase))}

// run the installer
wait /bin/sh -c &quot;/usr/sbin/installer -pkg /private/tmp/Microsoft_Excel_15.23.1_160617_Updater.pkg -target /&quot;

// action requires restart 89e2a2e7da969bda7e601e77c5a387e76950d58f
</ActionScript>
    </DefaultAction>
    <Action ID="Action21763">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process regardless of whether the related applications are running. </PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch Microsoft_Excel_15.23.1_160617_Updater.pkg sha1:89e2a2e7da969bda7e601e77c5a387e76950d58f size:892395195 http://officecdn.microsoft.com/pr/C1297A47-86C4-4C1F-97FA-950631F94777/OfficeMac/Microsoft_Excel_15.23.1_160617_Updater.pkg sha256:44b2c132b3d49da28c8320b8bce9336d109b1d6adc1b546ec87eea4c8fa3d9e5



// move the pkg file to a temp directory
wait cp &quot;{posix path of file &quot;Microsoft_Excel_15.23.1_160617_Updater.pkg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot;  &quot;/private/tmp/Microsoft_Excel_15.23.1_160617_Updater.pkg&quot;

if{(exists process whose (name of it as lowercase = &quot;Microsoft Excel&quot; as lowercase))}
wait /bin/sh -c &quot;kill {id of process whose (name of it as lowercase = &quot;Microsoft Excel&quot; as lowercase)}&quot;
endif

wait /bin/sh -c &quot;/usr/sbin/installer -pkg /private/tmp/Microsoft_Excel_15.23.1_160617_Updater.pkg -target /&quot;

// action requires restart 89e2a2e7da969bda7e601e77c5a387e76950d58f
</ActionScript>
    </Action>
    <Action ID="Action21764">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to run the installer while Excel is running... because you&apos;re a rebel... and it works.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch Microsoft_Excel_15.23.1_160617_Updater.pkg sha1:89e2a2e7da969bda7e601e77c5a387e76950d58f size:892395195 http://officecdn.microsoft.com/pr/C1297A47-86C4-4C1F-97FA-950631F94777/OfficeMac/Microsoft_Excel_15.23.1_160617_Updater.pkg sha256:44b2c132b3d49da28c8320b8bce9336d109b1d6adc1b546ec87eea4c8fa3d9e5



wait cp &quot;{posix path of file &quot;Microsoft_Excel_15.23.1_160617_Updater.pkg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot;  &quot;/private/tmp/Microsoft_Excel_15.23.1_160617_Updater.pkg&quot;

wait /bin/sh -c &quot;/usr/sbin/installer -pkg /private/tmp/Microsoft_Excel_15.23.1_160617_Updater.pkg -target /&quot;

if{(exists process whose (name of it as lowercase = &quot;Microsoft Excel&quot; as lowercase))}
// wait /bin/sh -c &quot;kill {id of process whose (name of it as lowercase = &quot;Microsoft Excel&quot; as lowercase)}&quot;
action requires restart 89e2a2e7da969bda7e601e77c5a387e76950d58f
endif
</ActionScript>
    </Action>
    <Action ID="Action21765">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> for more information about this Microsoft Office for Mac 2016 release.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">https://support.microsoft.com/en-us/kb/3155777</ActionScript>
    </Action>
  </Fixlet>
