<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Installs Blue Jeans</Title>
    <Description><![CDATA[<P>Downloads and installs Blue Jeans from the BlueJeans website</P>
<P>This can be used with the Self Service Application</P>]]></Description>
    <Relevance>true</Relevance>
    <Category>Bigfix.me</Category>
    <Source>Internal</Source>
    <SourceID>n0m4d1c</SourceID>
    <SourceReleaseDate>2018-05-24</SourceReleaseDate>
    <MIMEField>
      <Name>action-ui-metadata</Name>
      <Value>{&quot;icon&quot;:&quot;data:image/png;base64,&quot;}</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 09 Nov 2018 23:51:23 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//************************************************************************************
// Downloads the BlueJeans installer and installs it
//	Sha and Size are subject to change as the download is from Blue Jeans directly
//************************************************************************************

prefetch BlueJeans.1.35.15m.msi sha1:c95378d4120e36bf07a54fa075540a33927c030c size:38883328 https://swdl.bluejeans.com/desktop/win/1.35/1.35.15/BlueJeans.1.35.15m.msi

action uses wow64 redirection false

waithidden msiexec /i &quot;__Download\BlueJeans.1.35.15m.msi&quot; /q</ActionScript>
    </DefaultAction>
  </Task>
</BES>
