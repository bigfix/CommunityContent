      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch C2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A.dmg sha1:C2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A size:110565926 https://clientupdates.dropboxstatic.com/dbx-releng/client/Dropbox%2042.4.114.dmg sha256:18D37A7FD9715EDE7C6050DAA1A968ED403AD420612E4A1BE191D76FCAC1E823

delete &quot;/tmp/C2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A.dmg&quot;

move &quot;__Download/C2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A.dmg&quot; &quot;/tmp/C2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTC2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A&quot; &quot;/tmp/C2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A.dmg&quot;

wait sh -c &quot;rm /tmp/C2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A.dmg&quot;

wait cp -R /tmp/BESMNTPTC2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A/* /tmp/BESTEMPC2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTC2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A/. /tmp/BESTEMPC2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTC2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPC2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPC2CC13205EB56C68F8EBF64D3D6F40E1B03E0E8A&apos;&quot;
