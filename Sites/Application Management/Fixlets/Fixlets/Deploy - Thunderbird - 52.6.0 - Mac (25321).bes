    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch AE8E837038F217A0C62FCCC100139AE41023AD94.dmg sha1:AE8E837038F217A0C62FCCC100139AE41023AD94 size:79320953 https://download.mozilla.org/?product=thunderbird-52.6.0-SSL&os=osx&lang=en-US sha256:A456E160AD57CFEEC7A18D1D133001595CE52324C57E69EE49469A40BA7A5C28

delete "/tmp/AE8E837038F217A0C62FCCC100139AE41023AD94.dmg"

move "__Download/AE8E837038F217A0C62FCCC100139AE41023AD94.dmg" "/tmp/AE8E837038F217A0C62FCCC100139AE41023AD94.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPTAE8E837038F217A0C62FCCC100139AE41023AD94" "/tmp/AE8E837038F217A0C62FCCC100139AE41023AD94.dmg"

wait sh -c "rm /tmp/AE8E837038F217A0C62FCCC100139AE41023AD94.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPTAE8E837038F217A0C62FCCC100139AE41023AD94/. /tmp/BESTEMPAE8E837038F217A0C62FCCC100139AE41023AD94"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPTAE8E837038F217A0C62FCCC100139AE41023AD94 | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMPAE8E837038F217A0C62FCCC100139AE41023AD94/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMPAE8E837038F217A0C62FCCC100139AE41023AD94'"
]]></ActionScript>
