<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - Thunderbird - 45.5.0 - Windows</Title>
    <Description>This fixlet is for Deploy - Thunderbird - 45.5.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 35044552 * 2) and (not exists keys whose (value "DisplayName" of it as string starts with "Mozilla Thunderbird") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2016-11-23</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:mozilla:thunderbird:45.5.0:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:mozilla:thunderbird:45.5.0</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 0967E48E0159D116C576583B27E7B15969624380.exe sha1:0967E48E0159D116C576583B27E7B15969624380 size:35044552 https://download.mozilla.org/?product=thunderbird-45.5.0-SSL&amp;os=win&amp;lang=en-US sha256:CBC812E706EC1971C9FFC5B609255361D1E74E75D4B2AB4931EF0C36CBBC4335

delete setup.ini
delete __createfile

createfile until _end_
[Install]
DesktopShortcut=false
_end_

move __createfile setup.ini

override wait
hidden=true
completion=job
wait "__Download\0967E48E0159D116C576583B27E7B15969624380.exe" /INI="{(pathname of client folder of current site) & "\setup.ini"}"

delete "{value of variable "PUBLIC" of environment}\Desktop\Mozilla Thunderbird.lnk"]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
