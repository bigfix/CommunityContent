<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - Service Monitor - Reset Blacklist</Title>
    <Description><![CDATA[<P>Resets the list of blacklisted services from monitoring by service monitor.</P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists values of settings &quot;besservicemonitor-settings-blacklist&quot; of client</Relevance>
    <SourceReleaseDate>2016-05-07</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action24086">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
setting delete &quot;besservicemonitor-settings-blacklist&quot; on &quot;{now}&quot; for client</ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </Action>
  </Fixlet>
</BES>
