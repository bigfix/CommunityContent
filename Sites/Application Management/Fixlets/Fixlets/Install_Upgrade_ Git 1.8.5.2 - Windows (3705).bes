<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Install/Upgrade: Git 1.8.5.2 - Windows</Title>
    <Description><![CDATA[<P>Install Git v1.8.5.2</P>
<P>Git is a Cross Platform Version Control system.</P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance><![CDATA[not exists key whose (value "DisplayName" of it as string contains "Git" AND (preceding text of first "-" of (value "DisplayVersion" of it as string)) as version >= "1.8.5.2") of key "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry]]></Relevance>
    <Category>Software Sharing</Category>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2014-01-29</SourceReleaseDate>
    <MIMEField>
