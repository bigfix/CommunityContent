<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - RES ONE Workspace Agent - 9.10.1.003 - Windows</Title>
    <Description><![CDATA[<DIV id=fixletMessage2 class=FixletMessage>
<DIV id=paramFixletDescription>
<P>Deploy a new RES ONE Workspace 2015 SR1 Agent!</P>
<P>This parameterized Fixlet allows you to deploy RES ONE Workspace Agent that connects via Relay Authentication to a RES ONE Workspace Relay (This is the only form of agent to environment connection currently supported).</P>
<P>To deploy an agent you must determine what it's parent relay is going to be to connect into the environment as well as whether or not to inherit settings.</P>
<P><STRONG>Relay Parent&nbsp;Selection</STRONG>:<BR>This dropdown is populated with the current RES Relays deployed in the environment as well as a value, "Current BigFix Relay" which uses the currently configured BigFix Agent relay as the RES ONE Workspace Agent's relay.</P>
<P><STRONG>Inheritence Selection:<BR></STRONG>Inheritence causes the RES ONE Workspace Agent to obtain its configuration from its defined workspace. <STRONG>This is not recommended </STRONG>unless you have configured workspace containers in the RES ONE Workspace console.</P>
<P><FONT color=#ff0000><STRONG>NOTES: Grayed out settings used in this fixlet are configured via the Environment Configuration section of the Deployment Wizard!</STRONG></FONT><BR>- For <STRONG>"Relay"</STRONG> authentication, the Environment Configuration section below must be populated<STRONG>.</STRONG></P></DIV><script>
loaded = false;
var CODE_SITE_NAME = 'BES Support' ;
function loadScript (siteName, callback) {
loaded = false;
var relevanceQuery ='( value of it) of (mime fields of (bes fixlets whose ( name of it = "Parameterized Fixlet Library" and  name of site of it = \"' + siteName + '\" ))) whose (name of it = "vrt_utils.js")'
var code = EvaluateRelevance(relevanceQuery);
var head = document.getElementsByTagName("head")[0];
var script   = document.createElement("script");
script.type  = "text/javascript";
script.text = code;
head.appendChild(script);
callback();
}
function scriptLoaded(){
if (!loaded){
if ( typeof FixletUtils !== 'undefined') {
loaded = true;
/*
* Pleas Note: The following code will be moved to library with next publish of lib and user will have to only call method
*/
var relQuery = "(messages of it) of bes fixlets whose (name of it = \"Parameterized Fixlet Library\" and ((name of it ) of site of it = \"" + CODE_SITE_NAME +"\" ))";
var messages = EvaluateRelevance(relQuery);
var regex = /\s*<DIV id=globalizationMessageDiv  style="display:none;">([\x00-\x7F]+)\s*<\/Div>/i;
var matches = regex.exec(messages);
matches[1]=matches[1].replace(/<br>/gi,"");
eval(matches[1]);
FixletUtils.initFixletRender();
} } }
loadScript(CODE_SITE_NAME, scriptLoaded);
</script>
<DIV class=FixletProperty></DIV></DIV>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>not exists service &quot;res&quot; /* RES is Installed */</Relevance>
    <Category>Upgrade</Category>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-10-03</SourceReleaseDate>
    <MIMEField>
      <Name>x-res-release-display-name</Name>
      <Value>RES ONE Workspace 2015 SR1</Value>
    </MIMEField>
    <MIMEField>
      <Name>parametermetadatatag</Name>
      <Value>{
&quot;Section1&quot; :{
	&quot;Name&quot;: &quot;Method&quot;,
	&quot;Title&quot;: &quot;Agent Configuration&quot;,
	&quot;UIType&quot;: &quot;accordion&quot;,
	&quot;Values&quot;: [
	{
	    &quot;Name&quot;: &quot;rlParent&quot;,
	    &quot;Title&quot;: &quot;Relay Parent&quot;,
	    &quot;Description&quot;: &quot;Select the parent of this relay&quot;,
		&quot;UIType&quot;: &quot;select&quot;,
		&quot;Override&quot;: &quot;true&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;\&quot;Current BigFix Relay\&quot;;unique values of ((concatenation of (hostname of computer of it as lowercase;\&quot;:\&quot;; value of it)) of results of property 5 of fixlets whose (name of it = \&quot;RES ONE Workspace - Relay - Universal\&quot;) of site of current fixlet;substrings separated by \&quot;,\&quot; of (values of shared variables whose (name of it contains \&quot;RelayServers\&quot;) of wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot;) of site of current fixlet) as lowercase)&quot;
	},
	{
	    &quot;Name&quot;: &quot;inheritSettings&quot;,
	    &quot;Title&quot;: &quot;Inheritance Rules&quot;,
	    &quot;Description&quot;: &quot;Inherit Settings&quot;,
	    &quot;UIType&quot;: &quot;Select&quot;,
		&quot;ValueType&quot;: &quot;specified&quot;,
		&quot;Values&quot;: [&quot;Do not Inherit Settings&quot;,&quot;Inherit Settings&quot;]
	},
	{
	    &quot;Name&quot;: &quot;dbAuthMethod&quot;,
	    &quot;Title&quot;: &quot;Authentication&quot;,
	    &quot;Description&quot;: &quot;Authentication Method&quot;,
	    &quot;UIType&quot;: &quot;Select&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
		&quot;ValueType&quot;: &quot;specified&quot;,
		&quot;Values&quot;: [&quot;Relay&quot;]
	}
	]
},
&quot;Section5&quot; : {
	&quot;Name&quot;: &quot;EnvConfig&quot;,
	&quot;Title&quot;: &quot;Environment Configuration&quot;,
	&quot;UIType&quot;: &quot;accordion&quot;,
	&quot;Values&quot;: [
	{
	    &quot;Name&quot;: &quot;RESEnvPwdHash&quot;,
	    &quot;Title&quot;: &quot;RES Environment Password Hash&quot;,
	    &quot;Description&quot;: &quot;Enter the RES Environment Password Hash&quot;,
		&quot;UIType&quot;: &quot;Textbox&quot;,
		&quot;Encrypt&quot;: &quot;false&quot;,
		&quot;SubUIType&quot;: &quot;password&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;values of shared variables whose (name of it contains \&quot;respw_hash\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;
	},
	{
	    &quot;Name&quot;: &quot;RESRELPORT&quot;,
	    &quot;Title&quot;: &quot;RES Relay Port&quot;,
	    &quot;Description&quot;: &quot;Enter the RES Relay Port&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
		&quot;UIType&quot;: &quot;Textbox&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;values of shared variables whose (name of it contains \&quot;resrelport\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;
	},
	{
	    &quot;Name&quot;: &quot;RESEnvGUID&quot;,
	    &quot;Title&quot;: &quot;RES Environment GUID&quot;,
	    &quot;Description&quot;: &quot;Enter the RES Environment GUID&quot;,
		&quot;UIType&quot;: &quot;Textbox&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;unique values of (values of shared variables whose (name of it contains \&quot;EnvironmentGUID\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet);(values of results of properties whose (name of it = \&quot;RES ONE Workspace Database - Site GUID - Windows\&quot;) of fixlets whose (name of it = \&quot;RES ONE Workspace - Database - Windows\&quot;) of site of current fixlet))&quot;
	}
]
}
}</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 22:01:55 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action22779">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Source Release Date: 2016-10-03
prefetch RESWMAgent.msi sha1:29166d1c2cfe9c9c5cdefef5fd85c49b550d0863 size:35611648 http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-Agent-SR1.msi
prefetch Auto-RES-ONE-Workspace-2015-SR1-Hotfix-9.10.1.003.exe sha1:71B269170D2288689F295FEE57C7C7E47799CBFB size:6132584 http://downloads.ressoftware.com/downloads/cdm/040116/Auto-RES-ONE-Workspace-2015-SR1-Hotfix-9.10.1.003.exe sha256:70A250F4F7B2B14B332AC4E1919A9329CA5B8B7DB2814791965BC9A32A347B0F
prefetch RunRES.exe sha1:AB5B623828605B30CD00EF2EDBC66541A550693C size:329936 http://downloads.ressoftware.com/downloads/cdm/RunRES/2015.0.0.0/RunRES.exe sha256:4B5BC4DF5ECC85ADF097192E6AC1AA556CA554D33E9D50FDD374796481987D92

// action log all

//
// Validation
//

continue if {parameter "rlParent" of action != ""}
continue if {parameter "RESEnvGUID" of action != ""}
continue if {parameter "RESRELPORT" of action != ""}
continue if {parameter "RESEnvPwdHash" of action != ""}

if {parameter "rlParent" of action = "Current BigFix Relay"}
	parameter "CurrentRelay"="{(preceding text of first ":" of name of registration server as lowercase ) & ":" & parameter "RESRELPORT" of action}"
	parameter "ConfRelay1"="{(";" & preceding text of first ":" of following text of first "//" of value of setting "__RelayServer1" of client as string as lowercase & ":" & parameter "RESRELPORT" of action) | ""}"
	parameter "ConfRelay2"="{(";" & preceding text of first ":" of following text of first "//" of value of setting "__RelayServer2" of client as string as lowercase  & ":" & parameter "RESRELPORT" of action) | ""}"
	parameter "RelayList"="{ concatenations ";" of unique values of substrings separated by ";" of (parameter "CurrentRelay" & parameter "ConfRelay1" & parameter "ConfRelay2")}"
else
	parameter "RelayList"="{parameter "rlParent" of action}"
endif


//if {parameter "workspaceContainer" of action != "None"}
	//parameter "Container"="ADDTOWORKSPACE={"%22"}{parameter "workspaceContainer" of action}{"%22"}"
parameter "Container"=""
//else
//	parameter "Container"=""
//endif

if {parameter "inheritSettings" of action = "Do not Inherit Settings"}
	parameter "INHERIT"="no"
else
	parameter "INHERIT"="yes"
endif

wait msiexec /i "__Download\RESWMAgent.msi" RSENVGUID="{(parameter "RESEnvGUID" of action)}" RSPASSWORD="{parameter "RESEnvPwdHash" of action}" RSPWHASHED=Yes RSDISCOVER=No RSLIST="{parameter "RelayList"}" INHERITSETTINGS="{parameter "INHERIT" of action}" {parameter "Container"} /qn
waithidden "__Download\Auto-RES-ONE-Workspace-2015-SR1-Hotfix-9.10.1.003.exe"
]]></ActionScript>
    </Action>
  </Fixlet>
</BES>
