<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Install VSFTPD on Ubuntu 12.04</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>name of operating system contains &quot;Ubuntu&quot;</Relevance>
    <Relevance>exists file &quot;availableApps.txt&quot; whose (exists lines whose (it starts with &quot;vsftpd&quot;) of it) of parent folder of client</Relevance>
    <Relevance>NOT exists file &quot;installedApps.txt&quot; whose (exists lines whose (it starts with &quot;vsftpd&quot;) of it) of parent folder of client</Relevance>
    <Category>Installation</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2013-04-30</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 01 May 2013 03:19:23 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[
delete __appendfile
appendfile #!/bin/bash
//install
delete "vsftpd.txt"
appendfile apt-get install -q -y vsftpd > vsftpd.txt
//modify config file
appendfile tmp=/etc/vsftpd.conf.tmp
appendfile rm $tmp
appendfile echo -n "" > "$tmp"
appendfile while read line; do
appendfile     if [[ "$line" =~ ^anonymous_enable ]]; then
appendfile         echo "#$line" >> "$tmp"
appendfile     elif [[ "$line" =~ ^#local_enable ]]; then
appendfile         echo "${{line/\#/}" >> "$tmp"
appendfile     elif [[ "$line" =~ ^#write_enable ]]; then
appendfile         echo "${{line/\#/}" >> "$tmp"
appendfile     else
appendfile         echo "$line" >> "$tmp"
appendfile     fi
appendfile done < /etc/vsftpd.conf
appendfile mv /etc/vsftpd.conf.tmp /etc/vsftpd.conf
//now restart it
appendfile service vsftpd restart
delete "installer.sh"
move __appendfile "installer.sh"
wait chmod +x installer.sh
wait ./installer.sh
//lastly update the list of currently installed applications
delete __appendfile
appendfile #!/bin/sh
appendfile dpkg --get-selections > "{pathname of parent folder of client}/installedApps.txt"
delete "installedApps.sh"
delete "{pathname of parent folder of client}/installedApps.txt"
move __appendfile "installedApps.sh"
wait chmod +x installedApps.sh
wait ./installedApps.sh
]]></ActionScript>
    </DefaultAction>
    <Action ID="Action1685">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to read&amp;nbsp;inspiring article for this fixlet.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://www.liberiangeek.net/2012/06/install-and-setup-ftp-server-vsftpd-in-ubuntu-12-04-precise-pangolin/</ActionScript>
    </Action>
  </Task>
</BES>
