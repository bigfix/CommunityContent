  Imported : 2013-10-24T06:48:54
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>VLC - 2.1.0 - Mac</Title>
    <Description><![CDATA[<P>VideoLAN has released a new version of VLC. Use the action below to update VLC to the latest version (2.1.0).</P>
<P><STRONG>File Size:</STRONG>&nbsp;29.9 MB</P>]]></Description>
    <Relevance>name of operating system = &quot;Mac OS X&quot;</Relevance>
    <Relevance><![CDATA[system version >= "10.6"]]></Relevance>
    <Relevance><![CDATA[exists application "VLC.app" whose (version of it >= "" as version AND version of it < "2.1.0" as version)]]></Relevance>
    <Relevance><![CDATA[free space of filesystem of folder (pathname of client) > 62727942]]></Relevance>
    <Category>Update</Category>
    <Source>VideoLAN</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2013-09-25</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 26 Sep 2013 20:41:11 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[begin prefetch block
  add prefetch item name=vlc_2_1_0 sha1=a28961b75ca445ac8daad7944c71d6dbab0c7397 size=31363971 url=http://get.videolan.org/vlc/2.1.0/macosx/vlc-2.1.0.dmg
end prefetch block


// Create variables to house the name of the .dmg file, mount name and current install location. Makes updating the script easier.
// NOTE: Install_Mount MUST match the name used in the prefetch block!
parameter "Install_DMG" = "VLC-2.1.0.dmg"
parameter "Install_Mount" = "vlc_2_1_0"

// All SWD files will go into a folder in the clients __BESData folder. This folder gets cleared on every restart.
parameter "baseFolder" =  "__Download/"

// Move files into subfolders and unescape file names
wait sh -c "rm '/tmp/{parameter "Install_DMG"}'"
move "__Download/{parameter "Install_Mount"}" "/tmp/{parameter "Install_DMG"}"

// Mount the Disk Image
wait hdiutil attach -quiet -private -mountpoint "/tmp/{parameter "Install_Mount"}" "/tmp/{parameter "Install_DMG"}"

parameter "Install_Location" = "{posix path of application (name whose (it ends with ".app") of folders of folder ("/tmp/" & parameter "Install_Mount"))}"

wait sh -c "rm -R '{parameter "Install_Location"}'"
wait sh -c "cp -Rfp /tmp/{parameter "Install_Mount"}/*.app {parameter "Install_Location"}"
wait sh -c "chown -R root:admin '{parameter "Install_Location"}'"
wait sh -c "chmod -R 775 '{parameter "Install_Location"}'"
wait sh -c "xattr -d com.apple.quarantine '{parameter "Install_Location"}'"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/{parameter "Install_Mount"} | cut -f 1 -d \ | cut -f 3 -d / | head -1`"
wait sh -c "rm '/tmp/{parameter "Install_DMG"}'"]]></ActionScript>
    </DefaultAction>
    <Action ID="Action3911">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;for more information about this VLC release.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://www.videolan.org/vlc/releases/2.1.0.html</ActionScript>
    </Action>
  </Fixlet>
</BES>
