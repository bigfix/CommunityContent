<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Uninstall RoboSource Control</Title>
    <Description>This application is often installed with RoboHelp, but there are issues with RoboSource Control that comes with RoboHelp v8 that causes crashes on Windows 7 64bit (and possibly other OSes)</Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;RoboSource Control&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2012-03-14</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 16 Mar 2012 14:34:01 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">Wait msiexec.exe /X {name of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;RoboSource Control&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry} /qn /norestart</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
