<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall: Google Toolbar - uninstall</Title>
    <Description>This fixlet uninstalls the Google Toolbar</Description>
    <Relevance>Exists key whose (value &quot;displayname&quot; of it as string = &quot;Google Toolbar for Internet Explorer&quot; of it and value &quot;uninstallstring&quot; of it as string as lowercase contains &quot;uninstall&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Category>Uninstall</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2010-08-03</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:38:17 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click&amp;nbsp; </PreLink>
        <Link>here </Link>
        <PostLink>&amp;nbsp;to deploy this action. </PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">wait {value &quot;uninstallstring&quot; of key whose (value &quot;displayname&quot; of it as string = &quot;Google Toolbar for Internet Explorer&quot; of it and value &quot;uninstallstring&quot; of it as string as lowercase contains &quot;uninstall&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry}</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
