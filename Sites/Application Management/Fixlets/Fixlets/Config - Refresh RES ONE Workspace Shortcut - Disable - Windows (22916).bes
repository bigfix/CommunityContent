<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - Refresh RES ONE Workspace Shortcut - Disable - Windows</Title>
    <Description><![CDATA[Deploys a shortcut to the public desktop that allows the user to invoke a refresh of&nbsp;the RES ONE Workspace.]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists file &quot;Refresh Application Security Database.lnk&quot; of folder &quot;Users\Public\Desktop&quot; of drive of system folder</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>RESS</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Source Release Date: 2016-12-05

delete &quot;{pathname of file &quot;Refresh Application Security Database.lnk&quot; of folder &quot;Users\Public\Desktop&quot; of drive of system folder}&quot;
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
