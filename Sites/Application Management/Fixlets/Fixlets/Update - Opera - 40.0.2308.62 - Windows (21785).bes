<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update - Opera - 40.0.2308.62 - Windows</Title>
    <Description>This fixlet is for Update - Opera - 40.0.2308.62 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 40515896 * 2) and (exists ((keys of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of registry) whose (name of it contains "Opera" and value "Publisher" of it as string contains "Opera Software"))) and (value "DisplayVersion" of ((keys of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of registry) whose (name of it contains "Opera" and value "Publisher" of it as string contains "Opera Software")) as string as version < "40.0.2308.62" as version)]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Comment

prefetch C0E78DCAC96C94BA9783AC547922484B3BA2581D sha1:C0E78DCAC96C94BA9783AC547922484B3BA2581D size:40515896 http://download2.operacdn.com/pub/opera/desktop/40.0.2308.62/win/Opera_40.0.2308.62_Setup.exe sha256:573656C800061763C6FD9E57981DA86DBF802681DB34A0160D8BB8C01D584E47

parameter "baseFolder" =  "__Download/"

delete "{parameter "baseFolder"}Opera-Install.exe"
move "__Download/C0E78DCAC96C94BA9783AC547922484B3BA2581D" "{parameter "baseFolder"}Opera-Install.exe"

parameter "logFolder" = "{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs"
folder create "{parameter "logFolder"}"
parameter "logFile" = "PGW.log"

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
mkdir "{parameter "logFolder"}"

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | "Debugger" as string} - Opera >> "{parameter "logFolder"}/{parameter "logFile"}"

echo Opera-Install.exe /silent /allusers=yes /launchopera=no /desktopshortcut=no /setdefaultbrowser=no /pintotaskbar=no /startmenushortcut=yes /installfolder="{if (x64 of operating system) then (program files x64 folder) else (program files x32 folder)}\Opera Browser" /language=en-us >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

Opera-Install.exe /silent /allusers=yes /launchopera=no /desktopshortcut=no /setdefaultbrowser=no /pintotaskbar=no /startmenushortcut=yes /installfolder="{if (x64 of operating system) then (program files x64 folder) else (program files x32 folder)}\Opera Browser" /language=en-us >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

echo Return code: %errorlevel% >> "{parameter "logFolder"}/{parameter "logFile"}"
echo. >> "{parameter "logFolder"}/{parameter "logFile"}"

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
