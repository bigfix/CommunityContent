<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall: MSI - Sql Server Customer Experience Improvement Program - Windows</Title>
    <Description><![CDATA[<P>This task will uninstall the MSI: Sql Server Customer Experience Improvement Program</P><P>This task was automatically generated using the task: "RESTAPI: Generate uninstall tasks for all MSI applications on target computer - Windows"</P><P>&nbsp;</P>]]></Description>
    <Relevance><![CDATA[/* Windows XP or later */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance>/* Only run if Sql Server Customer Experience Improvement Program is installed */ exists keys whose( (exists values &quot;DisplayName&quot; whose(it as string as lowercase starts with &quot;Sql Server Customer Experience Improvement Program&quot; as lowercase) of it) AND (exists values whose(it as string as lowercase starts with &quot;msiexec&quot;) of it) ) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of ( x64 registries; x32 registries )</Relevance>
    <Category>Software Sharing</Category>
    <Source>RESTAPI: Generate uninstall tasks for all MSI applications on target computer - Windows</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2015-06-25</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 25 Jun 2015 20:55:07 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to uninstall Sql Server Customer Experience Improvement Program</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">waithidden msiexec.exe /X { name of keys whose( (exists values &quot;DisplayName&quot; whose(it as string as lowercase starts with &quot;Sql Server Customer Experience Improvement Program&quot; as lowercase) of it) AND (exists values whose(it as string as lowercase starts with &quot;msiexec&quot;) of it) ) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of ( x64 registries; x32 registries ) } /qn</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
