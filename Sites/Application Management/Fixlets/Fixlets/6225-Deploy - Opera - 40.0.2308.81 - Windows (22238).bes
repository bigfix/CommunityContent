wait &quot;__Download\0F371884D55220C523131C83C80B07EA1DDDDBD1.exe&quot; /silent /allusers=yes /launchopera=no /desktopshortcut=no /setdefaultbrowser=no /pintotaskbar=no /startmenushortcut=yes /installfolder=&quot;{if (x64 of operating system) then (program files x64 folder) else (program files x32 folder)}\Opera Browser&quot; /language=en-us
