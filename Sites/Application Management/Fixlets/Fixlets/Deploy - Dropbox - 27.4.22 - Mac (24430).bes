      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 8293EF79D1D5BBF4651BF2B995831463C0AA3500.dmg sha1:8293EF79D1D5BBF4651BF2B995831463C0AA3500 size:103483012 https://clientupdates.dropboxstatic.com/client/Dropbox%2027.4.22.dmg sha256:B1BA9E9F10F548288B2430D3A1D2E324E670708E8A462FF74C269315E8076702

delete &quot;/tmp/8293EF79D1D5BBF4651BF2B995831463C0AA3500.dmg&quot;

move &quot;__Download/8293EF79D1D5BBF4651BF2B995831463C0AA3500.dmg&quot; &quot;/tmp/8293EF79D1D5BBF4651BF2B995831463C0AA3500.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT8293EF79D1D5BBF4651BF2B995831463C0AA3500&quot; &quot;/tmp/8293EF79D1D5BBF4651BF2B995831463C0AA3500.dmg&quot;

wait sh -c &quot;rm /tmp/8293EF79D1D5BBF4651BF2B995831463C0AA3500.dmg&quot;

wait cp -R /tmp/BESMNTPT8293EF79D1D5BBF4651BF2B995831463C0AA3500/* /tmp/BESTEMP8293EF79D1D5BBF4651BF2B995831463C0AA3500

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT8293EF79D1D5BBF4651BF2B995831463C0AA3500/. /tmp/BESTEMP8293EF79D1D5BBF4651BF2B995831463C0AA3500&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT8293EF79D1D5BBF4651BF2B995831463C0AA3500 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP8293EF79D1D5BBF4651BF2B995831463C0AA3500/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP8293EF79D1D5BBF4651BF2B995831463C0AA3500&apos;&quot;
</ActionScript>
