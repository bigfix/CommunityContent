      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A.dmg sha1:25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A size:58568776 http://download.gimp.org/mirror/pub/gimp/v2.8/osx/gimp-2.8.22-x86_64.dmg sha256:3414960C54B262B5793947F55A6D1AB53045A507978A21FF758A54BF6BE4BD16

delete &quot;/tmp/25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A.dmg&quot;

move &quot;__Download/25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A.dmg&quot; &quot;/tmp/25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A&quot; &quot;/tmp/25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A.dmg&quot;

wait sh -c &quot;rm /tmp/25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A/. /tmp/BESTEMP25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP25C276D82DA6B9BD07478F9D1D9BD4FACCEA9D4A&apos;&quot;
</ActionScript>
