<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Uninstall: Monarch 6 Pro -Windows</Title>
    <Description>Uninstall: Monarch 6 Pro </Description>
    <Relevance>true</Relevance>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it) OR (name of it = &quot;Win8&quot; AND NOT x64 of it) OR (name of it = &quot;Win8&quot; AND x64 of it) OR (name of it = &quot;Win8.1&quot; AND NOT x64 of it) OR (name of it = &quot;Win8.1&quot; AND x64 of it)) of operating system AND TRUE</Relevance>
    <Relevance>exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{AC4A3E33-D03D-43A4-9E5B-50063405A489}&quot; of registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2018-01-22</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 22 Jan 2018 18:11:37 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Create Uninstall Respose file
delete __appendfile
appendfile [InstallShield Silent]
appendfile Version=v6.00.000
appendfile File=Response File
appendfile [File Transfer]
appendfile OverwrittenReadOnly=NoToAll
appendfile [{{AC4A3E33-D03D-43A4-9E5B-50063405A489}-DlgOrder]
appendfile Dlg0={{AC4A3E33-D03D-43A4-9E5B-50063405A489}-SdWelcomeMaint-0
appendfile Count=3
appendfile Dlg1={{AC4A3E33-D03D-43A4-9E5B-50063405A489}-SprintfBox-0
appendfile Dlg2={{AC4A3E33-D03D-43A4-9E5B-50063405A489}-File Transfer
appendfile [{{AC4A3E33-D03D-43A4-9E5B-50063405A489}-SdWelcomeMaint-0]
appendfile Result=303
appendfile [{{AC4A3E33-D03D-43A4-9E5B-50063405A489}-SprintfBox-0]
appendfile Result=1
appendfile [Application]
appendfile Name=Monarch Pro 6.00 Workstation
appendfile Version=6.00 Workstation
appendfile Company=Datawatch
appendfile Lang=0009
appendfile [{{AC4A3E33-D03D-43A4-9E5B-50063405A489}-File Transfer]
appendfile SharedFile=YesToAll
appendfile Count=0
move __appendfile "C:\temp\mon6prorem.iss"

//Prepare the Uninstall parameters
if {x64 of operating system}
if {exists "c:\temp\mon6prorem.bat"}
delete "c:\temp\mon6prorem.bat"
endif

delete __appendfile
appendfile @echo off
appendfile cd\
appendfile c:
appendfile cd "%PROGRAMFILES(X86)%\InstallShield Installation Information\{{AC4A3E33-D03D-43A4-9E5B-50063405A489}"
appendfile setup.exe -s -f1c:\temp\mon6prorem.iss
appendfile exit
move __appendfile "c:\temp\mon6prorem.bat"

else

if {exists "c:\temp\mon6prorem.bat"}
delete "c:\temp\mon6prorem.bat"
endif

delete __appendfile
appendfile @echo off
appendfile cd\
appendfile c:
appendfile cd "%PROGRAMFILES%\InstallShield Installation Information\{{AC4A3E33-D03D-43A4-9E5B-50063405A489}"
appendfile setup.exe -s -f1c:\temp\mon6prorem.iss
appendfile exit
move __appendfile "c:\temp\mon6prorem.bat"

endif

//Uninstall the software
waithidden "{pathname of system folder & "\cmd.exe"}" /Q /C "c:\temp\mon6prorem.bat"

]]></ActionScript>
    </DefaultAction>
  </Task>
</BES>
