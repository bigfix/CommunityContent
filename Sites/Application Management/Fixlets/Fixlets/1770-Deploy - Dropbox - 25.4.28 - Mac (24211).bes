      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch CC923FAC12182FA03D0504F7C22F60CB2F313F0B.dmg sha1:CC923FAC12182FA03D0504F7C22F60CB2F313F0B size:103046735 https://clientupdates.dropboxstatic.com/client/Dropbox%2025.4.28.dmg sha256:6DA3070EE354E3DAEDEA7FAE16193F61D151FDB99203896026CC39FFE8A05172

delete &quot;/tmp/CC923FAC12182FA03D0504F7C22F60CB2F313F0B.dmg&quot;

move &quot;__Download/CC923FAC12182FA03D0504F7C22F60CB2F313F0B.dmg&quot; &quot;/tmp/CC923FAC12182FA03D0504F7C22F60CB2F313F0B.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTCC923FAC12182FA03D0504F7C22F60CB2F313F0B&quot; &quot;/tmp/CC923FAC12182FA03D0504F7C22F60CB2F313F0B.dmg&quot;

wait sh -c &quot;rm /tmp/CC923FAC12182FA03D0504F7C22F60CB2F313F0B.dmg&quot;

wait cp -R /tmp/BESMNTPTCC923FAC12182FA03D0504F7C22F60CB2F313F0B/* /tmp/BESTEMPCC923FAC12182FA03D0504F7C22F60CB2F313F0B

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTCC923FAC12182FA03D0504F7C22F60CB2F313F0B/. /tmp/BESTEMPCC923FAC12182FA03D0504F7C22F60CB2F313F0B&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTCC923FAC12182FA03D0504F7C22F60CB2F313F0B | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPCC923FAC12182FA03D0504F7C22F60CB2F313F0B/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPCC923FAC12182FA03D0504F7C22F60CB2F313F0B&apos;&quot;
</ActionScript>
