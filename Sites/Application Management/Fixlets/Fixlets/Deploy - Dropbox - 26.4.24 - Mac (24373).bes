      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 2CF438CCBE389107ABCB6C8FE2270C9114D96E06.dmg sha1:2CF438CCBE389107ABCB6C8FE2270C9114D96E06 size:102971069 https://clientupdates.dropboxstatic.com/client/Dropbox%2026.4.24.dmg sha256:06DFF3EA2EC4ED19540F531FAC078413E29F517D1C50BD722872D8BEF3E8E2B6

delete &quot;/tmp/2CF438CCBE389107ABCB6C8FE2270C9114D96E06.dmg&quot;

move &quot;__Download/2CF438CCBE389107ABCB6C8FE2270C9114D96E06.dmg&quot; &quot;/tmp/2CF438CCBE389107ABCB6C8FE2270C9114D96E06.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT2CF438CCBE389107ABCB6C8FE2270C9114D96E06&quot; &quot;/tmp/2CF438CCBE389107ABCB6C8FE2270C9114D96E06.dmg&quot;

wait sh -c &quot;rm /tmp/2CF438CCBE389107ABCB6C8FE2270C9114D96E06.dmg&quot;

wait cp -R /tmp/BESMNTPT2CF438CCBE389107ABCB6C8FE2270C9114D96E06/* /tmp/BESTEMP2CF438CCBE389107ABCB6C8FE2270C9114D96E06

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT2CF438CCBE389107ABCB6C8FE2270C9114D96E06/. /tmp/BESTEMP2CF438CCBE389107ABCB6C8FE2270C9114D96E06&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT2CF438CCBE389107ABCB6C8FE2270C9114D96E06 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP2CF438CCBE389107ABCB6C8FE2270C9114D96E06/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP2CF438CCBE389107ABCB6C8FE2270C9114D96E06&apos;&quot;
</ActionScript>
