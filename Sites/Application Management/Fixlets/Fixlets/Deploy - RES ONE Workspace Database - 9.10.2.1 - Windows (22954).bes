<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - RES ONE Workspace Database - 9.10.2.1 - Windows</Title>
    <Description><![CDATA[<DIV id=fixletMessage2 class=FixletMessage>
<DIV id=paramFixletDescription>
<P>Use this Fixlet to deploy a new RES ONE Workspace 2015 SR2.1 Database!</P>
<p>
	You should always <b>run the Environment Validation fixlet</b> and make sure the validation succeeds before deploying the database.
</p>
<P>
	This fixlet will <b>only be applicable against the BigFix Root Server </b> and only if it has SQL Command Line Tools and at least Powershell 2.0 installed. The database deployment will take place using the Root Server as a launching point. From the Root Server, this fixlet will connect to whichever SQL server is configured in the environment configuration and provision the database on that SQL server.
</P>
<h5><FONT color=#ff0000><STRONG>NOTE:</FONT></STRONG> Settings below are configured via the Deployment Wizard!</h5>
<p>
	<ul>
		<li>
			If you are using "Windows - Only" or "Mixed - Use Windows" the Windows Authentication section must be populated.
		</li>
		<li>
			If you are using "SQL- Only" or "Mixed - Use SQL" the SQL Authentication section must be populated.
		</li>
		<li>
			If you are using "Mixed - Use Windows" or "Mixed - Use SQL" both the SQL Authentication and Windows Authentication sections >must be populated
		</li>
	</ul>
</p>
</DIV>

<DIV id=plainOrdinaryFixletDescription>Failed to load parameterized fixlet.</div>
</div>

<script>
    loaded = false;

	function loadGlobalization() {
		var globalization = EvaluateRelevance('(messages of it) of fixlets whose ( name of it = "Parameterized Fixlet Library") of all bes sites whose (name of it = "BES Support")');
		var regex = /\s*<DIV id=globalizationMessageDiv  style="display:none;">([\x00-\x7F]+)\s*<\/Div>/i;
		var matches = regex.exec(globalization);
		var globalizationSanitized = matches[1].replace(/<br>/gi, "");
		return globalizationSanitized;
	}

	function loadUtils() {
		return EvaluateRelevance('unique value of values of mime fields whose (name of it = "vrt_utils.js") of fixlets whose ( name of it = "Parameterized Fixlet Library") of all bes sites whose (name of it = "BES Support")');
	}

    function loadScript(url, callback) {
		var head = document.getElementsByTagName("head")[0];
		var script = document.createElement("script");
		script.type = "text/javascript";
		script.text = loadUtils() + loadGlobalization();
        script.onreadystatechange = callback;
        script.onload = callback;

        head.appendChild(script);
    }

    function scriptLoaded() {
        if (!loaded) {
            var paramFixletDescription = document.getElementById('paramFixletDescription');
            var plainOrdinaryFixletDescription = document.getElementById('plainOrdinaryFixletDescription');

            if (typeof FixletUtils !== 'undefined') {
                loaded = true;
                paramFixletDescription.style.display = "block";
                plainOrdinaryFixletDescription.style.display = "none";

                FixletUtils.initFixletRender();
            } else {
                paramFixletDescription.style.display = "none";
                plainOrdinaryFixletDescription.style.display = "block";
            }
        }
    }

    loadScript("vrt_fixletUtils.js", scriptLoaded);
</script>
]]></Description>
    <Relevance>exists main gather service</Relevance>
    <Relevance>windows of operating system</Relevance>
    <Relevance>not exists service &quot;res&quot; /* Agent is not Installed */</Relevance>
    <Relevance><![CDATA[not exists file ((it & "pwrtech.exe") of (values "InstallDir" of keys "HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager" of x32 registry as string)) /* Console is not Installed */]]></Relevance>
    <Relevance>exists files &quot;SQLCMD.exe&quot; of folders (substrings separated by &quot;;&quot; of value of variable &quot;PATH&quot; of environment) or exists (file &quot;SQLCmd.exe&quot; of folder &quot;Microsoft SQL Server\110\Tools\Binn&quot; of program files x64 folder)</Relevance>
    <Category>Upgrade</Category>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <MIMEField>
      <Name>x-res-release-display-name</Name>
      <Value>RES ONE Workspace 2015 SR2</Value>
    </MIMEField>
    <MIMEField>
      <Name>parametermetadatatag</Name>
      <Value>{
&quot;Section1&quot; :{
	&quot;Name&quot;: &quot;Method&quot;,
	&quot;Title&quot;: &quot;Database Authentication Method&quot;,
	&quot;UIType&quot;: &quot;accordion&quot;,
	&quot;Values&quot;: [
	{
	    &quot;Name&quot;: &quot;dbAuthMethod&quot;,
	    &quot;Title&quot;: &quot;Authentication&quot;,
	    &quot;Description&quot;: &quot;Authentication Method&quot;,
	    &quot;UIType&quot;: &quot;Select&quot;,
		&quot;ValueType&quot;: &quot;specified&quot;,
		&quot;Values&quot;: [&quot;Windows - Only&quot;,&quot;Mixed - Use Windows&quot;,&quot;Mixed - Use SQL&quot;,&quot;SQL - Only&quot;]
	}
	]
},
&quot;Section2&quot; : {
	&quot;Name&quot;: &quot;dbInfo&quot;,
	&quot;Title&quot;: &quot;Database Information&quot;,
	&quot;UIType&quot;: &quot;accordion&quot;,
	&quot;Values&quot;: [
	{
	    &quot;Name&quot;: &quot;dbServer&quot;,
	    &quot;Title&quot;: &quot;Database Server&quot;,
	    &quot;Description&quot;: &quot;Enter the name of the Database Server to be used for the RES ONE Workspace Database&quot;,
		&quot;UIType&quot;: &quot;Textbox&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;values of shared variables whose (name of it is \&quot;dbserver\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;
	},
	{
	    &quot;Name&quot;: &quot;dbName&quot;,
	    &quot;Title&quot;: &quot;Database Name&quot;,
	    &quot;Description&quot;: &quot;Enter the name of the Database on the DB Server to be used for the RES ONE Workspace Database&quot;,
		&quot;UIType&quot;: &quot;Textbox&quot;,
		&quot;Disabled&quot;: &quot;true&quot;,
	    &quot;ValueType&quot;: &quot;relevance&quot;,
		&quot;Values&quot;: &quot;values of shared variables whose (name of it contains \&quot;dbname\&quot;) of bes wizards whose (dashboard id of it as lowercase contains \&quot;resdeploy\&quot; and name of site of it = name of site of current fixlet)&quot;
	}
]
},
&quot;Section3&quot; : {
	&quot;Name&quot;: &quot;adWinAuth&quot;,
	&quot;Title&quot;: &quot;Windows Authentication&quot;,
