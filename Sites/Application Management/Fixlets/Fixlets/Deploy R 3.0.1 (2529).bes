<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Deploy R 3.0.1</Title>
    <Description><![CDATA[This task will deploy R 3.0.1 <BR><BR>This task is applicable on Mac OS X 10.6, Mac OS X 10.7 and Mac OS X 10.8 ]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[(system version >= "10.6" AND system version < "10.9")]]></Relevance>
    <Relevance><![CDATA[not exists application whose (name of it as string is "R.app" and ((bundle version of it) >= "6492.0" as version)) of applications folder]]></Relevance>
    <Category>Software Deployment</Category>
    <Source>Mac Software Deployment Wizard</Source>
    <SourceID>mah60</SourceID>
    <SourceReleaseDate>2026-09-17</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Mac Software Deployment Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 08 Jul 2013 13:36:52 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch R-3.0.1.pkg sha1:72b0c63db562b4001eb6a29d43232fc33c3a747e size:67651121 http://cran.r-project.org/bin/macosx/R-3.0.1.pkg
wait /usr/sbin/installer -pkg &quot;__Download/R-3.0.1.pkg&quot; -target /
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
