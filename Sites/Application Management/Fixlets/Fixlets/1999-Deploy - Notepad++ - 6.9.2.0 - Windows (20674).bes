<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - Notepad++ - 6.9.2.0 - Windows</Title>
    <Description>This fixlet is for Deploy - NotePadPP - 6.9.2.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "5.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 4211112 * 2) and (not exists regapp ("notepad++.exe"))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceID>!FixletID!</SourceID>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:05 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Comment

prefetch 6A54E0E8C8DBFCA68ABE3CBE66D99C66CED59CEA sha1:6A54E0E8C8DBFCA68ABE3CBE66D99C66CED59CEA size:4211112 https://notepad-plus-plus.org/repository/6.x/6.9.2/npp.6.9.2.Installer.exe sha256:A329D076A349C9BFFA02BFE670E1D9BEAA21CE10A695DB2D675E9346B6E72FCA

parameter "baseFolder" =  "__Download/"

delete "{parameter "baseFolder"}NotePadPP.exe"
move "__Download/6A54E0E8C8DBFCA68ABE3CBE66D99C66CED59CEA" "{parameter "baseFolder"}NotePadPP.exe"

parameter "logFolder" = "{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs"
folder create "{parameter "logFolder"}"
parameter "logFile" = "PGW.log"

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
mkdir "{parameter "logFolder"}"

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | "Debugger" as string} - NotePadPP >> "{parameter "logFolder"}/{parameter "logFile"}"

"NotePadPP.exe" /S >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

echo Return code: %errorlevel% >> "{parameter "logFolder"}/{parameter "logFile"}"
echo. >> "{parameter "logFolder"}/{parameter "logFile"}"

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
