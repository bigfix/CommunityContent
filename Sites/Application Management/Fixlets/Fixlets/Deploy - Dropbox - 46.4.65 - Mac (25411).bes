      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch CF155C4AD54495EE917892B4979CAB2C6192BF63.dmg sha1:CF155C4AD54495EE917892B4979CAB2C6192BF63 size:117868873 https://clientupdates.dropboxstatic.com/dbx-releng/client/Dropbox%2046.4.65.dmg sha256:46D7BDEE4916C8F45D4D9B8BFAEB473F3198ACDF969AE2821B989DDA76634782

delete &quot;/tmp/CF155C4AD54495EE917892B4979CAB2C6192BF63.dmg&quot;

move &quot;__Download/CF155C4AD54495EE917892B4979CAB2C6192BF63.dmg&quot; &quot;/tmp/CF155C4AD54495EE917892B4979CAB2C6192BF63.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTCF155C4AD54495EE917892B4979CAB2C6192BF63&quot; &quot;/tmp/CF155C4AD54495EE917892B4979CAB2C6192BF63.dmg&quot;

wait sh -c &quot;rm /tmp/CF155C4AD54495EE917892B4979CAB2C6192BF63.dmg&quot;

wait cp -R /tmp/BESMNTPTCF155C4AD54495EE917892B4979CAB2C6192BF63/* /tmp/BESTEMPCF155C4AD54495EE917892B4979CAB2C6192BF63

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTCF155C4AD54495EE917892B4979CAB2C6192BF63/. /tmp/BESTEMPCF155C4AD54495EE917892B4979CAB2C6192BF63&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTCF155C4AD54495EE917892B4979CAB2C6192BF63 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPCF155C4AD54495EE917892B4979CAB2C6192BF63/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPCF155C4AD54495EE917892B4979CAB2C6192BF63&apos;&quot;
</ActionScript>
