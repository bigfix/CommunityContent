<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>AccessEnum v1.32 Available!</Title>
    <Description><![CDATA[While the flexible security model employed by Windows NT-based systems allows full control over security and file permissions, managing permissions so that users have appropriate access to files, directories and Registry keys can be difficult. There's no built-in way to quickly view user accesses to a tree of directories or keys. <EM>AccessEnum</EM> gives you a full view of your file system and Registry security settings in seconds, making it the ideal tool for helping you for security holes and lock down permissions where necessary.]]></Description>
    <Relevance>name of operating system starts with &quot;Win&quot;</Relevance>
    <Relevance>not exists file &quot;AccessEnum.exe&quot; of windows folder</Relevance>
    <Category>Install</Category>
    <Source>danielheth@bigfix.me</Source>
    <SourceID>&lt;Unspecified&gt;</SourceID>
    <SourceReleaseDate>2013-01-10</SourceReleaseDate>
    <SourceSeverity>&lt;Unspecified&gt;</SourceSeverity>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 10 Jan 2013 18:26:47 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here </Link>
        <PostLink>to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">action parameter query &quot;EULA&quot; with description &quot;Click OK if you agree to the SysInternals EULA (see http://technet.microsoft.com/en-us/sysinternals/bb897332) on behalf of the System Account on the endpoint(s).&quot; and with default value &quot;I AGREE&quot;
continue if {parameter &quot;EULA&quot; = &quot;I AGREE&quot;}
prefetch AccessEnum.zip sha1:1e20ed578af7af3ba07d5ae7fa100d42ef689a8c size:51139 http://download.sysinternals.com/files/AccessEnum.zip
prefetch unzip.exe sha1:84debf12767785cd9b43811022407de7413beb6f size:204800 http://software.bigfix.com/download/redist/unzip-6.0.exe sha256:2122557d350fd1c59fb0ef32125330bde673e9331eb9371b454c2ad2d82091ac
utility __Download\unzip.exe
waithidden __Download\unzip.exe -qq -o -d &quot;{pathname of client folder of current site}\__Download&quot; __Download\AccessEnum.zip
copy &quot;{pathname of client folder of current site}\__Download\AccessEnum.exe&quot; &quot;{pathname of windows folder}\AccessEnum.exe&quot;
continue if {version of file &quot;AccessEnum.exe&quot; of windows folder = &quot;1.32.0.0&quot;}
//Set EULA agreement flags
regset &quot;[HKEY_CURRENT_USER\Software\Sysinternals\AccessEnum]&quot; &quot;EulaAccepted&quot;=dword:00000001
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action878">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn about Peter Hahndorf&apos;s research into accepting Sysinternals Licenses.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://peter.hahndorf.eu/blog/2010/03/07/WorkAroundSysinternalsLicensePopups.aspx</ActionScript>
    </Action>
    <Action ID="Action1621">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to learn more about this application.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://technet.microsoft.com/en-us/sysinternals/bb897332</ActionScript>
    </Action>
  </Task>
</BES>
