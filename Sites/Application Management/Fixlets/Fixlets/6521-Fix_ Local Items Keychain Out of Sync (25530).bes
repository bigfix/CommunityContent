<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Fix: Local Items Keychain Out of Sync</Title>
    <Description>Resolves issues where a user&apos;s local items keychain is out of sync, usually caused when the user&apos;s password is changed outside of the macOS dialogue. </Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance>exists current user</Relevance>
    <Source>Internal</Source>
    <SourceID>icc2</SourceID>
    <SourceReleaseDate>2018-07-06</SourceReleaseDate>
    <MIMEField>
      <Name>action-ui-metadata</Name>
      <Value>{&quot;version&quot;: &quot;1.0&quot;, &quot;size&quot;: &quot;0&quot;, &quot;icon&quot;: &quot;data:image/png;base64,&quot;}</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 16 Jul 2018 19:39:13 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click &amp;nbsp;</PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp; to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[parameter "start_time" = "{now}"


createfile until ___EOF___
{concatenations "%0A" of ("/bin/rm -rf %22" & (it as string) & "%22") of ( pathnames of folders of folder ("/Users/" & (name of current user) & "/Library/Keychains"))}
{concatenations "%0A" of ("/bin/rm -f %22" & (it as string) & "%22") of ("/Users/" & (name of current user) & "/Library/Keychains"))}

___EOF___

delete "deleteKeychains.command"
move __createfile "deleteKeychains.command"
wait /bin/chmod +x "deleteKeychains.command"
wait /bin/sh "deleteKeychains.command"
delete "deleteKeychains.command"

action requires restart]]></ActionScript>
      <SuccessCriteria Option="CustomRelevance"></SuccessCriteria>
    </DefaultAction>
    <Action ID="Action26812">
      <Description>
        <PreLink>Click &amp;nbsp;</PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp; for information regarding this issue.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">https://support.apple.com/en-us/ht201609</ActionScript>
    </Action>
    <Action ID="Action26813">
      <Description>
        <PreLink>Click &amp;nbsp;</PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp; for information on changing or reseting a macOS user account.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">https://support.apple.com/en-us/HT202860</ActionScript>
    </Action>
  </Task>
</BES>
