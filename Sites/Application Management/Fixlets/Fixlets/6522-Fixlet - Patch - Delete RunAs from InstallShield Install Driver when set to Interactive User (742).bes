<!--
  BigFix Task Export

  Title    : Fixlet - Patch - Delete RunAs from InstallShield Install Driver when set to Interactive User
  ID       : 742
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T14:48:16
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Fixlet - Patch - Delete RunAs from InstallShield Install Driver when set to Interactive User</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance>exists keys whose ((default value of it as string) contains &quot;InstallShield InstallDriver&quot; AND value &quot;RunAs&quot; of it as string contains &quot;Interactive User&quot;) of key &quot;HKEY_CLASSES_ROOT\AppID&quot; of registry</Relevance>
    <Category>Registry Edit</Category>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2011-08-31</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 02 Sep 2011 17:20:05 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// From https://wss.psu.edu/SysMan/Content%20Development/Fixlet%20-%20Patch%20-%20Delete%20RunAs%20from%20InstallShield%20Install%20Driver%20when%20set%20to%20Interactive%20User.aspx
// The following deletes the &quot;RunAs&quot; entry in the registry for the InstallShiled Install Driver, which effectively resets it to the default, which is &quot;Launching User&quot;
regdelete &quot;[HKEY_CLASSES_ROOT\AppID\{tuple string items 0 of concatenation &quot;, &quot; of (names of keys whose ((default value of it as string) contains &quot;InstallShield InstallDriver&quot; AND value &quot;RunAs&quot; of it as string contains &quot;Interactive User&quot;) of key &quot;HKEY_CLASSES_ROOT\AppID&quot; of registry)}]&quot; &quot;RunAs&quot;
// There are often more than one entry, this will effect the next one.
if{exists keys whose ((default value of it as string) contains &quot;InstallShield InstallDriver&quot; AND value &quot;RunAs&quot; of it as string contains &quot;Interactive User&quot;) of key &quot;HKEY_CLASSES_ROOT\AppID&quot; of registry}
regdelete &quot;[HKEY_CLASSES_ROOT\AppID\{tuple string items 0 of concatenation &quot;, &quot; of (names of keys whose ((default value of it as string) contains &quot;InstallShield InstallDriver&quot; AND value &quot;RunAs&quot; of it as string contains &quot;Interactive User&quot;) of key &quot;HKEY_CLASSES_ROOT\AppID&quot; of registry)}]&quot; &quot;RunAs&quot;
endif
// The following should not execute, unless there happen to be more than 2 entries for InstallShield InstallDrivers
if{exists keys whose ((default value of it as string) contains &quot;InstallShield InstallDriver&quot; AND value &quot;RunAs&quot; of it as string contains &quot;Interactive User&quot;) of key &quot;HKEY_CLASSES_ROOT\AppID&quot; of registry}
regdelete &quot;[HKEY_CLASSES_ROOT\AppID\{tuple string items 0 of concatenation &quot;, &quot; of (names of keys whose ((default value of it as string) contains &quot;InstallShield InstallDriver&quot; AND value &quot;RunAs&quot; of it as string contains &quot;Interactive User&quot;) of key &quot;HKEY_CLASSES_ROOT\AppID&quot; of registry)}]&quot; &quot;RunAs&quot;
endif</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
