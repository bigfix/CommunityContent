wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT5F377384F2455C37700073419C1E39092D65EAD0&quot; &quot;/tmp/5F377384F2455C37700073419C1E39092D65EAD0.dmg&quot;

