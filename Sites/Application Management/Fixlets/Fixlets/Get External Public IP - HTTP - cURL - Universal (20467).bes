<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Get External Public IP - HTTP - cURL - Universal</Title>
    <Description>&amp;lt;enter a description of the task here&amp;gt; </Description>
    <Relevance>not exists files whose(name of it as lowercase starts with &quot;public_ip_http_curl.log&quot; AND name of it as lowercase ends with &quot;.log&quot; AND (now - modification time of it) &lt; 9*day ) of folders &quot;Logs&quot; of folders &quot;__Global&quot; of data folders of client</Relevance>
    <Relevance>exists files whose(name of it as lowercase = &quot;curl&quot; OR name of it as lowercase = &quot;curl.exe&quot;) of (folders it) of unique values of (it as trimmed string) of substrings separated by (&quot;;&quot;;&quot;:&quot;) of values of (variables &quot;PATH&quot; of it; (if (windows of operating system) then (x64 variables &quot;PATH&quot; of it) else NOTHINGS) ) of environments</Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2016-05-04</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 05 May 2016 21:00:01 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
// http://myip.dnsomatic.com
// http://whatismyip.org
// http://icanhazip.com
// http://ipecho.net/plain
// http://externip.com

parameter &quot;ProviderPublicIP&quot; = &quot;http://ipecho.net/plain&quot;

wait curl {parameter &quot;ProviderPublicIP&quot;} -o &quot;{pathname of folders &quot;Logs&quot; of folders &quot;__Global&quot; of data folders of client}{if windows of operating system then &quot;\&quot; else &quot;/&quot;}public_ip_http_curl.log&quot;
</ActionScript>
    </DefaultAction>
  </Task>
</BES>
