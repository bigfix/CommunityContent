<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Upgrade: AutoPkg 0.4.2 - Mac OS X</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.9"]]></Relevance>
    <Relevance><![CDATA[not exists (strings of values of entries whose(key of it = "Version") of dictionaries of files "/Library/AutoPkg/autopkglib/version.plist") whose(it as version >= "0.4.2" as version)]]></Relevance>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2015-03-26</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 26 Mar 2015 20:31:53 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
prefetch autopkg.pkg sha1:2706cb6e1bbe4f5752fe5fa5fba3003ac40a3efa size:74527 https://github.com/autopkg/autopkg/releases/download/v0.4.2/autopkg-0.4.2.pkg

move &quot;__Download/autopkg.pkg&quot; &quot;/tmp/autopkg.pkg&quot;

wait /usr/sbin/installer -pkg &quot;/tmp/autopkg.pkg&quot; -target /

delete &quot;/tmp/autopkg.pkg&quot;
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
