move "__Download/D04321E7AF26F2040A653B5955294DC481F61C8E.dmg" "/tmp/D04321E7AF26F2040A653B5955294DC481F61C8E.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPTD04321E7AF26F2040A653B5955294DC481F61C8E" "/tmp/D04321E7AF26F2040A653B5955294DC481F61C8E.dmg"

wait sh -c "rm /tmp/D04321E7AF26F2040A653B5955294DC481F61C8E.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPTD04321E7AF26F2040A653B5955294DC481F61C8E/. /tmp/BESTEMPD04321E7AF26F2040A653B5955294DC481F61C8E"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPTD04321E7AF26F2040A653B5955294DC481F61C8E | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMPD04321E7AF26F2040A653B5955294DC481F61C8E/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMPD04321E7AF26F2040A653B5955294DC481F61C8E'"
