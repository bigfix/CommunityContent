wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT2360C953599C12909616F189786C8E9666975AA9&quot; &quot;/tmp/2360C953599C12909616F189786C8E9666975AA9.dmg&quot;

