      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch A53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9.dmg sha1:A53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9 size:103906471 https://clientupdates.dropboxstatic.com/client/Dropbox%2029.4.20.dmg sha256:E1DA78DE63E820D77A9F30F024D4707DA21FEDB101C72ABAC8F04A537EBC40AC

delete &quot;/tmp/A53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9.dmg&quot;

move &quot;__Download/A53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9.dmg&quot; &quot;/tmp/A53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTA53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9&quot; &quot;/tmp/A53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9.dmg&quot;

wait sh -c &quot;rm /tmp/A53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTA53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9/. /tmp/BESTEMPA53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTA53693CDEA6E38DAD5D79E69A0B9FE3B7DB6E3C9 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

