      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch D8AA49AAC47465F1876A005C2893801880F2CE5A.exe sha1:D8AA49AAC47465F1876A005C2893801880F2CE5A size:81258920 https://clientupdates.dropboxstatic.com/client/Dropbox%2023.4.17%20Offline%20Installer.exe sha256:14A6246E669FA24C58B585900F114C9488684FE872426B9CAE5815C0A1C346DF

override wait
hidden=true
wait &quot;__Download\D8AA49AAC47465F1876A005C2893801880F2CE5A.exe&quot; /S

regdelete &quot;[HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Run]&quot; &quot;Dropbox&quot;

delete &quot;{value of variable &quot;PUBLIC&quot; of environment}\Desktop\Dropbox.lnk&quot;
</ActionScript>
