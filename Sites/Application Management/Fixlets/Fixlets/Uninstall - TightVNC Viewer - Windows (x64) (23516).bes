<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall - TightVNC Viewer - Windows (x64)</Title>
    <Description>This fixlet is for Uninstall - TightVNC Viewer - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance>(windows of operating system) and (version of operating system &gt;= &quot;6.1&quot;) and (if exists property &quot;in proxy agent context&quot; then ( not in proxy agent context ) else true) and (x64 of operating system) and (exists value &quot;UninstallString&quot; whose (it as string contains &quot;MsiExec&quot;) of keys whose (value &quot;DisplayName&quot; of it as string starts with &quot;TightVNC&quot;) of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries)) and exists file (pathname of program files x64 folder &amp; &quot;\TightVNC\tvnviewer.exe&quot;)</Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2017-02-17</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:tightvnc:tightvnc:*:*:*:*:*:*:x64:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:tightvnc:tightvnc</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
override wait
hidden=true
completion=job
wait msiexec /i {name of keys whose (value &quot;DisplayName&quot; of it as string contains &quot;TightVNC&quot; and value &quot;UninstallString&quot; of it as string contains &quot;MsiExec&quot;) of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries)} /quiet /norestart REMOVE=&quot;Viewer&quot;

// If there are no more tightvnc modules left we do a full cleanup
if {not exists files whose (name of it ends with &quot;.exe&quot;) of folders &quot;TightVNC&quot; of program files x64 folder}

override wait
hidden=true
completion=job
wait msiexec /x {name of keys whose (value &quot;DisplayName&quot; of it as string starts with &quot;TightVNC&quot; and value &quot;UninstallString&quot; of it as string contains &quot;MsiExec&quot;) of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries)} /quiet /norestart

endif
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
