    <Action ID="Action2852">
      <Description>
        <PreLink>Click&amp;nbsp;</PreLink>
        <Link>here</Link>
        <PostLink>&amp;nbsp;to deploy this action</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Download all specified files
begin prefetch block
  add prefetch item name=53A5687CB26DC41F2AB4033E97E13ADEFD3740D6 sha1=53a5687cb26dc41f2ab4033e97e13adefd3740d6 size=7 url=SWDProtocol://127.0.0.1:52311/uploads/53A5687CB26DC41F2AB4033E97E13ADEFD3740D6/build.status.bfswd
  add prefetch item name=A390F0B5AD0E4F6879723EF1141ED4EB443FBF75 sha1=a390f0b5ad0e4f6879723ef1141ed4eb443fbf75 size=23855414 url=SWDProtocol://127.0.0.1:52311/uploads/A390F0B5AD0E4F6879723EF1141ED4EB443FBF75/compressedPackageData.bftemp.bfswd
  add prefetch item name=360D9E4BC282B8EBDCA982927B47D86021FA5D42 sha1=360d9e4bc282b8ebdca982927b47d86021fa5d42 size=3226112 url=SWDProtocol://127.0.0.1:52311/uploads/360D9E4BC282B8EBDCA982927B47D86021FA5D42/ClientUpdate.msi.bfswd
end prefetch block

// All SWD Files will go into a folder in the clients __BESData folder. This folder get cleared on every restart.
parameter "baseFolder" =  "__Download\"

// Make Relative Folders
delete __createfile
delete makeDirs.bat
createfile until _end_
@ECHO OFF
mkdir "{parameter "baseFolder"}"
_end_
move __createfile makeDirs.bat
waithidden makeDirs.bat

// Move files into subfolders and unescape file names
move "__Download\A390F0B5AD0E4F6879723EF1141ED4EB443FBF75" "__Download\compressedPackageData.bftemp"
move "__Download\360D9E4BC282B8EBDCA982927B47D86021FA5D42" "{parameter "baseFolder"}ClientUpdate.msi"
move "__Download\53A5687CB26DC41F2AB4033E97E13ADEFD3740D6" "{parameter "baseFolder"}build.status"


// extract any compressed files
extract compressedPackageData.bftemp

delete __createfile
delete moveArchive.bat
//move all the extracted files and folders to our new folder.
createfile until _end_
@ECHO OFF
{concatenations "%0d%0a" of (("move %22" & item 1 of it as string & "%22 %22" & parameter "baseFolder" & "" & item 0 of it as string & "%22") of ((name of it, pathname of it) of files whose (name of it != "RunAsCurrentUser.exe" AND name of it != "compressedPackageData.bftemp") of it) of (download folder) ; ("move %22" & it as string & "%22 %22" & parameter "baseFolder" & "%22") of ((pathname of it) of folders whose (pathname of it does not end with (preceding text of last "\" of parameter "baseFolder" as string)) of it) of (download folder))}
_end_
move __createfile moveArchive.bat
waithidden moveArchive.bat



// Run setup process
delete __createfile
delete run.bat

// Use .bat to set working directy to packages root, for setup command.
createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
msiexec.exe /i "ClientUpdate.msi" /qn
_end_

move __createfile run.bat

// You will not be able to stop or take action on an applicable BES Client until your installer completes,
// so ensure no user input is required.
// If your package absolutely must interact with the user, replace waithidden with run.
waithidden run.bat]]></ActionScript>
    </Action>
