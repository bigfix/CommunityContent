<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - ShareX - 11.2.1.0 - Windows</Title>
    <Description>This fixlet is for Deploy - ShareX - 11.2.1.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (exists key "HKLM\SOFTWARE\Microsoft\.NETFramework\v4.0.30319" of native registry)  and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 4788418 * 2) and (not exists (key of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of ( x32 registry; (if exists x64 registry then x64 registry else nothing) )) whose (value "DisplayName" of it as string is "ShareX"))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Comment

prefetch DCCB0DE5DD30F8C18337802DD63918F5E05E691C sha1:DCCB0DE5DD30F8C18337802DD63918F5E05E691C size:4788418 https://github.com/ShareX/ShareX/releases/download/v11.2.1/ShareX-11.2.1-setup.exe sha256:A89B0B23879C365AC4C54ABB5B8016DB527762525D2FE191A3061DD844D01240

parameter "baseFolder" =  "__Download/"

delete "{parameter "baseFolder"}ShareX.exe"
move "__Download/DCCB0DE5DD30F8C18337802DD63918F5E05E691C" "{parameter "baseFolder"}ShareX.exe"

parameter "logFolder" = "{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs"
folder create "{parameter "logFolder"}"
parameter "logFile" = "PGW.log"

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
mkdir "{parameter "logFolder"}"

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | "Debugger" as string} - ShareX >> "{parameter "logFolder"}/{parameter "logFile"}"

"ShareX.exe" /sp /silent /norestart /LOG="{parameter "logFolder"}\ShareX.log" >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

taskkill /f /fi "imagename eq ShareX.exe" /fi "username eq System"

echo Return code: %errorlevel% >> "{parameter "logFolder"}/{parameter "logFile"}"
echo. >> "{parameter "logFolder"}/{parameter "logFile"}"

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
