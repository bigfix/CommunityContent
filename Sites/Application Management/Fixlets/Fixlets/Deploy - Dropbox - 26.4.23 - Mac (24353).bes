    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch A816CD904D1BC965EA9232F750960B322C3DC28A.dmg sha1:A816CD904D1BC965EA9232F750960B322C3DC28A size:102971426 https://clientupdates.dropboxstatic.com/client/Dropbox%2026.4.23.dmg sha256:C4991E2E012FEBF6E2C131A52443794611435C729C767CA953D4DB6D49C9E7AE

delete &quot;/tmp/A816CD904D1BC965EA9232F750960B322C3DC28A.dmg&quot;

move &quot;__Download/A816CD904D1BC965EA9232F750960B322C3DC28A.dmg&quot; &quot;/tmp/A816CD904D1BC965EA9232F750960B322C3DC28A.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTA816CD904D1BC965EA9232F750960B322C3DC28A&quot; &quot;/tmp/A816CD904D1BC965EA9232F750960B322C3DC28A.dmg&quot;

wait sh -c &quot;rm /tmp/A816CD904D1BC965EA9232F750960B322C3DC28A.dmg&quot;

wait cp -R /tmp/BESMNTPTA816CD904D1BC965EA9232F750960B322C3DC28A/* /tmp/BESTEMPA816CD904D1BC965EA9232F750960B322C3DC28A

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTA816CD904D1BC965EA9232F750960B322C3DC28A/. /tmp/BESTEMPA816CD904D1BC965EA9232F750960B322C3DC28A&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTA816CD904D1BC965EA9232F750960B322C3DC28A | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPA816CD904D1BC965EA9232F750960B322C3DC28A/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPA816CD904D1BC965EA9232F750960B322C3DC28A&apos;&quot;
</ActionScript>
