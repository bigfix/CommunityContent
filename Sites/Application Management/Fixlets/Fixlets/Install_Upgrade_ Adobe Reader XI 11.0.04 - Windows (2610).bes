<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Upgrade: Adobe Reader XI 11.0.04 - Windows</Title>
    <Description>&lt;P&gt;&amp;nbsp;&lt;STRONG&gt;&amp;nbsp;&lt;FONT size=3&gt;About Adobe Reader&lt;/FONT&gt;&lt;/STRONG&gt;&lt;/P&gt;
&lt;BLOCKQUOTE style=&quot;MARGIN-RIGHT: 0px&quot; dir=ltr&gt;
&lt;P&gt;Adobe Reader&amp;nbsp;is an&amp;nbsp;application developed by Adobe Systems to view and&amp;nbsp;print files in portable document format (PDF). Adobe&apos;s solution for creating and manipulating PDF files is Adobe Acrobat Professional, which requires a license.&lt;/P&gt;&lt;/BLOCKQUOTE&gt;
&lt;P&gt;&lt;FONT color=#0080ff size=3&gt;&lt;STRONG&gt;Licensing&lt;/STRONG&gt;&lt;/FONT&gt;&lt;/P&gt;
&lt;BLOCKQUOTE style=&quot;MARGIN-RIGHT: 0px&quot; dir=ltr&gt;
&lt;P&gt;Adobe Reader is freeware.&lt;/P&gt;&lt;/BLOCKQUOTE&gt;&lt;STRONG&gt;
&lt;P&gt;&lt;FONT size=3&gt;About This Task&lt;/FONT&gt;&lt;/P&gt;&lt;/STRONG&gt;
&lt;BLOCKQUOTE&gt;This task will install/upgrade: Adobe Reader XI 11.0.04.&lt;BR&gt;&lt;BR&gt;This task is applicable on: Windows XP, Windows XP x64, Windows Vista, Windows Vista x64, Windows 7, Windows 7 x64, Windows&amp;nbsp;8 and Windows&amp;nbsp;8 x64. &lt;/BLOCKQUOTE&gt;</Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance>/* Windows XP or Higher */ version of operating system &gt;= &quot;5.1&quot;</Relevance>
    <Relevance>not exists key whose (value &quot;DisplayName&quot; of it as string contains &quot;Adobe Reader&quot; AND (it &gt;= &quot;11.0.04&quot; as version) of (value &quot;DisplayVersion&quot; of it as string as version)) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of x32 registry</Relevance>
    <Category>Software Sharing</Category>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2013-09-30</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 02 Oct 2013 16:31:49 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink></PreLink>
        <Link>Install/upgrade</Link>
        <PostLink>&amp;nbsp;and disable auto-updates.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//download Adobe Reader installer
prefetch AdbeRdr_en_US.exe sha1:9c295c16d374735bf292ef6c630c9ab392c22500 size:50573696 http://ardownload.adobe.com/pub/adobe/reader/win/11.x/11.0.04/en_US/AdbeRdr11004_en_US.exe

//uninstall previous version of Adobe Reader
if  { exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{AC76BA86-7AD7-1033-7B44-AB0000000001}}&quot; of registry }
    wait &quot;{pathname of system folder &amp; &quot;\msiexec.exe&quot;}&quot; /x &quot;{{AC76BA86-7AD7-1033-7B44-AB0000000001}&quot; /qn /norestart
endif

//install Adobe Reader without desktop shortcut
wait __Download\AdbeRdr_en_US.exe /sAll /l /msi /qn /norestart DISABLE_ARM_SERVICE_INSTALL=1 EULA_ACCEPT=YES DISABLE_AIR_SHARE=YES SUPPRESS_APP_LAUNCH=YES AgreeToLicense=Yes ALLUSERS=1 DISABLEDESKTOPSHORTCUT=1
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
