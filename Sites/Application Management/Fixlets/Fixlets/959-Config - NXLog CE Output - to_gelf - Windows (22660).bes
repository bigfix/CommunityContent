<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - NXLog CE Output - to_gelf - Windows</Title>
    <Description><![CDATA[<P>This Fixlet configures NXLog Community Edition to set the default output type to gelf.</P>
<P>This will not work unless you have enabled modular management using <STRONG>Fixlet:</STRONG> Config - NXLog CE - Enable Modular Management - Windows</P>
<P>If you specify the SSL protocol you must place a certificate in the CERT directory of the NXLog Client.</P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists values &quot;installdir&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\nxlog&quot; of x32 registries</Relevance>
    <Relevance>not exists files &quot;to_gelf.conf&quot; of folders &quot;Output&quot; of folders &quot;conf&quot; of folders (values &quot;installdir&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\nxlog&quot; of x32 registries as string)</Relevance>
    <Category>NXLog CE</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-11-07</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Enter your action script here
action parameter query "server" with description "Please enter the fqdn of the gelf server"
action parameter query "port" with description "Please enter the gelf port number" with default "514"
action parameter query "protocol" with description "Please enter the gelf protocol (udp/tcp/ssl)" with default "tcp"

// Must be UDP or TCP
continue if {(it = "udp" or it = "tcp" or it = "ssl") of (parameter "protocol" of action as lowercase)}

// Must be an integer
continue if {exists (it as integer) of (parameter "port" of action as lowercase)}

parameter "nxlog"="{pathnames of folders (values "installdir" of keys "HKEY_LOCAL_MACHINE\Software\nxlog" of x32 registries as string)}"
parameter "nxlog_conf"="{pathnames of folders "conf" of folders (values "installdir" of keys "HKEY_LOCAL_MACHINE\Software\nxlog" of x32 registries as string)}"

folder create "{parameter "nxlog_conf"}\Output"

delete __appendfile

appendfile <Output out>
appendfile    Module      om_{parameter "protocol" of action as lowercase}
appendfile    Host        {parameter "server" of action}
appendfile    Port        {parameter "port" of action}

if {parameter "protocol" of action as lowercase = "ssl"}
appendfile    CADir       %ROOT%\cert
appendfile    OutputType  GELF_TCP
endif

if {parameter "protocol" of action as lowercase = "tcp"}
appendfile    CADir       %ROOT%\cert
appendfile    OutputType  GELF_TCP
endif

if {parameter "protocol" of action as lowercase = "udp"}
appendfile    OutputType  GELF
endif

appendfile	  Exec $short_message = $raw_event;
appendfile </Output>

delete "{parameter "nxlog_conf"}\Output\to_gelf.conf"

copy __appendfile "{parameter "nxlog_conf"}\Output\to_gelf.conf"]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
