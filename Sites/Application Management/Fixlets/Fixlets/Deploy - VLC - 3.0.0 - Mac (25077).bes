      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 642E6244C9DE16B2B54A004F0B410DBF9F2CA505.dmg sha1:642E6244C9DE16B2B54A004F0B410DBF9F2CA505 size:46818658 http://download.videolan.org/pub/videolan/vlc/3.0.0/macosx/vlc-3.0.0.dmg sha256:E6F7179CB06809B6101803DA3AC4191EDB72ECF82F31B8AE7DBF010E1A78BA26

delete &quot;/tmp/642E6244C9DE16B2B54A004F0B410DBF9F2CA505.dmg&quot;

move &quot;__Download/642E6244C9DE16B2B54A004F0B410DBF9F2CA505.dmg&quot; &quot;/tmp/642E6244C9DE16B2B54A004F0B410DBF9F2CA505.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT642E6244C9DE16B2B54A004F0B410DBF9F2CA505&quot; &quot;/tmp/642E6244C9DE16B2B54A004F0B410DBF9F2CA505.dmg&quot;

wait sh -c &quot;rm /tmp/642E6244C9DE16B2B54A004F0B410DBF9F2CA505.dmg&quot;

wait sh -c &quot;cp -Rpn /tmp/BESMNTPT642E6244C9DE16B2B54A004F0B410DBF9F2CA505/. /tmp/BESTEMP642E6244C9DE16B2B54A004F0B410DBF9F2CA505&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT642E6244C9DE16B2B54A004F0B410DBF9F2CA505 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP642E6244C9DE16B2B54A004F0B410DBF9F2CA505/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP642E6244C9DE16B2B54A004F0B410DBF9F2CA505&apos;&quot;
</ActionScript>
