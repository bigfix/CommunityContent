    <Domain>RESS</Domain>
    <Action ID="Action23965">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this task.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Source Release Date: 2016-12-05

parameter "PowerShellExe"="{ pathname of file ((it as string) of value "Path" of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\1\ShellIds\Microsoft.PowerShell" of native registry) }"

parameter "SQLCMDExe"="{tuple string item 0 of concatenations "," of pathnames of files "SQLCMD.exe" of folders (substrings separated by ";" of value of variable "PATH" of environment) | pathname of (file "SQLCmd.exe" of folder "Microsoft SQL Server\110\Tools\Binn" of program files x64 folder)}"

delete __createfile
delete validate.ps1

createfile until _end_
param (
    $SQLCmd = "{parameter "SQLCMDExe"}",
    $SQLServer = "{parameter "dbServer" of action}",
    $SQLDatastore = "{parameter "dbName" of action}",
    [Switch] $SQL = {if (parameter "dbAuthMethod" of action = "SQL") then ("$true") else ("$false")},
    $SQLUser = "{parameter "SQLUser" of action}",
    $SQLPassword = "{parameter "SQLPass" of action}",
    $GroupDomain = "{preceding text of first "\" of parameter "adGroupName" of action}",
    $GroupName = "{following text of first "\" of parameter "adGroupName" of action}",
	$ServiceDomain = "{preceding text of first "\" of parameter "adServiceAccountUsername" of action}",
    $ServiceUser = "{following text of first "\" of parameter "adServiceAccountUsername" of action}",
    $ServicePassword = "{parameter "adServiceAccountPassword" of action}"
)

#Not Automatically set on Windows 7
$PSScriptRoot = Split-Path $MyInvocation.MyCommand.Path -Parent

function write-log {{
    param(
        $Message
    )
    $LogFile = "$PSScriptRoot\Validation.log"

    $FormattedMessage = "$((get-date).tostring()) - $((Get-PSCallStack).FunctionName[1]) - $Message"

    write-verbose $FormattedMessage; $FormattedMessage >> $LogFile
}

$errServerNotFound=10
$errConnectToSQL=20
$errCreateDatabase=30
$errCreateTable=40
$errGroupDomain = 50
$errGroupName = 60
$errGroupMembership = 70
$errServiceDomain = 80
$errServiceAccount = 90

$VerbosePreference = "Continue"

function invoke-sqlquery {{
    [cmdletbinding(DefaultParameterSetName='Windows')]
    param (
        [string] $Query
    )

    if ($SQL) {{
        $Result = & "$SQLCMD" "-U" "$SQLUser" "-P" "$SQLPassword" "-S" "$SQLServer" "-Q" "$Query" 2>&1 | %{{ "$_" }
    } else {{
       $Result = & "$SQLCMD" "-E" "-S" "$SQLServer" "-Q" "$Query" 2>&1 | %{{ "$_" }
    }
    return $Result
}

function ExitWithCode
{{
    param
    (
        $exitcode
    )
    $host.SetShouldExit($exitcode)
    exit
    #write-log "Would exit with $Exitcode"
    #throw "Killing Script"
}

write-log "Attempting to connect to $SQLServer"
$ServerTest = invoke-sqlquery -Query "USE [$SQLDatastore]"

write-log "Checking Server $SQLServer"
if ($ServerTest -like "*Server is not found*") {{ write-log "Server was not found."; ExitWithCode($errServerNotFound)}
write-log "Found Server $SQLServer"

write-log "Checking Authentication Credentials"
if ($ServerTest -like "*Login failed for user*") {{ write-log "Login failed."; ExitWithCode($errConnectToSQL)}
write-log "Login Succeeded"

#Database Exists
write-log "Checking for Database $SQLDatastore"
if ($ServerTest -like "*Changed database context to*") {{
    write-log "Database $SQLDatastore exists!"

    write-log "Checking for Create Table permissions on $SQLDatastore"
    $DataStorePermissions = invoke-sqlquery -query "SELECT * FROM fn_my_permissions(NULL, 'DATABASE')"
    if ($DataStorePermissions -like "*CREATE TABLE*") {{
        write-log "Account has Create Table permissions"
    } else {{
        write-log "Does not have create table permissions"
        exitwithcode($errCreateTable)
    }
}

#Database Does Not Exist
else {{
    write-log "Database does not exist. Checking for Database Permission"
    $DBPermissions = invoke-sqlquery -query "SELECT * FROM fn_my_permissions(NULL, 'SERVER')"

    write-log "Checking for Create Database permissions on $SQLServer"
    if ($DBPermissions -like "*CREATE ANY DATABASE*") {{
        write-log "Account has Create Database permissions"
    } else {{
        write-log "Does not have Create Database permission"
        exitwithcode($errCreateDatabase)
    }
}

Add-Type -AssemblyName System.DirectoryServices.AccountManagement
$ct = [System.DirectoryServices.AccountManagement.ContextType]::Domain

try {{
    write-log "Attempting to connect to the domain $GroupDomain"
    $pc = New-Object System.DirectoryServices.AccountManagement.PrincipalContext $ct,$GroupDomain
    write-log "Connected to the domain $GroupDomain"
} catch {{
    write-log "Error contacting domain $GroupDomain"
    exitwithcode($errGroupDomain)
}

try {{
    write-log "Checking for AD Group: $GroupName"
    $group = [System.DirectoryServices.AccountManagement.GroupPrincipal]::FindByIdentity($ct,$GroupName)
    $GroupMembers = ($group.GetMembers($true)).SamAccountName
    write-log "Found AD Group: $GroupName"
} catch {{
    write-log "Invalid AD Group Supplied"
    exitwithcode($errGroupName)
}

write-log "Verifying $($env:COMPUTERNAME) is a member of $GroupName"
if (!($GroupMembers.Contains("$($env:COMPUTERNAME)$"))){{
    write-log "Computer object is not a member of supplied AD Group"
    exitwithcode($errGroupMembership)
} else {{
    write-log "Computer Object $($env:COMPUTERNAME) is a member of $GroupName"
}

if ($SQL -and ($ServiceDomain -like "" -or $ServiceUser -like "" -or $ServicePassword -like "")){{
	write-log "Service Acount is not defined... Skipping"
} else {
	write-log "Checking Service Account Domain: $ServiceDomain"
	try {{
		write-log "Attempting to connect to the domain $ServiceDomain"
		$sd = New-Object System.DirectoryServices.AccountManagement.PrincipalContext $ct,$ServiceDomain
		write-log "Connected to the domain $ServiceDomain"
	} catch {{
		write-log "Error contacting domain $ServiceDomain"
		exitwithcode($errServiceDomain)
	}

	write-log "Checking Service Account: $ServiceUser"
	if (!($sd.ValidateCredentials($ServiceUser,$ServicePassword))) {{
		write-log "Invalid Service Account Credentials for $ServiceUser"
		exitwithcode($errServiceAccount)
	} else {{
		write-log "Service Account Credentials Verified"
	}
}

_end_

move __createfile validate.ps1

// We use command here so we can get a return code, file doesnt provide us the return code.
waithidden "{parameter "PowershellExe"}" -ExecutionPolicy Bypass -Command "& .\validate.ps1"

appendfile "Exit Code: {exit code of action}"

// SQL Server not found -- 171 = Start
continue if {exit code of action != 10}

// Could not connect to SQL -- Start + 2
continue if {exit code of action != 20}

// Can't create Database -- Start + 4
continue if {exit code of action != 30}

// Can't create tables in DB -- Start + 6
continue if {exit code of action != 40}

// Couldn't validate AD -- Start + 8
continue if {exit code of action != 50}

// Couldn't validate group name -- Start + 10
continue if {exit code of action != 60}

// BigFix server was not in AD Group -- Start + 12
continue if {exit code of action != 70}

// Couldn't validate service account domain -- Start + 14
continue if {exit code of action != 80}

// Couldn't validate service account -- Start + 16
continue if {exit code of action != 90}

notify client forcerefresh
]]></ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </Action>
  </Fixlet>
</BES>
