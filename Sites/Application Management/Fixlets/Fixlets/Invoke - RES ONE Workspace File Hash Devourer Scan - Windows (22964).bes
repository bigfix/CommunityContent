<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Invoke - RES ONE Workspace File Hash Devourer Scan - Windows</Title>
    <Description>Invoke the RES ONE Workspace File Hash Devourer </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists folder &quot;\RES Software\File Hash Devourer\Configuration&quot; of program files x32 folder</Relevance>
    <Relevance>not exists running tasks whose (name of it is &quot;Devour File Hashes&quot;)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 22:01:52 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Source Release Date: 2016-12-05
run schtasks /run /TN &quot;Devour File Hashes&quot;
</ActionScript>
    </DefaultAction>
  </Task>
</BES>
