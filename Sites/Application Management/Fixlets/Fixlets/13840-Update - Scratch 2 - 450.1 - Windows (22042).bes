      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:mit:scratch:450.1:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:mit:scratch:450.1</Value>
    </MIMEField>
