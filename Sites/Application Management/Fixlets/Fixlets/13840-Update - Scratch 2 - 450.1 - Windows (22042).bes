    	<Value>Thu, 17 Sep 2026 21:40:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 4209750C6D698E4238E14D3087E4A515E7C1C4F1.exe sha1:4209750C6D698E4238E14D3087E4A515E7C1C4F1 size:62157392 http://cdn.scratch.mit.edu/scratchr2/static/sa/Scratch-450.1.exe sha256:A616C8F4961A1541A9DCD4869C613FC49D2EFF12FD881AC612758C0BA2D8E4C1

//Update Fails if Scratch is Already Installed
override wait
hidden=true
completion=job
wait msiexec /x {following text of last &quot;/x &quot; of (it as string) of values &quot;UninstallString&quot; of keys &quot;edu.media.mit.Scratch2Editor&quot; of keys &quot;HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x32 registries; x64 registries)} /qn

override wait
hidden=true
completion=job
wait &quot;__Download\4209750C6D698E4238E14D3087E4A515E7C1C4F1.exe&quot; -silent -eulaAccepted -desktopShortcut -programMenu -allowDownload
</ActionScript>
