<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Upgrade RES ONE Workspace Relay Servers to 2015 SR1 (9.10.1.0) for Windows</Title>
    <Description><![CDATA[This fixlet will upgrade your existing Windows&nbsp;RES ONE Relay Servers to 2015 SR1 (9.10.1.0) ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[exists service "RESRLS" and version of service "RESRLS" as string < "9.10.1.0"]]></Relevance>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-03-21</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 24 Mar 2016 13:41:21 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">IF {x64 of operating system}
   prefetch WMRELAY64.MSI sha1:79820c3a7ff54a1cd723c7fd670ef1e0deb84bf6 size:2846720 http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Relay-Server(x64)-9.10.1.0.msi
   wait msiexec /i __Download\WMRELAY64.MSI /qn
ELSE
   prefetch WMRELAY86.MSI sha1:e68d4c183d4b6dea4da9e441f7fa08fcc480e0a6 size:2846720 http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Relay-Server(x86)-9.10.1.0.msi
   wait msiexec /i __Download\WMRELAY86.MSI /qn
ENDIF</ActionScript>
    </DefaultAction>
    <Action ID="Action11328">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to download RES-ONE-Workspace-2015-SR1-Upgrade-Guide.pdf</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Upgrade-Guide.pdf</ActionScript>
    </Action>
    <Action ID="Action11329">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to download RES-ONE-Workspace-2015-SR1-Release-Notes.pdf</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Release-Notes.pdf</ActionScript>
    </Action>
    <Action ID="Action11330">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to download RES-ONE-Workspace-2015-SR1-Administration-Guide.pdf</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-SR1-Administration-Guide.pdf</ActionScript>
    </Action>
  </Fixlet>
</BES>
