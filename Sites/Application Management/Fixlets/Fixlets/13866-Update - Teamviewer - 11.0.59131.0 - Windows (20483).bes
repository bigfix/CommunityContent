<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update - Teamviewer - 11.0.59131.0 - Windows</Title>
    <Description>This fixlet is for Update - Teamviewer - 11.0.59131.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "5.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 9614856 * 2) and exists (key of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of ( x32 registry; (if exists x64 registry then x64 registry else nothing) )) whose (name of it as string starts with "TeamViewer" and value "DisplayVersion" of it as string as version < "11.0.59131.0" as version)]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceID>!FixletID!</SourceID>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:42:52 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Comment

prefetch B10E18AC69EF686311E2D96C551F12649F695050 sha1:B10E18AC69EF686311E2D96C551F12649F695050 size:9614856 http://download.teamviewer.com/download/TeamViewer_Setup_en.exe sha256:6F18CBE41B2371DB39F27CD6417BD807CED75F3C36DCE9E973263CC27578B4D0

parameter "baseFolder" =  "__Download/"

delete "{parameter "baseFolder"}Teamviewer.exe"
move "__Download/B10E18AC69EF686311E2D96C551F12649F695050" "{parameter "baseFolder"}Teamviewer.exe"

parameter "logFolder" = "{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs"
folder create "{parameter "logFolder"}"
parameter "logFile" = "PGW.log"

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
mkdir "{parameter "logFolder"}"

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | "Debugger" as string} - Teamviewer >> "{parameter "logFolder"}/{parameter "logFile"}"

"Teamviewer.exe" /S >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

echo Return code: %errorlevel% >> "{parameter "logFolder"}/{parameter "logFile"}"
echo. >> "{parameter "logFolder"}/{parameter "logFile"}"

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
