      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch 9AD219B09570FD985D8CA8B7127F801833249DE2.dmg sha1:9AD219B09570FD985D8CA8B7127F801833249DE2 size:10759012 https://handbrake.fr/rotation.php?file=HandBrake-0.10.5-MacOSX.6_GUI_x86_64.dmg sha256:A2F1CACFB508E5EBE2489C64FA15204F15578AAF5E7F8A5AE9AB1FDCCDE51222

