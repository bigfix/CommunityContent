move &quot;__Download/9AD219B09570FD985D8CA8B7127F801833249DE2.dmg&quot; &quot;/tmp/9AD219B09570FD985D8CA8B7127F801833249DE2.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPT9AD219B09570FD985D8CA8B7127F801833249DE2&quot; &quot;/tmp/9AD219B09570FD985D8CA8B7127F801833249DE2.dmg&quot;

