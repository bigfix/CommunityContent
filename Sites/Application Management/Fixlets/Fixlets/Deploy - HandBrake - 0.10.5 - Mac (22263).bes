wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPT9AD219B09570FD985D8CA8B7127F801833249DE2 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMP9AD219B09570FD985D8CA8B7127F801833249DE2/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMP9AD219B09570FD985D8CA8B7127F801833249DE2&apos;&quot;
