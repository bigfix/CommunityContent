<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - CCleaner - 5.21.0.5700 - Windows</Title>
    <Description>This fixlet is for Deploy - CCleaner - 5.21.0.5700 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 8227032 * 2) and (not exists regapp ("CCleaner.exe"))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:05 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Comment

prefetch F10BD4904CE5A8C9DBCD95B8B8A330CEF75BC924 sha1:F10BD4904CE5A8C9DBCD95B8B8A330CEF75BC924 size:8227032 http://download.piriform.com/ccsetup521.exe sha256:066B70BE2072F754545D031EDBD58593AD68FA821191CF890A000BC743177106

parameter "baseFolder" =  "__Download/"

delete "{parameter "baseFolder"}CCleaner-Install.exe"
move "__Download/F10BD4904CE5A8C9DBCD95B8B8A330CEF75BC924" "{parameter "baseFolder"}CCleaner-Install.exe"

parameter "logFolder" = "{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs"
folder create "{parameter "logFolder"}"
parameter "logFile" = "PGW.log"

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
mkdir "{parameter "logFolder"}"

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | "Debugger" as string} - CCleaner >> "{parameter "logFolder"}/{parameter "logFile"}"

"CCleaner-Install.exe" /S >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

echo Return code: %errorlevel% >> "{parameter "logFolder"}/{parameter "logFile"}"
echo. >> "{parameter "logFolder"}/{parameter "logFile"}"

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
