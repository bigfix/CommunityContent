<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - Firefox - 58.0 - Windows</Title>
    <Description>This fixlet is for Deploy - Firefox - 58.0 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "6.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 36451128 * 2) and (not exists keys whose (value "DisplayName" of it as string starts with "Mozilla Firefox") of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registries; x64 registries))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2018-01-28</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:mozilla:firefox:58.0:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:mozilla:firefox:58.0</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:38:17 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch CE3425264373B0C4A5181C658EF9A7AD15EB0E94.exe sha1:CE3425264373B0C4A5181C658EF9A7AD15EB0E94 size:36451128 https://download.mozilla.org/?product=firefox-latest-ssl&amp;os=win&amp;lang=en-US sha256:A434E21B5B5C767BA38886C1DCD29624CCB6FC02F8CF2D7CE63F2EDFC78B58FD

delete setup.ini
delete __createfile

createfile until _end_
[Install]
DesktopShortcut=false
_end_

move __createfile setup.ini

override wait
hidden=true
completion=job
wait "__Download\CE3425264373B0C4A5181C658EF9A7AD15EB0E94.exe" /INI="{(pathname of client folder of current site) & "\setup.ini"}"

delete "{value of variable "PUBLIC" of environment}\Desktop\Mozilla Firefox.lnk"]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
