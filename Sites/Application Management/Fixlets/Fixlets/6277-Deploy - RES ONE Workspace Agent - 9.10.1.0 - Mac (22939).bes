	&quot;UIType&quot;: &quot;accordion&quot;,
	&quot;Values&quot;: [
	{
	    &quot;Name&quot;: &quot;RESEnvPwdHash&quot;,
	    &quot;Title&quot;: &quot;RES Environment Password Hash&quot;,
	    &quot;Description&quot;: &quot;Enter the RES Environment Password Hash&quot;,
