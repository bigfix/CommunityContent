move &quot;__Download/B4303796FE791B9E26B14063CAA0FB15B0EB2668.dmg&quot; &quot;/tmp/B4303796FE791B9E26B14063CAA0FB15B0EB2668.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTB4303796FE791B9E26B14063CAA0FB15B0EB2668&quot; &quot;/tmp/B4303796FE791B9E26B14063CAA0FB15B0EB2668.dmg&quot;

