wait sh -c &quot;cp -Rpn /tmp/BESMNTPTB4303796FE791B9E26B14063CAA0FB15B0EB2668/. /tmp/BESTEMPB4303796FE791B9E26B14063CAA0FB15B0EB2668&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTB4303796FE791B9E26B14063CAA0FB15B0EB2668 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPB4303796FE791B9E26B14063CAA0FB15B0EB2668/*.app /Applications&quot;

