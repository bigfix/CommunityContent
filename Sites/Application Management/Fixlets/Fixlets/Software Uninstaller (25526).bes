<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Software Uninstaller</Title>
    <Description>This fixlet will ask for a name and version of the software to be uninstalled. </Description>
    <Relevance>exist keys whose (value &quot;UninstallString&quot; of it as string as lowercase contains &quot;msiexec&quot;) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries; x32 registries)</Relevance>
    <Source>ronfrades@gmail.com</Source>
    <SourceReleaseDate>2018-03-05</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 14 Jun 2018 10:40:20 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[action parameter query "Name" with description "Please enter the Software Name"
action parameter query "Version" with description "Please enter the Software Version"
waithidden msiexec.exe /x {names of keys whose (value "DisplayName" of it as string as lowercase starts with (parameter "Name" of action as lowercase) AND value "DisplayVersion" of it as string as version <= (parameter "Version" of action as version) AND value "UninstallString" of it as string as lowercase contains "msiexec") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries; x32 registries)} /q
]]></ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
