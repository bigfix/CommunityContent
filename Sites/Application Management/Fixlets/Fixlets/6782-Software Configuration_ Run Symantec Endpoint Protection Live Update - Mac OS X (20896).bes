<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Software Configuration: Run Symantec Endpoint Protection Live Update - Mac OS X</Title>
    <Description><![CDATA[<P>Silently run Symantec Endpoint Protection Live Update</P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance>exists file &quot;/Library/Application Support/Symantec/LiveUpdate/LUTool&quot;</Relevance>
    <Relevance><![CDATA[not exists file "/Library/Application Support/Symantec/LiveUpdate/liveupdate.log" whose ((now - modification time of it) < 1*day)]]></Relevance>
    <Category>Software Configuration</Category>
    <Source>SysMan</Source>
    <SourceID>mah60</SourceID>
    <SourceReleaseDate>2016-07-01</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 01 Jul 2016 19:47:27 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Run Live Update
wait &quot;/Library/Application Support/Symantec/LiveUpdate/LUTool&quot;</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
