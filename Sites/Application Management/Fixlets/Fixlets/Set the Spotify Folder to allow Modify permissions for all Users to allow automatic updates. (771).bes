<!--
  BigFix Task Export

  Title    : Set the Spotify Folder to allow Modify permissions for all Users to allow automatic updates.
  ID       : 771
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T21:30:03
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Set the Spotify Folder to allow Modify permissions for all Users to allow automatic updates.</Title>
    <Description>This will allow all Users of a system to Modify the contents of the Spotify Folder on the system, which will enable Automatic Updates. This is no longer needed as newer versions of Spotify install to the user folder to allow standard users to install updates.</Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance>exists key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Spotify&quot; as lowercase) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>exists value &quot;InstallLocation&quot; of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Spotify&quot; as lowercase) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>exists folder (value &quot;InstallLocation&quot; of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Spotify&quot; as lowercase) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry as string)</Relevance>
    <Relevance>1245631 != effective access mode for &quot;Users&quot; of dacl of security descriptor of folder (value &quot;InstallLocation&quot; of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Spotify&quot; as lowercase) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry as string)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2011-10-13</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 07 Dec 2012 03:30:01 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Reference: http://forum.bigfix.com/viewtopic.php?id=372
// Reference: http://technet.microsoft.com/en-us/library/bb490872.aspx
// cacls.exe is a command line utility for changing security permissions for files or folders
//  /t   : Changes DACLs of specified files in the current directory and all subdirectories.
//  /e   : Edits a DACL instead of replacing it.
//  /g   User : permission   : Grants access rights to the specified user.
waithidden cmd.exe /C cacls.exe &quot;{pathname of folder (value &quot;InstallLocation&quot; of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Spotify&quot; as lowercase) of key &quot;HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry as string)}&quot; /T /E /G Users:C</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
