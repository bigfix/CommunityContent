<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Config - Virtualization Based Security - Using Secure Boot and DMA - Windows</Title>
    <Description>This Fixlet enables Virtualization Based Security on Windows devices that support it. </Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>set of (integer values of property &quot;AvailableSecurityProperties&quot; of select objects &quot;* from Win32_DeviceGuard&quot; of wmi &quot;root\Microsoft\Windows\DeviceGuard&quot;) contains 2 /* Secure Boot is Available */</Relevance>
    <Relevance>set of (integer values of property &quot;AvailableSecurityProperties&quot; of select objects &quot;* from Win32_DeviceGuard&quot; of wmi &quot;root\Microsoft\Windows\DeviceGuard&quot;) contains 1 /* Hypervisor Support is Available */</Relevance>
    <Relevance>(value &quot;EnableVirtualizationBasedSecurity&quot; of key &quot;HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\DeviceGuard&quot; of native registry as integer != 1) | true or (value &quot;RequirePlatformSecurityFeatures&quot; of key &quot;HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\DeviceGuard&quot; of native registry as integer != 3) | true</Relevance>
    <Relevance>set of (integer values of property &quot;AvailableSecurityProperties&quot; of select objects &quot;* from Win32_DeviceGuard&quot; of wmi &quot;root\Microsoft\Windows\DeviceGuard&quot;) contains 3 /* DMA Protection is Available */</Relevance>
    <Category>Virtualization Based Security</Category>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-05-12</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 20:56:29 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">regset &quot;[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\DeviceGuard]&quot; &quot;EnableVirtualizationBasedSecurity&quot;=dword:00000001
regset &quot;[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Control\DeviceGuard]&quot; &quot;RequirePlatformSecurityFeatures&quot;=dword:00000003</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
