wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTEC03BC42BE10C3BDEDA415CB10415FBC933C224C&quot; &quot;/tmp/EC03BC42BE10C3BDEDA415CB10415FBC933C224C.dmg&quot;

