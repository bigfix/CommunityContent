continue if [Parameter &quot;result1&quot; of action = &quot;success&quot; or Parameter &quot;result2&quot; of action = &quot;success&quot; or Parameter &quot;result3&quot; of action = &quot;success&quot; or Parameter &quot;result4&quot; of action = &quot;success&quot; or Parameter &quot;result5&quot; of action = &quot;success&quot; or Parameter &quot;result6&quot; of action = &quot;success&quot; or Parameter &quot;result7&quot; of action = &quot;success&quot; or Parameter &quot;result8&quot; of action = &quot;success&quot; or Parameter &quot;result9&quot; of action = &quot;success&quot; or Parameter &quot;result10&quot; of action = &quot;success&quot;}</ActionScript>
