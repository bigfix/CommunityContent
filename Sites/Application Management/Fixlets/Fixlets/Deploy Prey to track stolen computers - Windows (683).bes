<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Deploy Prey to track stolen computers - Windows</Title>
    <Description><![CDATA[<P>WARNING: you may violate local laws depending on your use of the software without knowledge of the owner &amp; user of the computer</P>
<P>More info here: <A href="http://preyproject.com/">http://preyproject.com/</A>.</P>
<P>Prey requires the computer to have WiFi or GPS to work properly, but can still provide valuable recovery data without it.</P>]]></Description>
    <Relevance>(name of it = &quot;Win2000&quot; OR name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it) OR name of it = &quot;WinXPe&quot;) of operating system</Relevance>
    <Relevance><![CDATA["2.0" as version <= maximum of ((following texts of firsts "v" of names of keys whose(name of it as string as lowercase contains "v") of key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\NET Framework Setup\NDP" of native registry) as version)]]></Relevance>
    <Relevance>not exists key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\services\CronService&quot; whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Cron Service for Prey&quot; as lowercase) of native registry</Relevance>
    <Relevance>exists connections whose (name of it as string as lowercase contains &quot;Wireless&quot; as lowercase) of network</Relevance>
    <Source>Internal</Source>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2011-12-01</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 04 Dec 2012 15:18:46 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[action parameter query "PreyAPI" with description "Please enter your Prey API key found here: http://panel.preyproject.com/profile"
// Download Prey
prefetch prey-win-install.exe sha1:1fb703d3962db76a8b059529b011f3398a79f889 size:5650143 https://preyproject.com/releases/0.5.3/prey-0.5.3-win.exe
// The following is based upon http://preyproject.com/releases/prey-win-batch-install.bat
waithidden "{(pathname of client folder of current site) & "\__Download\prey-win-install.exe"}" /S /NCRC /D=C:\Prey
waithidden C:\Prey\platform\windows\prey-config.exe /S /API_KEY={parameter "PreyAPI" of action} /CHECK_URL="control.preyproject.com" /SKIP_VALIDATION=true
delete __Download\prey-win-install.exe]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
