      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch C0E46033319A30BB910BD18FE445785EC120CBB9.dmg sha1:C0E46033319A30BB910BD18FE445785EC120CBB9 size:55328125 https://download.mozilla.org/?product=firefox-latest-ssl&os=osx&lang=en-US sha256:A853EB20821A21C0BEDEB0263D7B5975E7704F20B78EDFEF129C73804B1FB962

delete "/tmp/C0E46033319A30BB910BD18FE445785EC120CBB9.dmg"

move "__Download/C0E46033319A30BB910BD18FE445785EC120CBB9.dmg" "/tmp/C0E46033319A30BB910BD18FE445785EC120CBB9.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPTC0E46033319A30BB910BD18FE445785EC120CBB9" "/tmp/C0E46033319A30BB910BD18FE445785EC120CBB9.dmg"

wait sh -c "rm /tmp/C0E46033319A30BB910BD18FE445785EC120CBB9.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPTC0E46033319A30BB910BD18FE445785EC120CBB9/. /tmp/BESTEMPC0E46033319A30BB910BD18FE445785EC120CBB9"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPTC0E46033319A30BB910BD18FE445785EC120CBB9 | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMPC0E46033319A30BB910BD18FE445785EC120CBB9/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMPC0E46033319A30BB910BD18FE445785EC120CBB9'"
