<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Mozilla Firefox 46.0 Available - Mac OS X</Title>
    <Description>This fixlet is created using the &quot;Fixlet Maker&quot; wizard. </Description>
    <Relevance><![CDATA[(name of operating system = "Mac OS X") AND (if system version >= "10.6" then version of client >= "8.2" else true)]]></Relevance>
    <Relevance><![CDATA[exists application "Firefox.app" whose (version of it < "46.0" as version)]]></Relevance>
    <Category>Update</Category>
    <Source>Firefox</Source>
    <SourceReleaseDate>2016-04-25</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-first-propagation</Name>
      <Value>Fri, 24 Jan 2014 08:33:23 +0000</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-additional-notes</Name>
      <Value>Only supports Mozilla Firefox  &quot;.dmg&quot; (Enterprise Edition) stand-alone installer.</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-template-os</Name>
      <Value>Mac</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-domain_attributes</Name>
      <Value>PatchManagement 3rdPartyApp Mozilla Firefox</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-template-id</Name>
      <Value>mozillaFirefoxMacTemplate</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-product-name</Name>
      <Value>Mozilla Firefox</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-vendor-name</Name>
      <Value>Mozilla</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 29 Apr 2016 16:08:49 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action21278">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch Firefox_46.0.dmg sha1:2355d9b87f82ed31bfbcadedd425c76ed14038c2 size:87089754 http://download-installer.cdn.mozilla.net/pub/firefox/releases/46.0/mac/en-US/Firefox%2046.0.dmg sha256:f54b7e3e6bb330754ef4df7f96516fd7279a9fb01aad3db7fd2eadd25d8a279f

move "{posix path of file "Firefox_46.0.dmg" of folder "__Download" of client folder of current site}" "/private/tmp/Firefox_46.0.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint  "/Volumes/Firefox_46.0" "/private/tmp/Firefox_46.0.dmg"

wait cp -r "/Volumes/Firefox_46.0/Firefox.app" "/Applications/"

wait hdiutil detach -force "/Volumes/Firefox_46.0"

wait /bin/sh -c "rm '/private/tmp/Firefox_46.0.dmg' "

if {0 < size of intersection of (set of (names of processes as lowercase); set of ("firefox"))}
	action requires restart 2355d9b87f82ed31bfbcadedd425c76ed14038c2
endif]]></ActionScript>
    </Action>
    <Action ID="Action21279">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to upgrade Firefox regardless of whether or not Firefox is currently running.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch Firefox_46.0.dmg sha1:2355d9b87f82ed31bfbcadedd425c76ed14038c2 size:87089754 http://download-installer.cdn.mozilla.net/pub/firefox/releases/46.0/mac/en-US/Firefox%2046.0.dmg sha256:f54b7e3e6bb330754ef4df7f96516fd7279a9fb01aad3db7fd2eadd25d8a279f

move &quot;{posix path of file &quot;Firefox_46.0.dmg&quot; of folder &quot;__Download&quot; of client folder of current site}&quot; &quot;/private/tmp/Firefox_46.0.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint  &quot;/Volumes/Firefox_46.0&quot; &quot;/private/tmp/Firefox_46.0.dmg&quot;

wait sh -c &quot;killall &apos;firefox&apos; &quot;

wait cp -r &quot;/Volumes/Firefox_46.0/Firefox.app&quot; &quot;/Applications/&quot;

wait hdiutil detach -force &quot;/Volumes/Firefox_46.0&quot;

wait /bin/sh -c &quot;rm &apos;/private/tmp/Firefox_46.0.dmg&apos; &quot;
</ActionScript>
    </Action>
    <Action ID="Action21280">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> for security-related information from Mozilla.</PostLink>
      </Description>
      <ActionScript MIMEType="text/x-uri">http://www.sans.org/top20/#c1</ActionScript>
    </Action>
  </Fixlet>
</BES>
