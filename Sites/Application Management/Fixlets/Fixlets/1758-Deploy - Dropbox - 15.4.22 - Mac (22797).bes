      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">prefetch D590F9FE993CADC7436DA09D4FF17396369CAD75.dmg sha1:D590F9FE993CADC7436DA09D4FF17396369CAD75 size:95125596 https://clientupdates.dropboxstatic.com/client/Dropbox%2015.4.22.dmg sha256:A1569DFDEA08B585ECB9F50569F4D26BF86434957D604D7BD18498606C7E6A56

delete &quot;/tmp/D590F9FE993CADC7436DA09D4FF17396369CAD75.dmg&quot;

move &quot;__Download/D590F9FE993CADC7436DA09D4FF17396369CAD75.dmg&quot; &quot;/tmp/D590F9FE993CADC7436DA09D4FF17396369CAD75.dmg&quot;

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint &quot;/tmp/BESMNTPTD590F9FE993CADC7436DA09D4FF17396369CAD75&quot; &quot;/tmp/D590F9FE993CADC7436DA09D4FF17396369CAD75.dmg&quot;

wait sh -c &quot;rm /tmp/D590F9FE993CADC7436DA09D4FF17396369CAD75.dmg&quot;

wait cp -R /tmp/BESMNTPTD590F9FE993CADC7436DA09D4FF17396369CAD75/* /tmp/BESTEMPD590F9FE993CADC7436DA09D4FF17396369CAD75

wait sh -c &quot;cp -Rpn /tmp/BESMNTPTD590F9FE993CADC7436DA09D4FF17396369CAD75/. /tmp/BESTEMPD590F9FE993CADC7436DA09D4FF17396369CAD75&quot;

wait /bin/sh -c &quot;hdiutil detach -force `mount | grep /tmp/BESMNTPTD590F9FE993CADC7436DA09D4FF17396369CAD75 | cut -f 1 -d \ | cut -f 3 -d / | head -1`&quot;

wait /bin/sh -c &quot;cp -Rp /tmp/BESTEMPD590F9FE993CADC7436DA09D4FF17396369CAD75/*.app /Applications&quot;

wait sh -c &quot;rm -rf &apos;/tmp/BESTEMPD590F9FE993CADC7436DA09D4FF17396369CAD75&apos;&quot;
</ActionScript>
