<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Update: Microsoft Expression Web 4 - Windows</Title>
    <Description><![CDATA[<P>This task will deploy: Microsoft Expression Web 4</P>
<P>&nbsp;</P>
<P>&nbsp;</P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance><![CDATA[/* Only install if missing or an older version of Microsoft Expression Web is installed */ (not exists keys whose (value "DisplayName" of it as string starts with "Microsoft Expression Web" AND (value "DisplayVersion" of it as string as version) >= "4.0.1460.0" as version) of keys "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of registry)]]></Relevance>
    <Category>Software Sharing</Category>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2014-04-25</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 25 Apr 2014 20:30:42 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here </Link>
        <PostLink>to initiate the deployment process.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// http://www.microsoft.com/en-us/download/details.aspx?id=36179
prefetch Web_Trial_en.exe sha1:21531996203e83575d5e61e861c147d687c57ed6 size:103542856 http://download.microsoft.com/download/F/D/8/FD88D81D-52B5-486A-A53F-CCDB485D5258/Web_Trial_en.exe

wait __Download\Web_Trial_en.exe -q
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
