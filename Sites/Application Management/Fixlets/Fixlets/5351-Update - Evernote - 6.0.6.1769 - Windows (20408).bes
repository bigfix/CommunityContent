<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update - Evernote - 6.0.6.1769 - Windows</Title>
    <Description>This fixlet is for Update - Evernote - 6.0.6.1769 - Windows and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(windows of operating system) and (version of operating system >= "5.1") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of drive of client > 100435840 * 2) and (exists regapp ("Evernote.exe") whose (version of it < "6.0.6.1769" as version))]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceID>!FixletID!</SourceID>
    <SourceReleaseDate>2016-01-01</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:40:05 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//Comment

prefetch B71960357BFB3F894789AD420DADB97673CFFF86 sha1:B71960357BFB3F894789AD420DADB97673CFFF86 size:100435840 https://cdn1.evernote.com/win6/public/Evernote_6.0.6.1769.exe sha256:700DB91D03189244FFBFCFABCB034BEE7C900B97601B158603858DE1E4F6B827

parameter "baseFolder" =  "__Download/"

delete "{parameter "baseFolder"}Evernote.exe"
move "__Download/B71960357BFB3F894789AD420DADB97673CFFF86" "{parameter "baseFolder"}Evernote.exe"

parameter "logFolder" = "{parent folder of client folder of current site | data folder of client}/__Global/PGWLogs"
folder create "{parameter "logFolder"}"
parameter "logFile" = "PGW.log"

delete __createfile
delete run.bat

createfile until _end_
@ECHO OFF
cd "{parameter "baseFolder"}"
mkdir "{parameter "logFolder"}"

echo %DATE:~10,4%_%DATE:~4,2%_%DATE:~7,2% %time% - Action ID: {id of active action as string | "Debugger" as string} - Evernote >> "{parameter "logFolder"}/{parameter "logFile"}"

start /wait "Evernote" "Evernote.exe" /qn >> "{parameter "logFolder"}/{parameter "logFile"}" 2>&1

cmd.exe /c timeout 8

echo Return code: %errorlevel% >> "{parameter "logFolder"}/{parameter "logFile"}"
echo. >> "{parameter "logFolder"}/{parameter "logFile"}"

_end_

move __createfile run.bat

override wait
hidden=true
completion=job
wait run.bat]]></ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
