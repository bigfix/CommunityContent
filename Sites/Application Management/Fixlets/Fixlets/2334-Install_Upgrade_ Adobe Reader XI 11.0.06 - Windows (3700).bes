//wait __Download\AdbeRdr_en_US.exe /sAll /l /msi /qn /norestart DISABLE_ARM_SERVICE_INSTALL=1 DISABLE_AIR_SHARE=YES SUPPRESS_APP_LAUNCH=YES EULA_ACCEPT=YES AgreeToLicense=Yes ALLUSERS=1

