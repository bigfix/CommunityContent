    <Action ID="Action3996">
      <Description>
        <PreLink></PreLink>
        <Link>Install/upgrade</Link>
        <PostLink>&amp;nbsp;regardless of whether or not Reader is currently running.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//close any running instance of Reader
if {exists running application whose (name of it as lowercase = "acrord32.exe")}
	waithidden taskkill /F /T /IM acrord32.exe
	pause while {exists running application "acrord32.exe"}
endif

//download the Adobe Reader installer
prefetch AdbeRdr_en_US.exe sha1:6a3d5b494b4ed6e11fc7d917afc03eaf05d4a6aa size:50837888 http://ardownload.adobe.com/pub/adobe/reader/win/11.x/11.0.06/en_US/AdbeRdr11006_en_US.exe

//uninstall previous version of Adobe Reader
if  { exists key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{AC76BA86-7AD7-1033-7B44-AB0000000001}}" of registry }
    wait "{pathname of system folder & "\msiexec.exe"}" /x "{{AC76BA86-7AD7-1033-7B44-AB0000000001}" /qn /norestart
endif

// *** BEGIN INSTALL OPTIONS
// The default installation is to install Adobe Reader WITHOUT a desktop shortcut.
// To install with a desktop shortcut:
//  - Take the normal action you want to take (e.g., Install/Upgrade, Install/Upgrade if not running, etc.)
//  - Select the "Action Script" tab
//  - Select "Use the following action script"
//  - UNCOMMENT line 28
//  - COMMENT line 31

//install Adobe Reader WITH a desktop shortcut
//wait __Download\AdbeRdr_en_US.exe /sAll /l /msi /qn /norestart EULA_ACCEPT=YES DISABLE_AIR_SHARE=YES SUPPRESS_APP_LAUNCH=YES AgreeToLicense=Yes ALLUSERS=1

//to install Adobe Reader WITHOUT a desktop shortcut
wait __Download\AdbeRdr_en_US.exe /sAll /l /msi /qn /norestart EULA_ACCEPT=YES DISABLE_AIR_SHARE=YES SUPPRESS_APP_LAUNCH=YES AgreeToLicense=Yes ALLUSERS=1 DISABLEDESKTOPSHORTCUT=1 /L*v C:\Windows\Temp\software_reader.log

