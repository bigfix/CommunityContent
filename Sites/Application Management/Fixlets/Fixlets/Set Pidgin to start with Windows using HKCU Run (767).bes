  Imported : 2012-12-06T21:21:19
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Set Pidgin to start with Windows using HKCU Run</Title>
    <Description>This action will&amp;nbsp;set Pidgin to start with Windows using HKCU so that a user can unset it if desired using the Pidgin UI (through a &quot;Windows Pidgin Options&quot; plugin) </Description>
    <Relevance>(name of it = &quot;WinXP&quot; OR name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND NOT x64 of it) OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND NOT x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance>exists current user AND (1 = number of logged on users)</Relevance>
    <Relevance>exists keys whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Pidgin&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>exists value &quot;DisplayIcon&quot; whose (it as string as lowercase contains &quot;pidgin.exe&quot; as lowercase) of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Pidgin&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry</Relevance>
    <Relevance>not exists value &quot;Pidgin&quot; of key &quot;Software\Microsoft\Windows\CurrentVersion\Run&quot; of (key whose (((it = name of current user as lowercase OR it starts with name of current user as lowercase &amp; &quot;@&quot;) of (it as string as lowercase) of (if (name of operating system = &quot;Win7&quot;) then value &quot;USERNAME&quot; of key &quot;Volatile Environment&quot; of it else value &quot;Logon User Name&quot; of key &quot;Software\Microsoft\Windows\CurrentVersion\Explorer&quot; of it))) of key &quot;HKEY_USERS&quot; of registry)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2011-09-21</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 07 Dec 2012 03:21:37 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">regset64 &quot;[{(&quot;HKEY_USERS\&quot; &amp; (name of key whose (((it = name of current user as lowercase OR it starts with name of current user as lowercase &amp; &quot;@&quot;) of (it as string as lowercase) of (if (name of operating system = &quot;Win7&quot;) then value &quot;USERNAME&quot; of key &quot;Volatile Environment&quot; of it else value &quot;Logon User Name&quot; of key &quot;Software\Microsoft\Windows\CurrentVersion\Explorer&quot; of it))) of key &quot;HKEY_USERS&quot; of registry) &amp; &quot;\Software\Microsoft\Windows\CurrentVersion\Run&quot; )}]&quot; &quot;Pidgin&quot;=&quot;{escapes of (value &quot;DisplayIcon&quot; whose (it as string as lowercase contains &quot;pidgin.exe&quot; as lowercase) of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;Pidgin&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry as string)}&quot;</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
