<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Deploy - Firefox - 53.0.2 - Mac</Title>
    <Description>This fixlet is for Deploy - Firefox - 53.0.2 - Mac and was generated by William Easton as part of the C3 Patch offering. Access to this content is granted for free. If you make improvements to this fixlet please share them on BigFix.Me or on the orginal content on BigFix.Me. If you have paid for access to this content or if you have issues with this fixlet please contact Strawgate on forum.bigfix.com or comment on this piece of content on BigFix.Me.</Description>
    <Relevance><![CDATA[(mac of operating system) and (version of operating system >= "10.6") and (if exists property "in proxy agent context" then ( not in proxy agent context ) else true) and (free space of filesystem of folder (pathname of client) > 58455946 * 2) and (not exists application "Firefox.app")]]></Relevance>
    <Source>C3 Patch</Source>
    <SourceReleaseDate>2017-05-15</SourceReleaseDate>
    <SourceSeverity>Unspecified</SourceSeverity>
    <CVENames>Unspecified</CVENames>
    <MIMEField>
      <Name>cpe-id-v2.3</Name>
      <Value>cpe:2.3:a:mozilla:firefox:53.0.2:*:*:*:*:*:*:*</Value>
    </MIMEField>
    <MIMEField>
      <Name>cpe-id-v2.2</Name>
      <Value>cpe:/a:mozilla:firefox:53.0.2</Value>
    </MIMEField>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:38:17 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch CE3EE282E5DCDD6B50E65304349F15ECBC675374.dmg sha1:CE3EE282E5DCDD6B50E65304349F15ECBC675374 size:58455946 https://download.mozilla.org/?product=firefox-53.0.2-SSL&os=osx&lang=en-US sha256:180AE12E65FB2C8025FFAD501D998DC01DBE19408B528C78A05A163F0FA0B5BE

delete "/tmp/CE3EE282E5DCDD6B50E65304349F15ECBC675374.dmg"

move "__Download/CE3EE282E5DCDD6B50E65304349F15ECBC675374.dmg" "/tmp/CE3EE282E5DCDD6B50E65304349F15ECBC675374.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPTCE3EE282E5DCDD6B50E65304349F15ECBC675374" "/tmp/CE3EE282E5DCDD6B50E65304349F15ECBC675374.dmg"

wait sh -c "rm /tmp/CE3EE282E5DCDD6B50E65304349F15ECBC675374.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPTCE3EE282E5DCDD6B50E65304349F15ECBC675374/. /tmp/BESTEMPCE3EE282E5DCDD6B50E65304349F15ECBC675374"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPTCE3EE282E5DCDD6B50E65304349F15ECBC675374 | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMPCE3EE282E5DCDD6B50E65304349F15ECBC675374/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMPCE3EE282E5DCDD6B50E65304349F15ECBC675374'"
]]></ActionScript>
    </DefaultAction>
  </Fixlet>
