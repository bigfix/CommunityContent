      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 14C8DE98C24C2DA4A09149C9E0EA42D85825A629.dmg sha1:14C8DE98C24C2DA4A09149C9E0EA42D85825A629 size:55592658 https://download.mozilla.org/?product=firefox-latest-ssl&os=osx&lang=en-US sha256:C833D8E65490A7CF87E8A66AD037B8590C036AEBC39E1B01757D9B9D830D3402

delete "/tmp/14C8DE98C24C2DA4A09149C9E0EA42D85825A629.dmg"

move "__Download/14C8DE98C24C2DA4A09149C9E0EA42D85825A629.dmg" "/tmp/14C8DE98C24C2DA4A09149C9E0EA42D85825A629.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPT14C8DE98C24C2DA4A09149C9E0EA42D85825A629" "/tmp/14C8DE98C24C2DA4A09149C9E0EA42D85825A629.dmg"

wait sh -c "rm /tmp/14C8DE98C24C2DA4A09149C9E0EA42D85825A629.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPT14C8DE98C24C2DA4A09149C9E0EA42D85825A629/. /tmp/BESTEMP14C8DE98C24C2DA4A09149C9E0EA42D85825A629"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPT14C8DE98C24C2DA4A09149C9E0EA42D85825A629 | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMP14C8DE98C24C2DA4A09149C9E0EA42D85825A629/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMP14C8DE98C24C2DA4A09149C9E0EA42D85825A629'"
