<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Task Export
  
  Title    : Remove Java Update Scheduler from x64 Registry
  ID       : 764
  Author   : jgstew
  Domain   : BESC
  Imported : 2012-12-06T21:13:03
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Remove Java Update Scheduler from x64 Registry</Title>
    <Description>&amp;lt;enter a description of the task here&amp;gt; </Description>
    <Relevance>(name of it = &quot;WinXP-2003&quot; OR (name of it = &quot;WinVista&quot; AND product type of it = nt workstation product type AND x64 of it) OR (name of it = &quot;Win7&quot; AND x64 of it)) of operating system</Relevance>
    <Relevance>exists value &quot;SunJavaUpdateSched&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Run&quot; of x64 registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2011-11-14</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 15 Nov 2011 22:16:02 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">regdelete64 &quot;[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Run]&quot; &quot;SunJavaUpdateSched&quot;</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
