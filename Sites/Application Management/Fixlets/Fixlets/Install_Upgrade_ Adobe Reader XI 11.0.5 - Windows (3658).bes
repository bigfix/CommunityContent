<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Upgrade: Adobe Reader XI 11.0.5 - Windows</Title>
    <Description><![CDATA[<P><STRONG><FONT size=3>About Adobe Reader</FONT></STRONG></P>
<BLOCKQUOTE style="MARGIN-RIGHT: 0px" dir=ltr>
<P>Adobe Reader&nbsp;is an&nbsp;application developed by Adobe Systems to view and&nbsp;print files in portable document format (PDF). Adobe's solution for creating and manipulating PDF files is Adobe Acrobat Professional, which requires a license.</P></BLOCKQUOTE>
<P><FONT color=#0080ff size=3><STRONG>Licensing</STRONG></FONT></P>
<BLOCKQUOTE style="MARGIN-RIGHT: 0px" dir=ltr>
<P>Adobe Reader is freeware.</P></BLOCKQUOTE><STRONG>
<P><FONT size=3>About This Task</FONT></P></STRONG>
<BLOCKQUOTE>This task will install/upgrade: Adobe Reader XI 11.0.5<BR><BR>This task is applicable on: Windows XP and higher (32-bit and 64-bit)</BLOCKQUOTE>
<P><FONT size=3><STRONG>Action Description</STRONG></FONT></P>
<UL><FONT size=2>
<LI><FONT size=2><STRONG>Action1: Install/upgrade.</STRONG></FONT></LI></UL>
<BLOCKQUOTE style="MARGIN-RIGHT: 0px" dir=ltr>
<P><FONT size=2>This action installs Reader.</FONT></P></BLOCKQUOTE></FONT>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance><![CDATA[not exists key whose (value "DisplayName" of it as string contains "Adobe Reader" AND (it >= "11.0.05" as version) of (value "DisplayVersion" of it as string as version)) of key "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of x32 registry]]></Relevance>
    <Category>Software Sharing</Category>
    <SourceID>jgs194</SourceID>
    <SourceReleaseDate>2013-11-27</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-source</Name>
      <Value>Software Distribution Wizard</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 27 Nov 2013 20:00:41 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Action ID="Action3935">
      <Description>
        <PreLink></PreLink>
        <Link>Install/upgrade</Link>
        <PostLink>.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[//download the Adobe Reader installer
prefetch AdbeRdr_en_US.exe sha1:9c295c16d374735bf292ef6c630c9ab392c22500 size:50573696 http://ardownload.adobe.com/pub/adobe/reader/win/11.x/11.0.04/en_US/AdbeRdr11004_en_US.exe

//Adobe Reader XI 11.0.05 is a security update, i.e., no full installer
prefetch AdbeRdrSecUpd11005.msp sha1:6117f8b7545966b4b57fad13bf9636ca329139c8 size:2682880 http://ardownload.adobe.com/pub/adobe/reader/win/11.x/11.0.05/misc/AdbeRdrSecUpd11005.msp

// The following should not be needed as the installer should do this by default
//uninstall previous version of Adobe Reader
//if  { exists key "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{AC76BA86-7AD7-1033-7B44-AB0000000001}}" of registry }
//    wait "{pathname of system folder & "\msiexec.exe"}" /x "{{AC76BA86-7AD7-1033-7B44-AB0000000001}" /qn /norestart
//endif

// http://www.adobe.com/devnet-docs/acrobatetk/tools/AdminGuide/basics.html#expanding-exe-packages
// Extract the EXE to access the installer files directly - this will delete/overwrite files in the target directory
wait __Download\AdbeRdr_en_US.exe -sfx_o"{(pathname of client folder of current site)}\__Download\AdbeRdr_en_US" -sfx_ne

delete __Download\AdbeRdr_en_US\AdbeRdrSecUpd11005.msp
move __Download\AdbeRdrSecUpd11005.msp __Download\AdbeRdr_en_US\AdbeRdrSecUpd11005.msp

// create a setup.ini file to install both 11.0.4 and 11.0.5 at the same time. (chainloading)
delete setup.ini
delete __createfile
createfile until endCreateFile
[Startup]
RequireMSI=3.0

[Product]
msi=AcroRead.msi
PATCH=AdbeRdrUpd11004.msp;AdbeRdrSecUpd11005.msp

[MSI Updater]
Path=http://ardownload.adobe.com/pub/adobe/reader/win/8.x/8.0/misc/WindowsInstaller-KB893803-v2-x86.exe
endCreateFile

move __createfile setup.ini

// http://www.adobe.com/devnet-docs/acrobatetk/tools/AdminGuide/properties.html
// http://www.adobe.com/devnet-docs/acrobatetk/tools/AdminGuide/bootstrapper.html
// Setup.exe installation option effects.
//   /sAll                           --> Run installer in silent mode.
//   /rs                             --> Reboot Suppress. Setup.exe will not initiate reboot even if it is required.
//   /l                              --> Enable Logging
//   /ini "path\to\file.ini"         -->
//   DISABLE_ARM_SERVICE_INSTALL=1   --> Do not install updater service
//   EULA_ACCEPT=YES                 --> Accept the EULA to bypass it on first launch
//   DISABLE_AIR_SHARE=YES           --> Do not install AdobeAIR
//   SUPPRESS_APP_LAUNCH=YES         --> Do not launch Reader after installation
//   AgreeToLicense=Yes              --> ???? not sure what this does, if anything
//   ALLUSERS=1                      --> Install for all users
//   DISABLEDESKTOPSHORTCUT=1        --> Do not create desktop shortcut
//   DISABLE_CACHE=1                 --> Do not cache installer files
//   /msi /qn /norestart             --> pass "/qn /norestart" along to MSI, this may be redundant with "/rs" above
wait __Download\AdbeRdr_en_US\setup.exe /sAll /rs /l /ini "{(pathname of client folder of current site)}\setup.ini" DISABLE_ARM_SERVICE_INSTALL=1 EULA_ACCEPT=YES DISABLE_AIR_SHARE=YES SUPPRESS_APP_LAUNCH=YES AgreeToLicense=Yes ALLUSERS=1 DISABLEDESKTOPSHORTCUT=1 DISABLE_CACHE=1 /msi /qn /norestart
]]></ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </Action>
  </Fixlet>
</BES>
