<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Uninstall - RES ONE Workspace Relay - Windows</Title>
    <Description><![CDATA[<P>Removes an installed RES ONE Workspace Relay.</P>
<P>This simply runs a standard uninstall and does not perform any additional cleanup.</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists service &quot;RESRLS&quot;</Relevance>
    <Relevance>exists (value &quot;UninstallString&quot; of key whose (value &quot;DisplayName&quot; of it as string starts with &quot;RES ONE Workspace&quot; and value &quot;DisplayName&quot; of it as string ends with &quot;Relay Server&quot;) of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry as string)</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2016-12-05</SourceReleaseDate>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 21:42:52 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">// Source Release Date: 2016-12-05

// Enter your action script here
wait {preceding text of first &quot;%00&quot; of (value &quot;UninstallString&quot; of key whose (value &quot;DisplayName&quot; of it as string starts with &quot;RES ONE Workspace&quot; and value &quot;DisplayName&quot; of it as string ends with &quot;Relay Server&quot;) of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry as string)} /qn
</ActionScript>
    </DefaultAction>
  </Fixlet>
</BES>
