    <Domain>BESC</Domain>
    <Action ID="Action23926">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[// Source Release Date: 2016-12-05
// action log all

// If your action dies here you did not select an authentication method!
continue if {parameter "dbAuthMethod" of action != "Select an Authentication Type"}

if {parameter "dbAuthMethod" of action = "Relay"}
	if {parameter "rlParent" of action = "Current BigFix Relay"}
		parameter "ParentRelay"="{(preceding text of last "." of name of selected server as lowercase) & ":" & parameter "RESRELPORT" of action}"
	else
		parameter "ParentRelay"="{parameter "rlParent" of action}"
	endif
else
	parameter "ParentRelay"=""
endif

delete __createfile
delete relayconfig.xml
delete relayconfigu.xml

createfile until _done_
<?xml version="1.0" encoding="UTF-16"?>
<relayserver>
  <environments>
    <environment guid="{(parameter "RESEnvGUID" of action)}">
      <enabled>yes</enabled>
      <environmentname>{parameter "dbName" of action}@{parameter "dbServer" of action}</environmentname>
      <local>
        <providertype>0</providertype>
        <cachelocation>{value of variable "ALLUSERSPROFILE" of environment & "\RES\Relay Server"}</cachelocation>
      </local>
      <remote>
        <providertype>3</providertype>
        <addresslist>{parameter "ParentRelay"}</addresslist>
        <password encrypted="yes">{parameter "RESEnvPwdHash" of action}</password>
        <storefipsencrypted>yes</storefipsencrypted>
      </remote>
    </environment>
  </environments>
  <port>{parameter "RESRELPORT" of action}</port>
</relayserver>
_done_

move __createfile relayconfig.xml

wait CMD /U /C Type "relayconfig.xml" >> "relayconfigu.xml"

wait "{pathname of file of service "resrls"}" /configfile="{pathname of client folder of current site}\relayconfigu.xml" /silent

notify client forcerefresh
]]></ActionScript>
    </Action>
  </Fixlet>
</BES>
