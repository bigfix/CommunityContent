<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Install/Upgrade: Suspicious Package v2.0.1 - Mac OS X</Title>
    <Description><![CDATA[<P>This will install Suspicious Package v2.0.1</P>
<P>&nbsp;</P>]]></Description>
    <Relevance>mac of operating system</Relevance>
    <Relevance><![CDATA[system version >= "10.8"]]></Relevance>
    <Relevance><![CDATA[not exists strings "CFBundleShortVersionString" whose(it as version >= "2.0.1") of dictionaries of files "/Library/QuickLook/Suspicious Package.qlgenerator/Contents/Info.plist"]]></Relevance>
    <Category>Software Sharing</Category>
    <Source>Internal</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2015-03-26</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Thu, 09 Apr 2015 17:47:49 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
// http://www.mothersruin.com/software/SuspiciousPackage/download.html
prefetch SuspiciousPackage.pkg sha1:036b24c18e6318731d62446906431d27b3910b57 size:235765 http://www.mothersruin.com/software/downloads/SuspiciousPackage.pkg

wait /usr/sbin/installer -pkg &quot;__Download/SuspiciousPackage.pkg&quot; -target /
</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Fixlet>
</BES>
