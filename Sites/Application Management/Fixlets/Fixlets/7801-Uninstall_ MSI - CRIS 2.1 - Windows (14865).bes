<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Uninstall: MSI - CRIS 2.1 - Windows</Title>
    <Description><![CDATA[<P>This task will uninstall the MSI: CRIS 2.1</P><P>This task was automatically generated using the task: "RESTAPI: Generate uninstall tasks for all MSI applications on target computer - Windows"</P><P>&nbsp;</P>]]></Description>
    <Relevance><![CDATA[/* Windows XP or later */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance>/* Only run if CRIS 2.1 is installed */ 1 = number of keys whose( (exists values &quot;DisplayName&quot; whose(it as string as lowercase starts with &quot;CRIS 2.1&quot; as lowercase) of it) AND (exists values whose(it as string as lowercase starts with &quot;msiexec&quot;) of it) ) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of ( x64 registries; x32 registries )</Relevance>
    <Category>Software Sharing</Category>
    <Source>RESTAPI: Generate uninstall tasks for all MSI applications on target computer - Windows</Source>
    <SourceID>jgstew</SourceID>
    <SourceReleaseDate>2016-04-20</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 20 Apr 2016 22:50:18 -070 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to uninstall CRIS 2.1</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">waithidden msiexec.exe /X { name of keys whose( (exists values &quot;DisplayName&quot; whose(it as string as lowercase starts with &quot;CRIS 2.1&quot; as lowercase) of it) AND (exists values whose(it as string as lowercase starts with &quot;msiexec&quot;) of it) ) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of ( x64 registries; x32 registries ) } /qn</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
