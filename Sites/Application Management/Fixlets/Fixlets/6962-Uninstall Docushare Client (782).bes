<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Uninstall Docushare Client</Title>
    <Description><![CDATA[&lt;enter a description of the task here&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;DocuShare Client&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry</Relevance>
    <Source>Internal</Source>
    <SourceReleaseDate>2012-03-14</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 14 Mar 2012 21:19:47 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">Wait msiexec.exe /X {name of key whose (value &quot;DisplayName&quot; of it as string as lowercase contains &quot;DocuShare Client&quot; as lowercase) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry} /qn /norestart</ActionScript>
      <SuccessCriteria Option="OriginalRelevance"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
