    <Action ID="Action3996">
      <Description>
        <PreLink></PreLink>
        <Link>Install/upgrade</Link>
        <PostLink>&amp;nbsp;regardless of whether or not Reader is currently running.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">//close any running instance of Reader
if {exists running application whose (name of it as lowercase = &quot;acrord32.exe&quot;)}
	waithidden taskkill /F /T /IM acrord32.exe
	pause while {exists running application &quot;acrord32.exe&quot;}
endif

//download the Adobe Reader installer
prefetch AdbeRdr_en_US.exe sha1:6a3d5b494b4ed6e11fc7d917afc03eaf05d4a6aa size:50837888 http://ardownload.adobe.com/pub/adobe/reader/win/11.x/11.0.06/en_US/AdbeRdr11006_en_US.exe

//uninstall previous version of Adobe Reader
if  { exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{AC76BA86-7AD7-1033-7B44-AB0000000001}}&quot; of registry }
    wait &quot;{pathname of system folder &amp; &quot;\msiexec.exe&quot;}&quot; /x &quot;{{AC76BA86-7AD7-1033-7B44-AB0000000001}&quot; /qn /norestart
endif

// *** BEGIN INSTALL OPTIONS
