<!--
  BigFix Task Export

  Title    : Deploy RES ONE Workspace Agent for Windows
  ID       : 10562
  Author   : RESQA
  Domain   : BESC
  Imported : 2016-03-24T05:00:48
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Task>
    <Title>Deploy RES ONE Workspace Agent for Windows</Title>
    <Description><![CDATA[<P>This task will install the RES ONE Workspace&nbsp;Agent to Windows Endpoints.</P>
      <script>
      document.body.ontakeaction = function() {
var dbserver = EvaluateRelevance('(if (exists shared variable "dbserver" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) then (shared variable "dbserver" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) else (""))');

var resid = EvaluateRelevance('(if (exists shared variable "resid" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) then (shared variable "resid" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) else (""))');
var respw = EvaluateRelevance('(if (exists shared variable "respw_hash" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) then (shared variable "respw_hash" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) else (""))');
var ressa = EvaluateRelevance('(if (exists shared variable "ressa" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) then (shared variable "ressa" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) else (""))');
var ressapwd = EvaluateRelevance('(if (exists shared variable "ressapwd" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) then (shared variable "ressapwd" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) else (""))');
var resrelport = EvaluateRelevance('(if (exists shared variable "resrelport" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) then (shared variable "resrelport" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) else (""))');
var inherit= EvaluateRelevance('(if (exists shared variable "inherit" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) then (shared variable "inherit" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) else ("no"))');
var DNSname= EvaluateRelevance('(if (exists shared variable "DNSname" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) then (shared variable "DNSname" of bes wizards whose (dashboard id of it = "RESDeploymentWizard.ojo")) else (""))');

	TakeSecureFixletAction( Relevance('id of current fixlet'), Relevance('(if (exists id of current bes site) then (id of current bes site) else (id of bes site whose (name of it is "ActionSite")))'), "Action1",{ WMserver: dbserver, GUID: resid, serviceaccount: ressa, secret: ressapwd, RESRELPORT: resrelport,INHERIT:inherit, DNSNAME:DNSname }, { RESPW: respw });
	return false;
}
      </script>
    ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[version of client >= "9.0"]]></Relevance>
    <Relevance>not exists service &quot;RESPESVC&quot;</Relevance>
    <Source>RES Software</Source>
    <SourceReleaseDate>2016-03-21</SourceReleaseDate>
    <MIMEField>
      <Name>bigfixme-added-time</Name>
      <Value>Fri, 06 Dec 2013 04:16:50 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-modification-time</Name>
      <Value>Fri, 06 Dec 2013 04:16:50 GMT</Value>
    </MIMEField>
    <MIMEField>
      <Name>bigfixme-keywords</Name>
      <Value>user, net.exe, secure parameter, password</Value>
    </MIMEField>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 01 Dec 2015 10:32:12 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink></PreLink>
        <Link>Deploy</Link>
        <PostLink>&amp;nbsp;this action</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell">
        prefetch RESWMAgent.msi sha1:29166d1c2cfe9c9c5cdefef5fd85c49b550d0863 size:35611648 http://downloads.ressoftware.com/downloads/cdm/040116/RES-ONE-Workspace-2015-Agent-SR1.msi

        action parameter query &quot;WMserver&quot; with description &quot;Please enter the SQL Server Name (BigFixServer)&quot;
        action parameter query &quot;GUID&quot; with description &quot;Please enter the RES Environment ID. DO NOT INCLUDE CURLY BRACES {}(WM Console/Administration/Relay Servers/Settings)&quot;
        action parameter query &quot;serviceaccount&quot; with description &quot;Please enter the RES Service Account (domain\res.service)&quot;
        action parameter query &quot;secret&quot; with description &quot;Please enter the password for RES Service Account&quot;

        If {(parameter &quot;DNSNAME&quot; of action) != &quot;&quot;}
        wait msiexec /i __Download\RESWMAgent.msi RSENVGUID={(parameter &quot;GUID&quot; of action)} RSPASSWORD={parameter &quot;RESPW&quot; of action} RSPWHASHED=Yes RSDISCOVER=No RSLIST={preceding text of first &quot;:&quot; of (if ((it does not contain &quot;127.0.0.1&quot; and it does not contain &quot;::1&quot;) of name of registration server) then (name of registration server) else if (exists setting &quot;_BESRelay_PostResults_ParentRelayURL&quot; of client and exists value of setting &quot;_BESRelay_PostResults_ParentRelayURL&quot; of client as string) then (preceding text of first &quot;/&quot; of (following text of first &quot;//&quot; of (value of setting &quot;_BESRelay_PostResults_ParentRelayURL&quot; of client))) else &quot;BES Root Server&quot;)}:{parameter &quot;RESRELPORT&quot; of action} RSRESOLVE={parameter &quot;DNSNAME&quot; of action} INHERITSETTINGS={parameter &quot;INHERIT&quot; of action} /qn
        else
        wait msiexec /i __Download\RESWMAgent.msi RSENVGUID={(parameter &quot;GUID&quot; of action)} RSPASSWORD={parameter &quot;RESPW&quot; of action} RSPWHASHED=Yes RSDISCOVER=No RSLIST={preceding text of first &quot;:&quot; of (if ((it does not contain &quot;127.0.0.1&quot; and it does not contain &quot;::1&quot;) of name of registration server) then (name of registration server) else if (exists setting &quot;_BESRelay_PostResults_ParentRelayURL&quot; of client and exists value of setting &quot;_BESRelay_PostResults_ParentRelayURL&quot; of client as string) then (preceding text of first &quot;/&quot; of (following text of first &quot;//&quot; of (value of setting &quot;_BESRelay_PostResults_ParentRelayURL&quot; of client))) else &quot;BES Root Server&quot;)}:{parameter &quot;RESRELPORT&quot; of action} INHERITSETTINGS={parameter &quot;INHERIT&quot; of action} /qn
        endif
</ActionScript>
      <SuccessCriteria Option="RunToCompletion"></SuccessCriteria>
    </DefaultAction>
  </Task>
</BES>
