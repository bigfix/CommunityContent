    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to deploy this action.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 2F8C75552AB72A19AED8E035370B6B2C45C24FC2.dmg sha1:2F8C75552AB72A19AED8E035370B6B2C45C24FC2 size:86316466 https://download.mozilla.org/?product=firefox-50.0.2-SSL&os=osx&lang=en-US sha256:821E227A9FDDE4D9F0B05E936ABFB445CEF36E98C22DF1794027E60F8A502B0D

delete "/tmp/2F8C75552AB72A19AED8E035370B6B2C45C24FC2.dmg"

move "__Download/2F8C75552AB72A19AED8E035370B6B2C45C24FC2.dmg" "/tmp/2F8C75552AB72A19AED8E035370B6B2C45C24FC2.dmg"

wait hdiutil attach -quiet -noautoopen -nobrowse -private -mountpoint "/tmp/BESMNTPT2F8C75552AB72A19AED8E035370B6B2C45C24FC2" "/tmp/2F8C75552AB72A19AED8E035370B6B2C45C24FC2.dmg"

wait sh -c "rm /tmp/2F8C75552AB72A19AED8E035370B6B2C45C24FC2.dmg"

wait sh -c "cp -Rpn /tmp/BESMNTPT2F8C75552AB72A19AED8E035370B6B2C45C24FC2/. /tmp/BESTEMP2F8C75552AB72A19AED8E035370B6B2C45C24FC2"

wait /bin/sh -c "hdiutil detach -force `mount | grep /tmp/BESMNTPT2F8C75552AB72A19AED8E035370B6B2C45C24FC2 | cut -f 1 -d \ | cut -f 3 -d / | head -1`"

wait /bin/sh -c "cp -Rp /tmp/BESTEMP2F8C75552AB72A19AED8E035370B6B2C45C24FC2/*.app /Applications"

wait sh -c "rm -rf '/tmp/BESTEMP2F8C75552AB72A19AED8E035370B6B2C45C24FC2'"
]]></ActionScript>
