<?xml version="1.0" encoding="UTF-8"?>
<!--
  BigFix Fixlet Export

  Title    : Update 7-Zip 16.02 32-bit
  ID       : 20694
  Author   : BrianCanFixIT
  Domain   : BESC
  Imported : 2016-05-25T01:11:21
  Source   : bigfixm1_main @ BES-Root
-->
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Fixlet>
    <Title>Update 7-Zip 16.02 32-bit</Title>
    <Description><![CDATA[<P>Updates 7-Zip to version 16.02.</P>

<P>Removes ALL other installations, with the choice of installing the MSI or EXE version.</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[exists key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND (if exists value "DisplayVersion" of it then value "DisplayVersion" of it as string as version else maximum of (matches (regex "([0-9]+\.[0-9]+)") of (value "DisplayName" of it as string) as version)) < "16.02") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registry)]]></Relevance>
    <Category>Security Update</Category>
    <SourceReleaseDate>2016-05-23</SourceReleaseDate>
    <SourceSeverity>Important</SourceSeverity>
    <MIMEField>
    	<Name>x-fixlet-modification-time</Name>
    	<Value>Thu, 17 Sep 2026 04:04:04 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to remove the EXE version and update the MSI version.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 7z1602.msi sha1:03b0c377302d7b876eb1cf531f4b6ba5a3f79c33 size:1277440 http://www.7-zip.org/a/7z1602.msi sha256:547c24748705ad4b6e3f3944f38d0416c5cdd2de6ebe3d65a1840bd2b82519a4




// Remove the 32-bit EXE version

if {exists key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND value "UninstallString" of it as string as lowercase contains "uninstall") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registry)}

waithidden {value "UninstallString" of key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND value "UninstallString" of it as string as lowercase contains "uninstall") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registry)} /S

endif



// Remove the 32-bit MSI versions

if {exists key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND name of it starts with "{") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registry)}

delete __createfile

delete uninstall.bat

createfile until _end_

{ concatenations "%0d%0a" of ((pathname of system folder & "\msiexec.exe /X ")  & (preceding text of last "}}" of it) & "}} /quiet /norestart") of names of keys whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND name of it starts with "{") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registry) }

_end_

move __createfile uninstall.bat

waithidden uninstall.bat

endif



// Install

waithidden "{pathname of system folder & "\msiexec.exe"}" /i "{(pathname of client folder of current site) & "\__Download\7z1602.msi"}" /qn /QN REBOOT=ReallySuppress

parameter "Exitcode" = "{if exist exit code of action then exit code of action as string else "0"}"

if {parameter "Exitcode" != "0"}

	action requires restart 03b0c377302d7b876eb1cf531f4b6ba5a3f79c33

endif

exit {parameter "Exitcode"}

]]></ActionScript>
    </DefaultAction>
    <Action ID="Action21565">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to remove the MSI version and update the EXE version.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[prefetch 7z1602.exe sha1:a86f0726019ca84d1de1b036033d888d4538b2a9 size:1106469 http://www.7-zip.org/a/7z1602.exe sha256:629ce3c424bd884e74aed6b7d87d8f0d75274fb87143b8d6360c5eec41d5f865




// Remove the 32-bit MSI versions

if {exists key whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND name of it starts with "{") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registry)}

delete __createfile

delete uninstall.bat

createfile until _end_

{ concatenations "%0d%0a" of ((pathname of system folder & "\msiexec.exe /X ")  & (preceding text of last "}}" of it) & "}} /quiet /norestart") of names of keys whose (value "DisplayName" of it as string as lowercase contains "7-zip" AND name of it starts with "{") of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall" of (x32 registry) }

_end_

move __createfile uninstall.bat

waithidden uninstall.bat

endif



// Install

waithidden "__Download\7z1602.exe" /S

action requires restart a86f0726019ca84d1de1b036033d888d4538b2a9]]></ActionScript>
    </Action>
  </Fixlet>
</BES>
