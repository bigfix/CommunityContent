<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Application Usage - Adobe - Windows</Title>
    <Description><![CDATA[<P>This analysis provides information on the usage of Adobe applications.</P>
<P>For general information or to report issues with C3 Application Usage content please visit GitHub here: <A href="https://github.com/strawgate/C3-Application-Usage">https://github.com/strawgate/C3-Application-Usage</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists file &quot;AppUsage.xml&quot; of folder &quot;C3AppUsage&quot; of folder &quot;__Global&quot; of data folder of client</Relevance>
    <Relevance>exists selects &quot;/Usage/Applications&quot; of xml document of file &quot;AppUsage.xml&quot; of folder &quot;C3AppUsage&quot; of folder &quot;__Global&quot; of data folder of client</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Application Last Usage - Adobe Acrobat - Windows" EvaluationPeriod="P1D">maximum of (select &quot;Date&quot; of it as text as date &amp; (select &quot;Time&quot; of it as text as time_of_day &amp; local time zone)) of selects &quot;/Usage/Applications/App[Exe = &apos;ACROBAT.EXE&apos;]&quot; of xml document of file &quot;AppUsage.xml&quot; of folder &quot;C3AppUsage&quot; of folder &quot;__Global&quot; of data folder of client | error &quot;none&quot;</Property>
