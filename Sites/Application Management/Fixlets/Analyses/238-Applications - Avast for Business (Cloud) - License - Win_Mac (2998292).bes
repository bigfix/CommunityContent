<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Applications - Avast for Business (Cloud) - License - Win\Mac</Title>
    <Description><![CDATA[<P>Provides information on the current licensing state for the Avast for Business (Cloud) client on the device.</P>
<P>For general information or to report issues with C3 Protect content please visit GitHub here: <A href="https://github.com/strawgate/C3-Protect">https://github.com/strawgate/C3-Protect</A></P>]]></Description>
    <Relevance>NOT in proxy agent context</Relevance>
    <Relevance><![CDATA[windows of operating system and version of operating system >= "5.1" /* Supports >WinXP */ or mac of operating system and version of operating system >= "10.6" /* Supports > Snow Leopard */]]></Relevance>
    <Relevance>if (mac of operating system) then (exists &quot;/Applications/Avast.app&quot; and exists folder &quot;/Library/Application Support/Avast/config/bcc&quot;) else (exists (keys of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of x32 registry) whose (value &quot;DisplayName&quot; of it as string starts with &quot;Avast Business Security&quot;)) /* Is Avast Installed? */</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Avast for Business (Cloud) - License - Win\Mac" EvaluationPeriod="P1D">following text of first &quot; = &quot; of (line containing (&quot;# &quot; &amp; (key &quot;LicenseType&quot; of section &quot;Certificate0&quot; of it)) of (if (windows of operating system) then (file &quot;license.avastlic&quot; of folder (value &quot;DataFolder&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\AVAST Software\Avast&quot; of x32 registry as string)) else (file &quot;license.avastlic&quot; of folder &quot;/Library/Application Support/Avast/Config&quot;)))</Property>
    <Property ID="2" Name="Avast for Business (Cloud) - Customer Name - Win\Mac" EvaluationPeriod="P1D">(key &quot;CustomerName&quot; of section &quot;Certificates&quot; of (if (windows of operating system) then (file &quot;license.avastlic&quot; of folder (value &quot;DataFolder&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\AVAST Software\Avast&quot; of x32 registry as string)) else (file &quot;license.avastlic&quot; of folder &quot;/Library/Application Support/Avast/Config&quot;)))</Property>
    <Property ID="3" Name="Avast for Business (Cloud) - Customer Number - Win\Mac" EvaluationPeriod="P1D">(key &quot;CustomerNumber&quot; of section &quot;Certificates&quot; of (if (windows of operating system) then (file &quot;license.avastlic&quot; of folder (value &quot;DataFolder&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\AVAST Software\Avast&quot; of x32 registry as string)) else (file &quot;license.avastlic&quot; of folder &quot;/Library/Application Support/Avast/Config&quot;)))</Property>
  </Analysis>
</BES>
