<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Applications - 1E NightWatchman - Win\Mac</Title>
    <Description><![CDATA[<P>Provides information on the current 1E NightWatchman configuration.</P>
<P>For general information or to report issues with C3 Power Management content please visit GitHub here: <A href="https://github.com/strawgate/C3-Power-Management">https://github.com/strawgate/C3-Power-Management</A></P>]]></Description>
    <Relevance>windows of operating system or mac of operating system</Relevance>
    <Relevance>if (Windows of Operating System) then (exists key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman&quot; of native registry) else (exists file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot;)</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="NightWatchman - Version - Win\Mac" EvaluationPeriod="P1D">if (windows of operating system) then (value &quot;ProductVersion&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman&quot; of native registry)   else (version of folder &quot;/Library/Application Support/1E/NightWatchman/Agent.app&quot;)</Property>
    <Property ID="2" Name="NightWatchman - System Tray Visible - Win\Mac" EvaluationPeriod="P1D">if (windows of operating system) then (exists values &quot;SystemTray&quot; whose (it as string as uppercase = &quot;ON&quot;) of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman&quot; of native registry)  else (boolean &quot;ShowSystemTray&quot; of dictionary &quot;SysTraySettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot;)</Property>
    <Property ID="3" Name="NightWatchman - Policy Number - Windows" EvaluationPeriod="P1D">if (Windows of Operating System) then (value &quot;PolicyNumber&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\WakeUpAgt&quot; of native registries)  else nothing</Property>
    <Property ID="4" Name="NightWatchman - Disk Idle Timeout on AC - Win\Mac" EvaluationPeriod="P1D">(if (it = &quot;0&quot;) then (&quot;Disabled&quot;) else (it)) of (  if (windows of operating system) then (value &quot;DiskAC&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry as string)  else (integer &quot;DiskAC&quot; of dictionary &quot;PowerSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)  )</Property>
    <Property ID="5" Name="NightWatchman - Disk Idle Timeout on Battery - Win\Mac" EvaluationPeriod="P1D">(if (it = &quot;0&quot;) then (&quot;Disabled&quot;) else (it)) of (  if (windows of operating system) then (value &quot;DiskDC&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry as string)  else (integer &quot;DiskDC&quot; of dictionary &quot;PowerSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)  )</Property>
    <Property ID="6" Name="NightWatchman - Hibernate Timeout on AC - Win\Mac" EvaluationPeriod="P1D">(if (it = &quot;0&quot;) then (&quot;Disabled&quot;) else (it)) of (  if (windows of operating system) then (value &quot;HibernateAC&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry as string)  else (integer &quot;HibernateAC&quot; of dictionary &quot;PowerSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)  )</Property>
    <Property ID="7" Name="NightWatchman - Hibernate Timeout on Battery - Win\Mac" EvaluationPeriod="P1D">(if (it = &quot;0&quot;) then (&quot;Disabled&quot;) else (it)) of (  if (windows of operating system) then (value &quot;HibernateDC&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry as string)  else (integer &quot;HibernateDC&quot; of dictionary &quot;PowerSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)  )</Property>
    <Property ID="8" Name="NightWatchman - Monitor Timeout on AC - Win\Mac" EvaluationPeriod="P1D">(if (it = &quot;0&quot;) then (&quot;Disabled&quot;) else (it)) of (  if (windows of operating system) then (value &quot;MonitorAC&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry as string)  else (integer &quot;MonitorAC&quot; of dictionary &quot;PowerSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)  )</Property>
    <Property ID="9" Name="NightWatchman - Monitor Timeout on DC - Win\Mac" EvaluationPeriod="P1D">(if (it = &quot;0&quot;) then (&quot;Disabled&quot;) else (it)) of (  if (windows of operating system) then (value &quot;MonitorDC&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry as string)  else (integer &quot;MonitorDC&quot; of dictionary &quot;PowerSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)  )</Property>
    <Property ID="10" Name="NightWatchman - Password Wakeup - Win\Mac" EvaluationPeriod="P1D">if (windows of operating system) then (exists values &quot;PasswordOnWakeup&quot; whose (it as string = &quot;1&quot;) of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry)  else (boolean &quot;PasswordOnWakeup&quot; of dictionary &quot;PasswordOnWakeup&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)</Property>
    <Property ID="11" Name="NightWatchman - Standby Timeout on AC - Win\Mac" EvaluationPeriod="P1D">(if (it = &quot;0&quot;) then (&quot;Disabled&quot;) else (it)) of (  if (windows of operating system) then (value &quot;StandbyAC&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry as string)  else (integer &quot;StandbyAC&quot; of dictionary &quot;PowerSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)  )</Property>
    <Property ID="12" Name="NightWatchman - Standby Timeout on Battery - Win\Mac" EvaluationPeriod="P1D">(if (it = &quot;0&quot;) then (&quot;Disabled&quot;) else (it)) of (  if (windows of operating system) then (value &quot;StandbyDC&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\PowerSettings&quot; of native registry as string)  else (integer &quot;StandbyDC&quot; of dictionary &quot;PowerSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as string)  )</Property>
    <Property ID="13" Name="NightWatchman - Wakeup Agent Port - Windows" EvaluationPeriod="P1D">if (Windows of Operating System) then (value &quot;AgentTCP_Port&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\WakeUpAgt&quot; of native registries)  else nothing</Property>
    <Property ID="14" Name="NightWatchman - Service URL - Windows" EvaluationPeriod="P1D">if (Windows of Operating System) then (value &quot;ServiceUrl&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\Reporting&quot; of native registry)  else nothing</Property>
    <Property ID="15" Name="NightWatchman - Advanced Sleepless Detection - Windows" EvaluationPeriod="P1D">if (Windows of Operating System) then (exists value &quot;AdvancedSleeplessDetection&quot; whose (it as string as uppercase = &quot;ON&quot;) of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry)  else nothing</Property>
    <Property ID="16" Name="NightWatchman - Busy Process Detection - Windows" EvaluationPeriod="P1D">if (Windows of Operating System) then (exists value &quot;BusyProcessDetection&quot; whose (it as string as uppercase = &quot;ON&quot;) of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry)  else nothing</Property>
    <Property ID="17" Name="NightWatchman - Countdown Timer - Win\Mac" EvaluationPeriod="P1D">if (windows of operating system) then (value &quot;CountdownSecs&quot; of key &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman&quot; of native registry as string as integer)   else ((it as string) of integer &quot;CountdownSecs&quot; of dictionary &quot;CountdownDlgSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; )</Property>
    <Property ID="18" Name="NightWatchman - Debug Level - Windows" EvaluationPeriod="P1D">if (Windows of Operating System) then (value &quot;Debug&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry)  else nothing</Property>
    <Property ID="19" Name="NightWatchman - Log Off Action - Win\Mac" EvaluationPeriod="P1D">if (windows of operating system) then (value &quot;LogOffAction&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry as string as uppercase)  else (string &quot;LogOffAction&quot; of dictionary &quot;ShutdownSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as uppercase)</Property>
    <Property ID="20" Name="NightWatchman - Monitor SCCM Jobs - Windows" EvaluationPeriod="P1D">if (Windows of Operating System) then (value &quot;MonitorJobs&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry as string as uppercase)  else nothing</Property>
    <Property ID="21" Name="NightWatchman - Power Scheme Enforced - Windows" EvaluationPeriod="P1D">value &quot;PowerScheme&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry as string as uppercase</Property>
    <Property ID="22" Name="NightWatchman - Reporting - Win\Mac" EvaluationPeriod="P1D">if (Windows of Operating System) then (value &quot;PowerScheme&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry as string as uppercase)  else nothing</Property>
    <Property ID="23" Name="NightWatchman - Shutdown Action - Win\Mac" EvaluationPeriod="P1D">if (windows of operating system) then (value &quot;ShutdownAction&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry as string as uppercase)  else (string &quot;ShutdownAction&quot; of dictionary &quot;ShutdownSettings&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; as uppercase)</Property>
    <Property ID="24" Name="NightWatchman - Shutdown Message - Windows" EvaluationPeriod="P1D">if (Windows of Operating System) then (value &quot;ShutdownMsg&quot; of key &quot;1E\NightWatchman&quot; of key &quot;HKEY_LOCAL_MACHINE\Software&quot; of native registry) else nothing</Property>
    <Property ID="26" Name="NightWatchman - Monday Scheduled Action - Win\Mac" EvaluationPeriod="P1D">if (Windows of Operating System) then (  (item 0 of it * hour + item 1 of it * minute) of (values &quot;MondayPowerdownHour&quot; of it as string as integer, values &quot;MondayPowerdownMinutes&quot; of it as string as integer), values &quot;MondayLogoffAction&quot; of it as string as uppercase, values &quot;MondayPowerdownAction&quot; of it as string as uppercase) of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\ScheduledActions&quot; of native registry   else (  (string &quot;Time&quot; of it, string &quot;LogOff&quot; of it as uppercase, string &quot;Action&quot; of it as uppercase) of dictionaries whose (string &quot;Day&quot; of it = &quot;Monday&quot;) of values of array &quot;ScheduledActions&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; )</Property>
    <Property ID="27" Name="NightWatchman - Tuesday Scheduled Action - Win\Mac" EvaluationPeriod="P1D">if (Windows of Operating System) then (  (item 0 of it * hour + item 1 of it * minute) of (values &quot;TuesdayPowerdownHour&quot; of it as string as integer, values &quot;TuesdayPowerdownMinutes&quot; of it as string as integer), values &quot;TuesdayLogoffAction&quot; of it as string as uppercase, values &quot;TuesdayPowerdownAction&quot; of it as string as uppercase) of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\ScheduledActions&quot; of native registry   else (  (string &quot;Time&quot; of it, string &quot;LogOff&quot; of it as uppercase, string &quot;Action&quot; of it as uppercase) of dictionaries whose (string &quot;Day&quot; of it = &quot;Tuesday&quot;) of values of array &quot;ScheduledActions&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; )</Property>
    <Property ID="28" Name="NightWatchman - Wednesday Scheduled Action - Win\Mac" EvaluationPeriod="P1D">if (Windows of Operating System) then (  (item 0 of it * hour + item 1 of it * minute) of (values &quot;WednesdayPowerdownHour&quot; of it as string as integer, values &quot;WednesdayPowerdownMinutes&quot; of it as string as integer), values &quot;WednesdayLogoffAction&quot; of it as string as uppercase, values &quot;WednesdayPowerdownAction&quot; of it as string as uppercase) of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\ScheduledActions&quot; of native registry   else (  (string &quot;Time&quot; of it, string &quot;LogOff&quot; of it as uppercase, string &quot;Action&quot; of it as uppercase) of dictionaries whose (string &quot;Day&quot; of it = &quot;Wednesday&quot;) of values of array &quot;ScheduledActions&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; )</Property>
    <Property ID="29" Name="NightWatchman - Thursday Scheduled Action - Win\Mac" EvaluationPeriod="P1D">if (Windows of Operating System) then (  (item 0 of it * hour + item 1 of it * minute) of (values &quot;ThursdayPowerdownHour&quot; of it as string as integer, values &quot;ThursdayPowerdownMinutes&quot; of it as string as integer), values &quot;ThursdayLogoffAction&quot; of it as string as uppercase, values &quot;ThursdayPowerdownAction&quot; of it as string as uppercase) of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\ScheduledActions&quot; of native registry   else (  (string &quot;Time&quot; of it, string &quot;LogOff&quot; of it as uppercase, string &quot;Action&quot; of it as uppercase) of dictionaries whose (string &quot;Day&quot; of it = &quot;Thursday&quot;) of values of array &quot;ScheduledActions&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; )</Property>
    <Property ID="30" Name="NightWatchman - Friday Scheduled Action - Win\Mac" EvaluationPeriod="P1D">if (Windows of Operating System) then (  (item 0 of it * hour + item 1 of it * minute) of (values &quot;FridayPowerdownHour&quot; of it as string as integer, values &quot;FridayPowerdownMinutes&quot; of it as string as integer), values &quot;FridayLogoffAction&quot; of it as string as uppercase, values &quot;FridayPowerdownAction&quot; of it as string as uppercase) of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\ScheduledActions&quot; of native registry   else (  (string &quot;Time&quot; of it, string &quot;LogOff&quot; of it as uppercase, string &quot;Action&quot; of it as uppercase) of dictionaries whose (string &quot;Day&quot; of it = &quot;Friday&quot;) of values of array &quot;ScheduledActions&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; )</Property>
    <Property ID="31" Name="NightWatchman - Saturday Scheduled Action - Win\Mac" EvaluationPeriod="P1D">if (Windows of Operating System) then (  (item 0 of it * hour + item 1 of it * minute) of (values &quot;SaturdayPowerdownHour&quot; of it as string as integer, values &quot;SaturdayPowerdownMinutes&quot; of it as string as integer), values &quot;SaturdayLogoffAction&quot; of it as string as uppercase, values &quot;SaturdayPowerdownAction&quot; of it as string as uppercase) of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\ScheduledActions&quot; of native registry   else (  (string &quot;Time&quot; of it, string &quot;LogOff&quot; of it as uppercase, string &quot;Action&quot; of it as uppercase) of dictionaries whose (string &quot;Day&quot; of it = &quot;Saturday&quot;) of values of array &quot;ScheduledActions&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; )</Property>
    <Property ID="32" Name="NightWatchman - Sunday Scheduled Action - Win\Mac" EvaluationPeriod="P1D">if (Windows of Operating System) then (  (item 0 of it * hour + item 1 of it * minute) of (values &quot;SundayPowerdownHour&quot; of it as string as integer, values &quot;SundayPowerdownMinutes&quot; of it as string as integer), values &quot;SundayLogoffAction&quot; of it as string as uppercase, values &quot;SundayPowerdownAction&quot; of it as string as uppercase) of keys &quot;HKEY_LOCAL_MACHINE\Software\1E\NightWatchman\ScheduledActions&quot; of native registry   else (  (string &quot;Time&quot; of it, string &quot;LogOff&quot; of it as uppercase, string &quot;Action&quot; of it as uppercase) of dictionaries whose (string &quot;Day&quot; of it = &quot;Sunday&quot;) of values of array &quot;ScheduledActions&quot; of dictionary of file &quot;/Library/Preferences/com.1E.NightWatchman.plist&quot; )</Property>
