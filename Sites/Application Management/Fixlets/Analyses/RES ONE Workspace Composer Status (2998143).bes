<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>RES ONE Workspace Composer Status</Title>
    <Description>This analysis gives the startup status of the various windows agents. </Description>
    <Relevance>(windows of operating system and exists service &quot;RESPESVC&quot;) or (unix of operating system and exists service &quot;reswmad&quot;) or (name of operating system as lowercase starts with &quot;mac os x&quot; and exists file &quot;/etc/res/resauthd.conf&quot;)</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 08 Mar 2016 18:38:53 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Composer Status">If (windows of operating system) then (If ((value &quot;Shell&quot; of it as string as lowercase contains &quot;pfwsmgr&quot;) of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon&quot; of native registry OR (value &quot;Shell&quot; of it as string as lowercase contains &quot;pwrstart&quot;) of key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows NT\CurrentVersion\Winlogon&quot; of native registry) then (&quot;Automatic&quot;) ELSE (&quot;Manual&quot;))  ELSE (IF (line (1) of file &quot;/etc/res/resauthd.conf&quot; = &quot;LearningMode=no&quot;) then (&quot;Automatic&quot;) ELSE &quot;Manual&quot;)</Property>
    <Property ID="2" Name="Type of Install">If (windows of operating system) then (value &quot;InstallationType&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion&quot; of x32 registry as string) ELSE &quot;N/A&quot;</Property>
    <Property ID="3" Name="Operating System">name of operating system</Property>
    <Property ID="4" Name="Shell">If (windows of operating system) then (value &quot;Shell&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon&quot; of native registry as string) ELSE IF (exists file &quot;/etc/res/resauthd.conf&quot;) then (line (1) of file &quot;/etc/res/resauthd.conf&quot; &amp; &quot; - &quot; &amp; line (2) of file &quot;/etc/res/resauthd.conf&quot;) ELSE &quot;N/A&quot;</Property>
    <Property ID="5" Name="Operating System Version">version of operating system</Property>
  </Analysis>
</BES>
