    <Relevance>exists processes</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Processes - Running - Universal" EvaluationPeriod="PT1H">unique values of (concatenations of (it as string)) of (name of it | &quot;Name Missing&quot;, (if (exists property &quot;image file&quot; of type &quot;process&quot;) then (pathname of image file of it | &quot;N\A&quot;) else (&quot;N\A&quot;))) of processes</Property>
