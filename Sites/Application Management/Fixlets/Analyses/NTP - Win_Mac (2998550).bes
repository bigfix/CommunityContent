<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>NTP - Win\Mac</Title>
    <Description><![CDATA[Provides information on how NTP is currently configured.
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system or mac of operating system</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="NTP - Win\Mac" EvaluationPeriod="P1D">if (windows of operating system) then (if (value &quot;Type&quot; of key &quot;HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\W32Time\Parameters&quot; of registry = &quot;NT5DS&quot;) then (&quot;Domain Controller&quot;) else (value &quot;NtpServer&quot; of key &quot;HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\W32Time\Parameters&quot; of registry as string)) else ((preceding text of last &quot;.&quot; of following text of first &quot;server &quot; of it) of lines of files &quot;/private/etc/ntp.conf&quot;)</Property>
  </Analysis>
</BES>
