<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>PSU FIT audit - Windows</Title>
    <Description><![CDATA[<P>This is an audit of the installation status of the PSU FIT application and associated reports, files, and associations.</P>
<P>&nbsp;</P>
<P><FONT size=4><STRONG>Resources:</STRONG></FONT></P>
<P><A href="http://technet.microsoft.com/en-us/library/cc753525.aspx">http://technet.microsoft.com/en-us/library/cc753525.aspx</A></P>
<P><A href="http://support.microsoft.com/kb/220167">http://support.microsoft.com/kb/220167</A></P>
<P><A href="http://technet.microsoft.com/en-us/library/bb727008.aspx">http://technet.microsoft.com/en-us/library/bb727008.aspx</A></P>
<P><A href="http://bigfix.me/fixlet/details/771">http://bigfix.me/fixlet/details/771</A></P>
<P><A href="http://support.bigfix.com/cgi-bin/inspectorsearch/single_inspector.cgi?cpx=p&amp;keyphrase=effective+access+mode+for+%26lt%3Bstring%26gt%3B+of+%26lt%3Baccess+control+list%26gt%3B&amp;type=access+control+list&amp;win=WinSkip&amp;lin=LinSkip&amp;hpux=HPUXSkip&amp;mac=MacSkip&amp;aix=AIXSkip&amp;sol=SolSkip&amp;wm=WMSkip&amp;ubu=UbuSkip&amp;client=on&amp;core=on&amp;session=on&amp;regex=on">http://support.bigfix.com/cgi-bin/inspectorsearch/single_inspector.cgi?cpx=p&amp;keyphrase=effective+access+mode+for+%26lt%3Bstring%26gt%3B+of+%26lt%3Baccess+control+list%26gt%3B&amp;type=access+control+list&amp;win=WinSkip&amp;lin=LinSkip&amp;hpux=HPUXSkip&amp;mac=MacSkip&amp;aix=AIXSkip&amp;sol=SolSkip&amp;wm=WMSkip&amp;ubu=UbuSkip&amp;client=on&amp;core=on&amp;session=on&amp;regex=on</A></P>
<P><A href="http://support.bigfix.com/cgi-bin/inspectorsearch/single_inspector.cgi?cpx=c&amp;keyphrase=dacl+of+%26lt%3Bsecurity+descriptor%26gt%3B&amp;type=discretionary+access+control+list&amp;win=WinSkip&amp;lin=LinSkip&amp;hpux=HPUXSkip&amp;mac=MacSkip&amp;aix=AIXSkip&amp;sol=SolSkip&amp;wm=WMSkip&amp;ubu=UbuSkip&amp;client=on&amp;core=on&amp;session=on&amp;regex=on">http://support.bigfix.com/cgi-bin/inspectorsearch/single_inspector.cgi?cpx=c&amp;keyphrase=dacl+of+%26lt%3Bsecurity+descriptor%26gt%3B&amp;type=discretionary+access+control+list&amp;win=WinSkip&amp;lin=LinSkip&amp;hpux=HPUXSkip&amp;mac=MacSkip&amp;aix=AIXSkip&amp;sol=SolSkip&amp;wm=WMSkip&amp;ubu=UbuSkip&amp;client=on&amp;core=on&amp;session=on&amp;regex=on</A></P>
<P>&nbsp;</P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>(exists keys whose(value &quot;DisplayName&quot; of it as string as lowercase starts with &quot;fitwin&quot;) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (native registry;registry)) OR (exists folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder)</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 06 Aug 2014 13:33:28 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="version of FIT" EvaluationPeriod="P2D">unique values of (it as string) of values &quot;DisplayVersion&quot; of keys whose(value &quot;DisplayName&quot; of it as string as lowercase starts with &quot;fitwin&quot; AND value &quot;DisplayName&quot; of it as string as lowercase does not start with &quot;fitwinrpts&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry</Property>
    <Property ID="2" Name="version of FIT Reports" EvaluationPeriod="P2D">unique values of (it as string) of values &quot;DisplayVersion&quot; of keys whose(value &quot;DisplayName&quot; of it as string as lowercase starts with &quot;fitwinrpts&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry</Property>
    <Property ID="3" Name="SHA1 of FIT.im" EvaluationPeriod="P7D">unique values of (it as string) of sha1s of files &quot;fit.im&quot; of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder</Property>
    <Property ID="4" Name="Permissions of ibisfit FOLDER" EvaluationPeriod="PT6H">unique values of (it as bit set as string) of effective access modes for &quot;Users&quot; of dacls of security descriptors of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder</Property>
    <Property ID="5" Name="# of files of componentsConfig FOLDER" EvaluationPeriod="PT6H">number of files of folders &quot;componentsConfig&quot; of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder</Property>
    <Property ID="6" Name="permissions of fit FOLDERS" EvaluationPeriod="PT6H">(((it as bit set as string) of effective access mode for &quot;Users&quot; of dacl of security descriptor of it) &amp; &quot;  &quot; &amp; name of it) of (it;folder &quot;componentsConfig&quot; of it;folder &quot;data&quot; of it;folder &quot;excel&quot; of it;folder &quot;fitrpts&quot; of it) of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder</Property>
    <Property ID="7" Name="permissions of fit FILES" EvaluationPeriod="PT6H">(((it as bit set as string) of effective access mode for &quot;Users&quot; of dacl of security descriptor of it) &amp; &quot; &quot; &amp; following text of first ((it &amp; &quot;\&quot;) of unique value of pathnames of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder) of pathname of it) of descendants of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder</Property>
    <Property ID="8" Name="mod time of fit FILES" EvaluationPeriod="PT6H">(((it as string) of ((year of it as string &amp; month of it as two digits &amp; day_of_month of it as two digits) of date (local time zone) of it) of modification time of it) &amp; &quot; &quot; &amp; following text of first ((it &amp; &quot;\&quot;) of unique value of pathnames of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder) of pathname of it) of descendants of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder</Property>
    <Property ID="9" Name="mod time of fit FOLDERS" EvaluationPeriod="PT6H">(((it as string) of ((year of it as string &amp; month of it as two digits &amp; day_of_month of it as two digits) of date (local time zone) of it) of modification time of it) &amp; &quot; &quot; &amp; name of it) of (it;folder &quot;componentsConfig&quot; of it;folder &quot;data&quot; of it;folder &quot;excel&quot; of it;folder &quot;fitrpts&quot; of it) of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder</Property>
    <Property ID="10" Name=".im file type registered?" EvaluationPeriod="P1D">exists key &quot;HKEY_CLASSES_ROOT\.im\visual.works&quot; of registry</Property>
    <Property ID="11" Name="visual.works registered?" EvaluationPeriod="P1D">values &quot;&quot; of keys &quot;HKEY_CLASSES_ROOT\visual.works\shell\open\command&quot; of registry</Property>
    <Property ID="12" Name="# of files of data FOLDER" EvaluationPeriod="P2D">number of files of folders &quot;data&quot; of folders &quot;ibisfit&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of windows folder</Property>
    <Property ID="13" Name="visual.works command entry" EvaluationPeriod="P2D">values &quot;command&quot; of keys &quot;HKEY_CLASSES_ROOT\visual.works\shell\open\command&quot; of registry</Property>
  </Analysis>
