<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Hibernation - Win\Mac</Title>
    <Description><![CDATA[Hibernation Configuration for Windows&nbsp;and Mac OS
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>NOT in proxy agent context</Relevance>
    <Relevance>windows of operating system or mac of operating system</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Hibernation - State - Win\Mac" EvaluationPeriod="P1D">if ( if (Windows of Operating system) then (value &quot;HibernateEnabled&quot; of key &quot;HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Power&quot; of native registry as string = &quot;1&quot;) else ( if (Mac of Operating System) then (integer &quot;Hibernate Mode&quot; of dictionary of node &quot;IOPMrootDomain&quot; of node &quot;IOPowerConnection&quot; of power plane of iokit registry != 0) else (ERROR &quot;Unknown error&quot;))) then &quot;Enabled&quot; else &quot;Disabled&quot;</Property>
    <Property ID="2" Name="Hibernation - Image Size (GB) - Win\Mac" EvaluationPeriod="P1D">(size of file (if (Windows of Operating System) then ((name of drive of windows folder &amp; &quot;\hiberfil.sys&quot;)) else (if (Mac of Operating system) then (&quot;/var/vm/sleepimage&quot;) else (ERROR &quot;Unkown Error&quot;))) / 1024 /* KB */ / 1024 /* MB */ / 1024 /* GB */) | 0</Property>
    <Property ID="4" Name="Hibernation - Image Size (B) - Win\Mac" EvaluationPeriod="P1D">(size of file (if (Windows of Operating System) then ((name of drive of windows folder &amp; &quot;\hiberfil.sys&quot;)) else (if (Mac of Operating system) then (&quot;/var/vm/sleepimage&quot;) else (ERROR &quot;Unkown Error&quot;)))) | 0</Property>
  </Analysis>
</BES>
