<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>RES ONE Automation - Agent - Universal</Title>
    <Description><![CDATA[&lt;enter a description of the analysis here&gt; ]]></Description>
    <Relevance>mac of operating system or unix of operating system or windows of operating system</Relevance>
    <Relevance>if (mac of operating system or unix of operating system) then (exists file &quot;/etc/res/resauthd.conf&quot;) else (true)</Relevance>
    <Relevance>if (windows of operating system) then (exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES&quot; of x32 registry or exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES&quot; of x64 registry) else (true)</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="RES ONE Automation - Agent - State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;reswas&quot;)) then (state of service &quot;reswas&quot;) else (&quot;Not Installed&quot;)) else (if (unix of operating system) then (if (exists service &quot;resamad&quot;) then (state of service &quot;resamad&quot;) else (&quot;Not Installed&quot;)) else (&quot;-&quot;))</Property>
  </Analysis>
