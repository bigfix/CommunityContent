<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Applications - McAfee ePolicy Orchestrator - Win\Mac</Title>
    <Description><![CDATA[<P>This analysis provides information on the currently installed ePO agent.</P>
<P>For general information or to report issues with C3 Protect content please visit GitHub here: <A href="https://github.com/strawgate/C3-Protect">https://github.com/strawgate/C3-Protect</A></P>]]></Description>
    <Relevance>windows of operating system or mac of operating system</Relevance>
    <Relevance>if (windows of operating system) then (exists keys whose (value &quot;DisplayName&quot; of it as string is &quot;McAfee Agent&quot;) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\&quot; of ( x32 registry; (if exists x64 registry then x64 registry else nothing) )) else (exists file &quot;config.xml&quot; of folder whose (name of it starts with &quot;EPOAGENT&quot;) of folders &quot;/private/etc/cma.d&quot;)</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="McAfee ePO - Version - Win\Mac" EvaluationPeriod="PT1H"> if (windows of operating system) then ((value &quot;DisplayVersion&quot; of it as string) of keys whose (value &quot;DisplayName&quot; of it as string is &quot;McAfee Agent&quot;) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\&quot; of (x32 registries; x64 registries)) else ((substring after &quot;&lt;Version&gt;&quot;of substring before &quot;&lt;/Version&gt;&quot; of it as string) of lines containing &quot;&lt;Version&gt;&quot; of file &quot;config.xml&quot; of folder whose (name of it starts with &quot;EPOAGENT&quot;) of folders &quot;/private/etc/cma.d&quot;)</Property>
    <Property ID="2" Name="McAfee ePO - Management Server - Win\Mac" EvaluationPeriod="P1D">rows of statement &quot;SELECT SERVER_FQDN from AGENT_REPOSITORIES where path=&apos;Software&apos;&quot; of sqlite database of file &quot;ma.db&quot; of folder &quot;db&quot; of (if (windows of operating system) then (folders (value &quot;DataPath&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\McAfee\Agent&quot; of native registry as string)) else (folders &quot;/var/McAfee/agent&quot;))</Property>
    <Property ID="3" Name="McAfee ePO - Agent Ping Port - Win\Mac" EvaluationPeriod="P1D">rows of statement &quot;SELECT value from AGENT_CHILD where name=&apos;AgentPingPort&apos;&quot; of sqlite database of file &quot;ma.db&quot; of folder &quot;db&quot; of (if (windows of operating system) then (folders (value &quot;DataPath&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\McAfee\Agent&quot; of native registry as string)) else (folders &quot;/var/McAfee/agent&quot;))</Property>
    <Property ID="4" Name="McAfee ePO - Configured Tasks - Windows" EvaluationPeriod="P1D">(node values of attributes &quot;name&quot; of it) of (/* Filter out only the assigned tasks */ items 0 of (it whose (item 1 of it contains node value of attribute &quot;id&quot; of item 0 of it)) of (selects &quot;/Manifest/TaskRoot/Tasks/Task&quot; of it, set of node values of attributes &quot;id&quot; of (selects &quot;/Manifest/TaskRoot/Assignments/Assignment&quot; of it)) of (xml document of file &quot;manifest.xml&quot; of folder (value &quot;DataPath&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\McAfee\Agent&quot; of native registry as string)))</Property>
    <Property ID="5" Name="McAfee ePO - Configured Policies - Windows" EvaluationPeriod="P1D">(node values of attributes &quot;feature&quot; of it, node values of attributes &quot;type&quot; of it, node values of attributes &quot;name&quot; of it) of (/* Filter out only the assigned policies */ items 0 of (it whose (item 1 of it contains node value of attribute &quot;id&quot; of item 0 of it)) of (selects &quot;/Manifest/PolicyRoot/Policies/Policy&quot; of it, set of node values of attributes &quot;id&quot; of (selects &quot;/Manifest/PolicyRoot/Assignments/Assignment&quot; of it)) of (xml document of file &quot;manifest.xml&quot; of folder (value &quot;DataPath&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\McAfee\Agent&quot; of native registry as string)))</Property>
    <Property ID="6" Name="McAfee ePO - Enforcement State - Windows" EvaluationPeriod="PT1H">if ((select &quot;/Manifest/AgentMeta/EnforcePolicy&quot; of xml document of file &quot;manifest.xml&quot; of folder (value &quot;DataPath&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\McAfee\Agent&quot; of native registry as string) as text) = &quot;1&quot;) then &quot;Enforced&quot; else &quot;Not Enforced&quot;</Property>
    <Property ID="7" Name="McAfee ePO - Architecture - Windows" EvaluationPeriod="P1D">if (exists keys whose (value &quot;DisplayName&quot; of it as string is &quot;McAfee Agent&quot;) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\&quot; of ( x32 registry)) then &quot;x86&quot; else (if (exists keys whose (value &quot;DisplayName&quot; of it as string is &quot;McAfee Agent&quot;) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\&quot; of ( x64 registry)) then (&quot;x64&quot;) else (error &quot;none&quot;))</Property>
    <Property ID="8" Name="McAfee ePO - Agent GUID - Win\Mac" EvaluationPeriod="P1D">rows of statement &quot;SELECT value from AGENT_CHILD where name=&apos;AgentGuid&apos;&quot; of sqlite database of file &quot;ma.db&quot; of folder &quot;db&quot; of (if (windows of operating system) then (folders (value &quot;DataPath&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\McAfee\Agent&quot; of native registry as string)) else (folders &quot;/var/McAfee/agent&quot;))</Property>
    <Property ID="9" Name="McAfee ePO - Policy Enforcement Status - Win\Mac" EvaluationPeriod="PT12H">if (exists rows whose (it as string = &quot;1&quot;) of statement &quot;SELECT value from AGENT_CHILD where name=&apos;PolicyLastEnforcementStatus&apos;&quot; of sqlite database of file &quot;ma.db&quot; of folder &quot;db&quot; of (if (windows of operating system) then (folders (value &quot;DataPath&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\McAfee\Agent&quot; of native registry as string)) else (folders &quot;/var/McAfee/agent&quot;))) then &quot;Successful&quot; else &quot;Failure&quot;</Property>
    <Property ID="10" Name="McAfee ePO - Recent Log Messages - Win\Mac" EvaluationPeriod="PT12H">(column &quot;DATE_TIME&quot; of it, column &quot;SEVERITY&quot; of it, column &quot;MESSAGE&quot; of it) of rows of statement &quot;SELECT * from AGENT_LOGS ORDER BY ROWID DESC LIMIT 10&quot; of sqlite database of file &quot;ma.db&quot; of folder &quot;db&quot; of (if (windows of operating system) then (folders (value &quot;DataPath&quot; of keys &quot;HKEY_LOCAL_MACHINE\Software\McAfee\Agent&quot; of native registry as string)) else (folders &quot;/var/McAfee/agent&quot;))</Property>
  </Analysis>
</BES>
