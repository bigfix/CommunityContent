<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>RES Component State</Title>
    <Description>This analysis will retrieve the state of the various RES components deployed at endpoints. </Description>
    <Relevance>(unix of operating system and exists file &quot;/etc/res/resauthd.conf&quot;) or (mac of operating system and exists file &quot;/etc/res/resauthd.conf&quot;) or (if (windows of operating system) then exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES&quot; of x32 registry or exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES&quot; of x64 registry else false)</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Fri, 04 Sep 2015 16:38:13 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="RES ONE Workspace Agent State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;res&quot;)) then (state of service &quot;res&quot;) else (&quot;Not Installed&quot;)) else (if (exists file &quot;/etc/res/resauthd.conf&quot;) then (IF (exists process whose (name of it starts with &quot;reswmad&quot;)) then (&quot;Running&quot;) ELSE &quot;Stopped&quot;) else (&quot;Unknown&quot;))</Property>
    <Property ID="2" Name="RES ONE Workspace PE State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;respesvc&quot;)) then (state of service &quot;respesvc&quot;) else (&quot;Not Installed&quot;)) else (&quot;N/A&quot;)</Property>
    <Property ID="3" Name="RES ONE Workspace Relay State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;resrls&quot;)) then (state of service &quot;resrls&quot;) else (&quot;Not Installed&quot;)) else (&quot;N/A&quot;)</Property>
    <Property ID="4" Name="RES ONE Workspace Reporting Services State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;reswmrs&quot;)) then (state of service &quot;reswmrs&quot;) else (&quot;Not Installed&quot;)) else (&quot;N/A&quot;)</Property>
    <Property ID="5" Name="RES ONE Automation Agent State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;reswas&quot;)) then (state of service &quot;reswas&quot;) else (&quot;Not Installed&quot;)) else (if (unix of operating system) then (if (exists service &quot;resamad&quot;) then (state of service &quot;resamad&quot;) else (&quot;Not Installed&quot;)) else (&quot;-&quot;))</Property>
    <Property ID="6" Name="RES ONE Automation Console Service State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;reswcs&quot;)) then (state of service &quot;reswcs&quot;) else (&quot;Not Installed&quot;)) ELSE (&quot;N/A&quot;)</Property>
    <Property ID="7" Name="RES ONE Automation Dispatcher+ State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;reswds&quot;)) then (state of service &quot;reswds&quot;) else (&quot;Not Installed&quot;)) else (&quot;N/A&quot;)</Property>
    <Property ID="8" Name="RES ONE Service Store Catalog Services State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;resocs&quot;)) then (state of service &quot;resocs&quot;) else (&quot;Not Installed&quot;)) else (&quot;N/A&quot;)</Property>
    <Property ID="9" Name="RES ONE Service Store Transaction Engine State">if (windows of operating system) then (if (exists services whose (service name of it as lowercase = &quot;resote&quot;)) then (state of service &quot;resote&quot;) else (&quot;Not Installed&quot;)) else (&quot;N/A&quot;)</Property>
  </Analysis>
</BES>
