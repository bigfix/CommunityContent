  <Analysis>
    <Title>RES ONE Workspace - Console - Windows</Title>
    <Description><![CDATA[<P>Provides the configuration for the Windows RES ONE Workspace Console</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance><![CDATA[exists file ((value "InstallDir" of key "HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager" of x32 registry as string) & "pwrtech.exe")]]></Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="RES ONE Workspace Console - Version - Windows">version of file ((value &quot;InstallDir&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\RES\Workspace Manager&quot; of x32 registry as string) &amp; &quot;pwrtech.exe&quot;) | error &quot;none&quot;</Property>
  </Analysis>
