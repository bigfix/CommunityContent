<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Dell Warranty - Windows</Title>
    <Description><![CDATA[This analysis pairs with the "Invoke - Gather Dell Warranty - Windows" fixlet in order to provide warranty information about Dell devices.
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Relevance>
    <Domain>BESC</Domain>
    <Property ID="9" Name="Warranty - Dell Last Gather - Windows" EvaluationPeriod="P1D">modification time of file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="10" Name="Warranty - Dell Ship Date - Windows" EvaluationPeriod="P1D">unique values of (it as date) of (last 2 of it &amp; &quot; &quot; &amp; (substring (5,2) of it as integer as month as three letters) &amp; &quot; &quot; &amp; first 4 of it) of preceding text of first &quot;T&quot; of (it as text) of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:ShipDate/text()&quot; of xml document of file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="11" Name="Warranty - Dell Warranty Names - Windows" EvaluationPeriod="P1D">unique values of (it as trimmed string) of node values of selects &quot;a:ServiceLevelDescription/text()&quot; of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty&quot; whose( exists (it) whose(it &gt; current date) of ((it as date) of (last 2 of it &amp; &quot; &quot; &amp; (substring (4,2) of it as integer as month as three letters) &amp; &quot; &quot; &amp; first 4 of it) of it) of (it as trimmed string) of (concatenations of substrings separated by &quot;-&quot; of it) of (preceding text of first &quot;T&quot; of it) of node values of selects &quot;a:EndDate/text()&quot; of it ) of xml documents of file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="12" Name="Warranty - Dell Active Warranties - Windows" EvaluationPeriod="P1D">unique values of (it as trimmed string) of node values of selects &quot;a:ServiceLevelDescription/text()&quot; of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty&quot; whose( exists (it) whose(it &gt; current date) of ((it as date) of (last 2 of it &amp; &quot; &quot; &amp; (substring (4,2) of it as integer as month as three letters) &amp; &quot; &quot; &amp; first 4 of it) of it) of (it as trimmed string) of (concatenations of substrings separated by &quot;-&quot; of it) of (preceding text of first &quot;T&quot; of it) of node values of selects &quot;a:EndDate/text()&quot; of it ) of xml documents of files &quot;BigFixDellWarranty.xml&quot; of folders &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="13" Name="Warranty - Dell Expired Warranties - Windows" EvaluationPeriod="P1D">unique values of (it as trimmed string) of node values of selects &quot;a:ServiceLevelDescription/text()&quot; of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty&quot; whose( exists (it) whose(it &lt; current date) of ((it as date) of (last 2 of it &amp; &quot; &quot; &amp; (substring (4,2) of it as integer as month as three letters) &amp; &quot; &quot; &amp; first 4 of it) of it) of (it as trimmed string) of (concatenations of substrings separated by &quot;-&quot; of it) of (preceding text of first &quot;T&quot; of it) of node values of selects &quot;a:EndDate/text()&quot; of it ) of xml documents of files &quot;BigFixDellWarranty.xml&quot; of folders &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="14" Name="Warranty - Dell Hardware Description - Windows" EvaluationPeriod="P1D">( ( ( (it as integer) of first 4 of node value of select &quot;a:EndDate/text()&quot; of it ) - ( (it as integer) of first 4 of node value of select &quot;a:StartDate/text()&quot; of it ) ) as string &amp; &quot; Year &quot; &amp; ( node value of select &quot;a:ServiceLevelDescription/text()&quot; of it ) ) whose (it contains &quot;Business Day&quot;) of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty&quot; of xml documents of file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="15" Name="Warranty - Dell Complete Care Description - Windows" EvaluationPeriod="P1D">( ( ( (it as integer) of first 4 of node value of select &quot;a:EndDate/text()&quot; of it ) - ( (it as integer) of first 4 of node value of select &quot;a:StartDate/text()&quot; of it ) ) as string &amp; &quot; Year &quot; &amp; ( node value of select &quot;a:ServiceLevelDescription/text()&quot; of it ) ) whose (it contains &quot;Complete Care&quot;) of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty&quot; of xml documents of file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="16" Name="Warranty - Dell Hardware Expiration Date - Windows" EvaluationPeriod="P1D">maxima of unique values of (it as date) of (last 2 of first 10 of it &amp; &quot; &quot; &amp; (substring (5,2) of it as integer as month as three letters) &amp; &quot; &quot; &amp; first 4 of it) of (it as text) of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty[a:ServiceLevelDescription=&apos;Next Business Day Support&apos; or a:ServiceLevelDescription=&apos;Next Business Day + Onsite Resolution&apos;]&quot; of xml documents of file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="17" Name="Warranty - Dell Hardware Start Date - Windows" EvaluationPeriod="P1D">minima of unique values of (it as date) of (last 2 of first 10 of it &amp; &quot; &quot; &amp; (substring (5,2) of it as integer as month as three letters) &amp; &quot; &quot; &amp; first 4 of it) of (following text of last &quot; &quot; of preceding text of last &quot;T&quot; of it) of (it as text) of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty[a:ServiceLevelDescription=&apos;Next Business Day Support&apos; or a:ServiceLevelDescription=&apos;Next Business Day + Onsite Resolution&apos;]&quot; of xml documents of file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="18" Name="Warranty - Dell Complete Care Expiration Date - Windows" EvaluationPeriod="P1D">maxima of unique values of (it as date) of (last 2 of first 10 of it &amp; &quot; &quot; &amp; (substring (5,2) of it as integer as month as three letters) &amp; &quot; &quot; &amp; first 4 of it) of (it as text) of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty[a:ServiceLevelDescription=&apos;Complete Care&apos;]&quot; of xml documents of file &quot;BigFixDellWarranty.xml&quot; of folder &quot;Dell&quot; of folder &quot;ProgramData&quot; of drive of system folder</Property>
    <Property ID="19" Name="Warranty - Dell Complete Care Start Date - Windows" EvaluationPeriod="P1D">minima of unique values of (it as date) of(last 2 of first 10 of it &amp; &quot; &quot; &amp; (substring (5,2) of it as integer as month as three letters) &amp; &quot; &quot; &amp; first 4 of it) of (following text of last &quot; &quot; of preceding text of last &quot;T&quot; of it) of (it as text) of selects &quot;/GetAssetWarrantyResponse/GetAssetWarrantyResult/a:Response/a:DellAsset/a:Warranties/a:Warranty[a:ServiceLevelDescription=&apos;Complete Care&apos;]&quot; of xml documents of files &quot;BigFixDellWarranty.xml&quot; of folders &quot;Dell&quot; of folders &quot;ProgramData&quot; of drive of system folder</Property>
  </Analysis>
