<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>iTunes configuration - Windows</Title>
    <Description><![CDATA[<P>&nbsp;This analysis will enumerate the configuration of iTunes on the reporting system.</P>
<P>&nbsp;The latest version of this Analysis can be found here: &nbsp;<A href="http://bigfix.me/analysis/details/2994626">http://bigfix.me/analysis/details/2994626</A></P>
<P>&nbsp;</P>
<P><STRONG>References:</STRONG></P>
<P><A href="http://support.apple.com/kb/ht2102">http://support.apple.com/kb/ht2102</A></P>
<P><A href="http://bigfix.me/relevance/details/2998595">http://bigfix.me/relevance/details/2998595</A></P>
<P><A href="http://bigfix.me/fixlet/details/3704">http://bigfix.me/fixlet/details/3704</A></P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>/* iTunes is installed */ (exists key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes&quot; of registry) OR (exists keys whose(value &quot;DisplayName&quot; of it as string starts with &quot;iTunes&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry) OR (exists regapp &quot;iTunes.exe&quot;)</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Mon, 27 Jan 2014 21:07:43 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="version" EvaluationPeriod="PT12H">unique values of (((it as string) of versions of regapps &quot;iTunes.exe&quot;);((it as string) of values &quot;DisplayVersion&quot; of keys whose(value &quot;DisplayName&quot; of it as string starts with &quot;iTunes&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry))</Property>
    <Property ID="2" Name="RegValues" EvaluationPeriod="PT12H">(name of it, it as string) of values of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Apple Computer, Inc.\iTunes&quot; of registry</Property>
    <Property ID="4" Name="InstallDate" EvaluationPeriod="PT12H">values &quot;InstallDate&quot; of keys whose(value &quot;DisplayName&quot; of it as string starts with &quot;iTunes&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry</Property>
    <Property ID="5" Name="InstallSource" EvaluationPeriod="PT12H">values &quot;InstallSource&quot; of keys whose(value &quot;DisplayName&quot; of it as string starts with &quot;iTunes&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry</Property>
    <Property ID="6" Name="AdminFlags" EvaluationPeriod="PT12H">(it as string) of values &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="7" Name="kParentalFlags_Locked" EvaluationPeriod="PT12H">bit 0 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="8" Name="kParentalFlags_DisablePodcasts" EvaluationPeriod="PT12H">bit 1 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="9" Name="kParentalFlags_DisableMusicStore" EvaluationPeriod="PT12H">bit 2 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="10" Name="kParentalFlags_DisableSharing" EvaluationPeriod="PT12H">bit 3 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="11" Name="kParentalFlags_DisableExplicitContent" EvaluationPeriod="PT12H">bit 4 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="12" Name="kParentalFlags_DisableRadio">bit 5 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="13" Name="kParentalFlags_RestrictMovieContent" EvaluationPeriod="PT12H">bit 6 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="14" Name="kParentalFlags_RestrictTVShowContent" EvaluationPeriod="PT12H">bit 7 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="15" Name="kParentalFlags_DisableCheckForUpdates" EvaluationPeriod="PT12H">bit 8 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="16" Name="kParentalFlags_RestrictGames" EvaluationPeriod="PT12H">bit 9 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="17" Name="kParentalFlags_DisableAutomaticDeviceSync" EvaluationPeriod="PT12H">bit 10 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="18" Name="kParentalFlags_DisableGetAlbumArtwork" EvaluationPeriod="PT12H">bit 11 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="19" Name="kParentalFlags_DisablePlugins" EvaluationPeriod="PT12H">bit 12 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="20" Name="kParentalFlags_DisableOpenStream" EvaluationPeriod="PT12H">bit 13 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="21" Name="kParentalFlags_DisableAppleTV" EvaluationPeriod="PT12H">bit 14 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="22" Name="kParentalFlags_DisableDeviceRegistration" EvaluationPeriod="PT12H">bit 15 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="23" Name="kParentalFlags_DisableDiagnostics" EvaluationPeriod="PT12H">bit 16 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="24" Name="kParentalFlags_AllowITunesUAccess" EvaluationPeriod="PT12H">bit 17 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="25" Name="kParentalFlags_RequireEncryptedBackups" EvaluationPeriod="PT12H">bit 18 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="26" Name="kParentalFlags_DisableHomeSharing" EvaluationPeriod="PT12H">bit 19 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="27" Name="kParentalFlags_DisableCheckForAppUpdates" EvaluationPeriod="PT12H">bit 20 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="28" Name="kParentalFlags_DisableCheckForDeviceUpdates" EvaluationPeriod="PT12H">bit 21 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="29" Name="kParentlFlags_DisableFirstRunWelcomeWindow" EvaluationPeriod="PT12H">bit 22 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="30" Name="kParentalFlags_DisableDeviceFileSharing" EvaluationPeriod="PT12H">bit 23 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="31" Name="kParentalFlags_DisableExplicitBooks" EvaluationPeriod="PT12H">bit 24 of (it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
    <Property ID="32" Name="AdminFlags as bit set" EvaluationPeriod="PT12H">(it as integer as bits) of value &quot;AdminFlags&quot; of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Apple Computer, Inc.\iTunes\Parental Controls\Default&quot; of registry</Property>
  </Analysis>
