    <Property ID="7" Name="Dell Command | Update - Updates Available - Windows" EvaluationPeriod="PT1H">(select &quot;name&quot; of it as text, select &quot;version&quot; of it as text) of selects &quot;/updates/update&quot; of xml document of file &quot;report.xml&quot; of folder &quot;ProgramData\Dell\CommandUpdate&quot; of drive of system folder</Property>
    <Property ID="8" Name="Dell Command | Update - Download Source URLs - Windows" EvaluationPeriod="PT1H">(select &quot;name&quot; of it as text, select &quot;version&quot; of it as text, select &quot;file&quot; of it as text) of selects &quot;/updates/update&quot;  of xml document of file &quot;report.xml&quot; of folder &quot;ProgramData\Dell\CommandUpdate&quot; of drive of system folder</Property>
