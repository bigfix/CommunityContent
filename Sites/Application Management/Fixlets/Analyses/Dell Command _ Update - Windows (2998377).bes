    <Property ID="5" Name="Dell Command | Update - Recommended Updates - Windows" EvaluationPeriod="PT1H">(select &quot;name&quot; of it as text, select &quot;version&quot; of it as text) of selects &quot;/updates/update&quot; whose (select &quot;urgency&quot; of it as text = &quot;Recommended&quot;) of xml document of file &quot;report.xml&quot; of folder &quot;ProgramData\Dell\CommandUpdate&quot; of drive of system folder</Property>
