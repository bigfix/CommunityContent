<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Dell Command | Update - Windows</Title>
    <Description><![CDATA[&lt;enter a description of the analysis here&gt; ]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists file &quot;report.xml&quot; of folder &quot;ProgramData\Dell\CommandUpdate&quot; of drive of system folder</Relevance>
    <Domain>BESC</Domain>
    <Property ID="2" Name="Dell Command | Update - Raw Report - Windows" EvaluationPeriod="PT1H">lines of file &quot;report.xml&quot; of folder &quot;ProgramData\Dell\CommandUpdate&quot; of drive of system folder</Property>
    <Property ID="3" Name="Dell Command | Update - Urgent Updates - Windows" EvaluationPeriod="PT1H">(select &quot;name&quot; of it as text, select &quot;version&quot; of it as text) of selects &quot;/updates/update&quot; whose (select &quot;urgency&quot; of it as text = &quot;Urgent&quot;) of xml document of file &quot;report.xml&quot; of folder &quot;ProgramData\Dell\CommandUpdate&quot; of drive of system folder</Property>
