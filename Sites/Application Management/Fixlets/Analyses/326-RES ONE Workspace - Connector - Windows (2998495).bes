<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>RES ONE Workspace - Connector - Windows</Title>
    <Description>Provides configuration information regarding the RES2BES Connector</Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>NOT in proxy agent context</Relevance>
    <Relevance>(exists file &quot;res2bes.exe&quot; of folder &quot;res2bes&quot; of parent folder of parent folder of file of service &quot;res&quot; | false) or (exists (file &quot;res2bes.exe&quot; of folder (value &quot;path&quot; of key &quot;HKLM\SOFTWARE\BigFix\Enterprise Server\Applications\res2bes&quot; of registry as string)) | false)</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="RES ONE Workspace Connector - Version - Windows">(version of file &quot;res2bes.exe&quot; of folder (value &quot;path&quot; of key &quot;HKLM\SOFTWARE\BigFix\Enterprise Server\Applications\res2bes&quot; of registry as string)) | version of (file (pathname of parent folder of parent folder of file of service &quot;res&quot; &amp; &quot;\res2bes\res2bes.exe&quot;))</Property>
    <Property ID="2" Name="RES ONE Workspace Connector - Authentication Method - Windows">if (select &quot;/BESPluginRegistration&quot; of xml document of file &quot;res2bes.xml&quot; of folder &quot;Config&quot; of folder &quot;Applications&quot; of parent folder of file (following text of first &quot;%22&quot; of (image path of main gather service as string)) as text as string contains &quot;--sql&quot;) then &quot;SQL Authentication&quot; else &quot;Windows Authentication&quot;</Property>
    <Property ID="3" Name="RES ONE Workspace Connector - Run Frequency - Windows">xpaths &quot;/BESPluginRegistration/Schedule/WaitPeriodSeconds&quot; of xml document of file &quot;res2bes.xml&quot; of folder &quot;config&quot; of parent folder of file of service &quot;BESPluginService&quot; as text</Property>
    <Property ID="4" Name="RES ONE Workspace Connector - Current Invocation Command - Windows">selects &quot;/BESPluginRegistration&quot; of xml document of file &quot;res2bes.xml&quot; of folder &quot;Config&quot; of folder &quot;Applications&quot; of parent folder of file (following text of first &quot;%22&quot; of (image path of main gather service as string)) as text</Property>
    <Property ID="5" Name="RES ONE Workspace Connector - Last Run Result - Windows">(if (content of it contains &quot;Sync completed with no errors reported.&quot;) then (lines containing &quot;Sync completed with no errors reported.&quot; of it) else ((previous line of it; it; next line of it) of line containing &quot;Error while running the RES ONE Workspace Connector.&quot; of it)) of (item 1 of it of (maximum of modification times of files whose(name of it as lowercase ends with &quot;.log&quot;) of it, files whose(name of it as lowercase ends with &quot;.log&quot; of it) of it) whose (item 0 of it = modification time of item 1 of it) of folder &quot;res2bes&quot; of parent folder of file of service &quot;BESPluginService&quot; | error &quot;Waiting for first sync&quot;)</Property>
    <Property ID="6" Name="RES ONE Workspace Connector - Last Run - Windows">modification time of (item 1 of it of (maximum of modification times of files whose(name of it as lowercase ends with &quot;.log&quot;) of it, files whose(name of it as lowercase ends with &quot;.log&quot; of it) of it) whose (item 0 of it = modification time of item 1 of it) of folder &quot;res2bes&quot; of parent folder of file of service &quot;BESPluginService&quot;) | error &quot;Waiting for first sync&quot;</Property>
  </Analysis>
</BES>
