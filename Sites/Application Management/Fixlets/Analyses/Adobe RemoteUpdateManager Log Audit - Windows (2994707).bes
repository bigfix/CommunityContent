<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Adobe RemoteUpdateManager Log Audit - Windows</Title>
    <Description><![CDATA[<P>An audit of the Adobe Remote Update Manager (RUM) Log.</P>
<P>&nbsp;</P>
<P>Related:</P>
<P><A href="https://www.virustotal.com/en/file/7ee4f7a0e46e34539e9ed362c32ed751025103ade4cdad75c01ccb558c7015ea/analysis/">https://www.virustotal.com/en/file/7ee4f7a0e46e34539e9ed362c32ed751025103ade4cdad75c01ccb558c7015ea/analysis/</A></P>
<P><A href="https://www.virustotal.com/en/file/a667f8c4acb661ea17e3f82b3c776e31020d18859fb114198bd84d12b7f44571/analysis/">https://www.virustotal.com/en/file/a667f8c4acb661ea17e3f82b3c776e31020d18859fb114198bd84d12b7f44571/analysis/</A></P>
<P>&nbsp;</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists lines of files &quot;RemoteUpdateManager.log&quot; of ((folders &quot;temp&quot; of windows folders);((folders &quot;AppData\Local\Temp&quot; of folders of folders &quot;Users&quot; of it) of root folders of drives of system folders))</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 20 Aug 2014 15:04:58 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="# lines of RUM.log" EvaluationPeriod="P2D">number of lines of files &quot;RemoteUpdateManager.log&quot; of ((folders &quot;temp&quot; of windows folders);((folders &quot;AppData\Local\Temp&quot; of folders of folders &quot;Users&quot; of it) of root folders of drives of system folders))</Property>
    <Property ID="2" Name="modtime of RUM.log" EvaluationPeriod="PT12H">((((year of it as string &amp; month of it as two digits &amp; day_of_month of it as two digits) of date (local time zone) of it) of modification time of it) &amp; &quot;  &quot; &amp; pathname of it) of files &quot;RemoteUpdateManager.log&quot; of ((folders &quot;temp&quot; of windows folders);((folders &quot;AppData\Local\Temp&quot; of folders of folders &quot;Users&quot; of it) of root folders of drives of system folders))</Property>
    <Property ID="3" Name="version of Adobe Updater" EvaluationPeriod="PT12H">versions of files &quot;Common Files\Adobe\OOBE\PDApp\UWA\UpdaterCore.dll&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of system folder</Property>
    <Property ID="4" Name="version of RUM on system" EvaluationPeriod="PT12H">versions of files &quot;Common Files\Adobe\OOBE_Enterprise\RemoteUpdateManager\RemoteUpdateManager.exe&quot; of folders whose(name of it as lowercase starts with &quot;program files&quot;) of root folder of drive of system folder</Property>
    <Property ID="5" Name="Last 100 lines of RemoteUpdateManager.log files" EvaluationPeriod="P2D">( /* -&gt; Unicode to ASCII (non-ASCII characters will still be present if any exist and they will not show up correctly) -&gt; */ concatenation of characters whose (it != &quot;%00&quot;) of item 1 of /* -&gt; This &quot;it&quot; refers to the last 100 lines of the file -&gt; */ it) whose( /* -&gt; remove empty lines, which is why this relevance can return less than 100 lines per file -&gt; */ it as trimmed string != &quot;&quot;) of ( /* -&gt; this is the number of lines of the file from the previous statement -&gt; */ item 1 of it, (lines of /* -&gt; the file object -&gt; */ item 0 of it) ) /* -&gt; This whose statement is responsible for filtering for only the last 100 lines of the file -&gt; */ whose ( (line number of /* -&gt; lines of the file -&gt; */ item 1 of it) &gt; ( /* -&gt; number of lines of the file -&gt; */ item 0 of it - 100 /* &lt;- This is the number of lines to return, which is subtracted from the total # of lines &lt;- */ ) ) of ( /* -&gt; the parent file object itself -&gt; */ it, number of lines of it) of /* this will gather up all of the files -&gt; */ files &quot;RemoteUpdateManager.log&quot; of /* -&gt; All of the folders that there might be a RemoteUpdateManager.log file -&gt; */ ((folders &quot;temp&quot; of windows folders);((folders &quot;AppData\Local\Temp&quot; of folders of folders &quot;Users&quot; of it) of /* -&gt; Equivalent to (folder &quot;C:\&quot;) -&gt; */ root folders of drives of system folders))</Property>
    <Property ID="6" Name="Date of last successful check for updates" EvaluationPeriod="P2D">unique values of (preceding text of first &quot; &quot; of concatenation of characters whose (it != &quot;%00&quot;) of it) of items 0 of (lines of item 0 of it, item 1 of it) whose(line number of item 0 of it = item 1 of it) of (it, maximum of line numbers of lines whose(concatenation of characters whose (it != &quot;%00&quot;) of it contains &quot;CheckForUpdates completed successfully&quot;) of it) of files &quot;RemoteUpdateManager.log&quot; of /* -&gt; All of the folders that there might be a RemoteUpdateManager.log file -&gt; */ ((folders &quot;temp&quot; of windows folders) ;((folders &quot;AppData\Local\Temp&quot; of folders of folders &quot;Users&quot; of it) of /* -&gt; Equivalent to (folder &quot;C:\&quot;) -&gt; */ root folders of drives of system folders))</Property>
  </Analysis>
</BES>
