<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>BackupExec Audit - Windows</Title>
    <Description><![CDATA[<P>This is an analysis that was a work in progress, but I stopped using the product.</P>
<P>&nbsp;</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Wed, 06 May 2015 14:17:59 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="BackupExec Version" EvaluationPeriod="P1D">unique values of (it as string as version) of values &quot;DisplayVersion&quot; of keys whose (exists value &quot;DisplayVersion&quot; of it AND exists value &quot;DisplayName&quot; whose (it as string contains &quot;Symantec Backup Exec System Recovery&quot;) of it) of keys &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of (x64 registries; x32 registries)</Property>
    <Property ID="2" Name="VProConsole" EvaluationPeriod="P1D">versions of regapps &quot;VProConsole.exe&quot;</Property>
  </Analysis>
</BES>
