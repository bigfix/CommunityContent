<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Splunk Info</Title>
    <Description><![CDATA[<P>A listing of Splunk client information for Windows.</P>
<P>The Bar operator ("|") requires BES Client v8.&nbsp; Without this, several of the string-based properties will return errors if Splunk is not installed or configured on the client.</P>
<P>The Socket objects require BES Client v9.&nbsp; This is used to test connection status to the Splunk servers, and assumes connections on default Splunk port of 9997.</P>
<P>It's difficult to read status from the splunkd.log file, as the file is locked, and the information contained in the file itself is often misleading.</P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 28 May 2013 20:34:23 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="SplunkInstalled" EvaluationPeriod="PT6H">exists (keys of (key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry)) whose (value &quot;DisplayName&quot; of it = &quot;Universal Forwarder&quot; and value &quot;Publisher&quot; of it=&quot;Splunk, Inc.&quot;)</Property>
    <Property ID="2" Name="Version" EvaluationPeriod="PT6H">value &quot;DisplayVersion&quot; of  (keys of (key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry)) whose (value &quot;DisplayName&quot; of it = &quot;Universal Forwarder&quot; and value &quot;Publisher&quot; of it=&quot;Splunk, Inc.&quot;) as string | &quot;N/A&quot;</Property>
    <Property ID="3" Name="ServiceState" EvaluationPeriod="PT1H">state of service &quot;SplunkForwarder&quot; as string | &quot;Not Installed&quot;</Property>
    <Property ID="4" Name="SplunkServer" EvaluationPeriod="PT6H">preceding text of first &quot;:&quot; of following text of first &quot;=&quot; of (it) of line whose( ( if it does not contain &quot;;&quot; then it else preceding text of first &quot;;&quot; of it) as uppercase contains &quot;TARGETURI&quot; ) of file (value &quot;InstallLocation&quot; of  (keys of (key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry)) whose (value &quot;DisplayName&quot; of it = &quot;Universal Forwarder&quot; and value &quot;Publisher&quot; of it=&quot;Splunk, Inc.&quot;) as string &amp; &quot;etc\system\local\deploymentclient.conf&quot;) as trimmed string | &quot;N/A&quot;</Property>
    <Property ID="5" Name="Server Connection Status" EvaluationPeriod="PT30M">exists  (sockets of network) whose ((remote port of it = 9997) and (tcp state of it as string= &quot;ESTABLISHED&quot;))</Property>
    <Property ID="6" Name="Active Server IP Address" EvaluationPeriod="PT30M">unique values of (remote addresses of  (sockets of network) whose ((remote port of it = 9997) and (tcp state of it as string= &quot;ESTABLISHED&quot;)))</Property>
    <Property ID="7" Name="SplunkServerURI" EvaluationPeriod="PT6H">following text of first &quot;=&quot; of (it) of line whose( ( if it does not contain &quot;;&quot; then it else preceding text of first &quot;;&quot; of it) as uppercase contains &quot;TARGETURI&quot; ) of file (value &quot;InstallLocation&quot; of  (keys of (key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry)) whose (value &quot;DisplayName&quot; of it = &quot;Universal Forwarder&quot; and value &quot;Publisher&quot; of it=&quot;Splunk, Inc.&quot;) as string &amp; &quot;etc\system\local\deploymentclient.conf&quot;) as trimmed string | &quot;N/A&quot;</Property>
    <Property ID="8" Name="UninstallRegKey" EvaluationPeriod="P1D">(keys of (key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry)) whose (value &quot;DisplayName&quot; of it = &quot;Universal Forwarder&quot; and value &quot;Publisher&quot; of it=&quot;Splunk, Inc.&quot;)</Property>
    <Property ID="9" Name="SplunkConfigFile" EvaluationPeriod="P1D">(value &quot;InstallLocation&quot; of (keys of (key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry)) whose (value &quot;DisplayName&quot; of it = &quot;Universal Forwarder&quot; and value &quot;Publisher&quot; of it=&quot;Splunk, Inc.&quot;) as string &amp; &quot;etc\system\local\deploymentclient.conf&quot;) | &quot;N/A&quot;</Property>
    <Property ID="10" Name="InstallPath" EvaluationPeriod="PT6H">preceding text of last &quot;\&quot; of (value &quot;InstallLocation&quot; of  (keys of (key &quot;HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Uninstall&quot; of native registry)) whose (value &quot;DisplayName&quot; of it = &quot;Universal Forwarder&quot; and value &quot;Publisher&quot; of it=&quot;Splunk, Inc.&quot;) as string) | &quot;not installed&quot;</Property>
    <Property ID="11" Name="ServiceInstalled" EvaluationPeriod="P1D">exists service &quot;SplunkForwarder&quot;</Property>
  </Analysis>
</BES>
