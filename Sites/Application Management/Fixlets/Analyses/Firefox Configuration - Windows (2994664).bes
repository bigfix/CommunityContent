<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Firefox Configuration - Windows</Title>
    <Description><![CDATA[<P>This analysis reports on the endpoint's firefox configuration.</P>
<P>&nbsp;</P>
<P>Find the related "<STRONG>Browser, Flash, Java</STRONG>" analysis here:&nbsp; <A href="http://bigfix.me/analysis/details/2994622">http://bigfix.me/analysis/details/2994622</A></P>
<P>Find the latest version of this analysis here:&nbsp; <A href="http://bigfix.me/analysis/details/2994571">http://bigfix.me/analysis/details/2994571</A></P>]]></Description>
    <Relevance>/* Windows Only */ windows of operating system</Relevance>
    <Relevance><![CDATA[/* Windows XP or Higher */ version of operating system >= "5.1"]]></Relevance>
    <Relevance>/* Firefox is installed */ (exists folders &quot;Mozilla Firefox&quot; of (folders &quot;C:\Program Files (x86)&quot;;folders &quot;C:\Program Files&quot;)) OR (exists key whose(value &quot;DisplayName&quot; of it as string starts with &quot;Mozilla Firefox&quot;) of key &quot;HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall&quot; of registry) OR (exists regapp &quot;firefox.exe&quot;)</Relevance>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Tue, 01 Jul 2014 19:42:55 +0000</Value>
    </MIMEField>
    <Domain>BESC</Domain>
    <Property ID="1" Name="location of firefox.exe" EvaluationPeriod="P2D">locations of regapps &quot;firefox.exe&quot;</Property>
    <Property ID="3" Name="local-settings" EvaluationPeriod="P2D">exists files &quot;local-settings.js&quot; of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;)</Property>
    <Property ID="4" Name="Config File Name?" EvaluationPeriod="P2D">((it as string) whose(it as lowercase contains &quot;.cfg&quot;) of unique values of preceding texts of firsts &quot;%22&quot; of following texts of firsts &quot;%22&quot; of following texts of firsts &quot;,&quot; of preceding texts of firsts &quot;)&quot; of lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of files whose(name of it as lowercase ends with &quot;.js&quot; AND exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of it) of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;))</Property>
    <Property ID="5" Name="Config File exists?" EvaluationPeriod="P2D">exists files ((it as string) of preceding texts of firsts &quot;%22&quot; of following texts of firsts &quot;%22&quot; of following texts of firsts &quot;,&quot; of preceding texts of firsts &quot;)&quot; of lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of files whose(name of it as lowercase ends with &quot;.js&quot; AND exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of it) of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;)) of folders (locations of regapps &quot;firefox.exe&quot;)</Property>
    <Property ID="6" Name="Lines of Config File" EvaluationPeriod="P2D">lines of files ((it as string) of preceding texts of firsts &quot;%22&quot; of following texts of firsts &quot;%22&quot; of following texts of firsts &quot;,&quot; of preceding texts of firsts &quot;)&quot; of lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of files whose(name of it as lowercase ends with &quot;.js&quot; AND exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of it) of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;)) of folders (locations of regapps &quot;firefox.exe&quot;)</Property>
    <Property ID="7" Name="JS Config Setting file" EvaluationPeriod="P2D">names of files whose(name of it as lowercase ends with &quot;.js&quot; AND exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of it) of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;)</Property>
    <Property ID="8" Name="Lines of JS Config Setting file" EvaluationPeriod="P2D">lines of files whose(name of it as lowercase ends with &quot;.js&quot; AND exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of it) of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;)</Property>
    <Property ID="9" Name="Does .js setting &amp; config file exist?" EvaluationPeriod="P2D">(exists files whose(name of it as lowercase ends with &quot;.js&quot; AND exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of it) of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;)) AND (exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of files whose(name of it as lowercase ends with &quot;.js&quot; AND exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of it) of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;)) AND (exists files ((it as string) of preceding texts of firsts &quot;%22&quot; of following texts of firsts &quot;%22&quot; of following texts of firsts &quot;,&quot; of preceding texts of firsts &quot;)&quot; of lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of files whose(name of it as lowercase ends with &quot;.js&quot; AND exists lines whose((it as lowercase starts with &quot;pref&quot; OR it as lowercase starts with &quot;lockpref&quot;) AND it as lowercase contains &quot;general.config.filename&quot;) of it) of folders &quot;defaults\pref&quot; of folders (locations of regapps &quot;firefox.exe&quot;)) of folders (locations of regapps &quot;firefox.exe&quot;))</Property>
    <Property ID="10" Name="update.channel" EvaluationPeriod="PT12H">(preceding texts of firsts &quot;%22&quot; of following texts of firsts &quot;%22&quot; of following texts of firsts &quot;%22app.update.channel%22&quot; of lines whose(it contains &quot;%22app.update.channel%22&quot; AND it starts with &quot;pref&quot;) of files &quot;defaults\pref\channel-prefs.js&quot; of parent folders of regapps &quot;firefox.exe&quot;)</Property>
    <Property ID="11" Name="Firefox Folder" EvaluationPeriod="P2D">folders &quot;Mozilla Firefox&quot; of (folders &quot;C:\Program Files (x86)&quot;;folders &quot;C:\Program Files&quot;)</Property>
    <Property ID="12" Name="Version of firefox.exe" EvaluationPeriod="PT12H">version of regapp &quot;firefox.exe&quot;</Property>
