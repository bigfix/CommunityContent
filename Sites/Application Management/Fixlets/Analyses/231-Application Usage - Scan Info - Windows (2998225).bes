<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Application Usage - Scan Info - Windows</Title>
    <Description><![CDATA[<P>This analysis provides information on the Application Usage scan including the first scan on the endpoint, the most recent scan on the endpoint, and the current size of the application usage tracking database.</P>
<P>For general information or to report issues with C3 Application Usage content please visit GitHub here: <A href="https://github.com/strawgate/C3-Application-Usage">https://github.com/strawgate/C3-Application-Usage</A></P>]]></Description>
    <Relevance>windows of operating system</Relevance>
    <Relevance>exists file &quot;AppUsage.xml&quot; of folder &quot;C3AppUsage&quot; of folder &quot;__Global&quot; of data folder of client</Relevance>
    <Domain>BESC</Domain>
    <Property ID="2" Name="Usage - First Updated - Windows" EvaluationPeriod="P1D">(select &quot;Date&quot; of it as text as date &amp; (select &quot;Time&quot; of it as text as time_of_day &amp; local time zone)) of selects &quot;/Usage/FirstUpdate&quot; of xml document of file &quot;AppUsage.xml&quot; of folder &quot;C3AppUsage&quot; of folder &quot;__Global&quot; of data folder of client</Property>
    <Property ID="3" Name="Usage - Last Updated - Windows" EvaluationPeriod="P1D">(select &quot;Date&quot; of it as text as date &amp; (select &quot;Time&quot; of it as text as time_of_day &amp; local time zone)) of selects &quot;/Usage/LastUpdate&quot; of xml document of file &quot;AppUsage.xml&quot; of folder &quot;C3AppUsage&quot; of folder &quot;__Global&quot; of data folder of client</Property>
    <Property ID="5" Name="Usage - Database Size - Windows" EvaluationPeriod="P1D">size of file &quot;AppUsage.xml&quot; of folder &quot;C3AppUsage&quot; of folder &quot;__Global&quot; of data folder of client</Property>
  </Analysis>
</BES>
