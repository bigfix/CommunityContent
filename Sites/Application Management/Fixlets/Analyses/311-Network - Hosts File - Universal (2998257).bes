<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
  <Analysis>
    <Title>Network - Hosts File - Universal</Title>
    <Description><![CDATA[<P>Covers the configuration of the system hosts file. </P>
<P>Kudos, compliments and credit to jgstew for posting the source of this analysis: <A href="https://bigfix.me/analysis/details/2994561">https://bigfix.me/analysis/details/2994561</A></P>
<P>For general information or to report issues with C3 Inventory content please visit GitHub here: <A href="https://github.com/strawgate/C3-Inventory">https://github.com/strawgate/C3-Inventory</A></P>]]></Description>
    <Relevance>windows of operating system or mac of operating system</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Hosts File - Manual Entries Count - Universal" EvaluationPeriod="P1D">number of lines whose (it as trimmed string does not equal &quot;&quot; and it does not start with &quot;#&quot; and it does not start with &quot;127.0.0.1&quot; and it does not start with &quot;255.255.255.255&quot; and it does not start with &quot;::1&quot; and it does not start with &quot;fe80::1&quot;) of file &quot;hosts&quot; of (if windows of operating system then folder &quot;drivers\etc&quot; of (if (x64 of operating system ) then (system x64 folder) else (system x32 folder)) else (if mac of operating system then folder &quot;/private/etc&quot; else folder &quot;/etc&quot;)) &gt; 0</Property>
    <Property ID="2" Name="Hosts File - Manual Entries - Universal" EvaluationPeriod="P1D">lines whose (it as trimmed string does not equal &quot;&quot; and it does not start with &quot;#&quot; and it does not start with &quot;127.0.0.1&quot; and it does not start with &quot;255.255.255.255&quot; and it does not start with &quot;::1&quot; and it does not start with &quot;fe80::1&quot;) of file &quot;hosts&quot; of (if windows of operating system then folder &quot;drivers\etc&quot; of (if (x64 of operating system ) then (system x64 folder) else (system x32 folder)) else (if mac of operating system then folder &quot;/private/etc&quot; else folder &quot;/etc&quot;))</Property>
    <Property ID="3" Name="Hosts File - Exists - Universal" EvaluationPeriod="P1D">exists file &quot;hosts&quot; of (if windows of operating system then folder &quot;drivers\etc&quot; of (if (x64 of operating system ) then (system x64 folder) else (system x32 folder)) else (if mac of operating system then folder &quot;/private/etc&quot; else folder &quot;/etc&quot;))</Property>
  </Analysis>
</BES>
