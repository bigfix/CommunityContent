    <Relevance>true</Relevance>
    <Domain>BESC</Domain>
    <Property ID="1" Name="Volumes - System Drive has &lt;2% Free - Universal" EvaluationPeriod="P1D">(free space of drive of system folder as floating point / total space of drive of system folder as floating point) &lt; &quot;.02&quot; as floating point</Property>
    <Property ID="2" Name="Volumes - System Drive has &lt;5% Free - Universal" EvaluationPeriod="P1D">(free space of drive of system folder as floating point / total space of drive of system folder as floating point) &lt; &quot;.05&quot; as floating point</Property>
    <Property ID="3" Name="Volumes - System Drive % Free - Universal" EvaluationPeriod="P1D">relative significance place 2 of (free space of drive of system folder as floating point / total space of drive of system folder as floating point) * 100</Property>
    <Property ID="5" Name="Volumes - Total Space in GB - Windows" EvaluationPeriod="PT1H">if (windows of operating system) then (unique values of (it as string) of (name of it, (total space of it / 1024 / 1024 / 1024) as string &amp; &quot; GB&quot;) of drives whose (numeric type of it = 3)) else (nothing)</Property>
    <Property ID="6" Name="Volumes - Free Space in GB - Windows" EvaluationPeriod="PT1H">if (windows of operating system) then (unique values of (it as string) of (name of it, (free space of it / 1024 / 1024 / 1024) as string &amp; &quot; GB&quot;) of drives whose (numeric type of it = 3)) else (nothing)</Property>
    <Property ID="7" Name="Volumes - Free Space % - Windows" EvaluationPeriod="PT1H">if (windows of operating system) then (unique values of (it as string) of (name of it, (significance place 1 of (free space of it as floating point / total space of it as floating point * 100 )) as string &amp; &quot;%25&quot;) of drives whose (numeric type of it = 3)) else (nothing)</Property>
  </Analysis>
