    <Property ID="2" Name="# of lines of AcroFix.logs" EvaluationPeriod="P2D">(number of lines of it) of files &quot;acrofix.log&quot; of ((folders &quot;temp&quot; of windows folders);((folders &quot;AppData\Local\Temp&quot; of folders of folders &quot;Users&quot; of it) of root folders of drives of system folders))</Property>
    <Property ID="3" Name="ModTime of AcroFix.logs" EvaluationPeriod="PT12H">((((year of it as string &amp; month of it as two digits &amp; day_of_month of it as two digits) of date (local time zone) of it) of modification time of it) &amp; &quot; &quot; &amp; pathname of it) of files &quot;acrofix.log&quot; of ((folders &quot;temp&quot; of windows folders);((folders &quot;AppData\Local\Temp&quot; of folders of folders &quot;Users&quot; of it) of root folders of drives of system folders))</Property>
    <Property ID="4" Name="New Property" EvaluationPeriod="P2D">( /* -&gt; Unicode to ASCII (non-ASCII characters will still be present if any exist and they will not show up correctly) -&gt; */ concatenation of characters whose (it != &quot;%00&quot;) of item 1 of /* -&gt; This &quot;it&quot; refers to the last 100 lines of the file -&gt; */ it) whose( /* -&gt; remove empty lines, which is why this relevance can return less than 100 lines per file -&gt; */ it as trimmed string != &quot;&quot;) of ( /* -&gt; this is the number of lines of the file from the previous statement -&gt; */ item 1 of it, (lines of /* -&gt; the file object -&gt; */ item 0 of it) ) /* -&gt; This whose statement is responsible for filtering for only the last 100 lines of the file -&gt; */ whose ( (line number of /* -&gt; lines of the file -&gt; */ item 1 of it) &gt; ( /* -&gt; number of lines of the file -&gt; */ item 0 of it - 100 /* &lt;- This is the number of lines to return, which is subtracted from the total # of lines &lt;- */ ) ) of ( /* -&gt; the parent file object itself -&gt; */ it, number of lines of it) of /* this will gather up all of the log files -&gt; */ files &quot;acrofix.log&quot; of ((folders &quot;temp&quot; of windows folders);((folders &quot;AppData\Local\Temp&quot; of folders of folders &quot;Users&quot; of it) of root folders of drives of system folders))</Property>
